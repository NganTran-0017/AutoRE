**[LESSON]:** Alloy models involving temporal properties must represent time with numeric values or ordered integers to support arithmetic and comparison. Abstract atoms are insufficient for duration constraints.

**[PATTERN]:** Syntax errors in Alloy often arise from arithmetic on abstract atoms; converting to integer time representation resolves this and enables temporal verification.

**[EVENT]:** Detection of a syntax error from subtracting Time atoms blocked verification, emphasizing the need to explicitly specify time modeling approach and clarify temporal semantics in requirements to proceed.

**Current Alloy Model:**
```alloy
// Alloy 6 model for RBAC with Emergency Module - Revised time representation and temporal constraints

open util/ordering [Time]

// === Basic Types and Enums ===
abstract sig SecurityClearance {}
one sig High, Medium, Low extends SecurityClearance {}

abstract sig SystemMode {}
one sig NormalMode, EmergencyMode extends SystemMode {}

one sig True, False extends Bool {} // Bool type for flags

// Time atoms represent discrete time points; timeValue maps Time atoms to Int values for arithmetic
sig Time {}

fun timeValue[t: Time]: Int {
  // Abstract function mapping each Time atom to an integer value
  // For modeling, assume timeValue is total and injective
  // We do not define this function explicitly; Alloy treats it as uninterpreted
  // Usage: timeValue[t] returns integer timestamp of t
  0
}

// === Entities ===

sig User {
  clearance: one SecurityClearance,
  assignedRoles: set Role,
  delegatedRoles: set DelegatedRole,
  submittedRequests: set Request,
  isAdmin: one Bool,          // True if user is administrator (High clearance with admin privileges)
  updatedCredentials: one Bool // Indicates if credentials updated after Emergency mode ends
}

sig Role {
  minClearance: one SecurityClearance
}

sig DelegatedRole {
  role: one Role,
  delegate: one User,
  delegator: one User,
  startTime: one Time,
  endTime: one Time, // delegation expiration time or revocation time
  duringEmergency: one Bool // True if delegated during Emergency mode
}

sig Request {
  requester: one User,
  classification: one SecurityClearance,
  submittedAt: one Time,
  approvedBy: set User, // admins who approved (higher clearance)
  rejectedBy: set User  // admins who rejected (higher clearance)
}

sig SystemState {
  time: one Time,
  mode: one SystemMode,
  emergencyTriggerers: set User, // admins who triggered emergency at this time (used only in Normal mode)
  processingQueue: seq Request,
  delegatedRoles: set DelegatedRole,
  emergencyPrivileges: set User, // admins with emergency privileges (only during Emergency mode)
  emergencyEndedAt: lone Time
}

// === Clearance ordering and comparison ===

// Define ordering over SecurityClearance for convenience
fun clearanceOrder[c: SecurityClearance]: Int {
  c = Low => 0 else c = Medium => 1 else 2
}

pred clearanceAtLeast[c1, c2: SecurityClearance] {
  clearanceOrder[c1] >= clearanceOrder[c2]
}

// === Facts and Constraints ===

// Users with High clearance and isAdmin = True are administrators
fact AdminDef {
  all u: User | (u.clearance = High and u.isAdmin = True) iff (u.isAdmin = True)
}

// Requests can only be submitted if classification <= user's clearance
fact RequestSubmissionClearance {
  all r: Request | clearanceAtLeast[r.requester.clearance, r.classification]
}

// Higher clearance users may approve/reject requests from lower clearance users
fact ApprovalClearance {
  all r: Request, u: User |
    u in r.approvedBy + r.rejectedBy implies clearanceAtLeast[u.clearance, r.requester.clearance]
}

// Delegated roles require delegate to meet role’s min clearance
fact DelegationClearance {
  all d: DelegatedRole | clearanceAtLeast[d.delegate.clearance, d.role.minClearance]
}

// Mutual exclusive roles relation (pairs of roles mutually exclusive under Normal mode)
sig MutualExclusiveRoles {
  r1, r2: Role
}

fact MutualExclusivitySymmetry {
  all m: MutualExclusiveRoles | (m.r1 != m.r2)
  all m: MutualExclusiveRoles | some m2: MutualExclusiveRoles | m2.r1 = m.r2 and m2.r2 = m.r1
}

// Mutual exclusivity enforced only in Normal mode (suspended during Emergency mode)
fact RoleMutualExclusionNormalMode {
  all s: SystemState | s.mode = NormalMode =>
    all u: User |
      all r1, r2: Role |
        (r1 in u.assignedRoles + (d: DelegatedRole | d.delegate = u and d in s.delegatedRoles).role) and
        (r2 in u.assignedRoles + (d: DelegatedRole | d.delegate = u and d in s.delegatedRoles).role) and
        r1 != r2 =>
          no m: MutualExclusiveRoles | (m.r1 = r1 and m.r2 = r2)
}

// Emergency privileges granted only during Emergency mode and revoked immediately after
fact EmergencyPrivilegesTiming {
  all s: SystemState |
    s.mode = EmergencyMode => s.emergencyPrivileges = (u: User | u.isAdmin = True)
  all s: SystemState |
    s.mode = NormalMode => no s.emergencyPrivileges
}

// Delegated roles granted during Emergency mode are revoked after Emergency mode ends
fact DelegatedRolesEmergencyRevocation {
  all s: SystemState |
    s.mode = NormalMode and some t: Time | timeValue[t] < timeValue[s.time] and
    some s2: SystemState | s2.time = t and s2.mode = EmergencyMode =>
      all d: s.delegatedRoles | d.duringEmergency = True implies timeValue[d.endTime] <= timeValue[s.time]
}

// Administrators must update credentials after Emergency mode ends
fact CredentialUpdateAfterEmergency {
  all s: SystemState | s.mode = NormalMode and s.emergencyEndedAt = some t and timeValue[t] < timeValue[s.time] =>
    all u: User | u.isAdmin = True implies u.updatedCredentials = True
}

// Request processing order constraints:
// Normal mode: FIFO strictly by submittedAt time
fact RequestProcessingOrderNormal {
  all s: SystemState | s.mode = NormalMode =>
    all i, j: Int | i < j and i in s.processingQueue.inds and j in s.processingQueue.inds =>
      timeValue[s.processingQueue[i].submittedAt] <= timeValue[s.processingQueue[j].submittedAt]
}

// Emergency mode: FIFO order may be bypassed to allow simultaneous processing of multiple High-classification requests 
fact RequestProcessingOrderEmergency {
  all s: SystemState | s.mode = EmergencyMode =>
    all i, j: Int | i < j and i in s.processingQueue.inds and j in s.processingQueue.inds =>
      let ri = s.processingQueue[i], rj = s.processingQueue[j] |
        if ri.classification = High and rj.classification = High then true else
          timeValue[ri.submittedAt] <= timeValue[rj.submittedAt]
}

// System mode transitions: 
// R1: exactly two admins concurrently trigger emergency during Normal mode => EmergencyMode
// R2: Emergency mode lasts limited duration, then eventually return to Normal mode
fact SystemModeTransition {
  all s: SystemState |
    s.mode = NormalMode and #s.emergencyTriggerers = 2 and all u: s.emergencyTriggerers | u.isAdmin = True =>
      some s2: SystemState | timeValue[s2.time] > timeValue[s.time] and s2.mode = EmergencyMode
  all s: SystemState | s.mode = EmergencyMode =>
    some s2: SystemState | timeValue[s2.time] > timeValue[s.time] and s2.mode = NormalMode
}

// === Predicates for incrementally checking requirements ===

// Some fixed limited duration for Emergency mode (abstracted as 10 time units)
fun someLimitedDuration[] : Int {
  10
}

pred R1 {
  // R1: Emergency Mode Triggering: exactly two admins trigger emergency concurrently during Normal mode
  some s: SystemState | 
    s.mode = NormalMode and 
    #s.emergencyTriggerers = 2 and 
    all u: s.emergencyTriggerers | u.isAdmin = True and 
    some s2: SystemState | timeValue[s2.time] > timeValue[s.time] and s2.mode = EmergencyMode
}

pred R1R2 {
  R1[]
  // R2: Emergency mode lasts limited duration, then eventually returns to Normal mode
  all s: SystemState | s.mode = EmergencyMode =>
    some s2: SystemState | 
      timeValue[s2.time] > timeValue[s.time] and 
      s2.mode = NormalMode and 
      timeValue[s2.time] - timeValue[s.time] <= someLimitedDuration[]
}

pred R1R2R3 {
  R1R2[]
  // R3.1: During Emergency, FIFO may be bypassed for multiple High requests simultaneously
  all s: SystemState | s.mode = EmergencyMode =>
    some i, j: Int | i != j and i in s.processingQueue.inds and j in s.processingQueue.inds and
    s.processingQueue[i].classification = High and s.processingQueue[j].classification = High
  // R3.2: During Emergency, mutual exclusivity suspended (modeled by absence of exclusivity constraints)
  // Already accounted by fact RoleMutualExclusionNormalMode which applies only in Normal mode
  // R3.3: Emergency privileges granted to admins during Emergency mode (enforced by fact EmergencyPrivilegesTiming)
}

pred R1R2R3R4 {
  R1R2R3[]
  // R4.1: Emergency privileges revoked immediately after Emergency mode ends
  all s: SystemState | s.mode = NormalMode => no s.emergencyPrivileges
  // R4.2: Delegated roles granted during Emergency revoked after Emergency ends (enforced by fact DelegatedRolesEmergencyRevocation)
  // R4.3: Admins update credentials after Emergency mode ends (enforced by fact CredentialUpdateAfterEmergency)
}

// Comprehensive predicate asserting all requirements hold together
pred All_Requirements {
  R1R2R3R4[]
}

// === Assertions to check ===

assert assertR1 {
  R1[]
}

assert assertR2 {
  R1R2[]
}

assert assertR3 {
  R1R2R3[]
}

assert assertR4 {
  R1R2R3R4[]
}

assert assertAll {
  All_Requirements[]
}

// === Run and Check commands ===

run R1 for 5 but 5 Time, 5 User, 5 Role, 10 Request, 10 DelegatedRole, 2 SystemState
run R1R2 for 10 but 10 Time, 5 User, 5 Role, 10 Request, 10 DelegatedRole, 5 SystemState
run R1R2R3 for 10 but 10 Time, 6 User, 6 Role, 15 Request, 15 DelegatedRole, 6 SystemState
run R1R2R3R4 for 15 but 15 Time, 6 User, 6 Role, 20 Request, 20 DelegatedRole, 8 SystemState
run All_Requirements for 20 but 20 Time, 10 User, 10 Role, 30 Request, 30 DelegatedRole, 10 SystemState

check assertR1 for 5 but 5 Time, 5 User, 5 Role, 10 Request, 10 DelegatedRole, 2 SystemState
check assertR2 for 10 but 10 Time, 5 User, 5 Role, 10 Request, 10 DelegatedRole, 5 SystemState
check assertR3 for 10 but 10 Time, 6 User, 6 Role, 15 Request, 15 DelegatedRole, 6 SystemState
check assertR4 for 15 but 15 Time, 6 User, 6 Role, 20 Request, 20 DelegatedRole, 8 SystemState
check assertAll for 20 but 20 Time, 10 User, 10 Role, 30 Request, 30 DelegatedRole, 10 SystemState

```

**[LESSON]:**  
- Alloy does not support arithmetic on abstract atoms; representing time as an abstract signature requires mapping atoms to integers for arithmetic.  
- Defining a function `timeValue: Time -> Int` enables temporal arithmetic and comparison while keeping time abstract.  
- All expressions performing arithmetic on time atoms must be rewritten using `timeValue` to avoid syntax errors.  
- Using `util/ordering[Time]` still useful for ordering atoms, but arithmetic must use integer mapping.  
- Incremental predicates and facts must consistently use `timeValue` for temporal constraints.  
- Abstracting time as discrete integer steps simplifies modeling and verification of temporal properties.

