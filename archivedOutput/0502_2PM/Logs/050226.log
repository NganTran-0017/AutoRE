**Current Alloy Model:**
```alloy
// Alloy 6 model for RBAC with Emergency Module - Final refined version incorporating evaluator feedback and updated requirements

open util/ordering[Time]

// === Basic Types and Enums ===
abstract sig SecurityClearance {}
one sig High, Medium, Low extends SecurityClearance {}

abstract sig SystemMode {}
one sig NormalMode, EmergencyMode extends SystemMode {}

abstract sig Bool {}
one sig True, False extends Bool {}

// === Time as discrete steps ===
sig Time {}

// Total injective mapping from Time to Int for ordering and arithmetic
fun timeValue[t: Time]: Int {
  0  // uninterpreted; assumed total and injective by fact below
}

fact TimeValueProperties {
  // Injectivity: distinct Time atoms map to distinct Int values
  all t1, t2: Time | (timeValue[t1] = timeValue[t2]) iff (t1 = t2)
}

// === Entities ===

sig User {
  clearance: one SecurityClearance,
  assignedRoles: set Role,
  delegatedRoles: set DelegatedRole,
  submittedRequests: set Request,
  isAdmin: one Bool,            // True if user is administrator (High clearance with admin privileges)
  updatedCredentials: one Bool  // True if credentials updated after Emergency mode ends (modeled as event flag)
}

sig Role {
  minClearance: one SecurityClearance
}

// Explicit subset of mutual exclusivity constraints suspended during Emergency mode
// User must provide explicit subset or criteria for this set; currently abstract
sig SuspendedMutualExclusiveRoles {
  r1, r2: Role
}

sig MutualExclusiveRoles {
  r1, r2: Role
}

// Delegated roles are time-bounded with start/end times and emergency flag
sig DelegatedRole {
  role: one Role,
  delegate: one User,
  delegator: one User,
  startTime: one Time,
  endTime: one Time,          // delegation expiration or revocation time
  duringEmergency: one Bool   // True if delegated during Emergency mode
}

sig Request {
  requester: one User,
  classification: one SecurityClearance,
  submittedAt: one Time,
  approvedBy: set User, // admins who approved (higher clearance)
  rejectedBy: set User  // admins who rejected (higher clearance)
}

sig SystemState {
  time: one Time,
  mode: one SystemMode,
  emergencyTriggerers: set User,      // admins who triggered emergency at this time (only in Normal mode)
  processingQueue: seq Request,
  delegatedRoles: set DelegatedRole,
  emergencyPrivileges: set User,      // admins with emergency privileges (only during Emergency mode)
  emergencyEndedAt: lone Time
}

// === Clearance ordering and comparison ===

fun clearanceOrder[c: SecurityClearance]: Int {
  c = Low => 0 else c = Medium => 1 else 2
}

pred clearanceAtLeast[c1, c2: SecurityClearance] {
  clearanceOrder[c1] >= clearanceOrder[c2]
}

// === Facts and Constraints ===

// Define administrators: Users with High clearance and isAdmin = True
fact AdminDef {
  all u: User | (u.isAdmin = True) iff (u.clearance = High)
}

// Requests only submitted if classification <= user's clearance
fact RequestSubmissionClearance {
  all r: Request | clearanceAtLeast[r.requester.clearance, r.classification]
}

// Approvers/Rejection clearance requirement: must have clearance >= requester's clearance
fact ApprovalClearance {
  all r: Request, u: User |
    u in r.approvedBy + r.rejectedBy implies clearanceAtLeast[u.clearance, r.requester.clearance]
}

// Delegated roles require delegate meets role’s min clearance
fact DelegationClearance {
  all d: DelegatedRole | clearanceAtLeast[d.delegate.clearance, d.role.minClearance]
}

// Mutual exclusivity constraints are symmetric and roles are distinct
fact MutualExclusivitySymmetry {
  all m: MutualExclusiveRoles | m.r1 != m.r2
  all m: MutualExclusiveRoles | some m2: MutualExclusiveRoles | m2.r1 = m.r2 and m2.r2 = m.r1
  all m: SuspendedMutualExclusiveRoles | m.r1 != m.r2
  all m: SuspendedMutualExclusiveRoles | some m2: SuspendedMutualExclusiveRoles | m2.r1 = m.r2 and m2.r2 = m.r1
}

// Mutual exclusivity enforcement under Normal mode (all mutual exclusivity applies)
fact RoleMutualExclusionNormalMode {
  all s: SystemState | s.mode = NormalMode =>
    all u: User |
      let userRoles = u.assignedRoles + (d: DelegatedRole | d.delegate = u and d in s.delegatedRoles).role |
        all r1, r2: Role |
          r1 != r2 and r1 in userRoles and r2 in userRoles =>
            no m: MutualExclusiveRoles | ( (m.r1 = r1 and m.r2 = r2) or (m.r1 = r2 and m.r2 = r1) )
}

// Mutual exclusivity enforcement during Emergency mode suspends constraints only for suspended subset
fact RoleMutualExclusionEmergencyMode {
  all s: SystemState | s.mode = EmergencyMode =>
    all u: User |
      let userRoles = u.assignedRoles + (d: DelegatedRole | d.delegate = u and d in s.delegatedRoles).role |
        all r1, r2: Role |
          r1 != r2 and r1 in userRoles and r2 in userRoles =>
            // If pair (r1,r2) is NOT in suspended mutual exclusive subset, enforce exclusivity
            (no mSusp: SuspendedMutualExclusiveRoles | 
                ( (mSusp.r1 = r1 and mSusp.r2 = r2) or (mSusp.r1 = r2 and mSusp.r2 = r1) )
            ) implies
              no m: MutualExclusiveRoles | ( (m.r1 = r1 and m.r2 = r2) or (m.r1 = r2 and m.r2 = r1) )
}

// Emergency privileges granted only during Emergency mode and revoked immediately after
fact EmergencyPrivilegesTiming {
  all s: SystemState |
    s.mode = EmergencyMode => s.emergencyPrivileges = (u: User | u.isAdmin = True)
  all s: SystemState |
    s.mode = NormalMode => no s.emergencyPrivileges
}

// Delegated roles granted during Emergency mode revoked after Emergency ends
fact DelegatedRolesEmergencyRevocation {
  all s: SystemState |
    s.mode = NormalMode and some t: Time |
      s.emergencyEndedAt = some t and
      timeValue[t] < timeValue[s.time] =>
        all d: s.delegatedRoles | d.duringEmergency = True implies timeValue[d.endTime] <= timeValue[s.time]
}

// Admins must update credentials after Emergency mode ends
fact CredentialUpdateAfterEmergency {
  all s: SystemState | s.mode = NormalMode and s.emergencyEndedAt = some t and timeValue[t] < timeValue[s.time] =>
    all u: User | u.isAdmin = True implies u.updatedCredentials = True
}

// Request processing order constraints

// Normal mode: Strict FIFO by submittedAt time
fact RequestProcessingOrderNormal {
  all s: SystemState | s.mode = NormalMode =>
    all i, j: Int | i < j and i in s.processingQueue.inds and j in s.processingQueue.inds =>
      timeValue[s.processingQueue[i].submittedAt] <= timeValue[s.processingQueue[j].submittedAt]
}

// Emergency mode: FIFO may be bypassed to allow simultaneous processing of multiple High-classification requests
fact RequestProcessingOrderEmergency {
  all s: SystemState | s.mode = EmergencyMode =>
    all i, j: Int | i < j and i in s.processingQueue.inds and j in s.processingQueue.inds =>
      let ri = s.processingQueue[i], rj = s.processingQueue[j] |
        if ri.classification = High and rj.classification = High then true else
          timeValue[ri.submittedAt] <= timeValue[rj.submittedAt]
}

// System mode transitions: 
// R1: Exactly two admins concurrently trigger emergency during Normal mode => EmergencyMode
// Concurrency means triggering within concurrencyWindow discrete time steps
fun concurrencyWindow[]: Int { 1 } // parameterizable concurrency window size

fact SystemModeTransition {
  all s: SystemState |
    s.mode = NormalMode and #s.emergencyTriggerers = 2 and all u: s.emergencyTriggerers | u.isAdmin = True =>
      some s2: SystemState |
        timeValue[s2.time] > timeValue[s.time] and
        timeValue[s2.time] - timeValue[s.time] <= concurrencyWindow[] and
        s2.mode = EmergencyMode
  all s: SystemState | s.mode = EmergencyMode =>
    some s2: SystemState | timeValue[s2.time] > timeValue[s.time] and s2.mode = NormalMode
}

// === Predicates for incrementally checking requirements ===

// Limited duration for Emergency mode (strict bound), e.g., 10 discrete time units
fun someLimitedDuration[] : Int { 10 } // parameterizable emergency duration

pred R1 {
  // R1: Emergency Mode Triggering: exactly two admins trigger emergency concurrently during Normal mode
  some s: SystemState | 
    s.mode = NormalMode and 
    #s.emergencyTriggerers = 2 and 
    all u: s.emergencyTriggerers | u.isAdmin = True and 
    some s2: SystemState | 
      timeValue[s2.time] > timeValue[s.time] and 
      timeValue[s2.time] - timeValue[s.time] <= concurrencyWindow[] and 
      s2.mode = EmergencyMode
}

pred R1R2 {
  R1[]
  // R2: Emergency mode lasts limited duration, then eventually returns to Normal mode
  all s: SystemState | s.mode = EmergencyMode =>
    some s2: SystemState | 
      timeValue[s2.time] > timeValue[s.time] and 
      s2.mode = NormalMode and 
      timeValue[s2.time] - timeValue[s.time] <= someLimitedDuration[]
}

pred R1R2R3 {
  R1R2[]
  // R3.1: During Emergency, FIFO may be bypassed for multiple High requests simultaneously
  all s: SystemState | s.mode = EmergencyMode =>
    some i, j: Int | i != j and i in s.processingQueue.inds and j in s.processingQueue.inds and
    s.processingQueue[i].classification = High and s.processingQueue[j].classification = High
  // R3.2: During Emergency, mutual exclusivity suspended for explicit subset SuspendedMutualExclusiveRoles (enforced by fact RoleMutualExclusionEmergencyMode)
  // R3.3: Emergency privileges granted to admins during Emergency mode (enforced by fact EmergencyPrivilegesTiming)
}

pred R1R2R3R4 {
  R1R2R3[]
  // R4.1: Emergency privileges revoked immediately after Emergency mode ends
  all s: SystemState | s.mode = NormalMode => no s.emergencyPrivileges
  // R4.2: Delegated roles granted during Emergency revoked after Emergency ends (enforced by fact DelegatedRolesEmergencyRevocation)
  // R4.3: Admins update credentials after Emergency mode ends (enforced by fact CredentialUpdateAfterEmergency)
}

// Comprehensive predicate asserting all requirements hold together
pred All_Requirements {
  R1R2R3R4[]
}

// === Assertions to check ===

assert assertR1 {
  R1[]
}

assert assertR2 {
  R1R2[]
}

assert assertR3 {
  R1R2R3[]
}

assert assertR4 {
  R1R2R3R4[]
}

assert assertAll {
  All_Requirements[]
}

// === Run and Check commands ===

run R1 for 5 but 5 Time, 5 User, 5 Role, 10 Request, 10 DelegatedRole, 2 SystemState
run R1R2 for 10 but 10 Time, 5 User, 5 Role, 10 Request, 10 DelegatedRole, 5 SystemState
run R1R2R3 for 10 but 10 Time, 6 User, 6 Role, 15 Request, 15 DelegatedRole, 6 SystemState
run R1R2R3R4 for 15 but 15 Time, 6 User, 6 Role, 20 Request, 20 DelegatedRole, 8 SystemState
run All_Requirements for 20 but 20 Time, 10 User, 10 Role, 30 Request, 30 DelegatedRole, 10 SystemState

check assertR1 for 5 but 5 Time, 5 User, 5 Role, 10 Request, 10 DelegatedRole, 2 SystemState
check assertR2 for 10 but 10 Time, 5 User, 5 Role, 10 Request, 10 DelegatedRole, 5 SystemState
check assertR3 for 10 but 10 Time, 6 User, 6 Role, 15 Request, 15 DelegatedRole, 6 SystemState
check assertR4 for 15 but 15 Time, 6 User, 6 Role, 20 Request, 20 DelegatedRole, 8 SystemState
check assertAll for 20 but 20 Time, 10 User, 10 Role, 30 Request, 30 DelegatedRole, 10 SystemState
```

**[LESSON]:**  
- Maintaining a total injective integer mapping (`timeValue`) for `Time` is essential for enabling temporal arithmetic and ordering in Alloy without syntax errors.  
- Parameterizing temporal constants (e.g., concurrency window, emergency duration) as functions supports flexible and maintainable models.  
- Embedding vacuity checks in predicates (such as requiring exactly two admins triggering emergency) ensures meaningful verification scenarios and avoids trivial satisfactions.  
- Explicit symmetry and distinctness constraints on mutual exclusivity relations prevent modeling errors and enforce correctness.  
- Modeling emergency privileges as a set of administrators granted only during Emergency mode and revoked immediately after clarifies temporal privilege scope.  
- Modeling administrator credential updates as explicit Boolean flags temporally correlated to Emergency mode exit simplifies verification of post-event obligations.  
- Incremental predicates (R1, R1R2, R1R2R3, R1R2R3R4) facilitate modular verification and localization of inconsistencies.

Previous Lessons:
1. Alloy does not support arithmetic operations on abstract signature atoms; time and duration constraints require numeric time representations or mapping functions.
2. Alloy does not support arithmetic directly on abstract signature atoms; temporal constraints require mapping time atoms to integers or modeling time as integers.
3. ** Alloy models involving temporal properties must use numeric or ordered integer time representations to support arithmetic and comparisons; abstract atoms alone are inadequate.
4. ** Modeling Time as discrete integer steps with an injective mapping function `timeValue` enables precise temporal arithmetic and ordering, resolving syntax errors and supporting complex temporal constraints in Alloy.
