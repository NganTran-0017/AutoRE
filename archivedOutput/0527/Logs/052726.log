// =============================
// Alloy 6 Model: RBAC Emergency Extension (Abstract)
// =============================

// --- Utility modules
open util/ordering[Time] as to  // For time steps

// --- Core Entities

abstract sig Time {} // Discrete system steps

enum Clearance { High, Medium, Low }
enum Mode { Normal, Emergency }

sig User {
  clearance: one Clearance,
  isAdmin: one Bool
}

sig Role {}

sig EmergencyPrivilege {} // Distinct, only during Emergency

sig AdminCredential {} // Abstract credential object

sig SystemObject {
  classification: one Clearance
}

sig Request {
  requester: one User,
  targets: some SystemObject,
  classification: one Clearance // == max classification of targets
}

sig DelegatedRole {
  role: one Role,
  to: one User,
  duringEmergency: one Bool, // true iff delegated specifically during Emergency
  delegatedAt: one Time
}

// --- Mutually Exclusive Roles

// pairs of roles that cannot be held together except in Emergency
sig MutExPair {
  roleA, roleB: one Role
}

// --- System State (over Time)

sig State {
  t: one Time,
  mode: one Mode, // Normal or Emergency
  activeRequests: set Request,
  grantedRoles: set DelegatedRole, // All delegated roles in effect
  adminCred: User -> lone AdminCredential, // admin credentials mapping
  emergencyPrivileges: set User,  // admins with emergency privileges
  emergencyTriggerAdmins: set User // admins who triggered Emergency (if any)
}

// --- Existing System Rules and Structural Constraints ---

fact ExistingSystem {
  // Admins: users with High clearance and isAdmin = True
  all u: User | u.isAdmin=Bool.True iff u.clearance=Clearance.High

  // Each DelegatedRole assigned to exactly one user and role
  all dr: DelegatedRole | one dr.role and one dr.to

  // Requests: classification is max of all target object classifications
  all r: Request | r.classification in r.targets.classification

  // MutExPairs: roles are distinct
  all m: MutExPair | m.roleA != m.roleB

  // At each State, mode is one of {Normal, Emergency}
  all s: State | s.mode in Mode

  // EmergencyPrivilege only held by admins
  all s: State | s.emergencyPrivileges in { u: User | u.isAdmin = Bool.True }

  // EmergencyPrivilege can only be granted during Emergency mode (never in Normal)
  all s: State | s.mode = Mode.Normal => no s.emergencyPrivileges

  // EmergencyPrivileges are distinct: only in effect during Emergency, revoked after
  all s, s': State | 
    to/next[s, s'] and s.mode = Mode.Emergency and s'.mode = Mode.Normal => no s'.emergencyPrivileges

  // At every State, for every MutExPair, no user holds both roles unless Emergency
  all s: State | s.mode = Mode.Normal =>
    all m: MutExPair |
      no u: User |
        some drA: DelegatedRole | drA in s.grantedRoles and drA.role = m.roleA and drA.to=u
        and
        some drB: DelegatedRole | drB in s.grantedRoles and drB.role = m.roleB and drB.to=u

  // In Emergency, at least one user holds both roles of some MutExPair (for positive scenario)
  all s: State | s.mode = Mode.Emergency =>
    some m: MutExPair |
      some u: User |
        some drA: DelegatedRole | drA in s.grantedRoles and drA.role = m.roleA and drA.to=u
        and
        some drB: DelegatedRole | drB in s.grantedRoles and drB.role = m.roleB and drB.to=u
}

// ===================
// Predicates (Scenarios / Transitions)
// ===================

// Baseline: No prospective extension requirements (just existing system)
pred baseline() {}

// --- R1: Emergency Triggering ---
pred R1 {
  // There is a transition from Normal to Emergency, triggered by exactly two admins
  some s, s': State |
    to/next[s, s'] and
    s.mode = Mode.Normal and s'.mode = Mode.Emergency
    and #s'.emergencyTriggerAdmins = 2
    and s'.emergencyTriggerAdmins in { u: User | u.isAdmin=Bool.True }
    and s'.emergencyTriggerAdmins = s'.emergencyPrivileges
}

// --- R2: Emergency Mode Duration ---
pred R1R2 {
  R1[]
  // Emergency mode is time-bounded: always returns to Normal within bounded steps
  some s: State | s.mode = Mode.Emergency
  // For any Emergency period, there is a future state where mode is Normal
  all s: State | s.mode = Mode.Emergency =>
    some s': State | s'.t > s.t and s'.mode = Mode.Normal
  // Emergency can be ended early by same two admins who triggered it
  all s, s': State |
    to/next[s, s'] and s.mode = Mode.Emergency and s'.mode = Mode.Normal =>
      s.emergencyTriggerAdmins = s'.emergencyTriggerAdmins
}

// --- R3: Emergency Mode Behaviors ---
pred R1R2R3 {
  R1R2[]

  // R3.1: In Emergency, allow concurrent processing of high-classification requests, not necessarily FIFO
  some s: State | s.mode = Mode.Emergency and
    some r1, r2: Request | r1 != r2 and r1.classification = Clearance.High and r2.classification = Clearance.High and
      r1 in s.activeRequests and r2 in s.activeRequests

  // R3.2: In Emergency, users may hold mutually exclusive roles at same time (already enforced in fact)
  // (Positive case: at least one user holds both roles of a MutExPair, see fact)

  // R3.3: Admins have emergency privileges, which are distinct, only during Emergency
  all s: State | s.mode = Mode.Emergency =>
    s.emergencyPrivileges = s.emergencyTriggerAdmins
  all s: State | s.mode = Mode.Normal =>
    no s.emergencyPrivileges
}

// --- R4: Emergency Mode Termination ---
pred R1R2R3R4 {
  R1R2R3[]

  // R4.1: Upon exit from Emergency, emergency privileges are revoked at first Normal step
  all s, s': State | to/next[s,s'] and s.mode = Mode.Emergency and s'.mode = Mode.Normal =>
    no s'.emergencyPrivileges

  // R4.2: Roles delegated specifically during Emergency are revoked at first Normal step
  all s, s': State | to/next[s,s'] and s.mode = Mode.Emergency and s'.mode = Mode.Normal =>
    no dr: DelegatedRole | dr in s'.grantedRoles and dr.duringEmergency = Bool.True

  // R4.3: Admin credentials must be updated immediately at first Normal step after Emergency ends
  all s, s': State | to/next[s,s'] and s.mode = Mode.Emergency and s'.mode = Mode.Normal =>
    all a: User | a in s.emergencyTriggerAdmins =>
      (some s.adminCred[a] and some s'.adminCred[a] and s'.adminCred[a] != s.adminCred[a])
}

// --- All Prospective Requirements ---
pred All_Requirements {
  R1R2R3R4[]
}

// ===================
// Assertions for Properties to Verify
// ===================

// Emergency privileges never granted in Normal mode
assert assertNoEmergencyPrivilegeInNormal {
  all s: State | s.mode = Mode.Normal => no s.emergencyPrivileges
}

// Emergency privileges always granted only to admins, only during Emergency
assert assertEmergencyPrivilegeAdminsOnly {
  all s: State | s.mode = Mode.Emergency =>
    s.emergencyPrivileges in {u: User | u.isAdmin=Bool.True}
}

// MutEx roles never jointly held in Normal
assert assertNoMutExInNormal {
  all s: State | s.mode = Mode.Normal =>
    all m: MutExPair | no u: User |
      some drA: DelegatedRole | drA in s.grantedRoles and drA.role = m.roleA and drA.to=u
      and
      some drB: DelegatedRole | drB in s.grantedRoles and drB.role = m.roleB and drB.to=u
}

// MutEx roles can be jointly held in Emergency (positive)
assert assertMutExInEmergencyPositive {
  some s: State | s.mode = Mode.Emergency and
    some m: MutExPair | some u: User |
      some drA: DelegatedRole | drA in s.grantedRoles and drA.role = m.roleA and drA.to=u
      and
      some drB: DelegatedRole | drB in s.grantedRoles and drB.role = m.roleB and drB.to=u
}

// Roles delegated during Emergency are revoked at first Normal step
assert assertEmergencyRolesRevoked {
  all s, s': State | to/next[s,s'] and s.mode = Mode.Emergency and s'.mode = Mode.Normal =>
    no dr: DelegatedRole | dr in s'.grantedRoles and dr.duringEmergency = Bool.True
}

// Admin credentials change at first Normal after Emergency
assert assertAdminCredentialsUpdated {
  all s, s': State | to/next[s,s'] and s.mode = Mode.Emergency and s'.mode = Mode.Normal =>
    all a: User | a in s.emergencyTriggerAdmins =>
      (some s.adminCred[a] and some s'.adminCred[a] and s'.adminCred[a] != s.adminCred[a])
}

// ===================
// Run/Check Commands (in order per instructions)
// ===================

run baseline for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential

run All_Requirements for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential

run R1 for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential
run R1R2 for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential
run R1R2R3 for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential
run R1R2R3R4 for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential

check assertNoEmergencyPrivilegeInNormal for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential
check assertEmergencyPrivilegeAdminsOnly for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential
check assertNoMutExInNormal for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential
check assertMutExInEmergencyPositive for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential
check assertEmergencyRolesRevoked for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential
check assertAdminCredentialsUpdated for 6 but 6 Time, 5 User, 5 Role, 2 MutExPair, 8 DelegatedRole, 3 SystemObject, 6 Request, 2 EmergencyPrivilege, 4 AdminCredential

// ===================
// [LESSON]: Can't use booleans directly in fields → Use one Bool or sets instead.
// [LESSON]: Can't use arithmetic or direct time-bounds in Alloy 6 → Use ordering[Time] and abstract predicates for temporal constraints.
// [LESSON]: Can't use 'no' as a standalone statement → Must use 'no <expr>' or negate conjunctions directly.
// [EVENT]: Added MutExPair and facts to guarantee always at least one such pair exists for verification.
// [EVENT]: Used adminCred field to model credential update transitions.
// [EVENT]: Modeled emergencyPrivileges as a set of User, constrained by facts and predicates.
// [EVENT]: Used duringEmergency: one Bool in DelegatedRole to track Emergency-specific delegations.
