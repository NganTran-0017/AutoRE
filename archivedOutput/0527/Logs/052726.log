// Alloy 6 Model: Abstract RBAC with Emergency Module and Mode Transitions

open util/ordering[Time]

// --- Core Entities --- //

abstract sig Clearance {}
one sig High, Medium, Low extends Clearance {}

abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

sig Time {} // System states are indexed by Time

sig Role {
    minClearance: one Clearance
}

sig User {
    clearance: one Clearance,
    assigned: set Role,         // assigned roles (persistent)
    delegated: set Role         // roles delegated (temporary)
}

sig Administrator extends User {} // All Administrators have High clearance

sig SystemObject {
    classification: one Clearance
}

sig Request {
    requester: one User,
    affected: set SystemObject,
    time: one Time,
    processed: lone Time
}

// Mutually exclusive role pairs (static, required to always exist)
sig MutExPair {
    r1, r2: one Role
}

// Delegation event: who delegated, to whom, what role, when, and whether it was during Emergency
sig Delegation {
    from: one User,
    to: one User,
    role: one Role,
    start: one Time,
    duringEmergency: one SystemMode // Normal or Emergency
}

// EmergencyPrivilege is a tag for special privileges during Emergency mode
abstract sig EmergencyPrivilege {}

// Which administrators hold emergency privileges at which times
sig EmerPrivAssignment {
    admin: one Administrator,
    time: one Time
}

// --- System state variables over Time --- //

sig Session {
    // Mode of the system at each Time
    mode: Time -> one SystemMode,

    // Whether Emergency has already been triggered in this session
    emergencyTriggered: set Time,

    // Delegations active at each Time
    activeDelegations: Time -> set Delegation,

    // Emergency privileges held at each Time
    emergencyPrivs: Time -> set Administrator
}

// --- Facts: Existing System Assumptions, Invariants --- //

fact ExistingSystem {
    // All administrators have High clearance
    all a: Administrator | a.clearance = High

    // Mutually exclusive pairs: roles must be distinct and exist in Role
    all p: MutExPair | p.r1 != p.r2 and p.r1 in Role and p.r2 in Role

    // Enforce that at least one MutExPair always exists (for verification)
    some MutExPair

    // Mutual exclusivity applies in Normal mode: no user can hold both roles of a MutExPair at same time (assigned or delegated)
    all t: Time, s: Session |
        s.mode[t] = Normal =>
          all p: MutExPair, u: User |
            not (p.r1 in u.assigned + u.delegated and p.r2 in u.assigned + u.delegated)

    // Users must not submit requests classified above their clearance
    all r: Request |
        let cl = maxClass(r.affected) | {
            cl in Clearance and clToInt(cl) <= clToInt(r.requester.clearance)
        }

    // In Normal mode, request processing is FIFO (abstracted: processed in the order of time)
    all s: Session, t: Time |
        s.mode[t] = Normal =>
          all r1, r2: Request |
            r1.time < r2.time and
            r1.processed in Time and r2.processed in Time and
            r1.processed < r2.processed

    // Delegated roles are limited by clearance
    all d: Delegation |
        d.role.minClearance in Clearance and
        clToInt(d.to.clearance) >= clToInt(d.role.minClearance)
}

// --- Utility Functions --- //

// Maximum classification among objects
fun maxClass(os: set SystemObject): one Clearance {
    // Abstract: pick the highest (High > Medium > Low)
    // Alloy 6 lacks arithmetic, so define ordering by hand
    (High in os.classification) => High else
    (Medium in os.classification) => Medium else
    Low
}

// Clearance "order" for comparisons (simulate int by mapping)
fun clToInt(c: one Clearance): one Int {
    (c = High) => 3 else
    (c = Medium) => 2 else
    1
}

// --- Prospective Requirements --- //

// R1: Emergency Mode Triggering
pred R1[s: Session] {
    // Emergency can be triggered only from Normal mode, exactly once per session, by exactly two admins simultaneously
    some t: Time |
      s.mode[t] = Emergency and
      (no t': Time | t' < t and s.mode[t'] = Emergency) and
      // The transition must be from Normal to Emergency
      (some tPrev: Time | tPrev < t and s.mode[tPrev] = Normal and
         all tMid: Time | tPrev < tMid and tMid < t => s.mode[tMid] = Normal)
      // The trigger requires exactly two administrators acting at t
      // Abstract: model as a pair (a1, a2) at t
      // For verification, assume two admins exist and are involved
}

// R2: Emergency Mode Duration and Exit
pred R1R2[s: Session] {
    R1[s]
    // Emergency mode is active for contiguous times, then ends, and cannot be re-entered
    // There is a unique interval [tEStart, tEEnd) of Emergency mode
    some tEStart, tEEnd: Time |
        tEStart < tEEnd and
        // Emergency is active from tEStart (inclusive) to tEEnd (exclusive)
        all t: Time |
            (t >= tEStart and t < tEEnd) => s.mode[t] = Emergency
            else s.mode[t] = Normal
        // Emergency can only be entered once
        // Mode is Normal before tEStart, Emergency between, Normal after tEEnd
}

// R3: Emergency Mode Behavior
pred R1R2R3[s: Session] {
    R1R2[s]
    // 3.1: During Emergency, request processing may bypass FIFO for high-classification requests (abstract: allow concurrent, prioritized processing)
    // No FIFO required, and multiple high-class requests can be processed at same time
    // 3.2: During Emergency, users may hold mutually exclusive roles at the same time
    all t: Time |
        s.mode[t] = Emergency =>
            all p: MutExPair |
                some u: User | p.r1 in u.assigned + u.delegated and p.r2 in u.assigned + u.delegated
    // 3.3: During Emergency, all administrators hold emergency privileges
    all t: Time |
        s.mode[t] = Emergency =>
            s.emergencyPrivs[t] = Administrator
}

// R4: Emergency Mode Exit Actions
pred All_Requirements[s: Session] {
    R1R2R3[s]
    // Let tEEnd be the first Normal after Emergency
    some tEStart, tEEnd: Time |
        tEStart < tEEnd and
        all t: Time |
            (t >= tEStart and t < tEEnd) => s.mode[t] = Emergency
            else s.mode[t] = Normal
        // 4.1: Upon exit, all emergency privileges revoked
        all t: Time |
            (t >= tEEnd) => no s.emergencyPrivs[t]
        // 4.2: All roles delegated specifically during Emergency are revoked immediately at tEEnd
        all d: Delegation |
            d.duringEmergency = Emergency =>
                all t: Time | t >= tEEnd => d not in s.activeDelegations[t]
        // 4.3: Administrators must update credentials after Emergency ends (abstract: can model as a post-condition, e.g., all admins have updated creds at tEEnd)
        // For verification, assume a predicate adminCredsUpdatedAt[tEEnd]
}

// --- Baseline: Empty predicate for system facts only --- //
pred baseline[] {}

// --- Assertion: No user can hold mutually exclusive roles in Normal mode --- //
assert assertMutExRolesEnforcedInNormal {
    all s: Session, t: Time |
        s.mode[t] = Normal =>
            all p: MutExPair, u: User |
                not (p.r1 in u.assigned + u.delegated and p.r2 in u.assigned + u.delegated)
}

// --- Assertion: MutEx roles may be held together in Emergency mode --- //
assert assertMutExRolesPermittedInEmergency {
    all s: Session, t: Time |
        s.mode[t] = Emergency =>
            some p: MutExPair | some u: User | p.r1 in u.assigned + u.delegated and p.r2 in u.assigned + u.delegated
}

// --- Assertion: Emergency privilege never held outside Emergency --- //
assert assertEmerPrivRestricted {
    all s: Session, t: Time |
        s.mode[t] != Emergency => no s.emergencyPrivs[t]
}

// --- Assertion: Emergency privilege always held by all admins during Emergency --- //
assert assertEmerPrivGrantedInEmergency {
    all s: Session, t: Time |
        s.mode[t] = Emergency => s.emergencyPrivs[t] = Administrator
}

// --- Assertion: Emergency cannot be triggered more than once per session --- //
assert assertEmerOncePerSession {
    all s: Session |
        lone t: Time | s.mode[t] = Emergency
}

// --- Run and Check Commands --- //

run baseline for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment
run All_Requirements for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment
run R1 for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment
run R1R2 for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment
run R1R2R3 for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment

check assertMutExRolesEnforcedInNormal for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment
check assertMutExRolesPermittedInEmergency for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment
check assertEmerPrivRestricted for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment
check assertEmerPrivGrantedInEmergency for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment
check assertEmerOncePerSession for 4 User, 2 Administrator, 3 Role, 2 MutExPair, 4 SystemObject, 6 Time, 1 Session, 5 Delegation, 5 Request, 6 EmerPrivAssignment

// --- End of Alloy Model ---
