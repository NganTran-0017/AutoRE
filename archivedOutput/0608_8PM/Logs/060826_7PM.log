```alloy
// Alloy 6 Model for Prospective Emergency Module in RBAC System

open util/ordering[Time] as Ord

// ===== STRUCTURE =====

// Time for temporal modeling
sig Time {}

// Clearance and Classification Levels
abstract sig Clearance {}
one sig High, Medium, Low extends Clearance {}

abstract sig Classification {}
one sig CHigh, CMedium, CLow extends Classification {}

// Users and Administrators
sig User {
    clearance: one Clearance
}
sig Administrator in User {}

// Roles and Role Exclusivity
sig Role {
    minClearance: one Clearance,
    mutuallyExclusive: set Role // static: mutual exclusion (symmetric, irreflexive)
}

// Objects (resources)
sig Obj {
    classification: one Classification
}

// Requests
sig Request {
    requester: one User,
    affects: some Obj, // request affects one or more objects
    submittedAt: one Time
}

// System Mode
abstract sig Mode {}
one sig NormalMode, EmergencyMode extends Mode {}

// System State (indexed by Time)
sig SysState {
    mode: one Mode,
    // For each user, assigned and delegated roles at this time
    assigned: User -> Role,
    delegated: User -> Role,
    // Delegation: (delegator, delegatee, role) at this time
    delegation: set Delegation,
    // Emergency privileges (which admins currently hold them)
    emergencyPrivilege: set Administrator,
    // Requests present in queue (not yet processed)
    requestQueue: set Request,
    // For each admin, did they trigger Emergency? (persistently store for restoration constraint)
    triggeredEmergency: set Administrator,
    // For each admin, did they update credentials at this time?
    credentialsUpdated: set Administrator
} {
    // assigned and delegated roles must only be held by users
    assigned in User -> Role
    delegated in User -> Role
    // delegation only between users where delegator ≠ delegatee
    all d: delegation | d.delegator != d.delegatee
    // emergencyPrivilege only for administrators
    emergencyPrivilege in Administrator
    // triggeredEmergency only for administrators
    triggeredEmergency in Administrator
    // credentialsUpdated only for administrators
    credentialsUpdated in Administrator
}

// Delegation structure (who delegated what to whom, and at what time/mode)
sig Delegation {
    delegator: one User,
    delegatee: one User,
    role: one Role,
    delegatedAt: one Time,
    duringEmergency: one Bool // true iff delegated during EmergencyMode
}

// Utility for boolean values (since Alloy has no built-in Bool type)
abstract sig Bool {}
one sig True, False extends Bool {}

// Mutually exclusive roles must be symmetric and irreflexive
fact MutualExclusivityStatic {
    all r: Role | r not in r.mutuallyExclusive
    all r, r2: Role | r2 in r.mutuallyExclusive iff r in r2.mutuallyExclusive
}

// Administrators must have High clearance; not all High are admins
fact AdministratorsHighClearance {
    all a: Administrator | a.clearance = High
}

// Each user has exactly one clearance
fact UserClearanceUnique {
    all u: User | one u.clearance
}

// Objects have exactly one classification
fact ObjectClassificationUnique {
    all o: Obj | one o.classification
}

// Every request's classification = max classification of its affected objects
fun requestClassification[r: Request]: one Classification {
    one c: r.affects.classification | 
        no c2: r.affects.classification | c2 != c and higherClass[c2, c]
}

// Definition of "higher" classification
pred higherClass[h: Classification, l: Classification] {
    (h = CHigh and l in CMedium + CLow) or
    (h = CMedium and l = CLow)
}

// Requests: users can only submit requests at or below their clearance
fact RequestSubmissionConstraint {
    all r: Request | 
        let rc = requestClassification[r] |
            (rc = CHigh implies r.requester.clearance = High) and
            (rc = CMedium implies r.requester.clearance in High + Medium) and
            (rc = CLow implies r.requester.clearance in High + Medium + Low)
}

// Delegation: higher-clearance users can delegate to lower, subject to role clearance
fact DelegationConstraint {
    all d: Delegation | 
        d.delegator.clearance in High + Medium + Low and
        d.delegatee.clearance in High + Medium + Low and
        d.delegator.clearance != d.delegatee.clearance and
        higherOrEqual[d.delegator.clearance, d.delegatee.clearance] and
        higherOrEqual[d.delegator.clearance, d.role.minClearance] and
        higherOrEqual[d.delegatee.clearance, d.role.minClearance]
}

// Utility: clearance order
pred higherOrEqual[h: Clearance, l: Clearance] {
    (h = High) or (h = Medium and l != High) or (h = Low and l = Low)
}

// Role exclusivity (enforced only in Normal mode)
fact MutualExclusionEnforcedInNormal {
    all t: Time | 
        let s = stateAt[t] |
        s.mode = NormalMode =>
            all u: User |
                no r1, r2: Role | 
                    r1 != r2 and r2 in r1.mutuallyExclusive and
                    (u -> r1 in s.assigned + s.delegated) and
                    (u -> r2 in s.assigned + s.delegated)
}

// Emergency privileges: only granted to admins, only in Emergency mode
fact EmergencyPrivilegeOnlyInEmergency {
    all t: Time | 
        let s = stateAt[t] |
        (s.mode = EmergencyMode) iff (s.emergencyPrivilege = Administrator)
}

// Delegated roles: roles delegated during Emergency must be revoked after Emergency
fact DelegatedRolesEmergencyRevocation {
    all t, tNext: Time | 
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                all d: Delegation | 
                    d.duringEmergency = True and d.delegatedAt <= t =>
                        d.role not in (sNext.delegated[d.delegatee])
}

// Roles delegated in Normal mode follow their normal expiry
// (Abstracted: not further constrained here, as expiry logic is not detailed)

// Emergency mode must be triggered by exactly two admins, only from Normal mode
fact EmergencyTriggerTwoAdmins {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = NormalMode and sNext.mode = EmergencyMode =>
                #(sNext.triggeredEmergency - s.triggeredEmergency) = 2 and
                sNext.triggeredEmergency = s.triggeredEmergency + (sNext.triggeredEmergency - s.triggeredEmergency)
}

// Emergency mode must end after finite time (abstract liveness)
fact EmergencyDurationFinite {
    all t: Time |
        let s = stateAt[t] |
        s.mode = EmergencyMode implies some t2: Time | t2 > t and stateAt[t2].mode = NormalMode
}

// Emergency privileges revoked after Emergency ends
fact EmergencyPrivilegesRevokedAfterEmergency {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                no sNext.emergencyPrivilege
}

// Credentials must be updated on first Normal mode step after Emergency
fact CredentialUpdateAfterEmergency {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                all a: Administrator | 
                    (a in s.triggeredEmergency) implies (a in sNext.credentialsUpdated)
}

// FIFO request queue: requests processed in FIFO order in Normal mode, may be bypassed in Emergency for high-classification
fact FIFOProcessingRules {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            (s.mode = NormalMode and sNext.mode = NormalMode) =>
                // Only the oldest request(s) may be removed from the queue
                let removed = s.requestQueue - sNext.requestQueue |
                all r: removed | 
                    all r2: s.requestQueue | 
                        r2.submittedAt < r.submittedAt => r2 in removed
            (s.mode = EmergencyMode) =>
                // Only high-classification requests may jump FIFO (i.e., be removed out of order)
                let removed = s.requestQueue - sNext.requestQueue |
                    all r: removed | requestClassification[r] = CHigh
}

// Liveness: every request is eventually processed (abstract liveness, not enforced as a fact but as an assertion below)

// ========== SYSTEM EVOLUTION (Temporal) ==========

// State at each Time (temporal function)
fun stateAt[t: Time]: one SysState { SysState.t = t }

// ==================== BASELINE PREDICATE ====================
pred baseline {}

// ============= PROSPECTIVE REQUIREMENT PREDICATES =============

// R1: Emergency Trigger - exactly two admins jointly trigger Emergency from Normal
pred R1 {
    some t, tNext: Time |
        Ord.next[t] = tNext and
        let s = stateAt[t], sNext = stateAt[tNext] |
        s.mode = NormalMode and sNext.mode = EmergencyMode and
        #(sNext.triggeredEmergency - s.triggeredEmergency) = 2
}

// R2: Emergency Duration - Emergency mode ends after finite time
pred R1R2 {
    R1
    all t: Time |
        let s = stateAt[t] |
        s.mode = EmergencyMode implies some t2: Time | t2 > t and stateAt[t2].mode = NormalMode
}

// R3: Emergency Mode Behavioral Changes
pred R1R2R3 {
    R1R2
    // R3.1: During Emergency, high-class requests can be prioritized and processed concurrently (modeled in FIFOProcessingRules)
    // R3.2: During Emergency, mutual exclusion is suspended
    all t: Time |
        let s = stateAt[t] |
        s.mode = EmergencyMode =>
            some u: User, r1, r2: Role |
                r1 != r2 and r2 in r1.mutuallyExclusive and
                (u -> r1 in s.assigned + s.delegated) and
                (u -> r2 in s.assigned + s.delegated)
    // R3.3: During Emergency, only admins hold emergency privileges
    all t: Time | let s = stateAt[t] | s.mode = EmergencyMode => s.emergencyPrivilege = Administrator
}

// R4: Post-Emergency Restoration
pred R1R2R3R4 {
    R1R2R3
    // R4.1, R4.2, R4.3 encoded in facts: EmergencyPrivilegesRevokedAfterEmergency, DelegatedRolesEmergencyRevocation, CredentialUpdateAfterEmergency
}

// All requirements together
pred All_Requirements {
    R1R2R3R4
}

// ================= RUN COMMANDS =================
run baseline for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation
run All_Requirements for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation
run R1 for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation
run R1R2 for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation
run R1R2R3 for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// ================= ASSERTIONS AND CHECKS =================

// Assert: It is never possible for a user to hold mutually exclusive roles in Normal mode
assert assertNoMutualExclusiveRolesInNormal {
    all t: Time | 
        let s = stateAt[t] |
        s.mode = NormalMode =>
            all u: User, r1, r2: Role |
                r1 != r2 and r2 in r1.mutuallyExclusive =>
                    not ((u -> r1 in s.assigned + s.delegated) and (u -> r2 in s.assigned + s.delegated))
}
check assertNoMutualExclusiveRolesInNormal for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: There exists at least one user holding mutually exclusive roles during Emergency mode (positive scenario)
assert assertPositiveMutualExclusiveRolesInEmergency {
    some t: Time | 
        let s = stateAt[t] |
        s.mode = EmergencyMode and
        some u: User, r1, r2: Role |
            r1 != r2 and r2 in r1.mutuallyExclusive and
            (u -> r1 in s.assigned + s.delegated) and
            (u -> r2 in s.assigned + s.delegated)
}
check assertPositiveMutualExclusiveRolesInEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: Emergency privilege is never granted outside Emergency mode
assert assertEmergencyPrivilegeOnlyInEmergency {
    all t: Time | 
        let s = stateAt[t] |
        (s.mode != EmergencyMode) => no s.emergencyPrivilege
}
check assertEmergencyPrivilegeOnlyInEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: All delegated roles assigned during Emergency are revoked after Emergency ends
assert assertEmergencyDelegationRevokedOnExit {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                all d: Delegation | 
                    d.duringEmergency = True and d.delegatedAt <= t =>
                        d.role not in (sNext.delegated[d.delegatee])
}
check assertEmergencyDelegationRevokedOnExit for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: Credential update by Emergency-triggering admins occurs on first Normal time step after Emergency
assert assertCredentialsUpdatedAfterEmergency {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                all a: Administrator | 
                    (a in s.triggeredEmergency) implies (a in sNext.credentialsUpdated)
}
check assertCredentialsUpdatedAfterEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: Every request is eventually processed (liveness, abstract)
assert assertEveryRequestProcessed {
    all r: Request |
        some t: Time | r not in stateAt[t].requestQueue
}
check assertEveryRequestProcessed for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: Only high-classification requests can bypass FIFO in Emergency (negative scenario)
assert assertNoLowMediumBypassFIFOInEmergency {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode =>
                let removed = s.requestQueue - sNext.requestQueue |
                    all r: removed | requestClassification[r] = CHigh
}
check assertNoLowMediumBypassFIFOInEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// == END OF MODEL ==
