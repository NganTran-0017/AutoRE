                        d.role not in (sNext.delegated[d.delegatee])
}

// Roles delegated in Normal mode follow their normal expiry
// (Abstracted: not further constrained here, as expiry logic is not detailed)

// Emergency mode must be triggered by exactly two admins, only from Normal mode
fact EmergencyTriggerTwoAdmins {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = NormalMode and sNext.mode = EmergencyMode =>
                #(sNext.triggeredEmergency - s.triggeredEmergency) = 2 and
                sNext.triggeredEmergency = s.triggeredEmergency + (sNext.triggeredEmergency - s.triggeredEmergency)
}

// Emergency mode must end after finite time (abstract liveness)
fact EmergencyDurationFinite {
    all t: Time |
        let s = stateAt[t] |
        s.mode = EmergencyMode implies some t2: Time | t2 > t and stateAt[t2].mode = NormalMode
}

// Emergency privileges revoked after Emergency ends
fact EmergencyPrivilegesRevokedAfterEmergency {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                no sNext.emergencyPrivilege
}

// Credentials must be updated on first Normal mode step after Emergency
fact CredentialUpdateAfterEmergency {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                all a: Administrator | 
                    (a in s.triggeredEmergency) implies (a in sNext.credentialsUpdated)
}

// FIFO request queue: requests processed in FIFO order in Normal mode, may be bypassed in Emergency for high-classification
fact FIFOProcessingRules {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            (s.mode = NormalMode and sNext.mode = NormalMode) =>
                // Only the oldest request(s) may be removed from the queue
                let removed = s.requestQueue - sNext.requestQueue |
                all r: removed | 
                    all r2: s.requestQueue | 
                        r2.submittedAt < r.submittedAt => r2 in removed
            (s.mode = EmergencyMode) =>
                // Only high-classification requests may jump FIFO (i.e., be removed out of order)
                let removed = s.requestQueue - sNext.requestQueue |
                    all r: removed | requestClassification[r] = CHigh
}

// Liveness: every request is eventually processed (abstract liveness, not enforced as a fact but as an assertion below)

// ========== SYSTEM EVOLUTION (Temporal) ==========

// State at each Time (temporal function)
fun stateAt[t: Time]: one SysState { SysState.t = t }

// ==================== BASELINE PREDICATE ====================
pred baseline {}

// ============= PROSPECTIVE REQUIREMENT PREDICATES =============

// R1: Emergency Trigger - exactly two admins jointly trigger Emergency from Normal
pred R1 {
    some t, tNext: Time |
        Ord.next[t] = tNext and
        let s = stateAt[t], sNext = stateAt[tNext] |
        s.mode = NormalMode and sNext.mode = EmergencyMode and
        #(sNext.triggeredEmergency - s.triggeredEmergency) = 2
}

// R2: Emergency Duration - Emergency mode ends after finite time
pred R1R2 {
    R1
    all t: Time |
        let s = stateAt[t] |
        s.mode = EmergencyMode implies some t2: Time | t2 > t and stateAt[t2].mode = NormalMode
}

// R3: Emergency Mode Behavioral Changes
pred R1R2R3 {
    R1R2
    // R3.1: During Emergency, high-class requests can be prioritized and processed concurrently (modeled in FIFOProcessingRules)
    // R3.2: During Emergency, mutual exclusion is suspended
    all t: Time |
        let s = stateAt[t] |
        s.mode = EmergencyMode =>
            some u: User, r1, r2: Role |
                r1 != r2 and r2 in r1.mutuallyExclusive and
                (u -> r1 in s.assigned + s.delegated) and
                (u -> r2 in s.assigned + s.delegated)
    // R3.3: During Emergency, only admins hold emergency privileges
    all t: Time | let s = stateAt[t] | s.mode = EmergencyMode => s.emergencyPrivilege = Administrator
}

// R4: Post-Emergency Restoration
pred R1R2R3R4 {
    R1R2R3
    // R4.1, R4.2, R4.3 encoded in facts: EmergencyPrivilegesRevokedAfterEmergency, DelegatedRolesEmergencyRevocation, CredentialUpdateAfterEmergency
}

// All requirements together
pred All_Requirements {
    R1R2R3R4
}

// ================= RUN COMMANDS =================
run baseline for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation
run All_Requirements for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation
run R1 for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation
run R1R2 for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation
run R1R2R3 for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// ================= ASSERTIONS AND CHECKS =================

// Assert: It is never possible for a user to hold mutually exclusive roles in Normal mode
assert assertNoMutualExclusiveRolesInNormal {
    all t: Time | 
        let s = stateAt[t] |
        s.mode = NormalMode =>
            all u: User, r1, r2: Role |
                r1 != r2 and r2 in r1.mutuallyExclusive =>
                    not ((u -> r1 in s.assigned + s.delegated) and (u -> r2 in s.assigned + s.delegated))
}
check assertNoMutualExclusiveRolesInNormal for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: There exists at least one user holding mutually exclusive roles during Emergency mode (positive scenario)
assert assertPositiveMutualExclusiveRolesInEmergency {
    some t: Time | 
        let s = stateAt[t] |
        s.mode = EmergencyMode and
        some u: User, r1, r2: Role |
            r1 != r2 and r2 in r1.mutuallyExclusive and
            (u -> r1 in s.assigned + s.delegated) and
            (u -> r2 in s.assigned + s.delegated)
}
check assertPositiveMutualExclusiveRolesInEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: Emergency privilege is never granted outside Emergency mode
assert assertEmergencyPrivilegeOnlyInEmergency {
    all t: Time | 
        let s = stateAt[t] |
        (s.mode != EmergencyMode) => no s.emergencyPrivilege
}
check assertEmergencyPrivilegeOnlyInEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: All delegated roles assigned during Emergency are revoked after Emergency ends
assert assertEmergencyDelegationRevokedOnExit {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                all d: Delegation | 
                    d.duringEmergency = True and d.delegatedAt <= t =>
                        d.role not in (sNext.delegated[d.delegatee])
}
check assertEmergencyDelegationRevokedOnExit for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: Credential update by Emergency-triggering admins occurs on first Normal time step after Emergency
assert assertCredentialsUpdatedAfterEmergency {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode and sNext.mode = NormalMode =>
                all a: Administrator | 
                    (a in s.triggeredEmergency) implies (a in sNext.credentialsUpdated)
}
check assertCredentialsUpdatedAfterEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: Every request is eventually processed (liveness, abstract)
assert assertEveryRequestProcessed {
    all r: Request |
        some t: Time | r not in stateAt[t].requestQueue
}
check assertEveryRequestProcessed for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// Assert: Only high-classification requests can bypass FIFO in Emergency (negative scenario)
assert assertNoLowMediumBypassFIFOInEmergency {
    all t, tNext: Time |
        Ord.next[t] = tNext =>
            let s = stateAt[t], sNext = stateAt[tNext] |
            s.mode = EmergencyMode =>
                let removed = s.requestQueue - sNext.requestQueue |
                    all r: removed | requestClassification[r] = CHigh
}
check assertNoLowMediumBypassFIFOInEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// == END OF MODEL ==

**Evaluator Feedback:**
```
[DIAGNOSIS]:
The error arises because the body of the function requestClassification (lines 110-113) is written using curly braces and a bar '|' as if it were a predicate or a set comprehension, but Alloy 6 requires function bodies to be a single expression, not a block. In Alloy 6, the function body must use '=' and return a single value or an expression that yields a value of the function's declared return type. Here, the block attempts to use quantifiers and constraints in a predicate style within a function, which is not permitted. This is why Alloy reports a type error: it expects a set or relation, but the block produces a Boolean.

[FIX INTENT]:
Rewrite the function body as a single quantified expression that returns the unique Classification value, using Alloy 6 function syntax.

[REPAIR INSTRUCTIONS]:
- Step 1: Replace the entire function body of requestClassification with a single quantified expression using the 'one' quantifier.
- Step 2: Remove the curly braces and the vertical bar from the function definition.
- Step 3: Use the following Alloy 6-compliant syntax for the function:
    fun requestClassification(r: Request): one Classification {
        one c: r.affects.classification | 
            no c2: r.affects.classification | c2 != c and higherClass[c2, c]
    }
  becomes
    fun requestClassification(r: Request): one Classification {
        one c: r.affects.classification | 
            no c2: r.affects.classification | c2 != c and higherClass[c2, c]
    }
  → But since function bodies can't be blocks, instead write:
    fun requestClassification(r: Request): one Classification {
        one c: r.affects.classification | 
            no c2: r.affects.classification | c2 != c and higherClass[c2, c]
    }
  → But this is still a block! To make it a single expression, use:
    fun requestClassification(r: Request): one Classification {
        one c: r.affects.classification | 
            no c2: r.affects.classification | c2 != c and higherClass[c2, c]
    }
  → Instead, use the following correct single-expression form (no braces):
    fun requestClassification[r: Request]: one Classification
        { one c: r.affects.classification | no c2: r.affects.classification | c2 != c and higherClass[c2, c] }
  Or, more idiomatically in Alloy 6:
    fun requestClassification[r: Request]: one Classification {
        one c: r.affects.classification | 
            no c2: r.affects.classification | c2 != c and higherClass[c2, c]
    }
- Step 4: Ensure you use brackets [ ] for function arguments (Alloy 6 syntax).

[RATIONALE]:
This fix rewrites the function as a single quantified expression returning a Classification, using proper Alloy 6 function syntax (no block structure inside function bodies), thus directly addressing the type error and following Alloy 6's requirement for function definitions.

[LESSON]:
When defining functions in Alloy 6, the body must be a single expression; predicate-style blocks with bars and curly braces are only valid for predicates and facts, not functions.
```

**Latest Requirements:**
```
SYSTEM OVERVIEW
===============
The system is a Role-Based Access Control (RBAC) system operating in a multi-user environment with support for role hierarchies, delegation, and concurrency. Users are assigned security clearance levels (High, Medium, Low), and system objects have classification levels. Actions are requested by users, subject to clearance and classification constraints, and are processed concurrently in FIFO order. The system enforces authorization correctness, permission and delegation consistency, liveness, and safety under concurrency. Administrators are a subset of users with High clearance. The new Emergency Module modifies system behavior under emergency conditions, allowing exceptions to standard processing, privilege, and role exclusivity.

EXISTING-SYSTEM ASSUMPTIONS AND CONSTRAINTS
============================================
- Each user is assigned one clearance level: High, Medium, or Low.
- Administrators have High clearance; not all High-clearance users are administrators.
- Users may hold assigned roles or delegated roles, subject to clearance and role requirements.
- Objects have classification levels: High, Medium, or Low.
- Requests have a classification determined by the highest classification of affected objects.
- Users may submit requests only if the request’s classification is ≤ their clearance.
- Requests are processed concurrently in FIFO order.
- Users with higher clearance may approve/reject requests from lower-clearance users.
- Delegation of roles: Higher-clearance users can delegate roles to lower-clearance users, subject to minimum clearance for the role.
- Delegated roles expire after a fixed time or may be revoked by administrators at any time.
- The system preserves authorization correctness, delegation/permission consistency, liveness, and concurrency safety.
- Every request is eventually processed.

PROSPECTIVE FUNCTIONAL REQUIREMENTS
=======================
R1: Emergency Trigger
While in Normal mode, exactly two administrators must jointly trigger the emergency, causing the system to enter Emergency mode.

R2: Emergency Duration
Emergency mode is active only for a limited time; the system must eventually return to Normal mode.

R3: Emergency Mode Behavioral Changes
R3.1: During Emergency mode, request processing may bypass FIFO order to prioritize and process multiple high-classification requests concurrently.
R3.2: During Emergency mode, users may temporarily hold mutually exclusive roles, even though these roles are defined as mutually exclusive in the role definitions.
R3.3: During Emergency mode, administrators temporarily hold emergency privileges.

R4: Post-Emergency Restoration
R4.1: Emergency privileges must be revoked when Emergency mode ends.
R4.2: Any roles delegated during the emergency (i.e., roles delegated during Emergency mode) must be revoked immediately upon Emergency exit; roles delegated during Normal mode remain subject to their normal expiry or administrator revocation.
R4.3: Administrators who triggered Emergency mode must update their credentials as an abstract action (modeled as "credentials updated") on the first Normal mode time step immediately after exiting Emergency mode.

KEY CONCEPTS AND ENTITIES
==========================
- User: An individual with a unique identity and a security clearance level.
- Administrator: A user with High clearance and special administrative privileges.
- Role: A set of permissions; may be assigned, delegated, or temporarily held. Roles may be defined as mutually exclusive with other roles as a static property.
- Delegated Role: A role temporarily granted by a higher-clearance user to a lower-clearance user; may be assigned during Normal or Emergency mode. Delegated roles assigned during Emergency mode are revoked immediately upon Emergency exit.
- Clearance Level: High, Medium, or Low; assigned to users.
- Object: An entity in the system with a classification level.
- Classification Level: High, Medium, or Low; assigned to objects.
- Request: An action submitted by a user, affecting one or more objects; has a classification.
- Emergency Mode: A special system state triggered by two administrators, with altered processing and privilege rules.
- Emergency Privileges: Special permissions or capabilities granted to administrators during Emergency mode.
- Mutually Exclusive Roles: Roles which are statically defined as mutually exclusive pairs/groups, and this exclusivity applies to both assigned and delegated roles under Normal mode. During Emergency mode, the exclusivity restriction is temporarily suspended.
- FIFO Order: First-In, First-Out processing queue for requests.
- Normal Mode: Default system operation state.

ASSUMPTIONS REQUIRING CLARIFICATION
====================================
None. All previous assumptions have been clarified:
1. Mutually exclusive roles is a static property of roles and applies to both assigned and delegated roles.
2. "Update credentials" is an abstract action modeled as "credentials updated", required on the first Normal mode time step after Emergency mode, for administrators who triggered Emergency mode.
3. "Roles delegated during the emergency" refers only to roles delegated during Emergency mode; these must be revoked immediately upon Emergency exit. Delegations from Normal mode are not affected.

CONSTRAINTS
===========
- Only exactly two administrators may jointly trigger Emergency mode while in Normal mode.
- Emergency mode has a fixed, limited duration.
- Emergency mode must end, restoring the system to Normal mode.
- FIFO processing may be bypassed only during Emergency mode and only to prioritize high-classification requests.
- Users may only simultaneously hold mutually exclusive roles during Emergency mode.
- Administrators' emergency privileges are strictly temporary and must be revoked after Emergency mode.
- All roles delegated during Emergency mode must be revoked immediately upon its conclusion; roles delegated in Normal mode are subject to their normal expiration or revocation rules.
- Administrators who triggered Emergency mode must perform a credential update (modeled as "credentials updated") on the first Normal mode time step after Emergency mode.
- No persistent violation of authorization, delegation, or permission consistency before, during, or after Emergency mode.
```

Previous Lessons:
1. Alloy 6 does not allow the 'in' operator with set comprehensions like User & (u: User | u.isAdmin = True); must use {u: User | u.isAdmin = True} for set comprehension.
2. Alloy 6 requires all predicate parameters to have explicit type annotations and to be separated by commas; cannot use parameters without types in predicate headers.
3. Alloy 6 does not support parameterized open of util/seq (e.g., open util/seq[Request]) → Must use open util/seq as Seq and use Seq/Seq[Type] for sequence-typed fields.
4. Alloy 6 does not allow inline comments at the end of open statements → Comments must be on a separate line above the statement.
5. After open util/seq[Request], type Seq[Request] is directly in scope—do not prefix with util/seq/ or alias.

