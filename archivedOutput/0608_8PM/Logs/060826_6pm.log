                    all r: removed | requestClassification[r] = CHigh
}
check assertNoLowMediumBypassFIFOInEmergency for 5 User, 3 Administrator, 4 Role, 3 Obj, 5 Time, 8 Request, 8 Delegation

// == END OF MODEL ==
