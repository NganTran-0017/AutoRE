```alloy
// ====================================================
// RBAC Emergency Model (Alloy 6) -- Updated per Evaluator Feedback & Latest Requirements
// ====================================================

open util/ordering[ClearanceLevel] as ClearanceOrd
open util/ordering[State] as Time

// == ENUMS AND MODES ==
abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig C_High, C_Medium, C_Low extends ClassificationLevel {}

abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// == USERS, ROLES, OBJECTS ==
sig User {
    clearance: one ClearanceLevel
}
sig Administrator in User {}

sig Role {
    mutuallyExclusiveWith: set Role,
    minClearance: one ClearanceLevel
}

sig Object {
    classification: one ClassificationLevel
}

// == REQUESTS & PROCESSING ==
sig Request {
    requestedBy: one User,
    affects: some Object,
    classification: one ClassificationLevel,
    approvedOrDeniedBy: lone User, // audit: who processed
    processedIn: lone State,       // audit: when processed
    approvalStatus: lone ApprovalStatus // null = unprocessed
}

// == DELEGATION & PRIVILEGES ==
abstract sig ApprovalStatus {}
one sig Approved, Denied extends ApprovalStatus {}

sig Delegation {
    delegator: one User,
    delegatee: one User,
    role: one Role,
    delegatedAt: one State,
    expiresAt: one State,
    approvedBy: one User,
    approvalStatus: one ApprovalStatus
}

sig EmergencyPrivilege {
    admin: one Administrator,
    grantedAt: one State,
    revokedAt: one State // always present for proper revocation
}

// == SYSTEM STATE (Time-Indexed) ==
sig State {
    mode: one SystemMode,
    emAdmins: set Administrator, // Exactly two admins if Emergency, else none
    requests: set Request,
    delegations: set Delegation,
    emPrivs: set EmergencyPrivilege,
    needsCredentialUpdate: set Administrator,
    assigned: User -> set Role // Which roles are assigned to which users in this State
}

// == GLOBAL STRUCTURAL FACTS ==

// Administrator count and definition
fact AdminCountRange {
    #Administrator >= 0 and #Administrator <= 4
}
fact AdminDefinition {
    all a: Administrator | a.clearance = High
}

// Role mutual exclusion: symmetric, irreflexive, at least one pair exists
fact MutExSymmIrreflexive {
    all r: Role | r not in r.mutuallyExclusiveWith
    all r1, r2: Role | r1 in r2.mutuallyExclusiveWith iff r2 in r1.mutuallyExclusiveWith
}
fact AtLeastOneMutExPairExists {
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
}

// == ASSIGNED ROLES ARE PERMANENT ==
fact AssignedRolesPermanent {
    all s1, s2: State, u: User, r: Role |
        (r in s1.assigned[u] and Time/lte[s1, s2]) => r in s2.assigned[u]
}

// == SELF-DELEGATION PROHIBITION ==
fact NoSelfDelegation {
    all d: Delegation | d.delegator != d.delegatee
}

// == STRICT DELEGATION DURATION ==
fact DelegationStrictDuration {
    all d: Delegation | lt[d.delegatedAt, d.expiresAt]
}

// == DELEGATOR MUST HAVE DIRECT ASSIGNMENT AT DELEGATION AND THROUGHOUT DELEGATION ==
fact DelegatorDirectAssignmentThroughoutDelegation {
    all d: Delegation, s: State |
        (Time/lte[d.delegatedAt, s] and Time/lte[s, d.expiresAt]) =>
            d.role in s.assigned[d.delegator]
}

// == DELEGATION CHAINS FORBIDDEN (no delegated role can be further delegated) ==
fact NoDelegationChains {
    all d: Delegation |
        d.role not in (activeDelegations[d.delegator, d.delegatedAt].role)
}

// == REQUEST CLASSIFICATION: by highest classification of affected objects ==
fun highestClass[os: set Object]: one ClassificationLevel {
    (some o: os | o.classification = C_High) => C_High
    else (some o: os | o.classification = C_Medium) => C_Medium
    else C_Low
}
fact RequestClassification {
    all req: Request | req.classification = highestClass[req.affects]
}

// == DELEGATION CLEARANCE -- delegatee must have clearance <= role.minClearance and <= delegator ==
fact DelegationClearance {
    all d: Delegation |
        ClearanceOrd/lte[d.delegatee.clearance, d.role.minClearance]
        and ClearanceOrd/lte[d.delegatee.clearance, d.delegator.clearance]
}

// == TIME HELPERS ==
fun pastOrEqual[s: State]: set State { { s2: State | Time/lte[s2, s] } }
fun past[s: State]: set State { { s2: State | Time/lt[s2, s] } }
fun future[s: State]: set State { { s2: State | Time/gt[s2, s] } }
pred prevModeIsNormal[s: State] { some Time/prev[s] and Time/prev[s].mode = Normal }
pred prevModeIsEmergency[s: State] { some Time/prev[s] and Time/prev[s].mode = Emergency }

// == ROLE ASSIGNMENT AND HOLDING ==
fun rolesHeld[u: User, s: State]: set Role { s.assigned[u] }
fun activeDelegations[u: User, s: State]: set Delegation {
    { d: s.delegations |
        d.delegatee = u and
        d.delegatedAt in pastOrEqual[s] and
        Time/lte[s, d.expiresAt] and
        d.approvalStatus = Approved
    }
}
fun allRolesHeld[u: User, s: State]: set Role {
    rolesHeld[u, s] + activeDelegations[u, s].role
}

// == MUTUAL EXCLUSION ENFORCEMENT IN NORMAL ==
fact MutExEnforcedInNormal {
    all s: State | (s.mode = Normal) =>
        all u: User |
            all r1, r2: Role |
                not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and
                     r1 in allRolesHeld[u, s] and r2 in allRolesHeld[u, s])
}

// == EMERGENCY MODE COVERAGE (Global) ==
fact EmergencyModeCoverage {
    some s: State | s.mode = Emergency
}

// == EMERGENCY PRIVILEGE GRANT/REVOKE POLICY ==
fun firstNormalAfter[se: State]: lone State {
    { s: State | s in future[se] and s.mode = Normal and prevModeIsEmergency[s] }
}
fact EmergencyPrivilegeGrantRevoke {
    // EmergencyPrivilege only granted in Emergency, only to emAdmins, and revoked exactly at first Normal after Emergency
    all ep: EmergencyPrivilege |
        ep.grantedAt.mode = Emergency and
        ep.admin in ep.grantedAt.emAdmins and
        some firstNormalAfter[ep.grantedAt] and
        ep.revokedAt = firstNormalAfter[ep.grantedAt] and
        ep.revokedAt.mode = Normal and
        prevModeIsEmergency[ep.revokedAt]
    // No EmergencyPrivilege persists in Normal mode
    all s: State | s.mode = Normal => s.emPrivs = none
    // No EmergencyPrivilege is granted outside Emergency mode
    all ep: EmergencyPrivilege | ep.grantedAt.mode = Emergency
}

// == EMERGENCY DELEGATION EXPIRY POLICY ==
fact EmergencyDelegationExpiry {
    all d: Delegation |
        (d.delegatedAt.mode = Emergency) =>
            (some s_post: State |
                s_post = firstNormalAfter[d.delegatedAt] and
                d.expiresAt = s_post)
}

// == REQUIREMENT: R1 (Emergency Trigger, exactly two admins) ==
pred R1 {
    all s: State |
        (s.mode = Emergency) =>
            (
                #s.emAdmins = 2 and
                all a: s.emAdmins | a in Administrator and
                prevModeIsNormal[s]
            )
        else
            s.emAdmins = none
}

// == REQUIREMENT: R2 (Emergency duration: must return to Normal) ==
pred R1R2 {
    R1
    and all s: State | (s.mode = Emergency) => some s2: future[s] | s2.mode = Normal
}

// == EMERGENCY REQUEST CLASS ORDERING (R3.1) ==
pred EmergencyClassOrder[s: State] {
    // High must be processed before Medium, Medium before Low
    all rH: s.requests | rH.classification = C_High =>
        all rM: s.requests | rM.classification = C_Medium =>
            (some sP: State | Time/lte[s, sP] and rM.processedIn = sP) =>
                (some sPH: State | Time/lte[s, sPH] and rH.processedIn = sPH and Time/lte[sPH, sP]) // H processed before M
    all rM: s.requests | rM.classification = C_Medium =>
        all rL: s.requests | rL.classification = C_Low =>
            (some sP: State | Time/lte[s, sP] and rL.processedIn = sP) =>
                (some sPM: State | Time/lte[s, sPM] and rM.processedIn = sPM and Time/lte[sPM, sP]) // M before L
}

// == REQUIREMENT: R3 (Emergency behavior) ==
pred R1R2R3 {
    R1R2
    // R3.1: EmergencyClassOrdering
    and all s: State | (s.mode = Emergency) => EmergencyClassOrder[s]
    // R3.2: Mutual exclusion suspended in Emergency, enforced in Normal (globally covered)
    // R3.3: EmergencyPrivilege logic (globally enforced)
}

// == REQUIREMENT: R4 (Restoration after Emergency, privilege & delegation expiry strictness) ==
pred R1R2R3R4 {
    R1R2R3
    // R4.1: EmergencyPrivilege must be revoked at first Normal after Emergency (globally enforced)
    // R4.2a: Delegations assigned during Emergency must expire exactly at the first Normal after Emergency (globally enforced)
    // R4.2b: Delegations from before Emergency not revoked at Emergency exit
    and all s: State | (s.mode = Normal and prevModeIsEmergency[s]) =>
        all d: Time/prev[s].delegations |
            (d.delegatedAt.mode = Normal) => (d.expiresAt != s)
    // R4.3: Only emAdmins need credential update
    and all s: State | (s.mode = Normal and prevModeIsEmergency[s]) =>
        s.needsCredentialUpdate = Time/prev[s].emAdmins
}

// == REQUIREMENT: R5 (Delegation rules & expiry, audit, request tracking) ==
pred R1R2R3R4R5 {
    R1R2R3R4
    // R5.1: Delegator must have direct assignment and retain it for duration of delegation (globally enforced)
    // R5.2: Delegatee’s clearance <= role.minClearance and <= delegator’s clearance (globally enforced)
    // R5.3: Self-delegation prohibited (globally enforced)
    // R5.4: Delegation chains forbidden (globally enforced)
    // R5.5: Delegation expiry > grant (globally enforced)
    // R5.6: All delegations must have approver
    and all d: Delegation | d.approvedBy != none
    // R5.7: Every delegation is processed (approved/denied), and approvalStatus, approvedBy are always set
    and all d: Delegation | d.approvalStatus in (Approved + Denied) and d.approvedBy != none
}

// == REQUIREMENT: R6 (Mutual exclusion globally enforced in Normal mode; suspended in Emergency) ==
pred R1R2R3R4R5R6 {
    R1R2R3R4R5
    // R6.1: In Normal, mutual exclusion enforced globally (assignment or delegation) [globally enforced]
    // R6.2: In Emergency, mutual exclusion suspended (any user can hold mut-ex roles, by assignment or delegation)
}

// == REQUIREMENT: R7 (Audit trail, all requests must be processed) ==
pred R1R2R3R4R5R6R7 {
    R1R2R3R4R5R6
    // R7.1: All requests must be processed (approved/denied), processedIn and approvedOrDeniedBy set
    and all r: Request | some r.processedIn and some r.approvedOrDeniedBy and r.approvalStatus in (Approved + Denied)
}

// == CORE ALL REQUIREMENTS (incremental coverage constraints for verification) ==
pred All_Requirements {
    R1R2R3R4R5R6R7
    and Coverage_EmergencyStateExists
    and Coverage_MutExPairExists
    and Coverage_MutExRolesHeldInEmergency
    and Coverage_PreEmergencyDelegationSpansEmergency
    and Coverage_UsersWithDistinctClearances
}

// == COVERAGE PREDICATES ==

// Emergency mode must be present in all verification scenarios
pred Coverage_EmergencyStateExists {
    some s: State | s.mode = Emergency
}

// At least one mut-ex pair exists globally (redundant, but for incremental run)
pred Coverage_MutExPairExists {
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
}

// At least one user holds both roles of a mut-ex pair in Emergency via assignment and/or delegation
pred Coverage_MutExRolesHeldInEmergency {
    some s: State | s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in allRolesHeld[u, s] and
            r2 in allRolesHeld[u, s]
}

// At least one delegation granted before Emergency, expires after Emergency
pred Coverage_PreEmergencyDelegationSpansEmergency {
    some s_pre, s_em, s_post: State, d: Delegation |
        Time/lt[s_pre, s_em] and Time/lt[s_em, s_post] and
        s_pre.mode = Normal and
        s_em.mode = Emergency and
        s_post.mode = Normal and
        prevModeIsEmergency[s_post] and
        d.delegatedAt = s_pre and
        d.expiresAt = s_post and
        d in s_pre.delegations and
        d in s_em.delegations and
        d in s_post.delegations
}

// Users with all clearances (for coverage, not required for business logic)
pred Coverage_UsersWithDistinctClearances {
    some u1, u2, u3: User |
        u1 != u2 and u2 != u3 and u1 != u3
        and u1.clearance = High
        and u2.clearance = Medium
        and u3.clearance = Low
}

// == NEGATIVE SCENARIOS (assertions only, not predicates) ==

// Delegator must be assigned the delegated role by direct assignment at time of delegation (never via delegation)
assert assertDelegatorAssignedRoleDirectly {
    all d: Delegation | d.role in d.delegatedAt.assigned[d.delegator]
}

// Delegator must retain direct assignment of delegated role throughout delegation
assert assertDelegatorRetainsAssignment {
    all d: Delegation, s: State |
        (Time/lte[d.delegatedAt, s] and Time/lte[s, d.expiresAt]) =>
            d.role in s.assigned[d.delegator]
}

// Delegation chain is impossible (delegator cannot delegate a role obtained via delegation)
assert assertNoDelegationChains {
    all d: Delegation | d.role not in (activeDelegations[d.delegator, d.delegatedAt].role)
}

// Delegation clearance: delegatee <= role.minClearance AND delegatee <= delegator
assert assertDelegationClearance {
    all d: Delegation |
        ClearanceOrd/lte[d.delegatee.clearance, d.role.minClearance]
        and ClearanceOrd/lte[d.delegatee.clearance, d.delegator.clearance]
}

// Mutual exclusion must NEVER be violated in Normal mode (by assignment or delegation)
assert assertMutExRolesNeverHeldInNormal {
    all s: State | (s.mode = Normal) =>
        all u: User |
            all r1, r2: Role |
                not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and
                     r1 in allRolesHeld[u, s] and r2 in allRolesHeld[u, s])
}

// EmergencyPrivilege never in Normal mode
assert assertNoEmergencyPrivilegeInNormal {
    all s: State | s.mode = Normal => s.emPrivs = none
}

// EmergencyPrivilege always revoked after Emergency, and never persists past the first Normal state after Emergency
assert assertEmergencyPrivilegeRevokedAfterEmergency {
    all ep: EmergencyPrivilege |
        some ep.revokedAt =>
            ep.grantedAt.mode = Emergency
            and ep.revokedAt.mode = Normal
            and prevModeIsEmergency[ep.revokedAt]
}

// All delegations and privilege requests (except automatic EmergencyPrivilege) have approver
assert assertDelegationAudit {
    all d: Delegation | d.approvedBy != none
}

// EmergencyPrivilege never granted outside Emergency
assert assertNoEmergencyPrivilegeOutsideEmergency {
    all ep: EmergencyPrivilege | ep.grantedAt.mode = Emergency
}

// Delegation assigned in Emergency cannot expire after Emergency (must expire exactly at first Normal after Emergency)
assert assertNoEmergencyDelegationWithLateExpiry {
    all d: Delegation |
        (d.delegatedAt.mode = Emergency) =>
            (some s_post: State |
                s_post.mode = Normal and
                prevModeIsEmergency[s_post] and
                d.expiresAt = s_post)
}

// Emergency mode must occur in every test scenario
assert assertEmergencyModeOccurs {
    some s: State | s.mode = Emergency
}

// -- NEW: No request may remain indefinitely unprocessed (eventual processing)
assert assertAllRequestsEventuallyProcessed {
    all r: Request | some s: State | r.processedIn = s and r.approvalStatus in (Approved + Denied)
}

// -- NEW: For every processed request, a user is recorded as approver/denier (audit trail)
assert assertAllRequestsHaveAuditTrail {
    all r: Request | some r.processedIn => some r.approvedOrDeniedBy
}

// -- NEW: During Emergency, all high-classification requests are processed before any medium; all medium before any low
assert assertEmergencyRequestProcessingOrder {
    all s: State |
        (s.mode = Emergency) =>
            (
                all rH: s.requests | rH.classification = C_High =>
                    all rM: s.requests | rM.classification = C_Medium =>
                        (some sP: State | Time/lte[s, sP] and rM.processedIn = sP) =>
                            (some sPH: State | Time/lte[s, sPH] and rH.processedIn = sPH and Time/lte[sPH, sP])
            )
            and
            (
                all rM: s.requests | rM.classification = C_Medium =>
                    all rL: s.requests | rL.classification = C_Low =>
                        (some sP: State | Time/lte[s, sP] and rL.processedIn = sP) =>
                            (some sPM: State | Time/lte[s, sPM] and rM.processedIn = sPM and Time/lte[sPM, sP])
            )
}

// == RUN/CHECK COMMANDS ==

run R1 for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
run R1R2 for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
run R1R2R3 for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
run R1R2R3R4 for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
run R1R2R3R4R5 for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
run R1R2R3R4R5R6 for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
run R1R2R3R4R5R6R7 for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
run { All_Requirements } for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
run { All_Requirements and Coverage_UsersWithDistinctClearances } for 8 but 5 State, 8 User, 5 Role, 5 Object, 5 Request

// == Assertion checks (all must pass) ==
check assertDelegatorAssignedRoleDirectly for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertDelegatorRetainsAssignment for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertNoDelegationChains for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertDelegationClearance for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertMutExRolesNeverHeldInNormal for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertNoEmergencyPrivilegeInNormal for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertEmergencyPrivilegeRevokedAfterEmergency for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertDelegationAudit for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertNoEmergencyPrivilegeOutsideEmergency for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertNoEmergencyDelegationWithLateExpiry for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertEmergencyModeOccurs for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request

// -- NEW checks for completeness and audit/order
check assertAllRequestsEventuallyProcessed for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertAllRequestsHaveAuditTrail for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request
check assertEmergencyRequestProcessingOrder for 6 but 5 State, 8 User, 5 Role, 5 Object, 5 Request

// == End ==

// =======
// [EVENT]: Increased User, Role, Object, Request scopes to 5+ for all run/check commands to ensure coverage predicates can be realized.
// [EVENT]: Updated Coverage_MutExRolesHeldInEmergency to allow roles to be held by assignment and/or delegation (not delegation only).
// [EVENT]: Added explicit processedIn, approvedOrDeniedBy, approvalStatus to Request sig for audit trail and request processing completeness.
// [EVENT]: Added assertions for request audit, completeness, and emergency processing order.
// [EVENT]: Added fact and assertion enforcing delegation chains are forbidden (delegated roles cannot be further delegated).
// [EVENT]: Kept negative scenarios as assertions, not scenario predicates.
// [EVENT]: Updated all incremental predicates and All_Requirements to reflect latest requirements and coverage constraints.
// [EVENT]: Added assertion for all requests eventually processed, and for audit trail on each processed request.
// [EVENT]: Provided an assertion for Emergency request processing order (high before medium, medium before low).
// [LESSON]: Alloy 6: Must use explicit logical implication/quantification instead of if-then-else in facts/predicates.
// [LESSON]: Alloy 6: Cannot use 'no' alone -- use 'no e' or 'not (e)' for negation.
// [LESSON]: Alloy 6: Use 'some'/'lone' fields on sigs for audit and traceability.
// [LESSON]: Alloy 6: All temporal constraints must be modeled using util/ordering and explicit time-indexed facts.
// [LESSON]: Alloy 6: Coverage predicates for verification are not business requirements and must be clearly separated.
