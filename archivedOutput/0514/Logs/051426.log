// EmergencyPrivilege never in Normal mode
assert assertNoEmergencyPrivilegeInNormal {
    all s: State | s.mode = Normal => s.emPrivs = none
}

// EmergencyPrivilege always revoked after Emergency, and never persists past the first Normal state after Emergency
assert assertEmergencyPrivilegeRevokedAfterEmergency {
    all ep: EmergencyPrivilege |
        some ep.revokedAt =>
            ep.grantedAt.mode = Emergency
            and ep.revokedAt.mode = Normal
            and prevModeIsEmergency[ep.revokedAt]
}

// All delegations and privilege requests (except automatic EmergencyPrivilege) have approver
assert assertDelegationAudit {
    all d: Delegation | d.approvedBy != none
}

// EmergencyPrivilege never granted outside Emergency
assert assertNoEmergencyPrivilegeOutsideEmergency {
    all ep: EmergencyPrivilege | ep.grantedAt.mode = Emergency
}

// Delegation assigned in Emergency cannot expire after Emergency (must expire exactly at first Normal after Emergency)
assert assertNoEmergencyDelegationWithLateExpiry {
    all d: Delegation |
        (d.delegatedAt.mode = Emergency) =>
            (some s_post: State |
                s_post.mode = Normal and
                prevModeIsEmergency[s_post] and
                d.expiresAt = s_post)
}

// Emergency mode must occur in every test scenario
assert assertEmergencyModeOccurs {
    some s: State | s.mode = Emergency
}

// == RUN/CHECK COMMANDS ==

// Incremental runs for debugging/diagnosis and coverage:
run R1 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3R4 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3R4R5 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3R4R5R6 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
