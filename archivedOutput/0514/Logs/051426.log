**Current Alloy Model:**
```alloy
// ====================================================
// RBAC Emergency Model (Alloy 6) -- Updated per Evaluator Feedback & Latest Requirements
// ====================================================

open util/ordering[ClearanceLevel] as ClearanceOrd
open util/ordering[State] as Time

// == ENUMS AND MODES ==
abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig C_High, C_Medium, C_Low extends ClassificationLevel {}

abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// == USERS, ROLES, OBJECTS ==
sig User {
    clearance: one ClearanceLevel
}
sig Administrator in User {}

sig Role {
    mutuallyExclusiveWith: set Role,
    minClearance: one ClearanceLevel
}

sig Object {
    classification: one ClassificationLevel
}

sig Request {
    requestedBy: one User,
    affects: some Object,
    classification: one ClassificationLevel
}

// == DELEGATION & PRIVILEGES ==
abstract sig ApprovalStatus {}
one sig Approved, Denied extends ApprovalStatus {}

sig Delegation {
    delegator: one User,
    delegatee: one User,
    role: one Role,
    delegatedAt: one State,
    expiresAt: one State,
    approvedBy: one User,
    approvalStatus: one ApprovalStatus
}

sig EmergencyPrivilege {
    admin: one Administrator,
    grantedAt: one State,
    revokedAt: one State // always present for proper revocation
}

// == SYSTEM STATE (Time-Indexed) ==
sig State {
    mode: one SystemMode,
    emAdmins: set Administrator, // Exactly two admins if Emergency, else none
    requests: set Request,
    delegations: set Delegation,
    emPrivs: set EmergencyPrivilege,
    needsCredentialUpdate: set Administrator,
    assigned: User -> set Role // Which roles are assigned to which users in this State
}

// == GLOBAL STRUCTURAL FACTS ==

// Administrator count and definition
fact AdminCountRange {
    #Administrator >= 0 and #Administrator <= 4
}
fact AdminDefinition {
    all a: Administrator | a.clearance = High
}

// Role mutual exclusion: symmetric, irreflexive, at least one pair exists
fact MutExSymmIrreflexive {
    all r: Role | r not in r.mutuallyExclusiveWith
    all r1, r2: Role | r1 in r2.mutuallyExclusiveWith iff r2 in r1.mutuallyExclusiveWith
}
fact AtLeastOneMutExPairExists {
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
}

// == SELF-DELEGATION PROHIBITION ==
fact NoSelfDelegation {
    all d: Delegation | d.delegator != d.delegatee
}

// == STRICT DELEGATION DURATION ==
fact DelegationStrictDuration {
    all d: Delegation | lt[d.delegatedAt, d.expiresAt]
}

// == REQUEST CLASSIFICATION: by highest classification of affected objects ==
fun highestClass[os: set Object]: one ClassificationLevel {
    (some o: os | o.classification = C_High) => C_High
    else (some o: os | o.classification = C_Medium) => C_Medium
    else C_Low
}
fact RequestClassification {
    all req: Request | req.classification = highestClass[req.affects]
}

// == TIME HELPERS ==
fun pastOrEqual[s: State]: set State { { s2: State | lte[s2, s] } }
fun past[s: State]: set State { { s2: State | lt[s2, s] } }
fun future[s: State]: set State { { s2: State | gt[s2, s] } }
pred prevModeIsNormal[s: State] { some Time/prev[s] and Time/prev[s].mode = Normal }
pred prevModeIsEmergency[s: State] { some Time/prev[s] and Time/prev[s].mode = Emergency }

// == ROLE ASSIGNMENT AND HOLDING ==
fun rolesHeld[u: User, s: State]: set Role { s.assigned[u] }
fun activeDelegations[u: User, s: State]: set Delegation {
    { d: s.delegations |
        d.delegatee = u and
        d.delegatedAt in pastOrEqual[s] and
        lte[s, d.expiresAt] and
        d.approvalStatus = Approved
    }
}
fun allRolesHeld[u: User, s: State]: set Role {
    rolesHeld[u, s] + activeDelegations[u, s].role
}

// == MUTUAL EXCLUSION ENFORCEMENT IN NORMAL ==
fact MutExEnforcedInNormal {
    all s: State | (s.mode = Normal) =>
        all u: User |
            all r1, r2: Role |
                not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and
                     r1 in allRolesHeld[u, s] and r2 in allRolesHeld[u, s])
}

// == EMERGENCY MODE COVERAGE (Global) ==
fact EmergencyModeCoverage {
    some s: State | s.mode = Emergency
}

// == EMERGENCY PRIVILEGE GRANT/REVOKE POLICY ==
fun firstNormalAfter[se: State]: lone State {
    { s: State | s in future[se] and s.mode = Normal and prevModeIsEmergency[s] }
}
fact EmergencyPrivilegeGrantRevoke {
    // EmergencyPrivilege only granted in Emergency, only to emAdmins, and revoked exactly at first Normal after Emergency
    all ep: EmergencyPrivilege |
        ep.grantedAt.mode = Emergency and
        ep.admin in ep.grantedAt.emAdmins and
        some firstNormalAfter[ep.grantedAt] and
        ep.revokedAt = firstNormalAfter[ep.grantedAt] and
        ep.revokedAt.mode = Normal and
        prevModeIsEmergency[ep.revokedAt]
    // No EmergencyPrivilege persists in Normal mode
    all s: State | s.mode = Normal => s.emPrivs = none
    // No EmergencyPrivilege is granted outside Emergency mode
    all ep: EmergencyPrivilege | ep.grantedAt.mode = Emergency
}

// == EMERGENCY DELEGATION EXPIRY POLICY ==
fact EmergencyDelegationExpiry {
    all d: Delegation |
        (d.delegatedAt.mode = Emergency) =>
            (some s_post: State |
                s_post = firstNormalAfter[d.delegatedAt] and
                d.expiresAt = s_post)
}

// == REQUIREMENT: R1 (Emergency Trigger, exactly two admins) ==
pred R1 {
    all s: State |
        (s.mode = Emergency) =>
            (
                #s.emAdmins = 2 and
                all a: s.emAdmins | a in Administrator and
                prevModeIsNormal[s]
            )
        else
            s.emAdmins = none
}

// == REQUIREMENT: R2 (Emergency duration: must return to Normal) ==
pred R1R2 {
    R1
    and all s: State | (s.mode = Emergency) => some s2: future[s] | s2.mode = Normal
}

// == EMERGENCY REQUEST CLASS ORDERING (R3.1) ==
pred EmergencyClassOrder[s: State] {
    all r: s.requests |
        (r.classification = C_Medium) =>
            no r2: s.requests | r2.classification = C_High
    all r: s.requests |
        (r.classification = C_Low) =>
            no r2: s.requests | r2.classification in (C_High + C_Medium)
}

// == REQUIREMENT: R3 (Emergency behavior) ==
pred R1R2R3 {
    R1R2
    // R3.1: EmergencyClassOrdering
    and all s: State | (s.mode = Emergency) => EmergencyClassOrder[s]
    // R3.2: Mutual exclusion suspended in Emergency, enforced in Normal (globally covered)
    // R3.3: EmergencyPrivilege logic (globally enforced)
}

// == REQUIREMENT: R4 (Restoration after Emergency, privilege & delegation expiry strictness) ==
pred R1R2R3R4 {
    R1R2R3
    // R4.1: EmergencyPrivilege must be revoked at first Normal after Emergency (globally enforced)
    // R4.2a: Delegations assigned during Emergency must expire exactly at the first Normal after Emergency (globally enforced)
    // R4.2b: Delegations from before Emergency not revoked at Emergency exit
    and all s: State | (s.mode = Normal and prevModeIsEmergency[s]) =>
        all d: Time/prev[s].delegations |
            (d.delegatedAt.mode = Normal) => (d.expiresAt != s)
    // R4.3: Only emAdmins need credential update
    and all s: State | (s.mode = Normal and prevModeIsEmergency[s]) =>
        s.needsCredentialUpdate = Time/prev[s].emAdmins
}

// == REQUIREMENT: R5 (Delegation rules & expiry) ==
pred R1R2R3R4R5 {
    R1R2R3R4
    and all d: Delegation |
        d.delegator != d.delegatee
        and d.role in rolesHeld[d.delegator, d.delegatedAt]
        and ClearanceOrd/lte[d.role.minClearance, d.delegatee.clearance]
        and ClearanceOrd/lte[d.delegatee.clearance, d.delegator.clearance]
        and lt[d.delegatedAt, d.expiresAt]
        and d.approvedBy != none
}

// == REQUIREMENT: R6 (Mutual exclusion globally enforced in Normal mode; suspended in Emergency) ==
pred R1R2R3R4R5R6 {
    R1R2R3R4R5
    // R6.1: In Normal, mutual exclusion enforced globally (assignment or delegation) [globally enforced]
    // R6.2: In Emergency, mutual exclusion suspended (any user can hold mut-ex roles, by assignment or delegation)
}

// == REQUIREMENT: R7 (Approval/audit trail for all delegation/privilege requests except automatic EmergencyPrivilege) ==
pred R1R2R3R4R5R6R7 {
    R1R2R3R4R5R6
    and all d: Delegation | d.approvedBy != none
    // EmergencyPrivilege: no approval/denial (automatic only for emAdmins)
}

// == CORE ALL REQUIREMENTS ==
pred All_Requirements {
    R1R2R3R4R5R6R7
    and Coverage_EmergencyStateExists
    and Coverage_MutExPairExists
    and Coverage_MutExRolesHeldInEmergency
    and Coverage_PreEmergencyDelegationSpansEmergency
}

// == COVERAGE PREDICATES ==

// Emergency mode must be present in all verification scenarios
pred Coverage_EmergencyStateExists {
    some s: State | s.mode = Emergency
}

// At least one mut-ex pair exists globally (redundant, but for incremental run)
pred Coverage_MutExPairExists {
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
}

// At least one user holds both roles of a mut-ex pair in Emergency via delegation
pred Coverage_MutExRolesHeldInEmergency {
    some s: State | s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in activeDelegations[u, s].role and
            r2 in activeDelegations[u, s].role
}

// At least one delegation granted before Emergency, expires after Emergency
pred Coverage_PreEmergencyDelegationSpansEmergency {
    some s_pre, s_em, s_post: State, d: Delegation |
        Time/lt[s_pre, s_em] and Time/lt[s_em, s_post] and
        s_pre.mode = Normal and
        s_em.mode = Emergency and
        s_post.mode = Normal and
        prevModeIsEmergency[s_post] and
        d.delegatedAt = s_pre and
        d.expiresAt = s_post and
        d in s_pre.delegations and
        d in s_em.delegations and
        d in s_post.delegations
}

// Optionally: Users with all clearances (for extended coverage, not required for core correctness)
pred Coverage_UsersWithDistinctClearances {
    some u1, u2, u3: User |
        u1 != u2 and u2 != u3 and u1 != u3
        and u1.clearance = High
        and u2.clearance = Medium
        and u3.clearance = Low
}

// == NEGATIVE SCENARIOS (assertions only, not predicates) ==

// Delegator must be assigned the role at time of delegation (not via delegation)
assert assertDelegatorAssignedRole {
    all d: Delegation | d.role in rolesHeld[d.delegator, d.delegatedAt]
}

// Delegation expiry must be after grant (strictly, zero-duration forbidden)
assert assertDelegationExpiryStrict {
    all d: Delegation | lt[d.delegatedAt, d.expiresAt]
}

// Delegation clearance: delegatee >= role.minClearance and <= delegator
assert assertDelegationClearance {
    all d: Delegation |
        ClearanceOrd/lte[d.role.minClearance, d.delegatee.clearance]
        and ClearanceOrd/lte[d.delegatee.clearance, d.delegator.clearance]
}

// Mutual exclusion must NEVER be violated in Normal mode (by assignment or delegation)
assert assertMutExRolesNeverHeldInNormal {
    all s: State | (s.mode = Normal) =>
        all u: User |
            all r1, r2: Role |
                not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and
                     r1 in allRolesHeld[u, s] and r2 in allRolesHeld[u, s])
}

// EmergencyPrivilege never in Normal mode
assert assertNoEmergencyPrivilegeInNormal {
    all s: State | s.mode = Normal => s.emPrivs = none
}

// EmergencyPrivilege always revoked after Emergency, and never persists past the first Normal state after Emergency
assert assertEmergencyPrivilegeRevokedAfterEmergency {
    all ep: EmergencyPrivilege |
        some ep.revokedAt =>
            ep.grantedAt.mode = Emergency
            and ep.revokedAt.mode = Normal
            and prevModeIsEmergency[ep.revokedAt]
}

// All delegations and privilege requests (except automatic EmergencyPrivilege) have approver
assert assertDelegationAudit {
    all d: Delegation | d.approvedBy != none
}

// EmergencyPrivilege never granted outside Emergency
assert assertNoEmergencyPrivilegeOutsideEmergency {
    all ep: EmergencyPrivilege | ep.grantedAt.mode = Emergency
}

// Delegation assigned in Emergency cannot expire after Emergency (must expire exactly at first Normal after Emergency)
assert assertNoEmergencyDelegationWithLateExpiry {
    all d: Delegation |
        (d.delegatedAt.mode = Emergency) =>
            (some s_post: State |
                s_post.mode = Normal and
                prevModeIsEmergency[s_post] and
                d.expiresAt = s_post)
}

// Emergency mode must occur in every test scenario
assert assertEmergencyModeOccurs {
    some s: State | s.mode = Emergency
}

// == RUN/CHECK COMMANDS ==

// Incremental runs for debugging/diagnosis and coverage:
run R1 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3R4 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3R4R5 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3R4R5R6 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run R1R2R3R4R5R6R7 for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request

// After confirming all requirements are satisfiable, incrementally add coverage predicates:

run { All_Requirements } for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
run { All_Requirements and Coverage_UsersWithDistinctClearances } for 8 but 4 State, 8 User, 3 Role, 5 Object, 5 Request

// == Assertion checks (all must pass) ==
check assertDelegatorAssignedRole for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertDelegationExpiryStrict for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertDelegationClearance for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertMutExRolesNeverHeldInNormal for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertNoEmergencyPrivilegeInNormal for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertEmergencyPrivilegeRevokedAfterEmergency for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertDelegationAudit for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertNoEmergencyPrivilegeOutsideEmergency for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertNoEmergencyDelegationWithLateExpiry for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request
check assertEmergencyModeOccurs for 6 but 4 State, 8 User, 3 Role, 5 Object, 5 Request

// == End ==

// =======
// [EVENT]: Moved self-delegation prohibition to global fact NoSelfDelegation.
// [EVENT]: Added fact MutExEnforcedInNormal for global mutual exclusion enforcement in Normal mode.
// [EVENT]: Added fact EmergencyModeCoverage to guarantee Emergency mode coverage in every scenario.
// [EVENT]: Added EmergencyPrivilegeGrantRevoke fact to require explicit, immediate revocation at first Normal after Emergency.
// [EVENT]: Added EmergencyDelegationExpiry fact to enforce expiry of Emergency delegations at first Normal after Emergency.
// [EVENT]: Updated R4.2b to clarify Emergency delegations expiry rule and persistence of pre-Emergency delegations.
// [EVENT]: Incremental run and coverage predicates retained for coverage as per requirements.
// [EVENT]: All_Requirements predicate covers all coverage predicates for non-vacuous verification.
// [LESSON]: Alloy 6: All facts must use explicit conditions; cannot have a standalone 'no' or 'some' as a block.
// [LESSON]: Modeling "first Normal after Emergency" as a function over the State ordering is valid if State is totally ordered (via util/ordering).
// [LESSON]: Alloy 6: Facts are global invariants; assertions are for negative/forbidden scenarios.
// [LESSON]: Facts enforcing coverage (e.g., EmergencyModeCoverage) guarantee non-vacuous verification, per requirements.
```

**Current Requirements:**
```
SYSTEM OVERVIEW
===============
The system is a Role-based Access Control (RBAC) environment supporting multiple users, role hierarchies, temporary role delegation, revocation, and concurrent request processing. The system enforces authorization correctness, maintains delegation and permission consistency, and ensures safety and liveness under concurrency. Users have clearance levels (High, Medium, Low), and objects have classification levels (High, Medium, Low). Requests are classified by the highest classification level of affected objects and must comply with user clearance. Higher-clearance users can approve or reject lower-clearance user requests. Delegation and revocation of roles are governed by clearance and administrative rules. The system includes an Emergency Module to manage exceptional scenarios, which alters standard behaviors under specific triggers and constraints. Emergency mode is abstracted as a fixed duration but may terminate early if both administrators who activated it jointly deactivate it. The system must always eventually return to Normal mode after Emergency mode.

EXISTING-SYSTEM ASSUMPTIONS AND CONSTRAINTS
============================================
- The set of administrators can range from 0 to 4, depending on scenario. Administrator uniqueness is based on set semantics; duplicate entries are not possible.
- Emergency mode can only be triggered from Normal mode and requires exactly two distinct administrators, acting jointly (no more, no fewer). If fewer or more than two administrators participate, Emergency mode cannot be entered.
- Emergency mode is time-bounded, abstracted as a fixed duration; it may terminate early if both participating administrators jointly deactivate Emergency. The system must eventually return to Normal mode after Emergency mode.
- FIFO ordering for request processing can be bypassed only during Emergency mode, and only for high-classification requests.
- Mutual exclusivity of roles is suspended for all users only during Emergency mode. During Emergency mode, any user may simultaneously hold any combination of roles, including roles that are mutually exclusive in Normal mode.
- Emergency privilege is granted automatically and only to the two administrators who triggered Emergency mode (emAdmins), only during Emergency mode, and is revoked explicitly and immediately at the first Normal state after Emergency mode ends. EmergencyPrivilege must never be granted outside Emergency mode or persist beyond the first Normal state after Emergency ends.
- Roles delegated during Emergency mode must expire exactly at the first Normal state after Emergency mode ends; any delegation assigned during Emergency mode must expire at that state, overriding any user-specified expiry time.
- Roles delegated prior to Emergency mode are not automatically revoked, but may still expire or be revoked by an administrator during Emergency mode.
- Only the administrators who participated in the Emergency trigger (the two emAdmins) are required to update their credentials after Emergency mode ends.
- No role is mutually exclusive with itself, and mutual exclusivity is symmetric.
- For all business scenarios, the set of administrators is bounded as above, but the system may contain a larger number of users for coverage and verification purposes.
- Self-delegation is prohibited; a user cannot delegate a role to itself. This is an explicit system invariant.

PROSPECTIVE FUNCTIONAL REQUIREMENTS
====================================
R1: Emergency Trigger  
Exactly two distinct administrators, while the system is in Normal mode, are required to jointly trigger entry into Emergency mode. No more and no fewer than two administrators may jointly trigger Emergency mode. Only these two participating administrators (emAdmins) are considered for all subsequent emergency-related requirements. Emergency mode cannot be entered unless exactly two administrators trigger it.

R2: Emergency Mode Duration  
Emergency mode is active only for a limited (bounded) time, abstracted as a fixed duration; however, it may terminate early if both participating administrators (emAdmins) jointly deactivate Emergency. The system must always eventually return to Normal mode after Emergency mode.

R3: Emergency Mode Behavior  
R3.1. During Emergency mode, request processing must occur by classification: all high-classification requests are processed first (possibly concurrently), then all medium-classification requests are processed concurrently, and finally all low-classification requests are processed.  
R3.2. During Emergency mode, mutual exclusivity of roles is suspended for all users. It must be possible and observable for any user to simultaneously hold any combination of roles, including at least one pair of roles that are mutually exclusive in Normal mode.  
R3.3. During Emergency mode, only the two administrators who participated in the Emergency trigger (emAdmins) temporarily hold emergency privileges, and EmergencyPrivilege is granted automatically and only to them for the duration of Emergency mode. EmergencyPrivilege must never be granted outside Emergency mode and must always be revoked explicitly and immediately at the first Normal state after Emergency mode ends. The revocation time for each EmergencyPrivilege must be explicitly tracked.

R4: Post-Emergency Restoration  
R4.1. At the first Normal state after Emergency mode ends, EmergencyPrivilege must always be revoked from the two administrators (emAdmins) who participated in the Emergency trigger, with explicit record of the revocation time. EmergencyPrivilege must not persist beyond that state, including the first step after Emergency mode ends.  
R4.2. After Emergency mode ends, any roles delegated during Emergency mode must be revoked; specifically:  
  - R4.2a. Any delegation assigned during Emergency mode must expire exactly at the first Normal state after Emergency ends, without exception, overriding any user-specified expiry time.  
  - R4.2b. Delegated roles from before Emergency mode are not automatically revoked solely due to the transition out of Emergency mode; they must remain active until their explicit expiry or explicit revocation, including through and after Emergency mode, unless explicitly revoked.  
R4.3. After Emergency mode ends, only the two administrators who participated in the Emergency trigger are required to update their credentials.

R5: Delegation Clearance and Tracking  
R5.1. Users with higher clearance may temporarily delegate one or more of their assigned roles to a lower-clearance user, provided that the delegate has clearance greater than or equal to the role’s minimum clearance requirement.  
R5.2. Delegation can only occur if the delegator holds the role at the time of delegation, and the delegatee meets the clearance requirement at the time of delegation.  
R5.3. Self-delegation is prohibited; a user cannot delegate a role to itself. This prohibition is enforced as a system invariant.  
R5.4. Every delegation must include an explicit expiry time, and remains active until its expiry time unless revoked earlier. No delegation expires before it is granted, and delegatedAt must be strictly less than expiresAt (zero-duration delegations are not allowed).  
R5.5. All delegations and privilege requests (except for automatic EmergencyPrivilege grants) must be tracked with the identity of the approver or denier.  
R5.6. There must be a record of assigned roles for each user so that delegation can be verified against assigned roles.

R6: Mutual Exclusivity Enforcement  
R6.1. In Normal mode, no user may simultaneously hold two mutually exclusive roles by any means (assignment or delegation). Mutual exclusivity applies globally across all roles held (direct or delegated) in Normal mode, except during Emergency mode.  
R6.2. In Emergency mode, mutual exclusivity of roles is suspended for all users, and any user may simultaneously hold any combination of roles, including mutually exclusive pairs, whether via assignment or delegation.

R7: Request/Delegation Approval Tracking  
R7.1. All privilege and delegation requests (except automatically granted EmergencyPrivilege) must be tracked with the identity of the user who approved or denied the request, and the decision made.

NEWLY DISCOVERED REQUIREMENT GAPS
==================================
- For verification coverage, enforce the following globally (after all requirements generate a satisfying instance):  
    - Emergency mode must always be exercised in verification scenarios to validate Emergency-specific requirements.  
    - The system may contain users with each clearance level (High, Medium, Low), but this is not required in all scenarios; it is enforced as a predicate for coverage after all requirements generate a satisfying instance.  
    - At least one pair of mutually exclusive roles must exist at all times; one pair is sufficient for coverage.  
    - During Emergency mode, at least one user must simultaneously hold both roles of a mutually exclusive pair, and this must be demonstrated only via delegation. It must not be possible for any user to hold both roles of a mutually exclusive pair in Normal mode (by assignment or delegation).  
    - At least one delegation must be granted before Emergency mode with an explicit expiry after Emergency mode ends, to verify persistence through mode transitions.  
    - For verification, the User scope must be set large enough to cover the maximum number of administrators (up to 4) and distinct users with different clearance levels, as required for coverage.  
    - For each positive test scenario, scenario preconditions (such as Emergency present, required delegations present, role exclusivity present) must always be satisfied in verification runs.  
    - For verification, negative scenarios (such as self-delegation or delegator not assigned the role) are enforced via global facts and assertions; explicit negative scenario construction is not required if facts/assertions are sufficient.  
    - All requirements and coverage constraints must be reflected in the All_Requirements predicate; do not create duplicate predicates with different names. Incremental run statements should be kept for incremental analysis.

PROVISIONAL ASSUMPTIONS FOR VERIFICATION
========================================
- For Alloy model checking, all coverage facts are enforced globally, not scenario-locally: (a) Emergency mode is always exercised in verification, (b) at least one pair of mutually exclusive roles exists, (c) at least one user is assigned two mutually exclusive roles during Emergency mode (via delegation), and (d) at least one delegation spans Emergency mode (granted before, expires after).
- For verification, include users with each clearance level (High, Medium, Low) where required for coverage, but this is not enforced in all scenarios.
- The User scope should be increased as needed for verification to cover all coverage conditions, regardless of the fixed administrator count.
- For verification scenario naming, include `positive` or `negative` to clarify expected outcome and scenario coverage.
- No particular constraints are required on which roles are mutually exclusive for verification; mutual exclusion is abstract and not role-specific.
- Clearance level comparisons in Alloy must use appropriate techniques due to non-integer ordering; delegation clearance checks must use "greater than or equal to".
- Do not create redundant assertions that simply restate enforced facts; avoid vacuous assertions.
- For delegation expiry, model delegations so that each instance has an explicit expiry time, and persists until expiry unless revoked. Zero-duration delegations are prohibited; expiry must be strictly after grant.
- Include edge-case scenarios, such as delegations with expiry after Emergency mode, and verify mutual exclusivity is only suspended in Emergency mode.
- Alloy syntax must not use a standalone `no`; always use `no` followed by an expression (e.g., `no x` or `no someRelation`). Negate conjunctions directly as needed.
