**Current Alloy Model:**
```alloy
// ===== RBAC Emergency Model (Alloy 6, Abstract, Requirements-conformant, Emergency Mutual Exclusion Edge Cases, Revised) =====

open util/ordering[State] as Time

// ===== ENUMS AND MODES =====

abstract sig Bool {}
one sig True, False extends Bool {}

abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig C_High, C_Medium, C_Low extends ClassificationLevel {}

abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// ===== CORE ENTITIES =====

sig User {
    clearance: one ClearanceLevel,
    isAdmin: one Bool
}

sig Administrator in User {}

sig Role {
    mutuallyExclusiveWith: set Role,
    minClearance: one ClearanceLevel
}

sig Object {
    classification: one ClassificationLevel
}

sig Request {
    requestedBy: one User,
    affects: some Object,
    classification: one ClassificationLevel
}

sig Delegation {
    delegator: one User,
    delegatee: one User,
    role: one Role,
    delegatedAt: one State,
    expiresAt: lone State
}

sig EmergencyPrivilege {
    admin: one Administrator,
    grantedAt: one State,
    revokedAt: lone State
}

// ===== SYSTEM STATE =====

sig State {
    mode: one SystemMode,
    emAdmins: set Administrator, // exactly 2 when entering Emergency, else empty
    requests: set Request,
    delegations: set Delegation,
    emPrivs: set EmergencyPrivilege,
    needsCredentialUpdate: set Administrator
}

// ===== GLOBAL FACTS AND SYSTEM INVARIANTS =====

// At least one mutually exclusive role pair in every run/check
fact AtLeastOneMutExPair {
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
}

// No role may be mutually exclusive with itself
fact F_NoRoleSelfExclusion {
    all r: Role | r not in r.mutuallyExclusiveWith
}

// isAdmin iff membership in Administrator
fact R0_IsAdminIffAdministrator {
    all u: User | (u in Administrator) iff (u.isAdmin = True)
}

// All Administrators have High clearance and isAdmin True
fact R0_AdminDefinition {
    all a: Administrator | a.clearance = High and a.isAdmin = True
    all u: User - Administrator | u.isAdmin = False
}

// === Minimum clearance for delegation (system-wide) ===
fact F_MinimumClearanceForDelegation {
    all s: State, d: s.delegations |
        d.delegatee.clearance >= d.role.minClearance
}

// Emergency mode entry: Only with exactly 2 distinct emAdmins (in Administrator), from Normal
fact R1_EmergencyEntry_Strict {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (#s.emAdmins = 2 and s.emAdmins in Administrator)
        else
            (s.mode = Emergency) => (#Time/prev[s].emAdmins = 2 and Time/prev[s].emAdmins in Administrator)
}

// EmergencyPrivilege: only for the two emAdmins, only during Emergency; none persists in any Normal state
fact R3_3_EmergencyPrivilegeAssignment_And_Revocation {
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs |
                ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt)
            and
            (all a: s.emAdmins | some ep: s.emPrivs | ep.admin = a and ep.grantedAt = s)
        else
            no s.emPrivs
}

// needsCredentialUpdate: set to both emAdmins only in first Normal after Emergency, empty in all other states
fact R4_3_EmergencyCredentialUpdate_Strict {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
        else
            no s.needsCredentialUpdate
}

// Delegation revocation: all delegations assigned during Emergency must be revoked at Emergency->Normal
fact R4_2_EmergencyDelegationRevocation {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => d.expiresAt = s
}

// Delegations from before Emergency are not revoked automatically
fact R4_2b_DelegationsNotRevokedIfBeforeEmergency {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)
}

// Request classification equals highest classification of affected objects
fact F_RequestClassification {
    all req: Request |
        req.classification = highestClass[req.affects]
}

// FIFO enforced except for C_High requests during Emergency
fact F_FIFOEnforcedExceptEmergency {
    all s: State |
        s.mode = Normal => FIFOProcessing[s]
}

// === Mutual exclusion suspension ONLY during Emergency with exactly two emAdmins ===
fact F_MutualExclusion_EnforcedAndSuspended_Strict {
    all s: State |
        (s.mode = Normal =>
            all u: User |
                all r1, r2: Role |
                    (r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s] and r1 != r2) =>
                        not (r1 in r2.mutuallyExclusiveWith)
        )
        and
        (s.mode = Emergency and #s.emAdmins = 2 =>
            // mutual exclusion suspension allowed; no constraint here
            True = True
        )
        and
        (s.mode = Emergency and #s.emAdmins != 2 =>
            all u: User |
                all r1, r2: Role |
                    (r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s] and r1 != r2) =>
                        not (r1 in r2.mutuallyExclusiveWith)
        )
}

// Emergency mode must always eventually end (liveness)
fact R2_EmergencyLiveness {
    all s: State |
        (s.mode = Emergency) => some s2: State | gt[s2, s] and s2.mode = Normal
}

// ==== Helper functions and predicates ====

// Returns the roles held by user u at state s
fun rolesHeld[u: User, s: State]: set Role {
    { r: Role |
        some d: s.delegations |
            d.delegatee = u and
            d.role = r and
            d.delegatedAt in pastOrEqual[s] and
            (no d.expiresAt or lt[s, d.expiresAt])
    }
}

// Returns all states up to and including s
fun pastOrEqual[s: State]: set State { { s2: State | lte[s2, s] } }

// Highest classification of a set of objects
fun highestClass[os: set Object]: one ClassificationLevel {
    (some o: os | o.classification = C_High) => C_High
    else (some o: os | o.classification = C_Medium) => C_Medium
    else C_Low
}

// FIFO abstract predicate
pred FIFOProcessing[s: State] {}

// Bypass FIFO for C_High requests during Emergency
pred bypassFIFOForHighClass[s: State] {
    all r: s.requests |
        (r.classification = C_High) => canBeProcessedOutOfOrder[r, s]
}

// During Emergency, C_High requests may be processed out of order
pred canBeProcessedOutOfOrder[r: Request, s: State] {
    r in s.requests and s.mode = Emergency and r.classification = C_High
}

// Helper: previous mode is Normal
pred prevModeIsNormal[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Normal
}

// Helper: previous mode is Emergency
pred prevModeIsEmergency[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Emergency
}

// ========== REQUIREMENT PREDICATES (incremental) ==========

// R1: Emergency Trigger — only if exactly 2 distinct emAdmins, both in Administrator, from Normal
pred R1 {
    some s: State |
        (s.mode = Emergency and prevModeIsNormal[s] and #s.emAdmins = 2 and
         s.emAdmins in Administrator)
    and
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (#s.emAdmins = 2 and
             s.emAdmins in Administrator)
}

// R2: Emergency Mode Duration (liveness) — system always returns to Normal
pred R1R2 {
    R1 and
    all s: State |
        (s.mode = Emergency) => some s2: State | gt[s2, s] and s2.mode = Normal
}

// R3: Emergency behavior (FIFO bypass, mutual exclusion suspended, em privileges granted)
pred R1R2R3 {
    R1R2 and

    // R3.1: FIFO can be bypassed for high-classification requests
    all s: State |
        (s.mode = Emergency) => bypassFIFOForHighClass[s]
    and

    // R3.2: Mutual exclusion is suspended ONLY in Emergency with exactly two emAdmins.
    some s: State |
        s.mode = Emergency and #s.emAdmins = 2 and
        some u: User, r1, r2: Role |
            r1 != r2 and
            r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
    and

    // R3.3: Only the two emAdmins have EmergencyPrivilege during Emergency
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs | ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt)
            and
            (all a: s.emAdmins | some ep: s.emPrivs | ep.admin = a and ep.grantedAt = s)
}

// R4: Post-Emergency Restoration (immediate revocation, credential update for emAdmins only)
pred R1R2R3R4 {
    R1R2R3 and

    // R4.1: emAdmins lose EmergencyPrivilege immediately after Emergency, in first and all subsequent Normal states
    all s: State |
        (s.mode = Normal) =>
            no s.emPrivs

    and

    // R4.2: Only delegations assigned during Emergency are revoked when Emergency ends
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s)

    and

    // R4.2b: Delegations assigned before Emergency are NOT revoked at Emergency end
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)

    and

    // R4.3: Only the two emAdmins must update credentials after Emergency, and only in the first Normal after Emergency. Otherwise, needsCredentialUpdate is empty.
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
    and
    all s: State |
        ((s.mode = Emergency) or (s.mode = Normal and not prevModeIsEmergency[s])) =>
            no s.needsCredentialUpdate
}

// All requirements predicate
pred All_Requirements { R1R2R3R4 }

// ========== EDGE CASE SCENARIO PREDICATES FOR EMERGENCY ENTRY ==========

// Negative: Emergency entry attempted with only one emAdmin
pred Scenario_EmergencyEntryWithSingleAdmin {
    some s: State |
        s.mode = Emergency and prevModeIsNormal[s] and #s.emAdmins = 1
}

// Negative: Emergency entry attempted with more than two emAdmins
pred Scenario_EmergencyEntryWithMoreThanTwoAdmins {
    some s: State |
        s.mode = Emergency and prevModeIsNormal[s] and #s.emAdmins > 2
}

// Negative: Emergency entry attempted with an emAdmin not in Administrator
pred Scenario_EmergencyEntryWithNonAdminEmAdmin {
    some s: State |
        s.mode = Emergency and prevModeIsNormal[s] and (some a: s.emAdmins | a not in Administrator)
}

// Positive: Emergency entry with exactly 2 distinct emAdmins
pred Scenario_EmergencyEntryWithExactlyTwoDistinctAdmins {
    some s: State |
        s.mode = Emergency and prevModeIsNormal[s] and
        #s.emAdmins = 2 and s.emAdmins in Administrator
}

// Negative: Emergency entry attempted with duplicate emAdmins (Alloy sets are duplicate-free, included for traceability)
pred Scenario_EmergencyEntryWithDuplicateAdmin {
    some s: State |
        s.mode = Emergency and prevModeIsNormal[s] and #s.emAdmins = 2 and
        (some a: s.emAdmins | #(s.emAdmins - a) < 1)
}

// ========== MUTUAL EXCLUSION SUSPENSION EDGE CASES (POSITIVE AND NEGATIVE) ==========

// Positive: Any user, delegated both mutually exclusive roles in the SAME Emergency state with exactly two emAdmins (minimum clearance enforced)
pred Scenario_MutualExclusionSuspended_Positive {
    some s: State |
        s.mode = Emergency and #s.emAdmins = 2 and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            some d1, d2: s.delegations |
                d1.delegatee = u and d2.delegatee = u and
                d1.role = r1 and d2.role = r2 and
                d1.delegatedAt = s and d2.delegatedAt = s and
                (no d1.expiresAt or s.lt[d1.expiresAt]) and
                (no d2.expiresAt or s.lt[d2.expiresAt]) and
                u.clearance >= r1.minClearance and u.clearance >= r2.minClearance
}

// Negative: Mutual exclusion suspended with less than two emAdmins (should be impossible)
pred Scenario_MutualExclusionSuspended_LessThanTwoAdmins {
    some s: State |
        s.mode = Emergency and #s.emAdmins < 2 and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// Negative: Mutual exclusion suspended with more than two emAdmins (should be impossible)
pred Scenario_MutualExclusionSuspended_MoreThanTwoAdmins {
    some s: State |
        s.mode = Emergency and #s.emAdmins > 2 and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// Negative: Mutual exclusion suspended in Emergency with a non-admin in emAdmins (should be impossible)
pred Scenario_MutualExclusionSuspended_NonAdminEmAdmin {
    some s: State |
        s.mode = Emergency and (some a: s.emAdmins | a not in Administrator) and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// Negative: User holds two mutually exclusive roles in Normal mode (should be impossible)
pred Scenario_MutualExclusionEnforcedInNormal {
    some s: State |
        s.mode = Normal and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// Negative: needsCredentialUpdate set outside first Normal after Emergency
pred Scenario_CredentialUpdateOutsidePostEmergency {
    some s: State |
        ((s.mode = Emergency) or (s.mode = Normal and not prevModeIsEmergency[s])) and
        some (s.needsCredentialUpdate)
}

// Negative: EmergencyPrivilege present in any Normal state
pred Scenario_EmergencyPrivilegeInNormal {
    some s: State |
        s.mode = Normal and some s.emPrivs
}

// Negative: Role mutually exclusive with itself
pred Scenario_RoleSelfExclusion {
    some r: Role | r in r.mutuallyExclusiveWith
}

// ========== ASSERTIONS FOR VERIFICATION ==========

assert assertR1 {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (#s.emAdmins = 2 and
             s.emAdmins in Administrator)
}

assert assertR2 {
    all s: State |
        (s.mode = Emergency) => (some s2: State | gt[s2, s] and s2.mode = Normal)
}

// Explicit assertion: Positive mutual exclusion suspension scenario is realizable (minimum clearance rule enforced)
assert assertR3_MutExScenario_Positive {
    Scenario_MutualExclusionSuspended_Positive
}

// Negative mutual exclusion suspension (less than two emAdmins)
assert assertR3_MutExScenario_Neg_LessThanTwo {
    not Scenario_MutualExclusionSuspended_LessThanTwoAdmins
}

// Negative mutual exclusion suspension (more than two emAdmins)
assert assertR3_MutExScenario_Neg_MoreThanTwo {
    not Scenario_MutualExclusionSuspended_MoreThanTwoAdmins
}

// Negative mutual exclusion suspension (non-admin emAdmin)
assert assertR3_MutExScenario_Neg_NonAdmin {
    not Scenario_MutualExclusionSuspended_NonAdminEmAdmin
}

// Negative: Mutual exclusion enforced in Normal
assert assertR3_MutExScenario_Neg_Normal {
    not Scenario_MutualExclusionEnforcedInNormal
}

assert assertR4_1 {
    all s: State |
        (s.mode = Normal) =>
            no s.emPrivs
}

assert assertR4_2 {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => d.expiresAt = s
}

assert assertR4_2b {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)
}

assert assertR4_3 {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
    and
    all s: State |
        ((s.mode = Emergency) or (s.mode = Normal and not prevModeIsEmergency[s])) =>
            no s.needsCredentialUpdate
}

assert assertIsAdminIffAdministrator {
    all u: User | (u in Administrator) iff (u.isAdmin = True)
}

// No role is ever mutually exclusive with itself (negative scenario)
assert assertNoRoleSelfExclusion {
    not Scenario_RoleSelfExclusion
}

// Vacuity assertion: If no user can ever hold two ME roles in Emergency with exactly two emAdmins, then all negative mutual exclusion scenarios must be vacuously true
assert assertMutExSuspensionVacuity {
    not Scenario_MutualExclusionSuspended_Positive =>
        not Scenario_MutualExclusionSuspended_LessThanTwoAdmins and
        not Scenario_MutualExclusionSuspended_MoreThanTwoAdmins and
        not Scenario_MutualExclusionSuspended_NonAdminEmAdmin and
        not Scenario_MutualExclusionEnforcedInNormal
}

// ========== RUN/CHECK/EXPECT COMMANDS ==========

run Scenario_EmergencyEntryWithExactlyTwoDistinctAdmins for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 1
run Scenario_EmergencyEntryWithSingleAdmin for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0
run Scenario_EmergencyEntryWithDuplicateAdmin for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0
run Scenario_EmergencyEntryWithNonAdminEmAdmin for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0
run Scenario_EmergencyEntryWithMoreThanTwoAdmins for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0

run Scenario_MutualExclusionSuspended_Positive for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 1
run Scenario_MutualExclusionSuspended_LessThanTwoAdmins for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0
run Scenario_MutualExclusionSuspended_MoreThanTwoAdmins for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0
run Scenario_MutualExclusionSuspended_NonAdminEmAdmin for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0
run Scenario_MutualExclusionEnforcedInNormal for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0

run Scenario_CredentialUpdateOutsidePostEmergency for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0
run Scenario_EmergencyPrivilegeInNormal for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request expect 0

run Scenario_RoleSelfExclusion for 6 but 3 State, 3 User, 3 Role, 3 Object, 3 Request expect 0

run R1 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
run R1R2 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
run R1R2R3 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
run R1R2R3R4 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
run All_Requirements for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request

check assertR1 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR2 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR3_MutExScenario_Positive for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR3_MutExScenario_Neg_LessThanTwo for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR3_MutExScenario_Neg_MoreThanTwo for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR3_MutExScenario_Neg_NonAdmin for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR3_MutExScenario_Neg_Normal for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR4_1 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR4_2 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR4_2b for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertR4_3 for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertIsAdminIffAdministrator for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request
check assertNoRoleSelfExclusion for 6 but 3 State, 3 User, 3 Role, 3 Object, 3 Request
check assertMutExSuspensionVacuity for 8 but 6 State, 6 User, 4 Role, 6 Object, 6 Request

// -- END OF MODEL --

// [EVENT]: Removed scenario-specific assumptions from facts; encoded explicit scenario for mutual exclusion suspension in predicate Scenario_MutualExclusionSuspended_Positive.
// [EVENT]: Added minimum clearance attribute to Role and enforced via F_MinimumClearanceForDelegation fact, system-wide (not scenario-specific).
// [EVENT]: Increased scope in run/check commands to ensure realizability of mutual exclusion suspension scenario and avoid vacuity.
// [EVENT]: Added assertion for scenario vacuity to confirm negative cases are not trivially true.
// [EVENT]: Confirmed via assertR3_MutExScenario_Positive that any user (not just emAdmins) may be delegated and hold two mutually exclusive roles in Emergency mode with exactly two emAdmins, both delegated in the same state, minimum clearance enforced.
// [EVENT]: Added explicit negative scenario and assertion for role self-exclusion, per requirements.
// [LESSON]: Alloy sets are inherently duplicate-free; modeling duplicate selection or "duplication" scenarios must use cardinality checks, not set duplicates.
// [LESSON]: Facts should only encode system-wide, persistent rules; scenario/test-specific constraints must be in predicates or assertions for targeted verification.
// [LESSON]: To avoid vacuity in negative checks, positive scenario must be possible in scope with correct facts/predicates separation and sufficient scope size.
