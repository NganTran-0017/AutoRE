```alloy
// Alloy 6 Model: RBAC System with Emergency Module (Abstract Verification Model)
// Updated for requirements coverage and logic corrections.

// --- OPEN MODULES ---
open util/ordering[State]
// open util/seq as Seq   // REMOVED: Alloy 6 does not support this

// --- STRUCTURAL SIGNATURES ---

// Clearance and classification levels
abstract sig Clearance {}
one sig High, Medium, Low extends Clearance {}

// --- CLEARANCE ORDERING ---

fun succClearance[c: Clearance]: set Clearance {
    (c = Low) => Medium else
    (c = Medium) => High else
    none
}

pred leqClearance[c1, c2: Clearance] {
    c1 = c2 or
    (c1 = Low and (c2 = Medium or c2 = High)) or
    (c1 = Medium and c2 = High)
}

// Users and their roles
sig User {
    clearance: one Clearance
}

sig Administrator extends User {}

// Roles; some are mutually exclusive with others
sig Role {
    minClearance: one Clearance,
    mutexWith: set Role
}

// Emergency Privileges (granted only to Administrators during Emergency)
sig EmergencyPrivilege {}

// Objects/resources in system
sig Object {
    classification: one Clearance
}

// Requests submitted by users, targeting objects
sig Request {
    submitter: one User,
    targets: some Object
}

// Delegated roles: granted from one user to another, with when delegated and delegation period info
sig Delegation {
    role: one Role,
    from: one User,
    to: one User,
    duringEmergency: one Bool // True if delegated during Emergency mode
}

// Bool type for delegation/other flags
abstract sig Bool {}
one sig True, False extends Bool {}

// System operational modes
abstract sig Mode {}
one sig Normal, Emergency extends Mode {}

// --- REQUEST STATUS AND PROCESSOR TRACKING ---

// RequestStatus for monotonic request lifecycle
abstract sig RequestStatus {}
one sig Pending, Processed extends RequestStatus {}

// --- SYSTEM STATE MODELING ---

sig State {
    mode: one Mode,
    // Active delegations in this state
    activeDelegations: set Delegation,
    // User->Role relation for roles held in this state (including via delegation)
    userRoles: User -> Role,
    // Emergency Privilege assignments (for administrators)
    emergencyPrivs: Administrator -> lone EmergencyPrivilege,
    // For each request, its status in this state (Pending or Processed)
    reqStatus: Request -> lone RequestStatus,
    // For each processed request: who processed it (if any)
    reqProcessor: Request -> lone User,
    // For each admin, whether credentials have been updated after Emergency ends
    adminCredUpdated: Administrator -> lone Bool
}

// --- REQUEST CLASSIFICATION LOGIC ---

fun requestClassification[r: Request]: one Clearance {
    // The highest classification among all targeted objects
    {c: Clearance | some o: r.targets | o.classification = c and
        no c2: Clearance | succClearance[c2] = c and some o2: r.targets | o2.classification = c2
    }
}

// --- SYSTEM INITIALIZATION ---

fact InitialState {
    // The first State (first[State]) is always in Normal mode
    first.mode = Normal
    // All requests are pending at start
    all r: Request | first.reqStatus[r] = Pending
    // No request is processed at the start
    all r: Request | no first.reqProcessor[r]
    // No admin has updated credentials at the start
    all a: Administrator | first.adminCredUpdated[a] = False
}

// --- FACTS: STRUCTURE AND ROLES ---

fact Structural {
    // All administrators have high clearance
    all a: Administrator | a.clearance = High

    // Role mutual exclusion is symmetric and irreflexive
    all r: Role | r not in r.mutexWith
    all r1, r2: Role | r2 in r1.mutexWith iff r1 in r2.mutexWith

    // At least one pair of mutually exclusive roles always exists
    some r1, r2: Role | r1 != r2 and r2 in r1.mutexWith
}

// --- FACTS: MODE EXCLUSIVITY ---

fact ModeExclusivity {
    all s: State | one m: Mode | s.mode = m
}

// --- FACTS: ROLE ASSIGNMENT AND PERSISTENCE ---

fact RoleAssignmentClearance {
    // Roles (assigned or delegated) must never exceed user's clearance
    all s: State, u: User, r: Role |
        r in s.userRoles[u] => leqClearance[r.minClearance, u.clearance]
}

fact DelegationClearance {
    // Delegation only if to user's clearance >= role's min clearance
    all d: Delegation | leqClearance[d.role.minClearance, d.to.clearance]
}

// Assigned roles persist unless explicitly revoked (userRoles only shrinks if delegation is revoked)
fact RolePersistence {
    all s, s2: State | 
        Next[s, s2] =>
            all u: User, r: Role |
                (r in s.userRoles[u] and not isRoleRevoked[s, s2, u, r]) => r in s2.userRoles[u]
}

// Helper predicate: isRoleRevoked
pred isRoleRevoked[s, s2: State, u: User, r: Role] {
    // Revocation: r in s.userRoles[u] but not in s2.userRoles[u]
    r in s.userRoles[u] and r not in s2.userRoles[u]
}

// --- FACTS: REQUEST STATUS MONOTONICITY ---

fact RequestStatusMonotonic {
    // A request cannot revert from Processed back to Pending
    all s, s2: State, r: Request |
        Next[s, s2] =>
            (s.reqStatus[r] = Processed) => (s2.reqStatus[r] = Processed)
}

// --- FACTS: REQUEST PROCESSOR AND CLEARANCE ---

fact RequestProcessorClearance {
    // If a request is processed in s, processor must have clearance > request's classification
    all s: State, r: Request |
        s.reqStatus[r] = Processed and some s.reqProcessor[r] =>
            let proc = s.reqProcessor[r], rc = requestClassification[r] |
                (proc in User) and
                (some c1, c2: Clearance | proc.clearance = c1 and rc = c2 and
                    (c1 = High or (c1 = Medium and (rc = Medium or rc = Low)) or (c1 = Low and rc = Low))
                )
}

// --- FACTS: REQUEST PROCESSING ORDER (NORMAL & EMERGENCY) ---

// Helper: sequence of requests in FIFO order (by index order in util/ordering[Request])
fun requestSeq: univ { none } // Dummy, since util/seq is not available

// In Normal mode, requests are processed strictly in FIFO order
fact NormalModeFIFO {
    all s, s2: State |
        s.mode = Normal and s2.mode = Normal and Next[s, s2] =>
            // The first pending request (by ordering) is the only one eligible for processing
            let pendingSeq = {r: Request | s.reqStatus[r] = Pending} |
                all r: Request |
                    (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) =>
                        r = firstPendingFIFO[s]
}

// Helper: first pending request in FIFO order
fun firstPendingFIFO[s: State]: lone Request =
    { r: Request | s.reqStatus[r] = Pending and
      no r2: Request | s.reqStatus[r2] = Pending and precedes[r2, r]
    }

// Helper: ordering on Request
pred precedes[r1, r2: Request] {
    // r1 comes before r2 in util/ordering[Request]
    some r1' : Request | r1' = r1 and r2 in util/ordering[Request]/next[r1']
}

// In Emergency, high-classification requests are processed before medium, then low
fact EmergencyProcessingPriority {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] =>
            // Only allow processing of requests with highest classification among pendings
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            let med = {r: Request | r in pending and requestClassification[r] = Medium} |
            let low = {r: Request | r in pending and requestClassification[r] = Low} |
            // Only process from the highest non-empty group
            (
                (some high and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in high) or
                (no high and some med and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in med) or
                (no high and no med and some low and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in low)
            )
}

// --- FACTS: MUTUAL EXCLUSION ---

fact DelegationMutex {
    // Outside Emergency, no user holds mutually exclusive roles at the same time
    all s: State |
        s.mode = Normal =>
            all u: User |
                all r1, r2: Role |
                    r2 in r1.mutexWith =>
                        not (r1 in s.userRoles[u] and r2 in s.userRoles[u])
}

// --- EMERGENCY MODULE GLOBAL FACTS ---

fact EmergencyPrivsOnlyDuringEmergency {
    all s: State | all a: Administrator |
        some s.emergencyPrivs[a] implies s.mode = Emergency
}

fact EmergencyPrivsRevokedAtExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | no s2.emergencyPrivs[a]
}

fact DelegationRevokedAtEmergencyExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = True => d not in s2.activeDelegations
}

fact DelegationRetainedAfterEmergencyIfNotDuring {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = False => (d in s2.activeDelegations iff d in s.activeDelegations)
}

// --- MODE TRANSITION AND ACTIVATION FACTS ---

fact EmergencyActivation {
    // Emergency mode can only be entered from Normal by joint act of exactly two admins
    all s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] =>
            some a1, a2: Administrator | a1 != a2
}

fact EmergencyDurationAndDeactivation {
    // Emergency mode is only active for finite, fixed period; must return to Normal
    all s: State |
        s.mode = Emergency =>
            some s2: State | Next[s, s2] and s2.mode = Normal
}

// --- PROSPECTIVE REQUIREMENTS (Emergency Module) ---

// R1: Emergency Activation
pred R1 {
    some s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] and
        some a1, a2: Administrator | a1 != a2
}

// R2: Emergency Duration and Deactivation
pred R1R2 {
    R1 and
    all s: State |
        s.mode = Emergency =>
            some s2: State | Next[s, s2] and s2.mode = Normal
}

// R3: Emergency Mode Operational Changes
pred R1R2R3 {
    R1R2 and
    // R3.1: FIFO may be bypassed for high-classification requests during Emergency
    all s: State |
        s.mode = Emergency =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            some high implies (
                all r: Request | (s.reqStatus[r] = Pending and s.reqStatus[r] = Processed) => r in high
            )
    // R3.2: During Emergency, users may hold mutually exclusive roles
    and
    all s: State |
        s.mode = Emergency =>
            some u: User, r1, r2: Role | r1 != r2 and r2 in r1.mutexWith and r1 in s.userRoles[u] and r2 in s.userRoles[u]
    // R3.3: Administrators temporarily gain EmergencyPrivilege (enforced in facts)
}

// R4: Emergency Deactivation Effects
pred R1R2R3R4 {
    R1R2R3 and
    // EmergencyPrivilege revoked at Emergency exit (fact)
    // Delegated roles assigned during Emergency are revoked at exit (fact)
    // Delegated roles assigned before Emergency are not revoked (fact)
    // R4.3: Administrators must update their credentials after Emergency exit
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | s2.adminCredUpdated[a] = True
}

// --- PREDICATE: All Requirements ---
pred All_Requirements { R1R2R3R4 }

// --- BASELINE PREDICATE (Existing System Only) ---
pred baseline {}

// --- ASSERTIONS FOR VERIFICATION ---

// Mutual exclusion negative property: In Normal, no user ever holds mutex pair
assert assertMutexNegative {
    all s: State |
        s.mode = Normal =>
            all u: User, r1, r2: Role |
                r2 in r1.mutexWith =>
                    not (r1 in s.userRoles[u] and r2 in s.userRoles[u])
}

// EmergencyPrivilege only granted during Emergency
assert assertEmergencyPrivsOnlyDuringEmergency {
    all s: State |
        all a: Administrator |
            some s.emergencyPrivs[a] implies s.mode = Emergency
}

// EmergencyPrivilege always revoked at Emergency exit
assert assertEmergencyPrivsRevokedAtExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | no s2.emergencyPrivs[a]
}

// Delegated roles during Emergency revoked at exit
assert assertDelegationRevokedAtEmergencyExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = True => d not in s2.activeDelegations
}

// Delegated roles from before Emergency not revoked at exit
assert assertDelegationRetainedAfterEmergencyIfNotDuring {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = False => (d in s2.activeDelegations iff d in s.activeDelegations)
}

// --- NEW ASSERTIONS: REQUEST STATUS, FIFO, PROCESSOR, CLEARANCE, PERSISTENCE ---

assert assertRequestStatusMonotonic {
    all s, s2: State, r: Request |
        Next[s, s2] =>
            (s.reqStatus[r] = Processed) => (s2.reqStatus[r] = Processed)
}

assert assertNormalModeFIFO {
    all s, s2: State |
        s.mode = Normal and s2.mode = Normal and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let first = firstPendingFIFO[s] |
            all r: Request |
                (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r = first
}

assert assertEmergencyProcessingPriority {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            let med = {r: Request | r in pending and requestClassification[r] = Medium} |
            let low = {r: Request | r in pending and requestClassification[r] = Low} |
            (
                (some high and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in high) or
                (no high and some med and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in med) or
                (no high and no med and some low and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in low)
            )
}

assert assertRequestProcessorClearance {
    all s: State, r: Request |
        s.reqStatus[r] = Processed and some s.reqProcessor[r] =>
            let proc = s.reqProcessor[r], rc = requestClassification[r] |
                (proc in User) and
                (some c1, c2: Clearance | proc.clearance = c1 and rc = c2 and
                    (c1 = High or (c1 = Medium and (rc = Medium or rc = Low)) or (c1 = Low and rc = Low))
                )
}

assert assertRoleAssignmentClearance {
    all s: State, u: User, r: Role |
        r in s.userRoles[u] => leqClearance[r.minClearance, u.clearance]
}

assert assertRolePersistence {
    all s, s2: State | 
        Next[s, s2] =>
            all u: User, r: Role |
                (r in s.userRoles[u] and not isRoleRevoked[s, s2, u, r]) => r in s2.userRoles[u]
}

// --- POSSIBILITY PREDICATE (for Emergency mutex) ---

// It is possible for a user to hold mutually exclusive roles during Emergency
pred MutexPossibleDuringEmergency {
    some s: State | 
        s.mode = Emergency and 
        some u: User, r1, r2: Role | 
            r2 in r1.mutexWith and 
            r1 in s.userRoles[u] and 
            r2 in s.userRoles[u]
}

// --- RUN COMMANDS (Verification Order) ---

run baseline
run All_Requirements
run R1
run R1R2
run R1R2R3
run R1R2R3R4

run MutexPossibleDuringEmergency

check assertMutexNegative
check assertEmergencyPrivsOnlyDuringEmergency
check assertEmergencyPrivsRevokedAtExit
check assertDelegationRevokedAtEmergencyExit
check assertDelegationRetainedAfterEmergencyIfNotDuring
check assertRequestStatusMonotonic
check assertNormalModeFIFO
check assertEmergencyProcessingPriority
check assertRequestProcessorClearance
check assertRoleAssignmentClearance
check assertRolePersistence
