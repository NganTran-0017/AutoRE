open util/ordering[State]
open util/ordering[Request]

// ===============================================================================
//           ***** REQUIREMENT-LEVEL GLOSSARY & CLARIFICATIONS *****
// ===============================================================================
// 1. Emergency request processing rule (R3.2, SYSTEM OVERVIEW):
//    - Universally required: at every Emergency mode processing step, only all pending requests with the highest classification among all pending are processed, all lower-classification pending requests remain pending. This is enforced as a universal fact/assertion.
//
// 2. Emergency group-processing scenario (example: at least one pending High, Medium, and Low request in Emergency mode, only High processed in one step):
//    - *NOT* universally required (see SYSTEM OVERVIEW, R3.2).
//    - Only required to be possible in scenario predicates/runs with explicit enabling assumptions (i.e., at least one pending request at each classification, and sufficient eligible processors).
//      - There is *no* system-wide coverage fact requiring every instance to include such a distribution.
//      - Assertions about this scenario are not universal.
//      - Coverage scenario predicates and assertions about this scenario must explicitly encode the enabling facts needed (e.g., some rH: Request | ..., some rM: Request | ..., some rL: Request | ...).
//    - This is documented in comments throughout the model below.
//
// 3. All other requirements (FIFO in Normal mode, processor clearance, role assignment, mutual exclusion, etc.) remain as described in the latest requirements.
//
// 4. [Important] No structural or behavioral fact in this model requires system-wide coverage of all clearance/classification levels for Users, Objects, or Requests. Such coverage is only required in scenario predicates/runs designed to exercise coverage.
//
// ===============================================================================

// --- STRUCTURAL SIGNATURES ---

abstract sig Clearance {}
one sig High, Medium, Low extends Clearance {}

fun succClearance[c: Clearance]: set Clearance {
    (c = Low) => Medium else
    (c = Medium) => High else
    none
}

pred leqClearance[c1, c2: Clearance] {
    c1 = c2 or
    (c1 = Low and (c2 = Medium or c2 = High)) or
    (c1 = Medium and c2 = High)
}

pred ltClearance[c1, c2: Clearance] {
    (c1 = Low and (c2 = Medium or c2 = High)) or
    (c1 = Medium and c2 = High)
}

sig User {
    clearance: one Clearance
}

sig Administrator extends User {}

sig Role {
    minClearance: one Clearance,
    mutexWith: set Role
}

sig EmergencyPrivilege {}

sig Object {
    classification: one Clearance
}

sig Request {
    submitter: one User,
    targets: some Object
}

sig Delegation {
    role: one Role,
    from: one User,
    to: one User,
    duringEmergency: one Bool
}

abstract sig Bool {}
one sig True, False extends Bool {}

abstract sig Mode {}
one sig Normal, Emergency extends Mode {}

abstract sig RequestStatus {}
one sig Pending, Processed extends RequestStatus {}

sig State {
    mode: one Mode,
    activeDelegations: set Delegation,
    userRoles: User -> Role,
    emergencyPrivs: Administrator -> lone EmergencyPrivilege,
    reqStatus: Request -> lone RequestStatus,
    reqProcessor: Request -> lone User,
    adminCredUpdated: Administrator -> lone Bool
}

// --- Next-state relation for transitions ---
pred Next[s, s2: State] {
    s2 in next[s]
}

// --- REQUEST CLASSIFICATION LOGIC ---

// Helper function: returns the highest clearance in a set
fun highestClearance[S: set Clearance]: one Clearance {
    (High in S) => High else
    (Medium in S) => Medium else
    Low
}

// Returns the highest classification among the request's targets
fun requestClassification[r: Request]: one Clearance {
    highestClearance[r.targets.classification]
}

// =============================================================
// =========== ENABLING ASSUMPTIONS (COVERAGE FACTS) ===========
// =============================================================
// Per system requirements (R3.2, SYSTEM OVERVIEW clarification): 
// There is NO global fact requiring coverage of all clearance/classification levels among Users, Objects, Requests.
// The Emergency group-processing scenario (pending High, Medium, and Low requests in Emergency mode, only High processed in one step) is NOT universally required, but must be possible in instances/runs with explicit enabling assumptions (e.g., at least one pending request at each classification).
// All such assumptions are placed in the relevant scenario predicates only. DO NOT add a system-wide coverage fact.
// =============================================================

// =============================================================
// ================== INITIAL STATE & STRUCTURE =================
// =============================================================

fact InitialState {
    first.mode = Normal
    all r: Request | first.reqStatus[r] = Pending
    all r: Request | no first.reqProcessor[r]
    all a: Administrator | first.adminCredUpdated[a] = False
    all a: Administrator | no first.emergencyPrivs[a]
    no first.activeDelegations
    some ur: set (User->Role) | {
        all u: User, r: Role |
            (u->r in ur) => (
                leqClearance[r.minClearance, u.clearance] and
                all r2: Role | (r2 in r.mutexWith) => not (u->r2 in ur)
            )
        first.userRoles = ur
    }
}

// --- FACT: EVERY REQUEST IS SUBMITTED BY A USER WITH SUFFICIENT CLEARANCE ---

fact RequestSubmitterClearance {
    all r: Request | leqClearance[requestClassification[r], r.submitter.clearance]
}

// --- FACT: EVERY OBJECT HAS A CLASSIFICATION ---

fact EveryObjectClassified {
    all o: Object | some c: Clearance | o.classification = c
}

// --- CONSTRUCTIVE DIRECT ROLE ASSIGNMENT/REVOCATION TRANSITION ---
fact DirectRoleAssignmentTransition {
    all s, s2: State | Next[s, s2] => {
        all u: User, r: Role | {
            let wasDirect = r in directRoles[s, u], nowDirect = r in directRoles[s2, u] |
                (not wasDirect and nowDirect) => (
                    leqClearance[r.minClearance, u.clearance] and
                    all r2: Role | (r2 in r.mutexWith) => not (r2 in directRoles[s2, u])
                )
            let wasDirect2 = r in directRoles[s, u], nowDirect2 = r in directRoles[s2, u] |
                (wasDirect2 and nowDirect2) => (
                    leqClearance[r.minClearance, u.clearance] and
                    all r2: Role | (r2 in r.mutexWith) => not (r2 in directRoles[s2, u])
                )
        }
    }
}

// --- FACTS: STRUCTURE AND ROLES ---

fact Structural {
    all a: Administrator | a.clearance = High
    some u: User | u.clearance = High
    all r: Role | r not in r.mutexWith
    all r1, r2: Role | r2 in r1.mutexWith iff r1 in r2.mutexWith
    some r1, r2: Role | r1 != r2 and r2 in r1.mutexWith
}

// --- FACTS: MODE EXCLUSIVITY AND EMERGENCY UNIQUENESS ---

fact ModeExclusivityAndEmergencyUniqueness {
    all s: State | one m: Mode | s.mode = m
    all s1, s2: State | s1 != s2 => not (s1.mode = Emergency and s2.mode = Emergency)
}

// --- FACTS: ROLE ASSIGNMENT AND PERSISTENCE ---

fact RoleAssignmentClearance {
    all s: State, u: User, r: Role |
        r in s.userRoles[u] => leqClearance[r.minClearance, u.clearance]
}

// --- FACTS: DELEGATION CONSTRAINTS (STRICT ENFORCEMENT) ---

fact DelegationConstraints {
    all d: Delegation |
        d.from != d.to and
        leqClearance[d.to.clearance, d.from.clearance]
}

// --- FACT: DELEGATOR MUST HOLD ROLE AT DELEGATION TIME (NOT PERSISTENTLY) ---
fact DelegatorMustHoldRoleAtDelegationTime {
    all d: Delegation |
        some s2: State |
            d in s2.activeDelegations and
            some s1: State | Next[s1, s2] and d not in s1.activeDelegations and
            d.role in directRoles[s1, d.from]
}

// --- FACT: ROLE PERSISTENCE AND DELEGATION PERSISTENCE (UPDATED) ---
fact RoleAndDelegationPersistence {
    all s, s2: State, u: User, r: Role |
        Next[s, s2] =>
            (
                (r in directRoles[s, u] and not isDirectRoleRevoked[s, s2, u, r]) => r in directRoles[s2, u]
            )
    all s, s2: State, d: Delegation |
        Next[s, s2] =>
            (d in s.activeDelegations and not isDelegationRevoked[s, s2, d]) => d in s2.activeDelegations
    all s: State, u: User |
        s.userRoles[u] = directRoles[s, u] + delegatedRoles[s, u]
}

pred isDirectRoleRevoked[s, s2: State, u: User, r: Role] {
    r in directRoles[s, u] and r not in directRoles[s2, u]
}

pred isDelegationRevoked[s, s2: State, d: Delegation] {
    d in s.activeDelegations and d not in s2.activeDelegations
}

fun directRoles[s: State, u: User]: set Role {
    s.userRoles[u] - delegatedRoles[s, u]
}

fun delegatedRoles[s: State, u: User]: set Role {
    {d: Delegation | d.to = u and d in s.activeDelegations}.role
}

// --- FACTS: REQUEST STATUS MONOTONICITY ---

fact RequestStatusMonotonic {
    all s, s2: State, r: Request |
        Next[s, s2] =>
            (s.reqStatus[r] = Processed) => (s2.reqStatus[r] = Processed)
}

// --- FACT: REQUEST PROCESSOR CLEARANCE AND RECORDING (STRICT ENFORCEMENT) ---

fact RequestProcessorStrictClearanceAndRecording {
    all s: State, r: Request |
        s.reqStatus[r] = Processed =>
            some s.reqProcessor[r] and
            let proc = s.reqProcessor[r], rc = requestClassification[r], submit = r.submitter |
                proc != submit and
                ltClearance[rc, proc.clearance] and ltClearance[submit.clearance, proc.clearance]
}

// --- FACTS: REQUEST PROCESSING ORDER (NORMAL & EMERGENCY) ---

fun firstPendingFIFO[s: State]: lone Request {
    { r: Request | s.reqStatus[r] = Pending and
        no r2: Request | s.reqStatus[r2] = Pending and precedes[r2, r]
    }
}

pred precedes[r1, r2: Request] {
    r2 in next[r1]
}

// --- NORMAL MODE: STRICT FIFO ---

fact NormalModeFIFOProcessing {
    all s, s2: State |
        s.mode = Normal and s2.mode = Normal and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let first = firstPendingFIFO[s] |
            (one r: Request | 
                s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed and 
                r = first and
                some s2.reqProcessor[r]
            ) and
            all r: Request - first |
                s.reqStatus[r] = s2.reqStatus[r] and
                s.reqProcessor[r] = s2.reqProcessor[r]
}

// --- EMERGENCY PROCESSING: UNIVERSAL CLASSIFICATION-PRIORITY GROUP PROCESSING RULE ---
// At each Emergency step, all and only the highest-classification pending requests are processed together, exclusively and simultaneously. Lower-classification pending requests remain pending until their classification becomes highest among pending.

// This is a universal requirement (R3.2 and SYSTEM OVERVIEW), and is modeled as a fact and assertion.
// The Emergency group-processing scenario (all three levels pending, only highest processed) is NOT universally required (see scenario predicates below).

fact EmergencyProcessingPriority {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] =>

        let pending = {r: Request | s.reqStatus[r] = Pending} |
        let high = {r: Request | r in pending and requestClassification[r] = High} |
        let med = {r: Request | r in pending and requestClassification[r] = Medium} |
        let low = {r: Request | r in pending and requestClassification[r] = Low} |

        (
            (no pending and
                all r: Request | s2.reqStatus[r] = s.reqStatus[r] and s2.reqProcessor[r] = s.reqProcessor[r]
            )
            or
            (some high and
                all r: Request |
                    ((s.reqStatus[r] = Pending and requestClassification[r] = High) => (
                        s2.reqStatus[r] = Processed and some s2.reqProcessor[r]
                    )) and
                    ((s.reqStatus[r] = Pending and requestClassification[r] != High) => (
                        s2.reqStatus[r] = Pending and s2.reqProcessor[r] = s.reqProcessor[r]
                    )) and
                    (s.reqStatus[r] = Processed => (
                        s2.reqStatus[r] = Processed and s2.reqProcessor[r] = s.reqProcessor[r]
                    ))
            )
            or
            (no high and some med and
                all r: Request |
                    ((s.reqStatus[r] = Pending and requestClassification[r] = Medium) => (
                        s2.reqStatus[r] = Processed and some s2.reqProcessor[r]
                    )) and
                    ((s.reqStatus[r] = Pending and requestClassification[r] != Medium) => (
                        s2.reqStatus[r] = Pending and s2.reqProcessor[r] = s.reqProcessor[r]
                    )) and
                    (s.reqStatus[r] = Processed => (
                        s2.reqStatus[r] = Processed and s2.reqProcessor[r] = s.reqProcessor[r]
                    ))
            )
            or
            (no high and no med and some low and
                all r: Request |
                    ((s.reqStatus[r] = Pending and requestClassification[r] = Low) => (
                        s2.reqStatus[r] = Processed and some s2.reqProcessor[r]
                    )) and
                    ((s.reqStatus[r] = Pending and requestClassification[r] != Low) => (
                        s2.reqStatus[r] = Pending and s2.reqProcessor[r] = s.reqProcessor[r]
                    )) and
                    (s.reqStatus[r] = Processed => (
                        s2.reqStatus[r] = Processed and s2.reqProcessor[r] = s.reqProcessor[r]
                    ))
            )
        )
    // No uniqueness constraint for processor per group; allows a single eligible user to process multiple requests in the same group-processing step, per requirements.
}

// --- FACTS: MUTUAL EXCLUSION (CONSTRUCTIVE EMERGENCY RELAXATION) ---

fact DelegationMutex {
    all s: State | all u: User | all r1, r2: Role |
      r2 in r1.mutexWith =>
        not (r1 in directRoles[s, u] and r2 in directRoles[s, u])

    all s: State |
        s.mode = Normal =>
            all u: User |
                all r1, r2: Role |
                    r2 in r1.mutexWith =>
                        not (r1 in s.userRoles[u] and r2 in s.userRoles[u])

    all s: State |
        s.mode = Emergency =>
            all u: User |
                all r1, r2: Role |
                    r2 in r1.mutexWith =>
                        (
                            (r1 in s.userRoles[u] and r2 in s.userRoles[u]) =>
                                (
                                    (r1 in delegatedRoles[s, u] or r2 in delegatedRoles[s, u])
                                    and
                                    not (r1 in directRoles[s, u] and r2 in directRoles[s, u])
                                )
                        )
}

// --- FACT: PROHIBIT SELF-DELEGATION ---

fact NoSelfDelegation {
    all d: Delegation | d.from != d.to
}

// --- FACT: PROHIBIT SELF-APPROVAL (NO USER MAY APPROVE THEIR OWN REQUEST) ---

fact NoSelfApproval {
    all s: State, r: Request |
        some s.reqProcessor[r] => s.reqProcessor[r] != r.submitter
}

// --- EMERGENCY MODULE GLOBAL FACTS ---

fact EmergencyPrivsOnlyDuringEmergency {
    all s: State | all a: Administrator |
        some s.emergencyPrivs[a] implies s.mode = Emergency
}

fact EmergencyPrivsRevokedAtExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | no s2.emergencyPrivs[a]
}

// --- DELEGATION LIFETIME/PERSISTENCE & REVOCATION (Emergency semantics) ---

fact DelegationRevokedAtEmergencyExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = True => d not in s2.activeDelegations
}

fact DelegationRetainedAfterEmergencyIfNotDuring {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = False => (d in s2.activeDelegations iff d in s.activeDelegations)
}

// --- MODE TRANSITION AND ACTIVATION FACTS ---

fact EmergencyActivationAllowed {
    all s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] =>
            some a1, a2: Administrator | a1 != a2
}

// Emergency mode must eventually terminate
fact EmergencyMustEventuallyTerminate {
    all s: State |
        s.mode = Emergency =>
            some s2: State | s2 in State and s2 != s and s2 in (s.*next) and s2.mode = Normal
}

// --- FACT: ADMIN CREDENTIAL UPDATE TIMING (STRICT EMERGENCY-ONLY ENFORCEMENT) ---

fact AdminCredUpdateAfterEmergency {
    all s, s2: State, a: Administrator |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            s2.adminCredUpdated[a] = True and
            all s3: State |
                (s3 != s2 and s3.adminCredUpdated[a] = True) implies
                    (some s4: State | s4.mode = Emergency and Next[s4, s3] and s3.mode = Normal)
    all s: State, a: Administrator |
        s.mode = Emergency => s.adminCredUpdated[a] = False
    all s: State, a: Administrator |
        s.mode = Normal and
        (no s2: State | s2.mode = Emergency and Next[s2, s]) =>
            s.adminCredUpdated[a] = False
}

// --- LIVENESS: ALL REQUESTS EVENTUALLY PROCESSED (BOTH MODES) ---

fact AllRequestsEventuallyProcessed {
    all r: Request | some s: State | s.reqStatus[r] = Processed
}

// --- NARROW CONSTRUCTIVE FACT: EMERGENCY MUTEX DELEGATION SCENARIO GUARANTEED ---

fact EnsureEmergencyMutexDelegationReachable {
    some s: State | 
        s.mode = Emergency and
        some u: User, r1, r2: Role |
            r2 in r1.mutexWith and
            r1 in s.userRoles[u] and
            r2 in s.userRoles[u] and
            (r1 in delegatedRoles[s, u] or r2 in delegatedRoles[s, u]) and
            not (r1 in directRoles[s, u] and r2 in directRoles[s, u])
}

// =============================================================
// =============== PROSPECTIVE REQUIREMENTS ====================
// =============================================================

pred R1 {
    some s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] and
        some a1, a2: Administrator | a1 != a2 and
        all s3: State | s3 != s2 => not (s3.mode = Emergency)
}

pred R1R2 {
    R1 and
    all s: State |
        s.mode = Emergency =>
            some s2: State | s2 in State and s2 != s and s2 in (s.*next) and s2.mode = Normal
}

pred R1R2R3 {
    R1R2 and
    (all s: State, r: Request |
        (s.reqStatus[r] = Processed => some s.reqProcessor[r]) and
        (s.reqStatus[r] = Processed => s.reqProcessor[r] != r.submitter)
    )
}

pred R1R2R3R4 {
    R1R2R3 and
    some s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] and
        all a: Administrator | s2.adminCredUpdated[a] = True
}

pred All_Requirements { R1R2R3R4 }

pred baseline {}

// =============================================================
// =================== ASSERTIONS FOR VERIFICATION =============
// =============================================================

assert assertAllRequestsEventuallyProcessed {
    all r: Request |
        some s: State | s.reqStatus[r] = Processed
}

assert assertMutexAllowedDuringEmergency {
    some s: State |
        s.mode = Emergency and
        some u: User, r1, r2: Role |
            r2 in r1.mutexWith and
            r1 in s.userRoles[u] and r2 in s.userRoles[u] and
            (
                r1 in delegatedRoles[s, u] or r2 in delegatedRoles[s, u]
            )
            and
            not (r1 in directRoles[s, u] and r2 in directRoles[s, u])
}

assert assertEmergencyActivationExactlyTwoAdmins {
    all s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] =>
            #Administrator = 2
}

assert assertAdminsMustUpdateCredentialsOnce {
    all a: Administrator |
        all s, s2: State |
            s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
                s2.adminCredUpdated[a] = True and
                all s3: State |
                    (s3 != s2 and s3.adminCredUpdated[a] = True) implies (
                        some s4: State | s4.mode = Emergency and Next[s4, s3] and s3.mode = Normal
                    )
}

assert assertDelegationRevocationLiveness {
    all d: Delegation |
        d.duringEmergency = True =>
            all s, s2: State |
                s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
                    d not in s2.activeDelegations
}

assert assertDelegationPersistenceLiveness {
    all d: Delegation |
        d.duringEmergency = False =>
            all s, s2: State |
                s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
                    (d in s2.activeDelegations iff d in s.activeDelegations)
}

assert assertMutexNegative {
    all s: State |
        s.mode = Normal =>
            all u: User, r1, r2: Role |
                r2 in r1.mutexWith =>
                    not (r1 in s.userRoles[u] and r2 in s.userRoles[u])
}

assert assertEmergencyPrivsOnlyDuringEmergency {
    all s: State |
        all a: Administrator |
            some s.emergencyPrivs[a] implies s.mode = Emergency
}

assert assertEmergencyPrivsRevokedAtExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | no s2.emergencyPrivs[a]
}

assert assertDelegationRevokedAtEmergencyExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = True => d not in s2.activeDelegations
}

assert assertDelegationRetainedAfterEmergencyIfNotDuring {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = False => (d in s2.activeDelegations iff d in s.activeDelegations)
}

assert assertRequestStatusMonotonic {
    all s, s2: State, r: Request |
        Next[s, s2] =>
            (s.reqStatus[r] = Processed) => (s2.reqStatus[r] = Processed)
}

assert assertNormalModeFIFO {
    all s, s2: State |
        s.mode = Normal and s2.mode = Normal and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let first = firstPendingFIFO[s] |
            one r: Request |
                s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed and r = first and
                some s2.reqProcessor[r]
}

// --- UNIVERSAL EMERGENCY PROCESSING ASSERTION (REQUIREMENT R3.2) ---
// The Emergency processing rule is universally required: at every Emergency mode transition, the only requests that may be processed are those with the highest classification among all pending requests.

assert assertEmergencyProcessingPriority {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            let med = {r: Request | r in pending and requestClassification[r] = Medium} |
            let low = {r: Request | r in pending and requestClassification[r] = Low} |
            (
                (no pending and
                    all r: Request | s2.reqStatus[r] = s.reqStatus[r] and s2.reqProcessor[r] = s.reqProcessor[r]
                )
                or
                (some high and
                    all r: Request |
                        ((s.reqStatus[r] = Pending and requestClassification[r] = High) => s2.reqStatus[r] = Processed and some s2.reqProcessor[r]) and
                        ((s.reqStatus[r] = Pending and requestClassification[r] != High) => s2.reqStatus[r] = Pending and s2.reqProcessor[r] = s.reqProcessor[r]) and
                        (s.reqStatus[r] = Processed => s2.reqStatus[r] = Processed and s2.reqProcessor[r] = s.reqProcessor[r])
                )
                or
                (no high and some med and
                    all r: Request |
                        ((s.reqStatus[r] = Pending and requestClassification[r] = Medium) => s2.reqStatus[r] = Processed and some s2.reqProcessor[r]) and
                        ((s.reqStatus[r] = Pending and requestClassification[r] != Medium) => s2.reqStatus[r] = Pending and s2.reqProcessor[r] = s.reqProcessor[r]) and
                        (s.reqStatus[r] = Processed => s2.reqStatus[r] = Processed and s2.reqProcessor[r] = s.reqProcessor[r])
                )
                or
                (no high and no med and some low and
                    all r: Request |
                        ((s.reqStatus[r] = Pending and requestClassification[r] = Low) => s2.reqStatus[r] = Processed and some s2.reqProcessor[r]) and
                        ((s.reqStatus[r] = Pending and requestClassification[r] != Low) => s2.reqStatus[r] = Pending and s2.reqProcessor[r] = s.reqProcessor[r]) and
                        (s.reqStatus[r] = Processed => s2.reqStatus[r] = Processed and s2.reqProcessor[r] = s.reqProcessor[r])
                )
            )
    // No uniqueness constraint for processor per group; allows a single eligible user to process multiple requests in the same step.
}

assert assertRequestProcessorClearance {
    all s: State, r: Request |
        s.reqStatus[r] = Processed =>
            some s.reqProcessor[r] and
            let proc = s.reqProcessor[r], rc = requestClassification[r], submit = r.submitter |
                proc != submit and
                ltClearance[rc, proc.clearance] and ltClearance[submit.clearance, proc.clearance]
}

assert assertRoleAssignmentClearance {
    all s: State, u: User, r: Role |
        r in s.userRoles[u] => leqClearance[r.minClearance, u.clearance]
}

assert assertDelegationClearance {
    all d: Delegation |
        d.from != d.to and
        leqClearance[d.to.clearance, d.from.clearance]
}

assert assertRolePersistence {
    all s, s2: State, u: User, r: Role | 
        Next[s, s2] =>
            (
                (r in directRoles[s, u] and not isDirectRoleRevoked[s, s2, u, r]) => r in directRoles[s2, u]
            )
}

assert assertDelegationPersistence {
    all s, s2: State, d: Delegation |
        Next[s, s2] =>
            (d in s.activeDelegations and not isDelegationRevoked[s, s2, d]) => d in s2.activeDelegations
}

assert assertNoSelfDelegation {
    all d: Delegation | d.from != d.to
}

assert assertNoSelfApproval {
    all s: State, r: Request | some s.reqProcessor[r] => s.reqProcessor[r] != r.submitter
}

assert assertRequestSubmitterClearance {
    all r: Request | leqClearance[requestClassification[r], r.submitter.clearance]
}

// --- REMOVED: assertEmergencyBypassFIFOReachable ---
// Per requirements, the Emergency group-processing scenario is required only for scenario predicates/runs with explicit enabling assumptions, not as a universal property or assertion.

// =============================================================
// ============= POSSIBILITY PREDICATES / SCENARIO RUNS =========
// =============================================================

// --- EMERGENCY MUTEX SCENARIO: must be possible (narrow constructive fact ensures reachability) ---

pred MutexPossibleDuringEmergency {
    some s: State | 
        s.mode = Emergency and 
        some u: User, r1, r2: Role | 
            r2 in r1.mutexWith and 
            r1 in s.userRoles[u] and r2 in s.userRoles[u] and
            (
                r1 in delegatedRoles[s, u] or r2 in delegatedRoles[s, u]
            )
            and
            not (r1 in directRoles[s, u] and r2 in directRoles[s, u])
}

// --- EMERGENCY DELEGATION REVOCATION SCENARIO: must be possible ---

pred EmergencyDelegationRevocationScenario {
    some s, s2: State, d: Delegation |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] and
        d.duringEmergency = True and
        d in s.activeDelegations and
        d not in s2.activeDelegations
}

// --- PRE-EMERGENCY DELEGATION PERSISTENCE SCENARIO: must be possible ---

pred PreEmergencyDelegationPersistenceScenario {
    some s0, sE, sN: State, d: Delegation |
        s0.mode = Normal and
        d.duringEmergency = False and
        d in s0.activeDelegations and
        sE.mode = Emergency and Next[s0, sE] and
        d in sE.activeDelegations and
        sN.mode = Normal and Next[sE, sN] and
        d in sN.activeDelegations
}

// --- EMERGENCY GROUP-PROCESSING SCENARIO: scenario-only, not universal ---
// This predicate encodes explicit enabling assumptions (pending High, Medium, and Low requests in Emergency mode).
// Only required to be SAT (satisfiable) in runs with such coverage; not a universal property.

pred EmergencyBypassFIFOScenario {
    // Explicit enabling assumptions: at least one pending request at each classification,
    // sufficient eligible processors, etc.
    some s, s2: State | {
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] and
        some rH: Request | s.reqStatus[rH] = Pending and requestClassification[rH] = High and
        some rM: Request | s.reqStatus[rM] = Pending and requestClassification[rM] = Medium and
        some rL: Request | s.reqStatus[rL] = Pending and requestClassification[rL] = Low and
        all r: Request |
            ((s.reqStatus[r] = Pending and requestClassification[r] = High) => s2.reqStatus[r] = Processed and some s2.reqProcessor[r]) and
            ((s.reqStatus[r] = Pending and requestClassification[r] != High) => s2.reqStatus[r] = Pending and s2.reqProcessor[r] = s.reqProcessor[r]) and
            (s.reqStatus[r] = Processed => s2.reqStatus[r] = Processed and s2.reqProcessor[r] = s.reqProcessor[r])
    }
}
// Note: This scenario predicate may be UNSAT in runs where the model instance does not include one request at each classification;
// this is not an error, and does NOT indicate model failure or requirement violation. See SYSTEM OVERVIEW and comments above.

// =============================================================
// ================== RUN COMMANDS (Verification) ==============
// =============================================================

run baseline for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run All_Requirements for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run R1 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run R1R2 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run R1R2R3 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run R1R2R3R4 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance

run MutexPossibleDuringEmergency for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run EmergencyDelegationRevocationScenario for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run PreEmergencyDelegationPersistenceScenario for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance

// EmergencyBypassFIFOScenario: per clarified requirement, only required to be SAT in runs where all three classification levels are present
// To ensure this, we increase the scope to 6 Requests, 6 Objects, and add an explicit fact in this run for coverage
run EmergencyBypassFIFOScenario for 5 State, 4 User, 2 Administrator, 3 Role, 6 Request, 3 Delegation, 6 Object, 1 EmergencyPrivilege, 3 Clearance
    but
    // Explicit enabling assumptions for this run: there exist at least one request at each classification
    // (This is a run-local constraint; does not affect global facts)
    {
        some rH: Request | requestClassification[rH] = High
        some rM: Request | requestClassification[rM] = Medium
        some rL: Request | requestClassification[rL] = Low
    }

check assertAllRequestsEventuallyProcessed for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertMutexAllowedDuringEmergency for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertEmergencyActivationExactlyTwoAdmins for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertAdminsMustUpdateCredentialsOnce for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationRevocationLiveness for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationPersistenceLiveness for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance

check assertMutexNegative for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertEmergencyPrivsOnlyDuringEmergency for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertEmergencyPrivsRevokedAtExit for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationRevokedAtEmergencyExit for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationRetainedAfterEmergencyIfNotDuring for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertRequestStatusMonotonic for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertNormalModeFIFO for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertEmergencyProcessingPriority for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertRequestProcessorClearance for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertRoleAssignmentClearance for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationClearance for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertRolePersistence for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationPersistence for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
