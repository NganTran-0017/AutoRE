sig State {
    mode: one SystemMode,
    emAdmins: set Administrator, // Admins who triggered Emergency (empty in Normal)
    requests: set Request,
    delegations: set Delegation,
    emPrivs: set EmergencyPrivilege,
    needsCredentialUpdate: set Administrator
}

// ===== EXISTING SYSTEM FACTS =====

// Admins always have High clearance and isAdmin = True
fact AdminDefinition {
    all a: Administrator | a.clearance = High and a.isAdmin = True
}

// Emergency can only be entered if exactly two Admins present and both jointly trigger entry
fact EmergencyEntryConstraint {
    all s: State |
        // Emergency can only be entered from Normal
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (#(s.emAdmins) = 2 and all a: s.emAdmins | a in Administrator)
    // In all other states, emAdmins is empty
        else (s.mode = Normal => no s.emAdmins)
}

// Emergency cannot be entered unless there are at least two Administrators in the system
fact EmergencyEntryRequiresTwoAdmins {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            #(Administrator) >= 2
}

// EmergencyPrivilege granted only to the two emAdmins, only during Emergency, at state s
fact EmergencyPrivilegeAssignment {
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs |
                ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt)
            and
            (all a: s.emAdmins | some ep: s.emPrivs | ep.admin = a and ep.grantedAt = s)
        else
            no s.emPrivs
}

// Mutual exclusion is enforced except in Emergency mode
fact MutualExclusionEnforced {
    all s: State |
        s.mode = Normal =>
            all u: User |
                all r1, r2: Role |
                    (r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s] and r1 != r2) =>
                        not (r1 in r2.mutuallyExclusiveWith)
    // No mutual exclusion constraint enforced during Emergency
}

// Returns the set of Roles held by user u at state s
fun rolesHeld[u: User, s: State]: set Role {
    { r: Role |
        some d: s.delegations |
            d.delegatee = u and
            d.role = r and
            d.delegatedAt in pastOrEqual[s] and
            (no d.expiresAt or lt[s, d.expiresAt])
    }
}

// Returns all states up to and including s (for delegation activity checks)
fun pastOrEqual[s: State]: set State {
    { s2: State | lte[s2, s] }
}

// Highest classification of a set of objects
fun highestClass[os: set Object]: one ClassificationLevel {
    (some o: os | o.classification = C_High) => C_High
    else (some o: os | o.classification = C_Medium) => C_Medium
    else C_Low
}

// Request classification reflects highest classification of affected objects
fact RequestClassification {
    all req: Request |
        req.classification = highestClass[req.affects]
}

// FIFO enforced except for C_High requests during Emergency
fact FIFOEnforcedExceptEmergency {
    all s: State |
        s.mode = Normal => FIFOProcessing[s]
}

// Abstract predicate: requests processed in arrival order unless Emergency
pred FIFOProcessing[s: State] {}

// EMERGENCY MODE MUST ALWAYS BE TERMINATED EVENTUALLY (LIVENESS)
fact EmergencyLiveness {
    // In every trace, for every Emergency state, there is a later state in Normal mode
    all s: State |
        (s.mode = Emergency) => some s2: State | gt[s2, s] and s2.mode = Normal
}

// Delegation revocation: all delegations assigned during Emergency must be revoked immediately at Emergency->Normal transition
fact EmergencyDelegationRevocation {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => d.expiresAt = s
}

// Only the two emAdmins must update credentials after Emergency
fact EmergencyCredentialUpdate {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
}

// Delegations from before Emergency are not revoked automatically
fact DelegationsNotRevokedIfBeforeEmergency {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)
}

// ====== REQUIREMENT PREDICATES (incremental) ======

// R1: Emergency Trigger (two Admins, concurrent, from Normal, and only if possible)
pred R1 {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (#(Administrator) >= 2 and #(s.emAdmins) = 2 and all a: s.emAdmins | a in Administrator)
}

// R1 negative test: Emergency cannot be entered if fewer than two Admins
assert assertR1_Negative {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) => #(Administrator) >= 2
}

// Helper: previous mode is Normal
pred prevModeIsNormal[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Normal
}

// R2: Emergency Mode Duration (liveness) — system always returns to Normal
pred R1R2 {
    R1 and
    all s: State |
        (s.mode = Emergency) => some s2: State | gt[s2, s] and s2.mode = Normal
}

// R3: Emergency behavior (FIFO bypass, mutual exclusion suspended, em privileges granted)
pred R1R2R3 {
    R1R2 and

    // R3.1: FIFO can be bypassed for high-classification requests
    all s: State |
        (s.mode = Emergency) => bypassFIFOForHighClass[s]
    and

    // R3.2: Mutual exclusion is suspended in Emergency — scenario testable via predicate
    all s: State |
        (s.mode = Emergency) => notMutualExclusionDuringEmergency[s]
    and

    // R3.3: Only the two emAdmins have EmergencyPrivilege during Emergency
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs | ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt)
            and
            (all a: s.emAdmins | some ep: s.emPrivs | ep.admin = a and ep.grantedAt = s)
}

// Bypass FIFO for C_High requests during Emergency
pred bypassFIFOForHighClass[s: State] {
    all r: s.requests |
        (r.classification = C_High) => canBeProcessedOutOfOrder[r, s]
}

// During Emergency, C_High requests may be processed out of order
pred canBeProcessedOutOfOrder[r: Request, s: State] {
    r in s.requests and s.mode = Emergency and r.classification = C_High
}

// Mutual exclusion not enforced during Emergency (scenario only)
pred notMutualExclusionDuringEmergency[s: State] {
    // No exclusion constraint checked: rolesHeld may overlap mutually exclusive roles
}

// Scenario predicate: There is a state in Emergency where a user holds two mutually exclusive roles
pred Scenario_MutualExclusionSuspended {
    some s: State |
        s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// R4: Post-Emergency Restoration (immediate revocation, credential update for emAdmins only)
pred R1R2R3R4 {
    R1R2R3 and

    // R4.1: emAdmins lose EmergencyPrivilege immediately after Emergency
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all a: Time/prev[s].emAdmins | no ep: s.emPrivs | ep.admin = a

    and

    // R4.2: Only delegations assigned during Emergency are revoked when Emergency ends
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s)

    and

    // R4.2b: Delegations assigned before Emergency are NOT revoked at Emergency end
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)

    and

    // R4.3: Only the two emAdmins must update credentials after Emergency
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
}

// Helper: previous mode is Emergency
pred prevModeIsEmergency[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Emergency
}

// All requirements predicate
pred All_Requirements { R1R2R3R4 }

// ================== ASSERTIONS FOR VERIFICATION ==================

// R1: Emergency can only be entered if two Admins jointly trigger from Normal mode
assert assertR1 {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (#(s.emAdmins) = 2 and all a: s.emAdmins | a in Administrator)
}

// R1 Negative: Emergency CANNOT be entered if fewer than two Admins exist
assert assertR1_Negative {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) => #(Administrator) >= 2
}

// R2: Emergency mode is always exited (liveness)
assert assertR2 {
    all s: State |
        (s.mode = Emergency) => (some s2: State | gt[s2, s] and s2.mode = Normal)
}

// R3.2: There is a scenario where a user holds two mutually exclusive roles during Emergency
assert assertR3_MutExScenario {
    Scenario_MutualExclusionSuspended
}

// R4.1: After Emergency, all EmergencyPrivileges revoked from emAdmins
assert assertR4_1 {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all a: Time/prev[s].emAdmins | no ep: s.emPrivs | ep.admin = a
}

// R4.2: After Emergency, only Emergency-delegated roles are revoked
assert assertR4_2 {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => d.expiresAt = s
}

// R4.2b: After Emergency, delegations from before Emergency are NOT revoked at Emergency end
assert assertR4_2b {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)
}

// R4.3: Only emAdmins must update credentials after Emergency
assert assertR4_3 {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
}

// ================== RUN/CHECK COMMANDS (SCOPES) ==================

// Default: No minimum Admins, but test traces with >=2 Admins for Emergency
run R1 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
run R1R2 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
run R1R2R3 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
run R1R2R3R4 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
run All_Requirements for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

// Targeted scenario run: At least one user with two mutually exclusive roles during Emergency
run Scenario_MutualExclusionSuspended for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

check assertR1 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR1_Negative for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR2 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR3_MutExScenario for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_1 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_2 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_2b for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_3 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

// -- END OF MODEL --

// [EVENT]: Replaced persistent requirement for two Admins with transition-only Emergency entry guard.
// [EVENT]: Added explicit liveness fact for Emergency termination.
// [EVENT]: Added fact to enforce immediate revocation of Emergency-delegated roles upon Emergency exit.
// [EVENT]: Added scenario predicate (Scenario_MutualExclusionSuspended) for testing mutual exclusion suspension in Emergency.
// [EVENT]: Added negative assertion for Emergency entry with insufficient Admins.
// [EVENT]: Added assertion to ensure only pre-Emergency delegations survive Emergency exit.
// [EVENT]: Credential update post-Emergency now applies only to the two emAdmins.
// [EVENT]: Revised EmergencyPrivilege assignment to be only for the two emAdmins during Emergency.
// [LESSON]: Can't enforce minimum subset sig cardinality (e.g., "two Admins always exist") via scoping → Must enforce only via transition guards and facts.
// [LESSON]: Liveness requires explicit fact (not just a requirement predicate); otherwise, Alloy traces may allow Emergency mode to persist forever.
// [LESSON]: Alloy 6 does not allow scoping of subset sigs (e.g., "3 Administrator" is invalid); only top-level sigs may be scoped in run/check.
// [LESSON]: Mutual exclusion suspension must be tested via scenario predicate, not assumed as a universal property in all traces (prevents vacuity).
// [EVENT]: All facts and assertions now reflect the clarified requirements regarding Emergency triggers, restoration, and role revocation.
