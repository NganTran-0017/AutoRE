// ===== RBAC Emergency Model (Alloy 6, strict 2-distinct-emAdmins, positive/negative entry scenarios) =====

open util/ordering[State] as Time

// ===== ENUMS AND MODES =====

abstract sig Bool {}
one sig True, False extends Bool {}

abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig C_High, C_Medium, C_Low extends ClassificationLevel {}

abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// ===== CORE ENTITIES =====

sig User {
    clearance: one ClearanceLevel,
    isAdmin: one Bool
}

sig Administrator in User {}

sig Role {
    mutuallyExclusiveWith: set Role
}

sig Object {
    classification: one ClassificationLevel
}

sig Request {
    requestedBy: one User,
    affects: some Object,
    classification: one ClassificationLevel
}

sig Delegation {
    delegatee: one User,
    role: one Role,
    delegatedAt: one State,
    expiresAt: lone State
}

sig EmergencyPrivilege {
    admin: one Administrator,
    grantedAt: one State,
    revokedAt: lone State
}

// ===== SYSTEM STATE =====

sig State {
    mode: one SystemMode,
    emAdmins: set Administrator, // Admins who triggered Emergency (should always be exactly 2 distinct in Emergency)
    requests: set Request,
    delegations: set Delegation,
    emPrivs: set EmergencyPrivilege,
    needsCredentialUpdate: set Administrator
}

// ===== EXISTING SYSTEM FACTS =====

// Admins always have High clearance and isAdmin = True
fact AdminDefinition {
    all a: Administrator | a.clearance = High and a.isAdmin = True
}

// Emergency can only be entered from Normal, and only if there are exactly two distinct Administrators who jointly trigger it as emAdmins
fact EmergencyEntryConstraint {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (
                #s.emAdmins = 2 and
                all a: s.emAdmins | a in Administrator and
                // Must be two distinct (set semantics, #=2 suffices, but be explicit)
                s.emAdmins in Administrator and
                // Both present in system (by definition)
                #(Administrator) >= 2 and
                // No duplicate allowed (set of two distinct)
                all a1, a2: s.emAdmins | a1 != a2
            )
        else
            (s.mode = Normal => no s.emAdmins)
}

// Emergency mode entry is impossible unless there are at least two distinct Administrators in the system
fact EmergencyEntryRequiresTwoAdmins {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) => #(Administrator) >= 2
}

// In any Emergency-triggering state, emAdmins are always two distinct present Admins
fact EmergencyEmAdminsAreDistinct {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and
             all a: s.emAdmins | a in Administrator and
             all a1, a2: s.emAdmins | a1 != a2)
}

// EmergencyPrivilege granted only to the two emAdmins, only during Emergency, at state s
fact EmergencyPrivilegeAssignment {
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs |
                ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt)
            and
            (all a: s.emAdmins | some ep: s.emPrivs | ep.admin = a and ep.grantedAt = s)
        else
            no s.emPrivs
}

// Mutual exclusion is enforced except in Emergency mode (only if exactly two emAdmins present)
fact MutualExclusionEnforced {
    all s: State |
        (s.mode = Normal =>
            all u: User |
                all r1, r2: Role |
                    (r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s] and r1 != r2) =>
                        not (r1 in r2.mutuallyExclusiveWith)
        )
    // No mutual exclusion constraint enforced during Emergency (if two emAdmins present)
}

// Returns the set of Roles held by user u at state s
fun rolesHeld[u: User, s: State]: set Role {
    { r: Role |
        some d: s.delegations |
            d.delegatee = u and
            d.role = r and
            d.delegatedAt in pastOrEqual[s] and
            (no d.expiresAt or lt[s, d.expiresAt])
    }
}

// Returns all states up to and including s (for delegation activity checks)
fun pastOrEqual[s: State]: set State {
    { s2: State | lte[s2, s] }
}

// Highest classification of a set of objects
fun highestClass[os: set Object]: one ClassificationLevel {
    (some o: os | o.classification = C_High) => C_High
    else (some o: os | o.classification = C_Medium) => C_Medium
    else C_Low
}

// Request classification reflects highest classification of affected objects
fact RequestClassification {
    all req: Request |
        req.classification = highestClass[req.affects]
}

// FIFO enforced except for C_High requests during Emergency
fact FIFOEnforcedExceptEmergency {
    all s: State |
        s.mode = Normal => FIFOProcessing[s]
}

// Abstract predicate: requests processed in arrival order unless Emergency
pred FIFOProcessing[s: State] {}

// EMERGENCY MODE MUST ALWAYS BE TERMINATED EVENTUALLY (LIVENESS)
fact EmergencyLiveness {
    // In every trace, for every Emergency state, there is a later state in Normal mode
    all s: State |
        (s.mode = Emergency) => some s2: State | gt[s2, s] and s2.mode = Normal
}

// Delegation revocation: all delegations assigned during Emergency must be revoked immediately at Emergency->Normal transition
fact EmergencyDelegationRevocation {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => d.expiresAt = s
}

// Only the two emAdmins must update credentials after Emergency
fact EmergencyCredentialUpdate {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
}

// Delegations from before Emergency are not revoked automatically
fact DelegationsNotRevokedIfBeforeEmergency {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)
}

// ====== REQUIREMENT PREDICATES (incremental) ======

// R1: Emergency Trigger — two distinct emAdmins, present, no duplicates, only from Normal, negative scenarios forbidden
pred R1 {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (
                #(Administrator) >= 2 and
                #s.emAdmins = 2 and
                all a: s.emAdmins | a in Administrator and
                all a1, a2: s.emAdmins | a1 != a2
            )
}

// Helper: previous mode is Normal
pred prevModeIsNormal[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Normal
}

// R2: Emergency Mode Duration (liveness) — system always returns to Normal
pred R1R2 {
    R1 and
    all s: State |
        (s.mode = Emergency) => some s2: State | gt[s2, s] and s2.mode = Normal
}

// R3: Emergency behavior (FIFO bypass, mutual exclusion suspended, em privileges granted)
pred R1R2R3 {
    R1R2 and

    // R3.1: FIFO can be bypassed for high-classification requests
    all s: State |
        (s.mode = Emergency) => bypassFIFOForHighClass[s]
    and

    // R3.2: Mutual exclusion is suspended in Emergency — scenario testable via predicate
    all s: State |
        (s.mode = Emergency) => notMutualExclusionDuringEmergency[s]
    and

    // R3.3: Only the two emAdmins have EmergencyPrivilege during Emergency
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs | ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt)
            and
            (all a: s.emAdmins | some ep: s.emPrivs | ep.admin = a and ep.grantedAt = s)
}

// Bypass FIFO for C_High requests during Emergency
pred bypassFIFOForHighClass[s: State] {
    all r: s.requests |
        (r.classification = C_High) => canBeProcessedOutOfOrder[r, s]
}

// During Emergency, C_High requests may be processed out of order
pred canBeProcessedOutOfOrder[r: Request, s: State] {
    r in s.requests and s.mode = Emergency and r.classification = C_High
}

// Mutual exclusion not enforced during Emergency (scenario only)
pred notMutualExclusionDuringEmergency[s: State] {
    // No exclusion constraint checked: rolesHeld may overlap mutually exclusive roles
}

// Scenario predicate: There is a state in Emergency where a user holds two mutually exclusive roles, only if two distinct emAdmins present
pred Scenario_MutualExclusionSuspended_Positive {
    some s: State |
        s.mode = Emergency and
        #s.emAdmins = 2 and
        all a1, a2: s.emAdmins | a1 != a2 and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// Negative scenario: Emergency mode is (wrongly) entered with <2 Admins present
pred Scenario_EmergencyEntryWithSingleAdmin {
    some s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) and #(Administrator) = 1
}

// Negative scenario: Emergency mode is (wrongly) entered with emAdmins containing duplicates (cardinality <2, but same Admin counted twice)
pred Scenario_EmergencyEntryWithDuplicateAdmin {
    some s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) and
        (#s.emAdmins = 1 or (some a: s.emAdmins | #(s.emAdmins) != 2))
}

// Negative scenario: Emergency entry attempted with two emAdmins but only one actually present in Administrator set (invalid)
pred Scenario_EmergencyEntryWithNonAdminEmAdmin {
    some s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) and
        (some a: s.emAdmins | a not in Administrator)
}

// R4: Post-Emergency Restoration (immediate revocation, credential update for emAdmins only)
pred R1R2R3R4 {
    R1R2R3 and

    // R4.1: emAdmins lose EmergencyPrivilege immediately after Emergency
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all a: Time/prev[s].emAdmins | no ep: s.emPrivs | ep.admin = a

    and

    // R4.2: Only delegations assigned during Emergency are revoked when Emergency ends
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s)

    and

    // R4.2b: Delegations assigned before Emergency are NOT revoked at Emergency end
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)

    and

    // R4.3: Only the two emAdmins must update credentials after Emergency
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
}

// Helper: previous mode is Emergency
pred prevModeIsEmergency[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Emergency
}

// All requirements predicate
pred All_Requirements { R1R2R3R4 }

// ================== ASSERTIONS FOR VERIFICATION ==================

// R1: Emergency can only be entered if two distinct Admins jointly trigger from Normal mode (and both present)
assert assertR1 {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (
                #(Administrator) >= 2 and
                #s.emAdmins = 2 and
                all a: s.emAdmins | a in Administrator and
                all a1, a2: s.emAdmins | a1 != a2
            )
}

// R1 Negative: Emergency CANNOT be entered if fewer than two Admins exist
assert assertR1_Negative {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) => #(Administrator) >= 2
}

// R1 Negative: Emergency CANNOT be entered with duplicate (non-distinct) emAdmins
assert assertR1_NoDuplicateEmAdmins {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            (#s.emAdmins = 2 and all a1, a2: s.emAdmins | a1 != a2)
}

// R1 Negative: Emergency CANNOT be entered if an emAdmin is not a present Administrator
assert assertR1_OnlyPresentAdmins {
    all s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) =>
            all a: s.emAdmins | a in Administrator
}

// R2: Emergency mode is always exited (liveness)
assert assertR2 {
    all s: State |
        (s.mode = Emergency) => (some s2: State | gt[s2, s] and s2.mode = Normal)
}

// R3.2: There is a scenario where a user holds two mutually exclusive roles during Emergency (only if two distinct emAdmins present)
assert assertR3_MutExScenario_Positive {
    Scenario_MutualExclusionSuspended_Positive
}

// R3.2 Negative: There is NO scenario where user holds two mutually exclusive roles during Emergency unless two distinct emAdmins are present
assert assertR3_MutExScenario_Negative {
    all s: State |
        (s.mode = Emergency and #s.emAdmins < 2) =>
            no u: User, r1, r2: Role |
                r1 != r2 and r1 in r2.mutuallyExclusiveWith and
                r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// R4.1: After Emergency, all EmergencyPrivileges revoked from emAdmins
assert assertR4_1 {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all a: Time/prev[s].emAdmins | no ep: s.emPrivs | ep.admin = a
}

// R4.2: After Emergency, only Emergency-delegated roles are revoked
assert assertR4_2 {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Emergency) => d.expiresAt = s
}

// R4.2b: After Emergency, delegations from before Emergency are NOT revoked at Emergency end
assert assertR4_2b {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: s.delegations |
                (d.delegatedAt.mode = Normal) => (no d.expiresAt or d.expiresAt != s)
}

// R4.3: Only emAdmins must update credentials after Emergency
assert assertR4_3 {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            s.needsCredentialUpdate = Time/prev[s].emAdmins
}

// NEGATIVE: Emergency mode entry with only one Admin present is impossible
assert assertR1_NegativeEntryWithSingleAdmin {
    no s: State |
        (s.mode = Emergency and prevModeIsNormal[s] and #(Administrator) = 1)
}

// NEGATIVE: Emergency mode entry with duplicate Admins (non-distinct emAdmins) is impossible
assert assertR1_NegativeEntryWithDuplicateAdmin {
    no s: State |
        (s.mode = Emergency and prevModeIsNormal[s]) and (#s.emAdmins < 2)
}

// NEGATIVE: Emergency mode entry with any emAdmin not in Administrator is impossible
assert assertR1_NegativeEntryWithNonAdminEmAdmin {
    no s: State |
        (s.mode = Emergency and prevModeIsNormal[s] and (some a: s.emAdmins | a not in Administrator))
}

// ================== RUN/CHECK COMMANDS (SCOPES) ==================

// Positive: Sufficient Admins for Emergency mode entry
run R1 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
run R1R2 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
run R1R2R3 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
run R1R2R3R4 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
run All_Requirements for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request

// Scenario: Mutual exclusion is suspended during Emergency if two distinct emAdmins present
run Scenario_MutualExclusionSuspended_Positive for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request

// Negative: Only one Admin present, Emergency entry must be impossible
run Scenario_EmergencyEntryWithSingleAdmin for 5 but 3 State, 1 Administrator, 2 User, 3 Role, 5 Object, 5 Request

// Negative: Duplicate Admin used in emAdmins, Emergency entry must be impossible
run Scenario_EmergencyEntryWithDuplicateAdmin for 5 but 3 State, 2 Administrator, 2 User, 3 Role, 5 Object, 5 Request

// Negative: emAdmins includes a non-Administrator, Emergency entry must be impossible
run Scenario_EmergencyEntryWithNonAdminEmAdmin for 5 but 3 State, 2 Administrator, 2 User, 1 Role, 5 Object, 5 Request

// CHECKS: All positive and negative assertions
check assertR1 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
check assertR1_Negative for 5 but 3 State, 2 User, 1 Administrator, 3 Role, 5 Object, 5 Request
check assertR1_NoDuplicateEmAdmins for 5 but 3 State, 2 User, 2 Administrator, 3 Role, 5 Object, 5 Request
check assertR1_OnlyPresentAdmins for 5 but 3 State, 2 User, 2 Administrator, 3 Role, 5 Object, 5 Request
check assertR2 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
check assertR3_MutExScenario_Positive for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
check assertR3_MutExScenario_Negative for 5 but 3 State, 2 User, 1 Administrator, 3 Role, 5 Object, 5 Request
check assertR4_1 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
check assertR4_2 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
check assertR4_2b for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
check assertR4_3 for 5 but 3 State, 4 User, 3 Administrator, 3 Role, 5 Object, 5 Request
check assertR1_NegativeEntryWithSingleAdmin for 5 but 3 State, 2 User, 1 Administrator, 3 Role, 5 Object, 5 Request
check assertR1_NegativeEntryWithDuplicateAdmin for 5 but 3 State, 2 User, 2 Administrator, 3 Role, 5 Object, 5 Request
check assertR1_NegativeEntryWithNonAdminEmAdmin for 5 but 3 State, 2 User, 2 Administrator, 1 Role, 5 Object, 5 Request

// -- END OF MODEL --

// [EVENT]: Strengthened EmergencyEntryConstraint to require #emAdmins = 2, all in Administrator, all distinct.
// [EVENT]: Added negative scenario predicates for Emergency entry with only one Admin, duplicate Admins, or non-Admin emAdmins.
// [EVENT]: Added positive and negative assertions for Emergency entry (exactly two distinct Administrators, no duplicates).
// [EVENT]: MutEx scenario assertion now guarded: only triggers if two distinct emAdmins present.
// [EVENT]: Adjusted all run/check scopes to explicitly model valid and invalid (negative) Emergency entry scenarios.
// [EVENT]: Explicitly disallowed Emergency entry when <2 Administrators, or emAdmins are not distinct or not all present.
// [LESSON]: Alloy 6 set multiplicity and cardinality (#s.emAdmins = 2 and all a1, a2: s.emAdmins | a1 != a2) is the correct way to enforce two distinct elements.
// [LESSON]: Negative scenarios ("no s: State | ...") are best checked with explicit assertions, not facts, to allow vacuity detection.
