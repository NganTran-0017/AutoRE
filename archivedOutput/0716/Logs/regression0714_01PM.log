    "updated_lines": "--- Output/AlloyModels/AlloyModel__43.als\t2026-07-14 11:58:30.366095988 -0500\n+++ Output/AlloyModels/AlloyModel__44.als\t2026-07-14 12:17:30.974199608 -0500\n@@ -3,7 +3,6 @@\n \n-\n open util/ordering[Time] as TO\n \n@@ -167,6 +166,23 @@\n     }.role\n }\n \n+\n+fact EmergencyDelegationAndPrivilegeRevocation {\n+    all et: EmergencyTrigger | one et.endedAt => \n+        all s: State | TO/gte[s.t, et.endedAt] and s.mode = NormalMode => {\n+            all d: Delegation | \n+                d.duringEmergency = True and \n+                d in s.delegations => \n+                    d.revoked = True\n+            s.emergencyAdmins = none\n+        }\n+}\n+\n \n pred baseline { }\n@@ -250,19 +266,19 @@\n pred R1R2R3R4 {\n     R1R2R3[]\n-    all s: State |\n-        s.mode = NormalMode =>\n+    all et: EmergencyTrigger | one et.endedAt =>\n+        all s: State | TO/gte[s.t, et.endedAt] and s.mode = NormalMode =>\n             all d: Delegation |\n                 d.duringEmergency = True and d in s.delegations => d.revoked = True\n     all et: EmergencyTrigger |\n         some s: State | s.mode = NormalMode and some et.endedAt and et.endedAt = s.t =>\n             all a: et.admins | credentialUpdated[a, s]\n-    some sE: State | sE.mode = EmergencyMode and some dE: Delegation | dE in sE.delegations and dE.duringEmergency = True\n-    some sN: State | sN.mode = NormalMode and some dN: Delegation | dN in sN.delegations and dN.duringEmergency = False\n+    some sE: State | sE.mode = EmergencyMode and some dE: Delegation | dE in sE.delegations and dE.duringEmergency = True and dE.revoked = False and TO/lte[dE.delegatedAt, sE.t] and (no dE.expiresAt or TO/lt[sE.t, dE.expiresAt])\n+    some sN: State | sN.mode = NormalMode and some dN: Delegation | dN in sN.delegations and dN.duringEmergency = False and dN.revoked = False and TO/lte[dN.delegatedAt, sN.t] and (no dN.expiresAt or TO/lt[sN.t, dN.expiresAt])\n }\n \n@@ -279,10 +295,13 @@\n+\n pred DelegationCoverage {\n-    some sE: State | sE.mode = EmergencyMode and some dE: Delegation | dE in sE.delegations and dE.duringEmergency = True\n-    some sN: State | sN.mode = NormalMode and some dN: Delegation | dN in sN.delegations and dN.duringEmergency = False\n+    some sE: State | sE.mode = EmergencyMode and some dE: Delegation | dE in sE.delegations and dE.duringEmergency = True and dE.revoked = False and TO/lte[dE.delegatedAt, sE.t] and (no dE.expiresAt or TO/lt[sE.t, dE.expiresAt])\n+    some sN: State | sN.mode = NormalMode and some dN: Delegation | dN in sN.delegations and dN.duringEmergency = False and dN.revoked = False and TO/lte[dN.delegatedAt, sN.t] and (no dN.expiresAt or TO/lt[sN.t, dN.expiresAt])\n }\n \n@@ -321,16 +340,16 @@\n \n assert assertR4_EmergencyDelegationsRevoked {\n-    all s: State |\n-        s.mode = NormalMode =>\n+    all et: EmergencyTrigger | one et.endedAt =>\n+        all s: State | TO/gte[s.t, et.endedAt] and s.mode = NormalMode =>\n             all d: Delegation |\n                 d.duringEmergency = True and d in s.delegations => d.revoked = True\n }\n \n assert assertDelegationCoverage {\n-    some sE: State | sE.mode = EmergencyMode and some dE: Delegation | dE in sE.delegations and dE.duringEmergency = True\n-    some sN: State | sN.mode = NormalMode and some dN: Delegation | dN in sN.delegations and dN.duringEmergency = False\n+    some sE: State | sE.mode = EmergencyMode and some dE: Delegation | dE in sE.delegations and dE.duringEmergency = True and dE.revoked = False and TO/lte[dE.delegatedAt, sE.t] and (no dE.expiresAt or TO/lt[sE.t, dE.expiresAt])\n+    some sN: State | sN.mode = NormalMode and some dN: Delegation | dN in sN.delegations and dN.duringEmergency = False and dN.revoked = False and TO/lte[dN.delegatedAt, sN.t] and (no dN.expiresAt or TO/lt[sN.t, dN.expiresAt])\n }\n \n",
