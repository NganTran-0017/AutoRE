**Current Alloy Model:**
open util/ordering[State] as SO

// =========================
// Alloy 6 Model for RBAC Emergency Module Requirements (Global Emergency Mode)
// =========================

// --- Abstract Sets and Relations ---

abstract sig User {
    clearance: one Clearance
}

abstract sig Administrator extends User {}

abstract sig Role {}
abstract sig Permission {}

abstract sig Clearance {} // e.g., High, Medium, Low

// --- directAssignment: Users directly assigned to Roles (global relation, see holdsRoleDirectly) ---
one sig DirectAssignmentRel {
    directAssignment: User -> Role
}

// --- Clearance Atoms ---
// The first three Clearance atoms in any instance should be interpreted as HighClearance, MediumClearance, and LowClearance, respectively.
fact ClearanceAtoms {
    some disj h, m, l: Clearance |
        h = h and m = m and l = l
}

// --- Mutually Exclusive Roles ---
// MutexRolePair defines symmetric, paired mutex relation (no self-mutex)
sig MutexRolePair {
    r1, r2: disj Role
}

// Enforce mutex role requirements (R6.1, R6.2)
fact MutexRoleSymmetryAndNoSelf {
    // Symmetry and pairing: for every pair, a symmetric exists; no self-mutex
    all p: MutexRolePair | p.r1 != p.r2
    all p: MutexRolePair | one q: MutexRolePair | q.r1 = p.r2 and q.r2 = p.r1
    // No role is mutex with itself
    all p: MutexRolePair | p.r1 != p.r2
}

// --- Set of all mutex roles for convenience ---
fun mutexRoles: set Role {
    MutexRolePair.r1 + MutexRolePair.r2
}

// Emergency privileges are an abstract set of permissions
one sig EmergencyPrivileges {
    perms: set Permission
}

// --- Bool enum for logical fields ---
enum Bool { True, False }

// Delegated role assignment with temporal scoping and revocation audit
sig Delegation {
    role: one Role,
    to: one User,
    delegatedBy: one Administrator,
    delegatedAt: one State,
    expiresAt: one State,  // Always set; strictly after delegatedAt
    revoked: one Bool,     // True if revoked before expiresAt, else False
    revokedBy: lone Administrator, // Set iff revoked=True
    revokedAt: lone State         // Set iff revoked=True
}

// Requests and processing
sig Request {
    submittedBy: one User,
    classification: one Clearance,
    submittedAt: one State,
    processedAt: lone State,
    processor: one User // Processor identity must always be logged
}

// System modes (global, not per session)
abstract sig SystemMode {}
one sig NormalMode, EmergencyMode extends SystemMode {}

// Emergency trigger event: exactly 2 admins, at a state
sig EmergencyTrigger {
    admins: set Administrator,
    at: one State,
    endedEarly: one Bool, // True if ended manually by same admins
    endedAt: one State    // Set when Emergency ends, must be >= at
}

// System session
sig Session {}

// System state at a step (global mode)
sig State {
    mode: one SystemMode,
    delegations: set Delegation,
    requests: set Request,
    emergencyAdmins: set Administrator,
    sessions: set Session
}

// =============================
// --- STRUCTURAL PRECONDITIONS (NEW for R8) ---

// 1. Emergency mode must occur exactly once per execution (i.e., exactly one EmergencyTrigger per model instance).
fact EmergencyTriggerOccursOnce {
    one EmergencyTrigger
}

// 2. Each user is assigned at least one role (direct assignment, at all times), and assignment is clearance-aware.
fact EachUserAssignedAtLeastOneRole_Clearance {
    all u: User | some r: Role | (u -> r) in DirectAssignmentRel.directAssignment and roleIsConsistentWithClearance[u, r]
}

// --- Helper: Role assignment is consistent with clearance (R5.5) ---
// For this abstract model, all roles are considered consistent with a user's clearance.
// If further mapping between roles and clearance is needed, adjust this predicate.
pred roleIsConsistentWithClearance[u: User, r: Role] {
    // In this model, assume all roles are consistent.
    some u and some r
}

// =============================

// --- Existing System Assumptions and Structural Constraints ---

// All administrators have high clearance (but non-admins may also have high)
fact AdminsHaveHighClearance {
    some disj h, m, l: Clearance |
        all a: Administrator | a.clearance = h
}

// All sessions share the same mode at any given state (mode is global)
fact AllSessionsShareMode {
    all s: State | all sess: Session | sess in s.sessions
}

// Only one active Emergency at a time (no overlap), trigger is global
fact SingleActiveEmergency {
    // There is only one EmergencyTrigger per execution due to EmergencyTriggerOccursOnce.
    // This fact now only serves as a sanity check.
    all et1, et2: EmergencyTrigger | et1 != et2 =>
        (SO/lt[et1.endedAt, et2.at] or SO/lt[et2.endedAt, et1.at])
}

// Structure and constraints for EmergencyTrigger (must be unique per system, not per session)
fact EmergencyTriggerStructure {
    all et: EmergencyTrigger | #et.admins = 2 and all a: et.admins | a in Administrator
    // endedAt must always be set for each trigger and >= at
    all et: EmergencyTrigger | SO/lte[et.at, et.endedAt]
    // If endedEarly, endedAt is within at..at+4; else, exactly at+5 (if enough states)
    all et: EmergencyTrigger | let start = et.at |
        (et.endedEarly = True) => (
            SO/gte[et.endedAt, start] &&
            SO/lte[et.endedAt, nthNext[start, 4]]
        )
    all et: EmergencyTrigger | let start = et.at |
        (et.endedEarly = False) => (
            some nthNext[start, 5] &&
            et.endedAt = nthNext[start, 5]
        )
}

// NON-RECURSIVE nthNext FUNCTION (Alloy 6-compliant):
fun nthNext[s: State, n: Int]: lone State {
    { t: State | #(SO/prevs[t] & SO/nexts[s]) = n }
}

// =============================
// --- Emergency Mode Globality and Related Constraints (UPDATED) ---
// Compose all constraints for Emergency mode as per requirements.

// 1. Emergency mode can only be triggered in NormalMode.
fact EmergencyMode_TriggerOnlyInNormal {
    all et: EmergencyTrigger | et.at.mode = NormalMode
    // No EmergencyTrigger event allowed while EmergencyMode is active (implied by one EmergencyTrigger per execution).
    all s: State |
        s.mode = EmergencyMode =>
            no et: EmergencyTrigger | et.at = s
}

// 2. Emergency mode is global and applies to all sessions/states between at and endedAt.
fact EmergencyMode_ModeActivation {
    all et: EmergencyTrigger | all s: State |
        (SO/lte[et.at, s] and SO/lt[s, et.endedAt]) <=> (s.mode = EmergencyMode)
}

// 3. After Emergency ends, system must be in NormalMode for all subsequent states.
fact EmergencyMode_PostEmergencyNormal {
    all et: EmergencyTrigger | all s: State | SO/gte[s, et.endedAt] => s.mode = NormalMode
}

// 4. Emergency mode, once triggered, must persist for at least one time step (R2).
fact EmergencyMode_MinimumDuration {
    all et: EmergencyTrigger | some SO/next[et.at] => SO/next[et.at].mode = EmergencyMode
}

// 5. Emergency privilege assignment (STRICT - per requirements R3.3, R4.1)
fact EmergencyMode_PrivilegeAssignment_Strict {
    // In EmergencyMode, only the two triggering admins have emergency privileges, and only during EmergencyMode.
    all et: EmergencyTrigger | all s: State |
        (s.mode = EmergencyMode =>
            s.emergencyAdmins = et.admins
        )
        and
        (s.mode = NormalMode => s.emergencyAdmins = none)
    // At no time may any admin other than the two triggering admins hold emergency privileges
    all s: State | all a: s.emergencyAdmins |
        one et: EmergencyTrigger | SO/lte[et.at, s] and SO/lt[s, et.endedAt] and a in et.admins
}

// 6. All delegations initiated during Emergency mode must be revoked before or at Emergency/Normal transition.
fact EmergencyMode_DelegationRevocation_Strict {
    // For the unique EmergencyTrigger, all delegations created in EmergencyMode must be revoked before or at first NormalMode state
    all et: EmergencyTrigger | 
        let firstNormal = et.endedAt |
        all d: Delegation | 
            d.delegatedAt.mode = EmergencyMode =>
                d.revoked = True and some d.revokedAt and SO/lte[d.revokedAt, firstNormal] and some d.revokedBy and d.revokedBy in Administrator
}

// --- Delegation Validity and Scope (REGENERATED) ---
// Enforces R5.1-R5.6

fact DelegationValidity {
    // No self-delegation
    all d: Delegation | d.to != d.delegatedBy
    // Only directly assigned roles may be delegated; delegatedBy must hold the role directly at delegation time
    all d: Delegation | 
        let s = d.delegatedAt, r = d.role, admin = d.delegatedBy | 
            holdsRoleDirectly[admin, r, s]
    // Expiry must be strictly after delegatedAt
    all d: Delegation | SO/lt[d.delegatedAt, d.expiresAt]
    // If revoked = True, must be revoked before expiresAt; revokedBy and revokedAt must be set and valid
    all d: Delegation | 
        d.revoked = True => (
            some d.revokedBy and d.revokedBy in Administrator
            and some d.revokedAt and SO/lt[d.revokedAt, d.expiresAt]
        )
    // If revoked = False, revokedBy and revokedAt must be none
    all d: Delegation | 
        d.revoked = False => no d.revokedBy and no d.revokedAt
    // Delegation recipient's clearance must be lower or equal to delegator's clearance (R5.6)
    all d: Delegation |
        d.to.clearance = d.delegatedBy.clearance or
        (some c1, c2: Clearance |
            d.delegatedBy.clearance = c1 and d.to.clearance = c2 and clearanceLeq[c2, c1] // c2 <= c1
        )
}

// Helper: A user holds a role directly at state s iff assigned, not via delegation
pred holdsRoleDirectly[u: User, r: Role, s: State] {
    (u -> r) in DirectAssignmentRel.directAssignment and
    // No evidence of delegation required for holding (i.e., not via another Delegation chain)
    no d: Delegation | d.role = r and d.to = u and SO/lte[d.delegatedAt, s] and SO/lt[s, d.expiresAt] and d.revoked = False
}

// Placeholder: clearanceLeq[c1, c2] iff c1 <= c2 in clearance ordering (for now, treat all clearances as totally ordered).
// For this model, assume High >= Medium >= Low (first three atoms).
// In Alloy, we can't impose a total order on abstract atoms, so we define a (possibly partial) order by index.
pred clearanceLeq[low: Clearance, high: Clearance] {
    // Assume Clearance is ordered as High (0), Medium (1), Low (2)
    // low <= high if low is "lower or equal" in ordinal
    // For now, permit all (not enforced unless more structure is added)
    some low and some high
}

// Roles held by user at state (including delegations active at s)
fun rolesHeld[u: User, s: State]: set Role {
    { d: Delegation |
        d.to = u and SO/lte[d.delegatedAt, s] and
        SO/lt[s, d.expiresAt] and d.revoked = False and
        d in s.delegations
    }.role
    // If modeling direct assignment, add: + { r: Role | (u->r) in DirectAssignmentRel.directAssignment }
}

// --- Request Processing Logging (REGENERATED) ---
fact RequestProcessorLogging {
    all r: Request | one r.processor
}

// --- Emergency Mutex Bypass (REGENERATED) ---
// (R3.2) In Emergency mode, if a user holds two mutex roles, at least one must have been delegated.
fact EmergencyMutexBypass {
    // Users may only hold mutex roles simultaneously in EmergencyMode
    all s: State | all u: User |
        #(mutexRoles & rolesHeld[u, s]) >= 2 implies s.mode = EmergencyMode

    // In EmergencyMode, if a user holds two mutex roles, at least one must have been delegated
    all s: State | s.mode = EmergencyMode =>
        all u: User |
            some disj r1, r2: mutexRoles |
                r1 != r2 and r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s] =>
                    (some d: Delegation |
                        d.to = u and d.role in (r1 + r2) and
                        d in s.delegations and
                        SO/lte[d.delegatedAt, s] and
                        SO/lt[s, d.expiresAt] and d.revoked = False)
}

// --- Baseline Predicate: Existing System Only ---
pred baseline { }

// =============================
// Prospective Requirements
// =============================

// --- R1: Emergency Triggering (Global) ---
pred R1 {
    // Exactly one EmergencyTrigger per execution
    one EmergencyTrigger
    // Exactly 2 admins trigger global Emergency only in Normal mode
    all et: EmergencyTrigger | #et.admins = 2
    // EmergencyTrigger only possible in Normal mode at trigger state
    all et: EmergencyTrigger | et.at.mode = NormalMode
    // No EmergencyTrigger event allowed while EmergencyMode is active
    all s: State |
        s.mode = EmergencyMode =>
            no et: EmergencyTrigger | et.at = s
}

// --- R2: Emergency Mode Duration & Exit (fixed duration or early end, and minimum duration) ---
pred R1R2 {
    R1[]
    all et: EmergencyTrigger | let start = et.at | {
        SO/lte[start, et.endedAt]
        // Early end: endedEarly => endedAt in [start, start+4]
        (et.endedEarly = True) => (
            SO/gte[et.endedAt, start] &&
            SO/lte[et.endedAt, nthNext[start, 4]]
        )
        (et.endedEarly = False) => (
            some nthNext[start, 5] &&
            et.endedAt = nthNext[start, 5]
        )
        // There must exist a State at endedAt where mode is NormalMode
        et.endedAt.mode = NormalMode
        // For all States, if s >= endedAt then mode is NormalMode
        all s: State | SO/gte[s, et.endedAt] => s.mode = NormalMode
        // EmergencyMode must be active from at (inclusive) up to endedAt (exclusive), then Normal
        all s: State |
            ((SO/gte[s, start] and SO/lt[s, et.endedAt]) => s.mode = EmergencyMode)
        // Emergency mode, once triggered, must persist for at least one step
        some SO/next[start] => SO/next[start].mode = EmergencyMode
    }
    // System always starts in NormalMode at first state
    SO/first.mode = NormalMode
}

// --- R3: Emergency Processing and Privileges (Global) ---
pred R1R2R3 {
    R1R2[]
    some disj h, m, l: Clearance {
        // Request processing order may be bypassed in Emergency (system-wide)
        all s: State |
            s.mode = EmergencyMode =>
                all r1, r2: s.requests |
                    (r1.classification = h and r2.classification = l and SO/lt[r2.submittedAt, r1.submittedAt]) =>
                        (no r1.processedAt or SO/lte[r1.processedAt, r2.processedAt])
        // Mutually exclusive roles may be held simultaneously only in Emergency; mutex bypass enforced via fact
        all s: State |
            all u: User |
                #(mutexRoles & rolesHeld[u, s]) >= 2 implies s.mode = EmergencyMode
        // --- Emergency privilege assignment (R3.3) ---
        // In EmergencyMode, only the two triggering admins hold emergency privileges (no handoff, no overlap, strict exclusivity).
        all s: State |
            s.mode = EmergencyMode =>
                one et: EmergencyTrigger | SO/lte[et.at, s] and SO/lt[s, et.endedAt] and
                    s.emergencyAdmins = et.admins and
                    all a: s.emergencyAdmins | a in Administrator
        // In NormalMode, emergencyAdmins is always empty
        all s: State |
            s.mode = NormalMode =>
                s.emergencyAdmins = none
        // At no time may any admin other than the two triggering admins hold emergency privileges during EmergencyMode
        all s: State | s.mode = EmergencyMode =>
            all a: s.emergencyAdmins |
                one et: EmergencyTrigger | SO/lte[et.at, s] and SO/lt[s, et.endedAt] and a in et.admins
    }
}

// --- R4: Post-Emergency Restoration (Global) ---
// Emergency-mode delegations (delegatedAt during Emergency mode) must be revoked before or at the Emergency/Normal transition; Normal-mode delegations may persist.
pred R1R2R3R4 {
    R1R2R3[]
    // Emergency privileges revoked after Emergency ends (already enforced)
    // Emergency-mode delegations revoked before or at Emergency end; prior delegations persist as per their policy
    all et: EmergencyTrigger | 
        let firstNormal = et.endedAt |
        all d: Delegation | 
            d.delegatedAt.mode = EmergencyMode =>
                d.revoked = True and some d.revokedAt and SO/lte[d.revokedAt, firstNormal] and some d.revokedBy and d.revokedBy in Administrator
    // Credential update required after Emergency for triggering admins (abstracted as a flag/condition)
    all et: EmergencyTrigger |
        some s: State | s = et.endedAt and s.mode = NormalMode =>
            all a: et.admins | credentialUpdated[a, s]
}

// --- R5, R6, R7 constraints are in facts above ---

// --- All Requirements ---
pred All_Requirements {
    R1R2R3R4[]
    // All facts are enforced globally
}

// --- Credential update helper predicate (abstract) ---
pred credentialUpdated[a: Administrator, s: State] {
    some a // Always true for abstract model
}

// =============================
// --- Delegation Coverage Witnesses (REGENERATED for clarified R8) ---
// These encode existential requirements, not system invariants.

// DelegationCoverageEmergency: There exists an execution in which at least one delegation is initiated (delegatedAt) during Emergency mode and is active in some EmergencyMode state.
pred DelegationCoverageEmergency {
    some d: Delegation | 
        d.delegatedAt.mode = EmergencyMode and
        SO/lt[d.delegatedAt, d.expiresAt] and
        (
            some s: State |
                s.mode = EmergencyMode and
                d in s.delegations and
                SO/lte[d.delegatedAt, s] and SO/lt[s, d.expiresAt] and
                d.revoked = False
        )
}

// DelegationCoverageNormal: There exists an execution in which at least one delegation is initiated (delegatedAt) during Normal mode and is active in some NormalMode state.
pred DelegationCoverageNormal {
    some d: Delegation |
        d.delegatedAt.mode = NormalMode and
        SO/lt[d.delegatedAt, d.expiresAt] and
        (
            some s: State |
                s.mode = NormalMode and
                d in s.delegations and
                SO/lte[d.delegatedAt, s] and SO/lt[s, d.expiresAt] and
                d.revoked = False
        )
}

// DelegationCoverage: There exists an execution with both (a) Emergency-mode delegation active during Emergency, and (b) Normal-mode delegation active during Normal.
pred DelegationCoverage {
    DelegationCoverageEmergency[] and DelegationCoverageNormal[]
}

// =============================
// --- Assertions for Verification ---
// =============================

// Only two admins can ever trigger Emergency (globally)
assert assertR1_OnlyTwoAdminsTrigger {
    all et: EmergencyTrigger | #et.admins = 2
}

// Emergency mode cannot be started twice in the system
assert assertR1_OneEmergencyPerSystem {
    one EmergencyTrigger
}

// Emergency mode eventually ends, system returns to NormalMode globally
assert assertR2_EventualReturnToNormal {
    all et: EmergencyTrigger | 
        et.endedAt.mode = NormalMode
        and
        (all s: State | (SO/gte[s, et.endedAt]) implies s.mode = NormalMode)
}

// Strictly, only the two triggering admins may hold emergency privileges during EmergencyMode; in NormalMode, privileges are always empty.
assert assertR3_OnlyTriggeringAdminsGetEmergencyPrivs {
    // In EmergencyMode, for every State, emergencyAdmins = exactly the two triggering admins (no more, no less, no overlap)
    all s: State | s.mode = EmergencyMode =>
        one et: EmergencyTrigger | SO/lte[et.at, s] and SO/lt[s, et.endedAt] and
            s.emergencyAdmins = et.admins and
            all a: s.emergencyAdmins | a in Administrator
    // In NormalMode, emergencyAdmins is always empty
    all s: State | s.mode = NormalMode => s.emergencyAdmins = none
    // At no time may any admin other than the two triggering admins hold emergency privileges during EmergencyMode
    all s: State | s.mode = EmergencyMode =>
        all a: s.emergencyAdmins |
            one et: EmergencyTrigger | SO/lte[et.at, s] and SO/lt[s, et.endedAt] and a in et.admins
}

// Roles delegated during Emergency (i.e., delegatedAt during Emergency) are revoked before or at the Emergency/Normal transition; prior delegations (delegatedAt in NormalMode) persist
assert assertR4_EmergencyDelegationsRevoked {
    all et: EmergencyTrigger | 
        let firstNormal = et.endedAt |
        all d: Delegation | 
            d.delegatedAt.mode = EmergencyMode =>
                d.revoked = True and some d.revokedAt and SO/lte[d.revokedAt, firstNormal] and some d.revokedBy and d.revokedBy in Administrator
}

// =============================
// Run and Check Commands
// =============================

// 1. Baseline: Existing system is consistent and satisfiable
run baseline for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

// 2. All requirements (comprehensive)
run All_Requirements for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

// 3. Incremental predicates
run R1 for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run R1R2 for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run R1R2R3 for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run R1R2R3R4 for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

// 4. Positive coverage: Delegations in both modes (now split for diagnostics)
run DelegationCoverageEmergency for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run DelegationCoverageNormal for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run DelegationCoverage for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

// 5. Assertions
check assertR1_OnlyTwoAdminsTrigger for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertR1_OneEmergencyPerSystem for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertR2_EventualReturnToNormal for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertR3_OnlyTriggeringAdminsGetEmergencyPrivs for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertR4_EmergencyDelegationsRevoked for 6 but 5 State, 3 Session, 1 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

