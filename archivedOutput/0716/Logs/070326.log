// =========================
// Alloy 6 Model for RBAC Emergency Module Requirements
// =========================

// --- Abstract Sets and Relations ---

abstract sig User {
    clearance: one Clearance
}

abstract sig Administrator extends User {}

abstract sig Role {}
abstract sig Permission {}

abstract sig Clearance {} // e.g., High, Medium, Low

// Predefined abstract set of mutually exclusive roles
one sig MutuallyExclusiveRoleSet {
    roles: set Role
}

// Emergency privileges are an abstract set of permissions
one sig EmergencyPrivileges {
    perms: set Permission
}

// --- Bool enum for logical fields ---
enum Bool { True, False }

// Delegated role assignment with temporal scoping
sig Delegation {
    role: one Role,
    to: one User,
    delegatedBy: one Administrator,
    delegatedAt: one Time,
    expiresAt: lone Time,  // If not set, persists until revoked
    revoked: one Bool,     // True if revoked
    duringEmergency: one Bool // True if delegated during Emergency
}

// Requests and processing
sig Request {
    submittedBy: one User,
    classification: one Clearance,
    submittedAt: one Time,
    processedAt: lone Time
}

// System modes
abstract sig SystemMode {}
one sig NormalMode, EmergencyMode extends SystemMode {}

// System session (each session: only one Emergency allowed)
sig Session {
    // This session's Emergency trigger event (if any)
    emergencyTriggered: lone EmergencyTrigger
}

// Emergency trigger event: exactly 2 admins, at a time, in a session
sig EmergencyTrigger {
    admins: set Administrator,
    at: one Time,
    session: one Session,
    endedEarly: one Bool, // True if ended manually by same admins
    endedAt: lone Time    // Set when Emergency ends
}

// Time abstraction (no concrete ticks)
sig Time {}

// System state at a time
sig State {
    t: one Time,
    mode: one SystemMode,
    session: one Session,
    // Set of active delegations
    delegations: set Delegation,
    // Requests submitted so far
    requests: set Request,
    // Emergency privilege assignment: mapping admin <-> active/inactive
    emergencyAdmins: set Administrator
}

// --- Existing System Assumptions and Structural Constraints ---

fact ExistingSystem {
    // Administrators have high clearance
    all a: Administrator | a.clearance = HighClearance

    // Users only hold mutually exclusive roles if Emergency
    all s: State |
        s.mode = NormalMode =>
            all u: User |
                lone (MutuallyExclusiveRoleSet.roles & rolesHeld[u, s])

    // Emergency privileges only exist as defined, only for admins
    all s: State |
        all u: User |
            u in s.emergencyAdmins <=> (
                s.mode = EmergencyMode &&
                u in Administrator &&
                some et: EmergencyTrigger | u in et.admins && et.session = s.session && et.at <= s.t && (no et.endedAt or s.t < et.endedAt)
            )

    // Only one EmergencyTrigger per Session
    all sess: Session | lone sess.emergencyTriggered

    // EmergencyTrigger admins must be 2 distinct Administrators
    all et: EmergencyTrigger | #et.admins = 2 && all a: et.admins | a in Administrator

    // Emergency mode can only be active once per session
    all s: State | 
        lone et: EmergencyTrigger | et.session = s.session && et.at <= s.t && (no et.endedAt or s.t < et.endedAt) =>
            s.mode = EmergencyMode
}

// --- Helper Relations and Functions ---

// Roles held by user at state (including delegations active at t)
fun rolesHeld[u: User, s: State]: set Role {
    { d: Delegation |
        d.to = u && d.delegatedAt <= s.t &&
        (no d.expiresAt or s.t < d.expiresAt) &&
        d.revoked = False &&
        d in s.delegations
    }.role
}

// --- Baseline Predicate: Existing System Only ---

pred baseline { }

// =============================
// Prospective Requirements
// =============================

// --- R1: Emergency Triggering ---

pred R1 {
    // In Normal mode, exactly 2 admins may trigger Emergency, switching mode
    some et: EmergencyTrigger | 
        let s0 = {s: State | s.t = et.at && s.session = et.session} |
        some s0 && all s: s0 | s.mode = EmergencyMode &&
        #et.admins = 2 && all a: et.admins | a in Administrator
    // Only one Emergency trigger per session
    all sess: Session | lone sess.emergencyTriggered
    // No Emergency trigger during Emergency
    all s: State | 
        s.mode = EmergencyMode => 
            no et: EmergencyTrigger | et.session = s.session && et.at = s.t
}

// --- R2: Emergency Mode Duration & Exit ---

pred R1R2 {
    R1[]
    // Emergency mode remains active for a fixed duration unless ended early by same admins
    all et: EmergencyTrigger | 
        some sStart: State | sStart.t = et.at && sStart.session = et.session && sStart.mode = EmergencyMode 
        implies
        let sEnd = {s: State | s.session = et.session && (s.t = et.endedAt or (no et.endedAt and false))} |
            some sEnd && all s: sEnd | s.mode = NormalMode
    // No new Emergency trigger during Emergency mode
    all s: State | 
        s.mode = EmergencyMode =>
            no et: EmergencyTrigger | et.session = s.session && et.at = s.t
}

// --- R3: Emergency Processing and Privileges ---

pred R1R2R3 {
    R1R2[]
    // Request processing order may be bypassed in Emergency
    all s: State | 
        s.mode = EmergencyMode => 
            all r1, r2: s.requests | 
                (r1.classification = HighClearance && r2.classification = LowClearance && r1.submittedAt > r2.submittedAt) =>
                    (no r1.processedAt or r1.processedAt <= r2.processedAt)
    // Mutually exclusive roles may be held simultaneously only in Emergency
    all s: State | 
        s.mode = EmergencyMode => 
            all u: User | 
                #(MutuallyExclusiveRoleSet.roles & rolesHeld[u, s]) >= 2 implies s.mode = EmergencyMode
    // Only triggering admins have emergency privileges in Emergency
    all s: State | 
        s.mode = EmergencyMode =>
            s.emergencyAdmins = (let et = {e: EmergencyTrigger | e.session = s.session && e.at <= s.t && (no e.endedAt or s.t < e.endedAt)} | (some et => et.admins else none))
}

// --- R4: Post-Emergency Restoration ---

pred R1R2R3R4 {
    R1R2R3[]
    // Emergency privileges revoked after Emergency ends
    all s: State | 
        s.mode = NormalMode =>
            s.emergencyAdmins = none
    // Roles delegated during Emergency revoked at Emergency end; prior delegations persist
    all s: State | 
        s.mode = NormalMode =>
            all d: Delegation | 
                d.duringEmergency = True && d in s.delegations => d.revoked = True
    // Credential update required after Emergency for triggering admins (abstracted as a flag/condition)
    all et: EmergencyTrigger | 
        some s: State | s.session = et.session && s.mode = NormalMode && et.endedAt = s.t =>
            all a: et.admins | credentialUpdated[a, s]
}

// --- All Requirements ---

pred All_Requirements {
    R1R2R3R4[]
}

// --- Credential update helper predicate (abstract) ---
pred credentialUpdated[a: Administrator, s: State] { 
    // Abstract: mark that admin a updated credentials at/after s.t
    // Satisfiable by some State property or sequence; left abstract for now
    // E.g., can be replaced with a concrete event in a more detailed model
    some a // Always true for abstract model
}

// =============================
// Assertions for Verification
// =============================

// Only two admins can ever trigger Emergency in a session
assert assertR1_OnlyTwoAdminsTrigger {
    all et: EmergencyTrigger | #et.admins = 2
}

// Emergency mode cannot be started twice in one session
assert assertR1_OneEmergencyPerSession {
    all sess: Session | lone sess.emergencyTriggered
}

// Emergency mode eventually ends (no infinite Emergency)
assert assertR2_EventualReturnToNormal {
    all sess: Session | 
        some et: EmergencyTrigger | et.session = sess =>
            some s: State | s.session = sess && s.mode = NormalMode && (et.endedAt = s.t or false)
}

// Emergency privileges only during Emergency, and only for triggering admins
assert assertR3_OnlyTriggeringAdminsGetEmergencyPrivs {
    all s: State |
        s.mode = EmergencyMode =>
            s.emergencyAdmins in Administrator &&
            all a: s.emergencyAdmins | 
                some et: EmergencyTrigger | a in et.admins && et.session = s.session && et.at <= s.t && (no et.endedAt or s.t < et.endedAt)
}

// =============================
// Run and Check Commands
// =============================

// 1. Baseline: Existing system is consistent and satisfiable
run baseline

// 2. All requirements (comprehensive)
run All_Requirements

// 3. Incremental predicates
run R1
run R1R2
run R1R2R3
run R1R2R3R4

// 4. Assertions
check assertR1_OnlyTwoAdminsTrigger
check assertR1_OneEmergencyPerSession
check assertR2_EventualReturnToNormal
check assertR3_OnlyTriggeringAdminsGetEmergencyPrivs

