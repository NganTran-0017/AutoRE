open util/ordering[Time] as TO

// =========================
// Alloy 6 Model for RBAC Emergency Module Requirements (Global Emergency Mode)
// =========================

// --- Abstract Sets and Relations ---

abstract sig User {
    clearance: one Clearance
}

abstract sig Administrator extends User {}

abstract sig Role {}
abstract sig Permission {}

abstract sig Clearance {} // e.g., High, Medium, Low

// --- directAssignment: Users directly assigned to Roles (global relation, see holdsRoleDirectly) ---
one sig DirectAssignmentRel {
    directAssignment: User -> Role
}

// --- Clearance Atoms ---
// The first three Clearance atoms in any instance should be interpreted as HighClearance, MediumClearance, and LowClearance, respectively.
fact ClearanceAtoms {
    some disj h, m, l: Clearance |
        h = h and m = m and l = l
}

// --- Mutually Exclusive Roles ---
// MutexRolePair defines symmetric, paired mutex relation (no self-mutex)
sig MutexRolePair {
    r1, r2: disj Role
}

// Enforce mutex role requirements (R6.1, R6.2)
fact MutexRoleSymmetryAndNoSelf {
    // Symmetry and pairing: for every pair, a symmetric exists; no self-mutex
    all p: MutexRolePair | p.r1 != p.r2
    all p: MutexRolePair | one q: MutexRolePair | q.r1 = p.r2 and q.r2 = p.r1
    // No role is mutex with itself
    all p: MutexRolePair | p.r1 != p.r2
}

// --- Set of all mutex roles for convenience ---
fun mutexRoles: set Role {
    MutexRolePair.r1 + MutexRolePair.r2
}

// Emergency privileges are an abstract set of permissions
one sig EmergencyPrivileges {
    perms: set Permission
}

// --- Bool enum for logical fields ---
enum Bool { True, False }

// Delegated role assignment with temporal scoping
// Regenerated: Add 'initiatedIn: one SystemMode' to track the system mode in which the delegation was created
sig Delegation {
    role: one Role,
    to: one User,
    delegatedBy: one Administrator,
    delegatedAt: one Time,
    expiresAt: lone Time,  // If not set, persists until revoked
    revoked: one Bool,     // True if revoked
    duringEmergency: one Bool, // Deprecated, replaced by initiatedIn
    initiatedIn: one SystemMode // New: precisely tracks the mode system was in at delegatedAt
}

// Requests and processing
sig Request {
    submittedBy: one User,
    classification: one Clearance,
    submittedAt: one Time,
    processedAt: lone Time,
    processor: one User // Processor identity must always be logged
}

// System modes (global, not per session)
abstract sig SystemMode {}
one sig NormalMode, EmergencyMode extends SystemMode {}

// Emergency trigger event: exactly 2 admins, at a time
sig EmergencyTrigger {
    admins: set Administrator,
    at: one Time,
    endedEarly: one Bool, // True if ended manually by same admins
    endedAt: lone Time    // Set when Emergency ends
}

// Time abstraction (no concrete ticks)
sig Time {
    next: lone Time
}

// System session
sig Session {}

// System state at a time (global mode)
sig State {
    t: one Time,
    mode: one SystemMode,
    delegations: set Delegation,
    requests: set Request,
    emergencyAdmins: set Administrator,
    sessions: set Session
}

// --- Existing System Assumptions and Structural Constraints ---

// All administrators have high clearance (but non-admins may also have high)
fact AdminsHaveHighClearance {
    some disj h, m, l: Clearance |
        all a: Administrator | a.clearance = h
}

// All sessions share the same mode at any given time (mode is global)
fact AllSessionsShareMode {
    all s: State | all sess: Session | sess in s.sessions
}

// Only one active Emergency at a time (no overlap), trigger is global
fact SingleActiveEmergency {
    all s: State |
        lone et: EmergencyTrigger |
            some et.endedAt and TO/lte[et.at, s.t] and TO/lt[s.t, et.endedAt] =>
                s.mode = EmergencyMode
}

// Structure and constraints for EmergencyTrigger (must be unique per system, not per session)
fact EmergencyTriggerStructure {
    all et: EmergencyTrigger | #et.admins = 2 and all a: et.admins | a in Administrator
    // endedAt must always be set for each trigger and >= at
    all et: EmergencyTrigger | one et.endedAt and TO/lte[et.at, et.endedAt]
    // If endedEarly, endedAt is within start..start+4; else, exactly at+5
    all et: EmergencyTrigger | let start = et.at |
        (et.endedEarly = True) => (
            TO/gte[et.endedAt, start] &&
            TO/lte[et.endedAt, TO/next[TO/next[TO/next[TO/next[start]]]]]
        )
    all et: EmergencyTrigger | let start = et.at |
        (et.endedEarly = False) => (
            some TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]] &&
            et.endedAt = TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]]
        )
}

// --- EmergencyModeGlobality (REGENERATED) ---
// Emergency mode is a global system-wide property; only one system-wide mode, transitions only as permitted, strict mutual exclusion and restoration.
// Emergency-mode delegations: Only delegations initiated in Emergency mode (i.e., Delegation.initiatedIn = EmergencyMode) must be revoked before or at the Emergency/Normal transition; others persist as per their policy.
fact EmergencyModeGlobality {
    // System always starts in NormalMode at initial state
    all s0: State | s0.t = TO/first => s0.mode = NormalMode

    // EmergencyMode is active iff there exists an EmergencyTrigger such that et.at <= s.t < et.endedAt
    all s: State |
        (some et: EmergencyTrigger | TO/lte[et.at, s.t] and TO/lt[s.t, et.endedAt]) <=> (s.mode = EmergencyMode)

    // At or after endedAt, system must be in NormalMode
    all et: EmergencyTrigger | one et.endedAt =>
        all s: State | TO/gte[s.t, et.endedAt] => s.mode = NormalMode

    // No EmergencyTrigger can be activated while EmergencyMode is active
    all et: EmergencyTrigger | some s: State | s.t = et.at and s.mode = NormalMode

    // No two EmergencyTriggers overlap in time
    all et1, et2: EmergencyTrigger | et1 != et2 =>
        (TO/lt[et1.endedAt, et2.at] or TO/lt[et2.endedAt, et1.at])

    // Only one EmergencyTrigger may be active at any time
    all s: State |
        lone et: EmergencyTrigger | TO/lte[et.at, s.t] and TO/lt[s.t, et.endedAt]

    // Emergency privileges: only the triggering admins hold emergency privileges in EmergencyMode, and ONLY during EmergencyMode
    all s: State |
        (s.mode = EmergencyMode =>
            one et: EmergencyTrigger | TO/lte[et.at, s.t] and TO/lt[s.t, et.endedAt] and
                s.emergencyAdmins = et.admins and
                all a: s.emergencyAdmins | a in Administrator
        )
        and
        (s.mode = NormalMode => s.emergencyAdmins = none)

    // Revocation of Emergency privileges and Emergency-mode delegations (regenerated per requirements):
    // - For all s: State where s.mode = NormalMode and s.t >= et.endedAt, for each EmergencyTrigger et:
    //   - emergencyAdmins is empty (privileges revoked)
    //   - all delegations initiated during EmergencyMode (d.initiatedIn = EmergencyMode) are revoked in s
    //   - delegations initiated in NormalMode may persist
    all et: EmergencyTrigger | one et.endedAt =>
        all s: State | TO/gte[s.t, et.endedAt] and s.mode = NormalMode => {
            s.emergencyAdmins = none
            all d: Delegation |
                d.initiatedIn = EmergencyMode and
                d in s.delegations and
                TO/lte[d.delegatedAt, s.t] and
                (no d.expiresAt or TO/lt[s.t, d.expiresAt]) =>
                    d.revoked = True
        }
    // Emergency-mode delegations (initiatedIn = EmergencyMode) MAY remain active through the last EmergencyMode state,
    // but must be revoked before (and not present in) any NormalMode state.
    all et: EmergencyTrigger | one et.endedAt => {
        // For all s: State, if s.mode = EmergencyMode and TO/lt[s.t, et.endedAt],
        // Emergency-mode delegations may be active and unrevoked in s.
        // For all s: State, if s.mode = NormalMode and TO/gte[s.t, et.endedAt],
        // Emergency-mode delegations must be revoked in s (see above).
        // No Emergency-mode delegation may persist into any NormalMode state.
        all d: Delegation | d.initiatedIn = EmergencyMode =>
            all s: State |
                s.mode = NormalMode and TO/gte[s.t, et.endedAt] and d in s.delegations and
                TO/lte[d.delegatedAt, s.t] and
                (no d.expiresAt or TO/lt[s.t, d.expiresAt]) =>
                    d.revoked = True
    }
    // Delegations initiated in NormalMode before Emergency may persist through EmergencyMode unless expired or revoked.
    // (No fact needed for this; just do NOT require revocation.)
}

// Each session may only trigger Emergency mode once (enforced globally)
fact OneEmergencyPerSystem {
    #EmergencyTrigger <= 1
}

// --- Delegation Constraints (R5) ---

// Prohibit self-delegation, and delegation of delegated roles; restrict delegation to direct assignees; enforce expiry strictly after delegatedAt
fact DelegationValidity {
    all d: Delegation | d.to != d.delegatedBy  // No self-delegation
    // Only directly assigned roles may be delegated; delegatedBy must hold the role directly (not via delegation)
    // For all d: Delegation, at delegatedAt, delegatedBy must hold role directly (not via delegation)
    all d: Delegation | 
        let t = d.delegatedAt, r = d.role, admin = d.delegatedBy | 
            holdsRoleDirectly[admin, r, t]
    // No delegation of delegated roles: the delegatedBy's holding of the role must not itself be via delegation
    // (Enforced above in holdsRoleDirectly)
    // Expiry (if present) must be strictly after delegatedAt
    all d: Delegation | some d.expiresAt => TO/lt[d.delegatedAt, d.expiresAt]
}

// Helper: A user holds a role directly at time t iff assigned, not via delegation
pred holdsRoleDirectly[u: User, r: Role, t: Time] {
    (u -> r) in DirectAssignmentRel.directAssignment and
    // No evidence of delegation required for holding (i.e., not via another Delegation chain)
    no d: Delegation | d.role = r and d.to = u and TO/lte[d.delegatedAt, t] and (no d.expiresAt or TO/lt[t, d.expiresAt]) and d.revoked = False
}

// Roles held by user at state (including delegations active at t)
fun rolesHeld[u: User, s: State]: set Role {
    { d: Delegation |
        d.to = u and TO/lte[d.delegatedAt, s.t] and
        (no d.expiresAt or TO/lt[s.t, d.expiresAt]) and
        d.revoked = False and
        d in s.delegations
    }.role
    // If modeling direct assignment, add: + { r: Role | (u->r) in DirectAssignmentRel.directAssignment }
}

// --- Request Processing Logging (R7) ---
fact RequestProcessorLogging {
    all r: Request | one r.processor
}

// =============================
// --- EmergencyMutexBypass ---
// (R3.2) In Emergency mode, if a user holds two mutex roles, at least one must have been delegated.
// (Satisfies: Users may hold mutex roles simultaneously only during Emergency, and at least one must be delegated)
fact EmergencyMutexBypass {
    // Users may only hold mutex roles simultaneously in EmergencyMode
    all s: State | all u: User |
        #(mutexRoles & rolesHeld[u, s]) >= 2 implies s.mode = EmergencyMode

    // In EmergencyMode, if a user holds two mutex roles, at least one must have been delegated
    all s: State | s.mode = EmergencyMode =>
        all u: User |
            some disj r1, r2: mutexRoles |
                r1 != r2 and r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s] =>
                    (some d: Delegation |
                        d.to = u and d.role in (r1 + r2) and
                        d in s.delegations and
                        TO/lte[d.delegatedAt, s.t] and
                        (no d.expiresAt or TO/lt[s.t, d.expiresAt]) and d.revoked = False)
}

// --- Baseline Predicate: Existing System Only ---
pred baseline { }

// =============================
// Prospective Requirements
// =============================

// --- R1: Emergency Triggering (Global) ---
pred R1 {
    // Exactly 2 admins trigger global Emergency only in Normal mode
    all et: EmergencyTrigger | #et.admins = 2
    // Only one Emergency trigger per system
    #EmergencyTrigger <= 1
    // EmergencyTrigger only possible in Normal mode at trigger time
    all et: EmergencyTrigger |
        some s: State | s.t = et.at and s.mode = NormalMode
    // No EmergencyTrigger event allowed while EmergencyMode is active
    all s: State |
        s.mode = EmergencyMode =>
            no et: EmergencyTrigger | et.at = s.t
}

// --- R2: Emergency Mode Duration & Exit (5-step timeout or early end) ---
pred R1R2 {
    R1[]
    all et: EmergencyTrigger | let start = et.at | {
        one et.endedAt
        TO/gte[et.endedAt, start]
        TO/lte[et.endedAt, TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]]]

        (et.endedEarly = True) => (
            TO/gte[et.endedAt, start] &&
            TO/lte[et.endedAt, TO/next[TO/next[TO/next[TO/next[start]]]]]
        )
        (et.endedEarly = False) => (
            some TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]] &&
            et.endedAt = TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]]
        )

        // There must exist a State at endedAt where the mode is NormalMode
        some s: State | s.t = et.endedAt and s.mode = NormalMode

        // For all States, if s.t >= et.endedAt then mode is NormalMode
        all s: State | (TO/gte[s.t, et.endedAt]) => s.mode = NormalMode

        // EmergencyMode must be active from at (inclusive) up to endedAt (exclusive), then Normal
        all s: State |
            ((TO/gte[s.t, start] and TO/lt[s.t, et.endedAt]) => s.mode = EmergencyMode)
    }
    // System always starts in NormalMode at first state
    all s0: State | s0.t = TO/first => s0.mode = NormalMode
}

// --- R3: Emergency Processing and Privileges (Global) ---
pred R1R2R3 {
    R1R2[]
    some disj h, m, l: Clearance {
        // Request processing order may be bypassed in Emergency (system-wide)
        all s: State |
            s.mode = EmergencyMode =>
                all r1, r2: s.requests |
                    (r1.classification = h and r2.classification = l and TO/gt[r1.submittedAt, r2.submittedAt]) =>
                        (no r1.processedAt or TO/lte[r1.processedAt, r2.processedAt])
        // Mutually exclusive roles may be held simultaneously only in Emergency; mutex bypass enforced via fact
        all s: State |
            all u: User |
                #(mutexRoles & rolesHeld[u, s]) >= 2 implies s.mode = EmergencyMode
        // --- Emergency privilege assignment (R3.3) ---
        // In EmergencyMode, only the two triggering admins hold emergency privileges (no handoff, no overlap, strict exclusivity).
        all s: State |
            s.mode = EmergencyMode =>
                one et: EmergencyTrigger | TO/lte[et.at, s.t] and TO/lt[s.t, et.endedAt] and
                    s.emergencyAdmins = et.admins and
                    all a: s.emergencyAdmins | a in Administrator
        // In NormalMode, emergencyAdmins is always empty
        all s: State |
            s.mode = NormalMode =>
                s.emergencyAdmins = none
    }
}

// --- R4: Post-Emergency Restoration (Global) ---
// Regenerated: Only delegations initiated in Emergency mode (Delegation.initiatedIn = EmergencyMode) must be revoked prior to or at Emergency/Normal transition; Normal-mode delegations may persist.
pred R1R2R3R4 {
    R1R2R3[]
    // Emergency privileges revoked after Emergency ends (already enforced)
    // Emergency-mode delegations revoked at Emergency end; prior delegations persist as per their policy
    all et: EmergencyTrigger | one et.endedAt =>
        all s: State | TO/gte[s.t, et.endedAt] and s.mode = NormalMode =>
            all d: Delegation |
                d.initiatedIn = EmergencyMode and d in s.delegations => d.revoked = True
    // Credential update required after Emergency for triggering admins (abstracted as a flag/condition)
    all et: EmergencyTrigger |
        some s: State | s.mode = NormalMode and some et.endedAt and et.endedAt = s.t =>
            all a: et.admins | credentialUpdated[a, s]
}

// --- R5, R6, R7 constraints are in facts above ---

// --- All Requirements ---
pred All_Requirements {
    R1R2R3R4[]
    // All facts are enforced globally
}

// --- Credential update helper predicate (abstract) ---
pred credentialUpdated[a: Administrator, s: State] {
    some a // Always true for abstract model
}

// =============================
// --- Delegation Coverage Witnesses (REGENERATED) ---
// For verification only: existentially require that there exists at least one execution (instance) with a delegation initiated and active during Emergency mode (not in NormalMode),
// and at least one (possibly different) execution (instance) with a delegation initiated and active during Normal mode.  These do not have to occur in the same execution.

// There exists a State in EmergencyMode with an active, unrevoked delegation that was initiated in EmergencyMode.
pred DelegationCoverageEmergency {
    some s: State | s.mode = EmergencyMode and
        some d: Delegation |
            d in s.delegations and
            d.initiatedIn = EmergencyMode and
            d.revoked = False and
            TO/lte[d.delegatedAt, s.t] and
            (no d.expiresAt or TO/lt[s.t, d.expiresAt])
}

// There exists a State in NormalMode with an active, unrevoked delegation that was initiated in NormalMode.
pred DelegationCoverageNormal {
    some s: State | s.mode = NormalMode and
        some d: Delegation |
            d in s.delegations and
            d.initiatedIn = NormalMode and
            d.revoked = False and
            TO/lte[d.delegatedAt, s.t] and
            (no d.expiresAt or TO/lt[s.t, d.expiresAt])
}

// DelegationCoverage is for verification only: requires that there exist
// (possibly different) executions with Emergency-mode and Normal-mode delegations active.
// Not required in a single run instance.
pred DelegationCoverage { }

// =============================
// --- Assertions for Verification (REGENERATED as needed) ---
// =============================

// Only two admins can ever trigger Emergency (globally)
assert assertR1_OnlyTwoAdminsTrigger {
    all et: EmergencyTrigger | #et.admins = 2
}

// Emergency mode cannot be started twice in the system
assert assertR1_OneEmergencyPerSystem {
    #EmergencyTrigger <= 1
}

// Emergency mode eventually ends, system returns to NormalMode globally
assert assertR2_EventualReturnToNormal {
    all et: EmergencyTrigger | 
        (some s: State | TO/lte[s.t, et.endedAt] and s.mode = NormalMode)
        and
        (all s: State | (TO/gte[s.t, et.endedAt]) implies s.mode = NormalMode)
}

// Strictly, only the two triggering admins may hold emergency privileges during EmergencyMode; in NormalMode, privileges are always empty.
assert assertR3_OnlyTriggeringAdminsGetEmergencyPrivs {
    // In EmergencyMode, for every State, emergencyAdmins = exactly the two triggering admins (no more, no less, no overlap)
    all s: State | s.mode = EmergencyMode =>
        one et: EmergencyTrigger | TO/lte[et.at, s.t] and TO/lt[s.t, et.endedAt] and
            s.emergencyAdmins = et.admins and
            all a: s.emergencyAdmins | a in Administrator
    // In NormalMode, emergencyAdmins is always empty
    all s: State | s.mode = NormalMode => s.emergencyAdmins = none
}

// Roles delegated during Emergency (i.e., initiatedIn = EmergencyMode) are revoked after Emergency ends, prior delegations (initiatedIn = NormalMode) persist
assert assertR4_EmergencyDelegationsRevoked {
    all et: EmergencyTrigger | one et.endedAt =>
        all s: State | TO/gte[s.t, et.endedAt] and s.mode = NormalMode =>
            all d: Delegation |
                d.initiatedIn = EmergencyMode and d in s.delegations => d.revoked = True
}

// Delegation coverage is existential, not per-instance: there exists an instance with Emergency-mode delegation, and an instance with Normal-mode delegation (not necessarily the same one)
assert assertDelegationCoverage {
    DelegationCoverageEmergency[]
    DelegationCoverageNormal[]
}

// =============================
// Run and Check Commands
// =============================

// 1. Baseline: Existing system is consistent and satisfiable
run baseline for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

// 2. All requirements (comprehensive)
run All_Requirements for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

// 3. Incremental predicates
run R1 for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run R1R2 for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run R1R2R3 for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run R1R2R3R4 for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

// 4. Positive coverage: Delegations in both modes (now split for diagnostics)
run DelegationCoverageEmergency for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run DelegationCoverageNormal for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
run DelegationCoverage for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

// 5. Assertions
check assertR1_OnlyTwoAdminsTrigger for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertR1_OneEmergencyPerSystem for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertR2_EventualReturnToNormal for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertR3_OnlyTriggeringAdminsGetEmergencyPrivs for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertR4_EmergencyDelegationsRevoked for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance
check assertDelegationCoverage for 6 but 5 Time, 5 State, 3 Session, 3 EmergencyTrigger, 3 Administrator, 5 User, 5 Role, 5 Delegation, 5 Request, 3 Clearance

**Current Requirements:**
```
SYSTEM OVERVIEW
===============
The system is a Role-Based Access Control (RBAC) platform supporting multi-user operations with role hierarchy, temporary delegation, clearance-based authorization, and concurrent request processing. The system enforces security constraints such as clearance-based permissions, role delegation and revocation, and preserves safety, liveness, and integrity under concurrent operations. A new Emergency Module is to be integrated, enabling a global/system-wide operational mode and privileges during emergencies, with specific triggering, duration, and exit requirements. Emergency mode is a system-wide state: when Emergency mode is triggered, all active sessions enter Emergency mode together, and no session may remain in or independently return to Normal mode until the Emergency ends. Only one Emergency may be active at a time. Administrators may not initiate or participate in separate concurrent Emergencies or acquire independent emergency privileges through different sessions. Emergency privileges and policy relaxations apply consistently across all sessions and are revoked globally when the system returns to Normal mode. Emergency mode can be triggered exactly once per session by exactly 2 administrators, is active for an abstract fixed duration but may be ended early by the same 2 administrators, and grants special privileges only to the triggering administrators, applied globally across all sessions. While Emergency mode is active, new triggers are blocked. Roles delegated during Emergency mode are revoked upon exit (before the first time step of Normal mode), while roles delegated prior persist as per their policy.

EXISTING-SYSTEM ASSUMPTIONS AND CONSTRAINTS
============================================
- Only exactly 2 administrators may jointly trigger Emergency mode when the system is in Normal mode; each session may only trigger Emergency mode once. Emergency mode entry is permitted only under these conditions.
- Emergency mode is a global/system-wide state and is time-limited by an abstract fixed duration and cannot persist indefinitely; the system must ensure eventual return to Normal mode for all sessions together. Early termination is permitted by the same 2 administrators who triggered Emergency mode.
- For every EmergencyTrigger, endedAt must be set (by either timeout or early termination). The system MUST return to NormalMode for all sessions together no later than the endedAt of the EmergencyTrigger, and restoration must not be delayed past endedAt.
- No new Emergency mode triggers are accepted while Emergency mode is active.
- During Emergency mode, request processing order may be bypassed to prioritize high classification requests; this relaxation is temporary and applies system-wide.
- Users may temporarily hold predefined mutually exclusive roles only during Emergency mode. Mutual exclusivity must be symmetric (if A is mutex with B, then B is mutex with A) and paired, and roles cannot be mutex with themselves.
- In Emergency mode, if a user holds two mutually exclusive roles, at least one must have been delegated.
- Only the administrators who triggered Emergency mode hold emergency privileges, defined as an abstract set of permissions, and only for the duration of Emergency mode. Emergency privileges are assigned and revoked globally across all sessions.
- All roles delegated during Emergency mode must be revoked at the Emergency end, before the first time step of Normal mode. Roles delegated prior to Emergency mode persist until expiry or administrator revocation.
- Administrators who held emergency privileges are required to update their credentials immediately upon exit from Emergency mode before resuming normal operations.
- Self-delegation is prohibited: a user cannot delegate a role to themselves.
- Only directly assigned roles may be delegated; delegation of delegated roles is prohibited.
- Delegation authority is restricted to users with direct assignment of the role.
- The expiry of a delegated role must be strictly after its delegation time (delegatedAt).
- For every request, the request processor (the entity processing the request) must be recorded, regardless of whether the request was approved or rejected.
- All administrators have high clearance, but not all high-clearance users are administrators.

PROSPECTIVE FUNCTIONAL REQUIREMENTS
====================================
R1: Emergency Triggering  
Exactly 2 administrators, while the system is in Normal mode, are required to trigger an emergency, causing the system to enter Emergency mode globally. Each session may only trigger Emergency mode once, and no new emergency triggers are accepted while Emergency mode is active. Emergency mode may be triggered only by exactly two administrators under these conditions.

R2: Emergency Mode Duration  
For every EmergencyTrigger, the system MUST return to NormalMode for all sessions together no later than EmergencyTrigger.endedAt, and remain in NormalMode for all subsequent times. Emergency mode may end either by an abstract fixed duration (timeout) or by early termination by the same 2 administrators who triggered it. The return to NormalMode must occur at or before endedAt; restoration must not be delayed past endedAt.

R3: Modified Processing and Privileges During Emergency  
R3.1: During Emergency mode, request processing may bypass FIFO order to prioritize multiple high classification requests simultaneously, system-wide.  
R3.2: During Emergency mode, users may temporarily hold mutually exclusive roles (as defined in the set of mutually exclusive abstract roles). If a user holds two mutually exclusive roles during Emergency mode, at least one must have been delegated (mutex role bypass requirement).  
R3.3: During Emergency mode, only the administrators who triggered Emergency mode temporarily hold emergency privileges, defined as an abstract set of permissions available exclusively during Emergency mode. Emergency privileges are assigned and revoked globally across all sessions.

R4: Post-Emergency Restoration  
R4.1: Emergency privileges must be revoked globally for all triggering administrators at the end of Emergency mode, prior to the first time step of Normal mode; at no time in NormalMode may any administrator hold emergency privileges.  
R4.2: All delegations that are initiated during Emergency mode must be revoked before or at the Emergency/Normal transition (the first time step of Normal mode). Delegations initiated in Normal mode, even if active during Emergency, do not require revocation at this transition. Delegations made during Normal mode, before Emergency mode, can persist across Emergency mode, unless revoked by an admin or expired during Emergency. Delegations during Normal mode must continue until their expiry or revocation, regardless of the system's mode transition.  
R4.3: Administrators who held emergency privileges must update their credentials immediately after Emergency mode ends, before resuming normal operations.

R5: Delegation Requirements  
R5.1: A user cannot delegate a role to themselves (self-delegation prohibition).  
R5.2: Only directly assigned roles may be delegated; delegation of delegated roles is prohibited.  
R5.3: Delegation authority is restricted to users with direct assignment of the role.  
R5.4: The expiry of a delegated role must be strictly after its delegation time (delegatedAt).

R6: Mutual Exclusion (Mutex) Role Requirements  
R6.1: Mutually exclusive roles must be defined in pairs and mutual exclusivity must be symmetric: if Role A is mutex with Role B, then Role B is mutex with Role A.  
R6.2: A role cannot be mutually exclusive with itself.

R7: Request Processing Logging  
R7.1: For every request (regardless of outcome), the system must record the processor responsible for the request.

R8: Delegation Coverage Verification  
R8.1: For verification purposes only, it is sufficient to show that (a) there exists an execution with a delegation initiated and active during Emergency mode, and (b) there exists an execution with a delegation initiated and active during Normal mode; these do not need to occur in the same execution. The absence of a delegation in either mode is permitted in actual system operation.
```

**Relevant lessons:**
Previous Lessons:
1. To require at least one delegation per mode for verification, must add a predicate (not fact) and assert it only for coverage, not as a system constraint.**
2. ** Modeling temporal simultaneity as a concurrency event enables a clean abstraction of "simultaneous" triggers without concrete time intervals. Using separate SystemMode states indexed by Time allows temporal reasoning about mode transitions and properties. Abstracting emergency privileges as distinct Permission subsets clarifies privilege grants and revocation. Temporarily relaxing constraints (mutual exclusivity, FIFO ordering) during Emergency is effectively modeled by conditional facts based on mode. Delegated roles with delegation time and expiry allow temporal scoping and revocation modeling. Assertions and incremental predicates enable stepwise verification of requirements.
3. Model coverage and witness properties with predicates while checking assertions for safety and invariant properties to avoid overconstraining the system.
4. ** Explicitly abstracting temporal simultaneity as concurrency events enables clear, verifiable modeling of triggers requiring simultaneous actions. Modeling emergency privileges as separate permission sets and relaxing mutual exclusivity as a temporary override simplifies reasoning about exceptional modes.
5. Explicitly modeling mutual exclusivity constraints as conditionally active based on system mode is critical to avoid contradictory facts causing vacuity or unsatisfiability. Abstracting temporal simultaneity as concurrency events simplifies emergency triggering verification but requires careful handling of concurrency windows. Small scopes can hide subtle concurrency or revocation bugs; increasing scope improves confidence.

Relevant Q&A:
=== RELEVANT PRIOR CLARIFICATIONS ===

[Q50_1] Context: R8.1
Q: Does R8.1 (DelegationCoverage) require that both an Emergency-mode delegation and a Normal-mode delegation be present in the same execution, or is it sufficient that there exist (possibly separate) executions each witnessing one or the other?
A: R8.1 requires that an Emergency-mode delegation and a Normal-mode delegation can be present in separate executions. Though this execution trace can happen: the Normal-mode delegation can exist first and persist into Emergency, and then the Emergency-mode delegation occurs.
