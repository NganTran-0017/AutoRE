            s.mode = NormalMode =>
                all u: User |
                    lone (MutuallyExclusiveRoleSet.roles & rolesHeld[u, s])

        // Emergency privileges only exist as defined, only for admins
        all s: State |
            all u: User |
                u in s.emergencyAdmins <=> (
                    s.mode = EmergencyMode &&
                    u in Administrator &&
                    some et: EmergencyTrigger | u in et.admins && et.session = s.session && TO/lte[et.at, s.t] && (no et.endedAt or TO/lt[s.t, et.endedAt])
                )

        // Only one EmergencyTrigger per Session
        all sess: Session | lone sess.emergencyTriggered

        // EmergencyTrigger admins must be 2 distinct Administrators
        all et: EmergencyTrigger | #et.admins = 2 && all a: et.admins | a in Administrator

        // Emergency mode can only be active once per session
        all s: State |
            lone et: EmergencyTrigger | et.session = s.session && TO/lte[et.at, s.t] && (no et.endedAt or TO/lt[s.t, et.endedAt]) =>
                s.mode = EmergencyMode

        // System always starts in NormalMode at the initial state for each session
        all sess: Session |
            some s0: State | s0.t = TO/first and s0.session = sess and s0.mode = NormalMode

        // No Emergency trigger can be activated while already in EmergencyMode in that session
        all s: State |
            s.mode = EmergencyMode =>
                no et: EmergencyTrigger | et.session = s.session && et.at = s.t

        // EmergencyTrigger occurs only when mode is Normal at trigger time
        all et: EmergencyTrigger |
            some s: State | s.t = et.at && s.session = et.session && s.mode = NormalMode

        // An EmergencyTrigger's endedAt, if set, must be >= at (cannot end before starting)
        all et: EmergencyTrigger | some et.endedAt => TO/lte[et.at, et.endedAt]

        // No two EmergencyTriggers can overlap in a session (as only one per session)
        all sess: Session |
            lone et: EmergencyTrigger | et.session = sess
    }
}

// --- Emergency Mode Duration and Exit: 5-step Timeout or Early Admin End ---

fact EmergencyModeDurationAndExit {
    // For each EmergencyTrigger, Emergency mode must end after exactly 5 steps from at, unless endedEarly=True, in which case it ends at endedAt (must be between at and at+4)
    all et: EmergencyTrigger | let session = et.session, start = et.at | {
        // If endedEarly=True, endedAt must be between at and at+4 (inclusive)
        (et.endedEarly = True and some et.endedAt) => (
            TO/gte[et.endedAt, start] and
            TO/lte[et.endedAt, TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]]]
        )
        // If not ended early, endedAt must be exactly at at+5
        (et.endedEarly = False or no et.endedAt) => (
            some TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]] and
            et.endedAt = TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]]
        )
        // Emergency mode must be Normal at and after endedAt (if set)
        some et.endedAt => all s: State | (session in s.session and TO/gte[s.t, et.endedAt]) => s.mode = NormalMode
        // Emergency mode must be EmergencyMode for all states from at up to but not including endedAt
        some et.endedAt => all s: State |
            (session in s.session and TO/gte[s.t, start] and TO/lt[s.t, et.endedAt]) => s.mode = EmergencyMode
    }
}

// --- Helper Relations and Functions ---

// Roles held by user at state (including delegations active at t)
fun rolesHeld[u: User, s: State]: set Role {
    { d: Delegation |
        d.to = u && TO/lte[d.delegatedAt, s.t] &&
        (no d.expiresAt or TO/lt[s.t, d.expiresAt]) &&
        d.revoked = False &&
        d in s.delegations
    }.role
}

// --- Baseline Predicate: Existing System Only ---

pred baseline { }

// =============================
// Prospective Requirements
// =============================

// --- R1: Emergency Triggering ---

pred R1 {
    // Exactly 2 admins may jointly trigger Emergency while in Normal mode, causing EmergencyMode
    all et: EmergencyTrigger | #et.admins = 2
    // Each session may only have one Emergency trigger
    all sess: Session | lone sess.emergencyTriggered
    // EmergencyTrigger only possible in Normal mode at trigger time
    all et: EmergencyTrigger |
        some s: State | s.t = et.at && s.session = et.session && s.mode = NormalMode
    // No EmergencyTrigger event allowed while EmergencyMode is active
    all s: State |
        s.mode = EmergencyMode =>
            no et: EmergencyTrigger | et.session = s.session && et.at = s.t
}

// --- R2: Emergency Mode Duration & Exit (5-step timeout or early end) ---

pred R1R2 {
    R1[]
    // For each Emergency, EmergencyMode must last at most 5 steps after trigger, ending at endedAt (timeout or early), then return to Normal
    all et: EmergencyTrigger | let start = et.at | {
        (et.endedEarly = True and some et.endedAt) => (
            TO/gte[et.endedAt, et.at] and
            TO/lte[et.endedAt, TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]]]
        )
        (et.endedEarly = False or no et.endedAt) => (
            some TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]] and
            et.endedAt = TO/next[TO/next[TO/next[TO/next[TO/next[start]]]]]
        )
        // EmergencyMode must be active from at (inclusive) up to endedAt (exclusive), then Normal
        some et.endedAt => all s: State | s.session = et.session =>
            (TO/gte[s.t, et.at] and TO/lt[s.t, et.endedAt] => s.mode = EmergencyMode) and
            (TO/gte[s.t, et.endedAt] => s.mode = NormalMode)
    }
    // System always starts in NormalMode at first state for every session
    all sess: Session | some s0: State | s0.t = TO/first and s0.session = sess and s0.mode = NormalMode
}

// --- R3: Emergency Processing and Privileges ---

pred R1R2R3 {
    R1R2[]
    // Bind Clearance atoms locally for use in this predicate
    some disj h, m, l: Clearance {
        // Request processing order may be bypassed in Emergency
        all s: State |
            s.mode = EmergencyMode =>
                all r1, r2: s.requests |
                    (r1.classification = h && r2.classification = l && TO/gt[r1.submittedAt, r2.submittedAt]) =>
                        (no r1.processedAt or TO/lte[r1.processedAt, r2.processedAt])
        // Mutually exclusive roles may be held simultaneously only in Emergency
        all s: State |
            s.mode = EmergencyMode =>
                all u: User |
                    #(MutuallyExclusiveRoleSet.roles & rolesHeld[u, s]) >= 2 implies s.mode = EmergencyMode
        // Only triggering admins have emergency privileges in Emergency
        all s: State |
            s.mode = EmergencyMode =>
                s.emergencyAdmins =
                    { a: Administrator |
                        some et: EmergencyTrigger |
                            a in et.admins &&
                            et.session = s.session &&
                            TO/lte[et.at, s.t] &&
                            some et.endedAt and TO/lt[s.t, et.endedAt]
                    }
    }
}

// --- R4: Post-Emergency Restoration ---

pred R1R2R3R4 {
    R1R2R3[]
    // Emergency privileges revoked after Emergency ends
    all s: State |
        s.mode = NormalMode =>
            s.emergencyAdmins = none
    // Roles delegated during Emergency revoked at Emergency end; prior delegations persist
    all s: State |
        s.mode = NormalMode =>
            all d: Delegation |
                d.duringEmergency = True && d in s.delegations => d.revoked = True
    // Credential update required after Emergency for triggering admins (abstracted as a flag/condition)
    all et: EmergencyTrigger |
        some s: State | s.session = et.session && s.mode = NormalMode && some et.endedAt && et.endedAt = s.t =>
            all a: et.admins | credentialUpdated[a, s]
}

// --- All Requirements ---

pred All_Requirements {
    R1R2R3R4[]
}

// --- Credential update helper predicate (abstract) ---
pred credentialUpdated[a: Administrator, s: State] {
    // Abstract: mark that admin a updated credentials at/after s.t
    // Satisfiable by some State property or sequence; left abstract for now
    some a // Always true for abstract model
}

// =============================
// Assertions for Verification
// =============================

// Only two admins can ever trigger Emergency in a session
assert assertR1_OnlyTwoAdminsTrigger {
    all et: EmergencyTrigger | #et.admins = 2
}

// Emergency mode cannot be started twice in one session
assert assertR1_OneEmergencyPerSession {
    all sess: Session | lone sess.emergencyTriggered
}

// Emergency mode eventually ends (no infinite Emergency)
assert assertR2_EventualReturnToNormal {
    all sess: Session |
        some et: EmergencyTrigger | et.session = sess =>
            some s: State | s.session = sess && s.mode = NormalMode && some et.endedAt && et.endedAt = s.t
}

// Emergency privileges only during Emergency, and only for triggering admins
assert assertR3_OnlyTriggeringAdminsGetEmergencyPrivs {
    all s: State |
        s.mode = EmergencyMode =>
            s.emergencyAdmins in Administrator &&
            all a: s.emergencyAdmins |
                some et: EmergencyTrigger | a in et.admins && et.session = s.session && TO/lte[et.at, s.t] && some et.endedAt && TO/lt[s.t, et.endedAt]
}

// =============================
// Run and Check Commands
// =============================

// 1. Baseline: Existing system is consistent and satisfiable
run baseline

// 2. All requirements (comprehensive)
run All_Requirements

// 3. Incremental predicates
run R1
run R1R2
run R1R2R3
run R1R2R3R4

// 4. Assertions
check assertR1_OnlyTwoAdminsTrigger
check assertR1_OneEmergencyPerSession
check assertR2_EventualReturnToNormal
check assertR3_OnlyTriggeringAdminsGetEmergencyPrivs
```

[LESSON]: When comparing a singleton set field to an atom in Alloy 6, use the in operator (atom in singleton set) rather than equality (field = atom) to avoid type errors in boolean expressions.
