// =========================
// Alloy 6 Model for RBAC Emergency Module Requirements
// =========================

// --- Open built-in ordering for Time ---

open util/ordering[Time] as TO

// --- Abstract Sets and Relations ---

abstract sig User {
    clearance: one Clearance
}

abstract sig Administrator extends User {}

abstract sig Role {}
abstract sig Permission {}

abstract sig Clearance {} // e.g., High, Medium, Low

// --- Clearance Atoms ---
// The first three Clearance atoms in any instance should be interpreted as HighClearance, MediumClearance, and LowClearance, respectively.
fact ClearanceAtoms {
    some disj h, m, l: Clearance |
        h = h and m = m and l = l
}

// Predefined abstract set of mutually exclusive roles
one sig MutuallyExclusiveRoleSet {
    roles: set Role
}

// Emergency privileges are an abstract set of permissions
one sig EmergencyPrivileges {
    perms: set Permission
}

// --- Bool enum for logical fields ---
enum Bool { True, False }

// Delegated role assignment with temporal scoping
sig Delegation {
    role: one Role,
    to: one User,
    delegatedBy: one Administrator,
    delegatedAt: one Time,
    expiresAt: lone Time,  // If not set, persists until revoked
    revoked: one Bool,     // True if revoked
    duringEmergency: one Bool // True if delegated during Emergency
}

// Requests and processing
sig Request {
    submittedBy: one User,
    classification: one Clearance,
    submittedAt: one Time,
    processedAt: lone Time
}

// System modes
abstract sig SystemMode {}
one sig NormalMode, EmergencyMode extends SystemMode {}

// System session (each session: only one Emergency allowed)
sig Session {
    // This session's Emergency trigger event (if any)
    emergencyTriggered: lone EmergencyTrigger
}

// Emergency trigger event: exactly 2 admins, at a time, in a session
sig EmergencyTrigger {
    admins: set Administrator,
    at: one Time,
    session: one Session,
    endedEarly: one Bool, // True if ended manually by same admins
    endedAt: lone Time    // Set when Emergency ends
}

// Time abstraction (no concrete ticks)
sig Time {
    next: lone Time
}

// System state at a time
sig State {
    t: one Time,
    mode: one SystemMode,
    session: one Session,
    // Set of active delegations
    delegations: set Delegation,
    // Requests submitted so far
    requests: set Request,
    // Emergency privilege assignment: mapping admin <-> active/inactive
    emergencyAdmins: set Administrator
}

// --- Existing System Assumptions and Structural Constraints ---

fact ExistingSystem {
    // Administrators have high clearance
    // Bind Clearance atoms for use here and in other constraints
    some disj h, m, l: Clearance {
        all a: Administrator | a.clearance = h

        // Users only hold mutually exclusive roles if Emergency
        all s: State |
            s.mode = NormalMode =>
                all u: User |
                    lone (MutuallyExclusiveRoleSet.roles & rolesHeld[u, s])

        // Emergency privileges only exist as defined, only for admins
        all s: State |
            all u: User |
                u in s.emergencyAdmins <=> (
                    s.mode = EmergencyMode &&
                    u in Administrator &&
                    some et: EmergencyTrigger | u in et.admins && et.session = s.session && TO/lte[et.at, s.t] && (no et.endedAt or TO/lt[s.t, et.endedAt])
                )

        // Only one EmergencyTrigger per Session
        all sess: Session | lone sess.emergencyTriggered

        // EmergencyTrigger admins must be 2 distinct Administrators
        all et: EmergencyTrigger | #et.admins = 2 && all a: et.admins | a in Administrator

        // Emergency mode can only be active once per session
        all s: State | 
            lone et: EmergencyTrigger | et.session = s.session && TO/lte[et.at, s.t] && (no et.endedAt or TO/lt[s.t, et.endedAt]) =>
                s.mode = EmergencyMode
    }
}

// --- Helper Relations and Functions ---

// Roles held by user at state (including delegations active at t)
fun rolesHeld[u: User, s: State]: set Role {
    { d: Delegation |
        d.to = u && TO/lte[d.delegatedAt, s.t] &&
        (no d.expiresAt or TO/lt[s.t, d.expiresAt]) &&
        d.revoked = False &&
        d in s.delegations
    }.role
}

// --- Baseline Predicate: Existing System Only ---

pred baseline { }

// =============================
// Prospective Requirements
// =============================

// --- R1: Emergency Triggering ---

pred R1 {
    // In Normal mode, exactly 2 admins may trigger Emergency, switching mode
    some et: EmergencyTrigger | 
        let s0 = {s: State | s.t = et.at && s.session = et.session} |
        some s0 && all s: s0 | s.mode = EmergencyMode &&
        #et.admins = 2 && all a: et.admins | a in Administrator
    // Only one Emergency trigger per session
    all sess: Session | lone sess.emergencyTriggered
    // No Emergency trigger during Emergency
    all s: State | 
        s.mode = EmergencyMode => 
            no et: EmergencyTrigger | et.session = s.session && et.at = s.t
}

// --- R2: Emergency Mode Duration & Exit ---

pred R1R2 {
    R1[]
    // Emergency mode remains active for a fixed duration unless ended early by same admins
    all et: EmergencyTrigger | 
        (some sStart: State | sStart.t = et.at && sStart.session = et.session && sStart.mode = EmergencyMode)
        implies
        (
            (all s: State | (s.session = et.session && (s.t = et.endedAt or (no et.endedAt and none != none))) => s.mode = NormalMode)
            &&
            (some s: State | s.session = et.session && (s.t = et.endedAt or (no et.endedAt and none != none)))
        )
    // No new Emergency trigger during Emergency mode
    all s: State | 
        s.mode = EmergencyMode =>
            no et: EmergencyTrigger | et.session = s.session && et.at = s.t
}

// --- R3: Emergency Processing and Privileges ---

pred R1R2R3 {
    R1R2[]
    // Bind Clearance atoms locally for use in this predicate
    some disj h, m, l: Clearance {
        // Request processing order may be bypassed in Emergency
        all s: State | 
            s.mode = EmergencyMode => 
                all r1, r2: s.requests | 
                    (r1.classification = h && r2.classification = l && TO/gt[r1.submittedAt, r2.submittedAt]) =>
                        (no r1.processedAt or TO/lte[r1.processedAt, r2.processedAt])
        // Mutually exclusive roles may be held simultaneously only in Emergency
        all s: State | 
            s.mode = EmergencyMode => 
                all u: User | 
                    #(MutuallyExclusiveRoleSet.roles & rolesHeld[u, s]) >= 2 implies s.mode = EmergencyMode
        // Only triggering admins have emergency privileges in Emergency
        all s: State | 
            s.mode = EmergencyMode =>
                s.emergencyAdmins = 
                    { a: Administrator | 
                        some et: EmergencyTrigger | 
                            a in et.admins && 
                            et.session = s.session && 
                            TO/lte[et.at, s.t] && 
                            (no et.endedAt or TO/lt[s.t, et.endedAt])
                    }
    }
}

// --- R4: Post-Emergency Restoration ---

pred R1R2R3R4 {
    R1R2R3[]
    // Emergency privileges revoked after Emergency ends
    all s: State | 
        s.mode = NormalMode =>
            s.emergencyAdmins = none
    // Roles delegated during Emergency revoked at Emergency end; prior delegations persist
    all s: State | 
        s.mode = NormalMode =>
            all d: Delegation | 
                d.duringEmergency = True && d in s.delegations => d.revoked = True
    // Credential update required after Emergency for triggering admins (abstracted as a flag/condition)
    all et: EmergencyTrigger | 
        some s: State | s.session = et.session && s.mode = NormalMode && et.endedAt = s.t =>
            all a: et.admins | credentialUpdated[a, s]
}

// --- All Requirements ---

pred All_Requirements {
    R1R2R3R4[]
}

// --- Credential update helper predicate (abstract) ---
pred credentialUpdated[a: Administrator, s: State] { 
    // Abstract: mark that admin a updated credentials at/after s.t
    // Satisfiable by some State property or sequence; left abstract for now
    // E.g., can be replaced with a concrete event in a more detailed model
    some a // Always true for abstract model
}

// =============================
// Assertions for Verification
// =============================

// Only two admins can ever trigger Emergency in a session
assert assertR1_OnlyTwoAdminsTrigger {
    all et: EmergencyTrigger | #et.admins = 2
}

// Emergency mode cannot be started twice in one session
assert assertR1_OneEmergencyPerSession {
    all sess: Session | lone sess.emergencyTriggered
}

// Emergency mode eventually ends (no infinite Emergency)
assert assertR2_EventualReturnToNormal {
    all sess: Session | 
        some et: EmergencyTrigger | et.session = sess =>
            some s: State | s.session = sess && s.mode = NormalMode && (et.endedAt = s.t or none != none)
}

// Emergency privileges only during Emergency, and only for triggering admins
assert assertR3_OnlyTriggeringAdminsGetEmergencyPrivs {
    all s: State |
        s.mode = EmergencyMode =>
            s.emergencyAdmins in Administrator &&
            all a: s.emergencyAdmins | 
                some et: EmergencyTrigger | a in et.admins && et.session = s.session && TO/lte[et.at, s.t] && (no et.endedAt or TO/lt[s.t, et.endedAt])
}

// =============================
// Run and Check Commands
// =============================

// 1. Baseline: Existing system is consistent and satisfiable
run baseline

// 2. All requirements (comprehensive)
run All_Requirements

// 3. Incremental predicates
run R1
run R1R2
run R1R2R3
run R1R2R3R4

// 4. Assertions
check assertR1_OnlyTwoAdminsTrigger
check assertR1_OneEmergencyPerSession
check assertR2_EventualReturnToNormal
check assertR3_OnlyTriggeringAdminsGetEmergencyPrivs

**Current Requirements:**
```
SYSTEM OVERVIEW
===============
The system is a Role-Based Access Control (RBAC) platform supporting multi-user operations with role hierarchy, temporary delegation, clearance-based authorization, and concurrent request processing. The system enforces security constraints such as clearance-based permissions, role delegation and revocation, and preserves safety, liveness, and integrity under concurrent operations. A new Emergency Module is to be integrated, enabling special operational modes and privileges during emergencies, with specific triggering, duration, and exit requirements. Emergency mode can be triggered exactly once per session by exactly 2 administrators, is active for an abstract fixed duration but may be ended early by the same 2 administrators, and grants special privileges only to the triggering administrators. While Emergency mode is active, new triggers are blocked. Roles delegated during Emergency mode are revoked upon exit, while roles delegated prior persist as per their policy.

PROSPECTIVE FUNCTIONAL REQUIREMENTS
=======================
R1: Emergency Triggering  
Exactly 2 administrators, while the system is in Normal mode, are required to trigger an emergency, causing the system to enter Emergency mode. Each session may only trigger Emergency mode once, and no new emergency triggers are accepted while Emergency mode is active.

R2: Emergency Mode Duration  
Emergency mode remains active for an abstract fixed duration, unless ended earlier by the same 2 administrators who triggered it. The system must eventually return to Normal mode, either automatically after the fixed duration or manually if ended early.

R3: Modified Processing and Privileges During Emergency  
R3.1: During Emergency mode, request processing may bypass FIFO order to prioritize multiple high classification requests simultaneously.  
R3.2: During Emergency mode, users may temporarily hold mutually exclusive roles (as defined in the set of mutually exclusive abstract roles).  
R3.3: During Emergency mode, only the administrators who triggered Emergency mode temporarily hold emergency privileges, defined as an abstract set of permissions available exclusively during Emergency mode.

R4: Post-Emergency Restoration  
R4.1: After Emergency mode ends, emergency privileges must be revoked from the administrators who held them.  
R4.2: All roles that were delegated during Emergency mode must be revoked upon exit from Emergency mode. Roles delegated prior to Emergency mode (during Normal mode) remain active until their expiry or until revoked by an administrator.  
R4.3: Administrators who held emergency privileges must update their credentials after Emergency mode ends.

KEY CONCEPTS AND ENTITIES
==========================
- User: An actor in the system, associated with a clearance level.
- Administrator: A user with High clearance and special administrative privileges. Only administrators can trigger or end Emergency mode and receive emergency privileges if they are the triggering administrators.
- Role: A set of permissions that can be assigned or delegated to users.
- Delegated Role: A role temporarily granted to a user, subject to clearance and expiration/revocation. Delegated roles granted during Emergency mode are revoked upon exit from Emergency mode.
- Emergency Mode: A special system state with altered processing and privilege rules, entered upon a valid emergency trigger by exactly 2 administrators, lasting a fixed duration unless ended early by the same administrators. Only one Emergency mode may be active per session.
- Normal Mode: The default operational state of the system.
- Emergency Privileges: An abstract set of permissions granted only to the administrators who triggered Emergency mode, effective only during Emergency mode.
- Mutually Exclusive Roles: A predefined abstract set of roles that cannot normally be held by the same user, but may be simultaneously held during Emergency mode.
- Request: A user-submitted action affecting system objects, classified by the objects’ security classifications.
- Request Processing Order: The order in which submitted requests are processed (normally FIFO; can be altered in Emergency mode to prioritize high classification requests).
- Credential Update: The process by which administrators update their authentication or authorization data after Emergency mode.

ASSUMPTIONS REQUIRING CLARIFICATION
====================================
1. No further clarification needed regarding Emergency mode duration, triggering, privileges, mutually exclusive roles, or post-emergency delegation, as these have been defined per user clarifications. Any changes to the abstract nature of emergency privileges or mutually exclusive roles should be explicitly specified.

CONSTRAINTS
===========
- Only exactly 2 administrators may jointly trigger Emergency mode when the system is in Normal mode; each session may only trigger Emergency mode once.
- Emergency mode is time-limited by an abstract fixed duration and cannot persist indefinitely; the system must ensure eventual return to Normal mode. Early termination is permitted by the same 2 administrators who triggered Emergency mode.
- No new Emergency mode triggers are accepted while Emergency mode is active.
- During Emergency mode, request processing order may be bypassed to prioritize high classification requests; this relaxation is temporary.
- Users may temporarily hold predefined mutually exclusive roles only during Emergency mode.
- Only the administrators who triggered Emergency mode hold emergency privileges, defined as an abstract set of permissions, and only for the duration of Emergency mode.
- All roles delegated during Emergency mode must be revoked when Emergency mode ends. Roles delegated prior to Emergency mode persist until expiry or administrator revocation.
- Administrators who held emergency privileges are required to update their credentials upon exit from Emergency mode before resuming normal operations.
