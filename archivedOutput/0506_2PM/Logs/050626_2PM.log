        a1 != a2 && a1 in Administrator && a2 in Administrator
}

// Define a predicate for the duration of Emergency mode
pred R2 (t: Time, s1: SystemState, s2: SystemState) {
    s1 = Emergency && s2 = Normal
    always (s1 = Emergency) implies eventually (s2 = Normal)
    some a1, a2: Administrator | 
        a1 != a2 && a1 in Administrator && a2 in Administrator => s2 = Normal
}

// Define behavior during Emergency mode
pred R3 (t: Time, s: SystemState) {
    s = Emergency implies {
        // R3.1: Prioritize high classification requests
        all req: Request | req.submittedBy.clearance = High
        
        // R3.2: Temporarily allow mutually exclusive roles
        all u: User | some r1, r2: Role | r1 in u.roles && r2 in u.roles
        
        // R3.3: Administrators hold emergency privileges
        all a: Administrator | some ep: EmergencyPrivilege | ep in a.emergencyPrivileges
    }
}

// Define post-Emergency cleanup
pred R4 (t: Time, s1: SystemState, s2: SystemState) {
    s1 = Emergency && s2 = Normal implies {
        // R4.1: Revoke emergency privileges
        all a: Administrator | no a.emergencyPrivileges
        
        // R4.2: Revoke delegated roles
        all u: User | no u.roles
        
        // R4.3: Update administrator credentials
        all a: Administrator | some newCredential: Credential | newCredential not in a.credentials
    }
}

// Define incremental predicates for scenarios
pred R1R2 (t: Time, s1: SystemState, s2: SystemState) {
    R1(t, s1, s2) && R2(t, s1, s2)
}

pred R1R2R3 (t: Time, s: SystemState) {
    R1R2(t, s, s) && R3(t, s)
}

pred All_Requirements (t: Time, s1: SystemState, s2: SystemState) {
    R1R2R3(t, s1) && R4(t, s1, s2)
}

// Define assertions for properties to verify
assert assertR4 {
    all t: Time, s1, s2: SystemState | All_Requirements(t, s1, s2)
}

// Run the predicates to check for satisfiability
run R1 for 5 but 3 User, 2 Administrator, 5 Time
run R1R2 for 5 but 3 User, 2 Administrator, 5 Time
run R1R2R3 for 5 but 3 User, 2 Administrator, 5 Time
run All_Requirements for 5 but 3 User, 2 Administrator, 5 Time

// Check the assertions
check assertR4 for 5 but 3 User, 2 Administrator, 5 Time
```

