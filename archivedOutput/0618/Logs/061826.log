// Alloy 6 Model: RBAC System with Emergency Module (Abstract Verification Model)
// Improved per evaluator feedback: liveness, mutex, Emergency activation, delegation revocation/persistence, admin credential update, and scope.

// --- OPEN MODULES ---
open util/ordering[State]
// Open ordering for Request to enable FIFO processing
open util/ordering[Request]

// --- STRUCTURAL SIGNATURES ---

// Clearance and classification levels
abstract sig Clearance {}
one sig High, Medium, Low extends Clearance {}

// --- CLEARANCE ORDERING ---

fun succClearance[c: Clearance]: set Clearance {
    (c = Low) => Medium else
    (c = Medium) => High else
    none
}

pred leqClearance[c1, c2: Clearance] {
    c1 = c2 or
    (c1 = Low and (c2 = Medium or c2 = High)) or
    (c1 = Medium and c2 = High)
}

// Users and their roles
sig User {
    clearance: one Clearance
}

sig Administrator extends User {}

// Roles; some are mutually exclusive with others
sig Role {
    minClearance: one Clearance,
    mutexWith: set Role
}

// Emergency Privileges (granted only to Administrators during Emergency)
sig EmergencyPrivilege {}

// Objects/resources in system
sig Object {
    classification: one Clearance
}

// Requests submitted by users, targeting objects
sig Request {
    submitter: one User,
    targets: some Object
}

// Delegated roles: granted from one user to another, with when delegated and delegation period info
sig Delegation {
    role: one Role,
    from: one User,
    to: one User,
    duringEmergency: one Bool // True if delegated during Emergency mode
}

// Bool type for delegation/other flags
abstract sig Bool {}
one sig True, False extends Bool {}

// System operational modes
abstract sig Mode {}
one sig Normal, Emergency extends Mode {}

// --- REQUEST STATUS AND PROCESSOR TRACKING ---

// RequestStatus for monotonic request lifecycle
abstract sig RequestStatus {}
one sig Pending, Processed extends RequestStatus {}

// --- SYSTEM STATE MODELING ---

sig State {
    mode: one Mode,
    // Active delegations in this state
    activeDelegations: set Delegation,
    // User->Role relation for roles held in this state (including via delegation)
    userRoles: User -> Role,
    // Emergency Privilege assignments (for administrators)
    emergencyPrivs: Administrator -> lone EmergencyPrivilege,
    // For each request, its status in this state (Pending or Processed)
    reqStatus: Request -> lone RequestStatus,
    // For each processed request: who processed it (if any)
    reqProcessor: Request -> lone User,
    // For each admin, whether credentials have been updated after Emergency ends
    adminCredUpdated: Administrator -> lone Bool
}

// --- Next-state relation for transitions ---
pred Next[s, s2: State] {
    s2 in next[s]
}

// --- REQUEST CLASSIFICATION LOGIC ---

fun requestClassification[r: Request]: one Clearance {
    // The highest classification among all targeted objects
    {c: Clearance | some o: r.targets | o.classification = c and
        no c2: Clearance | succClearance[c2] = c and some o2: r.targets | o2.classification = c2
    }
}

// --- SYSTEM INITIALIZATION ---

fact InitialState {
    // The first State (first[State]) is always in Normal mode
    first.mode = Normal
    // All requests are pending at start
    all r: Request | first.reqStatus[r] = Pending
    // No request is processed at the start
    all r: Request | no first.reqProcessor[r]
    // No admin has updated credentials at the start
    all a: Administrator | first.adminCredUpdated[a] = False
}

// --- FACTS: STRUCTURE AND ROLES ---

fact Structural {
    // All administrators have high clearance
    all a: Administrator | a.clearance = High

    // Role mutual exclusion is symmetric and irreflexive
    all r: Role | r not in r.mutexWith
    all r1, r2: Role | r2 in r1.mutexWith iff r1 in r2.mutexWith

    // At least one pair of mutually exclusive roles always exists
    some r1, r2: Role | r1 != r2 and r2 in r1.mutexWith
}

// --- FACTS: MODE EXCLUSIVITY ---

fact ModeExclusivity {
    all s: State | one m: Mode | s.mode = m
}

// --- FACTS: ROLE ASSIGNMENT AND PERSISTENCE ---

// Moved RoleAssignmentClearance and DelegationClearance to assertions.

fact RolePersistence {
    all s, s2: State | 
        Next[s, s2] =>
            all u: User, r: Role |
                (r in s.userRoles[u] and not isRoleRevoked[s, s2, u, r]) => r in s2.userRoles[u]
}

// Helper predicate: isRoleRevoked
pred isRoleRevoked[s, s2: State, u: User, r: Role] {
    // Revocation: r in s.userRoles[u] but not in s2.userRoles[u]
    r in s.userRoles[u] and r not in s2.userRoles[u]
}

// --- FACTS: REQUEST STATUS MONOTONICITY ---

fact RequestStatusMonotonic {
    // A request cannot revert from Processed back to Pending
    all s, s2: State, r: Request |
        Next[s, s2] =>
            (s.reqStatus[r] = Processed) => (s2.reqStatus[r] = Processed)
}

// --- FACTS: REQUEST PROCESSOR AND CLEARANCE ---

// Moved RequestProcessorClearance to assertion.

// --- FACTS: REQUEST PROCESSING ORDER (NORMAL & EMERGENCY) ---

// Helper: dummy function to prevent syntax errors, since util/seq is not available
fun requestSeq(): none { none }

// In Normal mode, requests are processed strictly in FIFO order
fact NormalModeFIFO {
    all s, s2: State |
        s.mode = Normal and s2.mode = Normal and Next[s, s2] =>
            // The first pending request (by ordering) is the only one eligible for processing
            let pendingSeq = {r: Request | s.reqStatus[r] = Pending} |
                all r: Request |
                    (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) =>
                        r = firstPendingFIFO[s]
}

// Helper: first pending request in FIFO order
fun firstPendingFIFO[s: State]: lone Request {
    { r: Request | s.reqStatus[r] = Pending and
        no r2: Request | s.reqStatus[r2] = Pending and precedes[r2, r]
    }
}

// Helper: ordering on Request
pred precedes[r1, r2: Request] {
    r2 in next[r1]
}

// In Emergency, high-classification requests are processed before medium, then low
fact EmergencyProcessingPriority {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] =>
            // Only allow processing of requests with highest classification among pendings
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            let med = {r: Request | r in pending and requestClassification[r] = Medium} |
            let low = {r: Request | r in pending and requestClassification[r] = Low} |
            // Only process from the highest non-empty group
            (
                (some high and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in high) or
                (no high and some med and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in med) or
                (no high and no med and some low and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in low)
            )
}

// --- FACTS: MUTUAL EXCLUSION ---

fact DelegationMutex {
    // Outside Emergency, no user holds mutually exclusive roles at the same time
    all s: State |
        s.mode = Normal =>
            all u: User |
                all r1, r2: Role |
                    r2 in r1.mutexWith =>
                        not (r1 in s.userRoles[u] and r2 in s.userRoles[u])
}

// --- EMERGENCY MODULE GLOBAL FACTS ---

fact EmergencyPrivsOnlyDuringEmergency {
    all s: State | all a: Administrator |
        some s.emergencyPrivs[a] implies s.mode = Emergency
}

fact EmergencyPrivsRevokedAtExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | no s2.emergencyPrivs[a]
}

fact DelegationRevokedAtEmergencyExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = True => d not in s2.activeDelegations
}

fact DelegationRetainedAfterEmergencyIfNotDuring {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = False => (d in s2.activeDelegations iff d in s.activeDelegations)
}

// --- MODE TRANSITION AND ACTIVATION FACTS ---

// Replaced weak EmergencyActivation with exactly-two requirement in assertion.

fact EmergencyActivationAllowed {
    // Emergency mode can only be entered from Normal (joint act by two admins enforced in assertion)
    all s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] =>
            // At least two admins exist in the system (structural guarantee), but the exactly-two activation is asserted below
            some a1, a2: Administrator | a1 != a2
}

fact EmergencyDurationAndDeactivation {
    // Emergency mode is only active for finite, fixed period; must return to Normal
    all s: State |
        s.mode = Emergency =>
            some s2: State | Next[s, s2] and s2.mode = Normal
}

// --- PROSPECTIVE REQUIREMENTS (Emergency Module) ---

// R1: Emergency Activation
pred R1 {
    some s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] and
        some a1, a2: Administrator | a1 != a2
}

// R2: Emergency Duration and Deactivation
pred R1R2 {
    R1 and
    all s: State |
        s.mode = Emergency =>
            some s2: State | Next[s, s2] and s2.mode = Normal
}

// R3: Emergency Mode Operational Changes
pred R1R2R3 {
    R1R2 and
    // R3.1: FIFO may be bypassed for high-classification requests during Emergency
    all s: State |
        s.mode = Emergency =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            some high implies (
                all r: Request | (s.reqStatus[r] = Pending and s.reqStatus[r] = Processed) => r in high
            )
    // R3.2: During Emergency, users may hold mutually exclusive roles
    and
    all s: State |
        s.mode = Emergency =>
            some u: User, r1, r2: Role | r1 != r2 and r2 in r1.mutexWith and r1 in s.userRoles[u] and r2 in s.userRoles[u]
    // R3.3: Administrators temporarily gain EmergencyPrivilege (enforced in facts)
}

// R4: Emergency Deactivation Effects
pred R1R2R3R4 {
    R1R2R3 and
    // EmergencyPrivilege revoked at Emergency exit (fact)
    // Delegated roles assigned during Emergency are revoked at exit (fact)
    // Delegated roles assigned before Emergency are not revoked (fact)
    // R4.3: Administrators must update their credentials after Emergency exit
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | s2.adminCredUpdated[a] = True
}

// --- PREDICATE: All Requirements ---
pred All_Requirements { R1R2R3R4 }

// --- BASELINE PREDICATE (Existing System Only) ---
pred baseline {}

// --- ASSERTIONS FOR VERIFICATION ---

// 1. LIVENESS: All requests are eventually processed after Emergency mode ends.
assert assertAllRequestsEventuallyProcessed {
    all r: Request |
        -- There exists a state in Normal mode where r is processed.
        some s: State | s.mode = Normal and s.reqStatus[r] = Processed
}

// 2. Emergency mode mutex relaxation possibility (positive witness)
assert assertMutexAllowedDuringEmergency {
    some s: State |
        s.mode = Emergency and
        some u: User, r1, r2: Role |
            r2 in r1.mutexWith and r1 in s.userRoles[u] and r2 in s.userRoles[u]
}

// 3. Emergency activation by exactly two admins (no more, no less)
assert assertEmergencyActivationExactlyTwoAdmins {
    all s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] =>
            #Administrator = 2
}

// 4. Admin credential update liveness and single update per Emergency period
assert assertAdminsMustUpdateCredentialsOnce {
    all a: Administrator |
        all s, s2: State |
            s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
                s2.adminCredUpdated[a] = True and
                -- If adminCredUpdated[a]=True in any other state s3 != s2, then s3 must be in Normal mode and immediately after Emergency exit
                all s3: State |
                    (s3 != s2 and s3.adminCredUpdated[a] = True) implies (
                        some s4: State | s4.mode = Emergency and Next[s4, s3] and s3.mode = Normal
                    )
}

// 5. Delegation and revocation edge case: Emergency delegations revoked at exit (liveness)
assert assertDelegationRevocationLiveness {
    all d: Delegation |
        d.duringEmergency = True =>
            all s, s2: State |
                s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
                    d not in s2.activeDelegations
}

// 6. Delegation and revocation: pre-Emergency delegations persist (liveness)
assert assertDelegationPersistenceLiveness {
    all d: Delegation |
        d.duringEmergency = False =>
            all s, s2: State |
                s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
                    (d in s2.activeDelegations iff d in s.activeDelegations)
}

// 7. Mutual exclusion negative property: In Normal, no user ever holds mutex pair
assert assertMutexNegative {
    all s: State |
        s.mode = Normal =>
            all u: User, r1, r2: Role |
                r2 in r1.mutexWith =>
                    not (r1 in s.userRoles[u] and r2 in s.userRoles[u])
}

// 8. EmergencyPrivilege only granted during Emergency
assert assertEmergencyPrivsOnlyDuringEmergency {
    all s: State |
        all a: Administrator |
            some s.emergencyPrivs[a] implies s.mode = Emergency
}

// 9. EmergencyPrivilege always revoked at Emergency exit
assert assertEmergencyPrivsRevokedAtExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | no s2.emergencyPrivs[a]
}

// 10. Delegated roles during Emergency revoked at exit
assert assertDelegationRevokedAtEmergencyExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = True => d not in s2.activeDelegations
}

// 11. Delegated roles from before Emergency not revoked at exit
assert assertDelegationRetainedAfterEmergencyIfNotDuring {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = False => (d in s2.activeDelegations iff d in s.activeDelegations)
}

// 12. Request status monotonicity
assert assertRequestStatusMonotonic {
    all s, s2: State, r: Request |
        Next[s, s2] =>
            (s.reqStatus[r] = Processed) => (s2.reqStatus[r] = Processed)
}

// 13. Normal mode FIFO
assert assertNormalModeFIFO {
    all s, s2: State |
        s.mode = Normal and s2.mode = Normal and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let first = firstPendingFIFO[s] |
            all r: Request |
                (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r = first
}

// 14. Emergency processing priority
assert assertEmergencyProcessingPriority {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            let med = {r: Request | r in pending and requestClassification[r] = Medium} |
            let low = {r: Request | r in pending and requestClassification[r] = Low} |
            (
                (some high and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in high) or
                (no high and some med and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in med) or
                (no high and no med and some low and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in low)
            )
}

// 15. Request processor clearance
assert assertRequestProcessorClearance {
    all s: State, r: Request |
        s.reqStatus[r] = Processed and some s.reqProcessor[r] =>
            let proc = s.reqProcessor[r], rc = requestClassification[r] |
                (proc in User) and
                (some c1, c2: Clearance | proc.clearance = c1 and rc = c2 and
                    (c1 = High or (c1 = Medium and (rc = Medium or rc = Low)) or (c1 = Low and rc = Low))
                )
}

// 16. Role assignment clearance (was fact, now assertion)
assert assertRoleAssignmentClearance {
    all s: State, u: User, r: Role |
        r in s.userRoles[u] => leqClearance[r.minClearance, u.clearance]
}

// 17. Delegation clearance (was fact, now assertion)
assert assertDelegationClearance {
    all d: Delegation | leqClearance[d.role.minClearance, d.to.clearance]
}

// 18. Role persistence
assert assertRolePersistence {
    all s, s2: State | 
        Next[s, s2] =>
            all u: User, r: Role |
                (r in s.userRoles[u] and not isRoleRevoked[s, s2, u, r]) => r in s2.userRoles[u]
}

// --- MUTEX ROLE ASSIGNMENT DURING EMERGENCY (SYNTAX FIX) ---

fact EmergencyMutexDelegationOnly {
    all s: State, u: User, r1, r2: Role |
        r1 in r2.mutexWith and s.mode = Emergency =>
            (r1 in s.userRoles[u] and r2 in s.userRoles[u]) =>
                (
                  (some d: s.activeDelegations | d.role = r1 and d.to = u) or
                  (some d: s.activeDelegations | d.role = r2 and d.to = u)
                )
}

// --- POSSIBILITY PREDICATES / SCENARIO RUNS ---

// It is possible for a user to hold mutually exclusive roles during Emergency
pred MutexPossibleDuringEmergency {
    some s: State | 
        s.mode = Emergency and 
        some u: User, r1, r2: Role | 
            r2 in r1.mutexWith and 
            r1 in s.userRoles[u] and 
            r2 in s.userRoles[u]
}

// It is possible for a delegation during Emergency to be revoked at Emergency exit
pred EmergencyDelegationRevocationScenario {
    some s, s2: State, d: Delegation |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] and
        d.duringEmergency = True and
        d in s.activeDelegations and
        d not in s2.activeDelegations
}

// It is possible for a pre-Emergency delegation to persist after Emergency
pred PreEmergencyDelegationPersistenceScenario {
    some s0, sE, sN: State, d: Delegation |
        s0.mode = Normal and
        d.duringEmergency = False and
        d in s0.activeDelegations and
        -- Enter Emergency
        sE.mode = Emergency and Next[s0, sE] and
        d in sE.activeDelegations and
        -- Exit Emergency
        sN.mode = Normal and Next[sE, sN] and
        d in sN.activeDelegations
}

// It is possible for a high-classification request to bypass FIFO in Emergency
pred EmergencyBypassFIFOScenario {
    some s, s2: State, r1, r2: Request |
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] and
        r1 != r2 and
        s.reqStatus[r1] = Pending and s.reqStatus[r2] = Pending and
        requestClassification[r1] = High and
        requestClassification[r2] != High and
        s2.reqStatus[r1] = Processed and
        s2.reqStatus[r2] = Pending
}

// --- RUN COMMANDS (Verification Order & Scopes) ---
// Increased scopes to ensure nontrivial, nondegenerate instances

run baseline for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run All_Requirements for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run R1 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run R1R2 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run R1R2R3 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run R1R2R3R4 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance

run MutexPossibleDuringEmergency for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run EmergencyDelegationRevocationScenario for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run PreEmergencyDelegationPersistenceScenario for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
run EmergencyBypassFIFOScenario for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance

// --- CHECK COMMANDS (Increased scopes for coverage) ---

check assertAllRequestsEventuallyProcessed for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertMutexAllowedDuringEmergency for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertEmergencyActivationExactlyTwoAdmins for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertAdminsMustUpdateCredentialsOnce for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationRevocationLiveness for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationPersistenceLiveness for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance

check assertMutexNegative for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertEmergencyPrivsOnlyDuringEmergency for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertEmergencyPrivsRevokedAtExit for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationRevokedAtEmergencyExit for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
check assertDelegationRetainedAfterEmergencyIfNotDuring for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance
