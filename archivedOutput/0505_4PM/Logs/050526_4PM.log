// Alloy 6 model for RBAC system with Emergency module prospective requirements
// Updated per evaluator feedback: unified Clearance and Classification enums,
// modeled Time with integer values and injective mapping for temporal arithmetic,
// abstracted mutual exclusivity, explicit fixed duration and manual early termination,
// atomic events for emergency triggering and credential updates,
// and clarified delegation revocation rules.

// === Imports and Utilities ===
open util/ordering[Time] as TO
open util/integer as Int

// === Basic Types and Enums ===
// Unified Clearance and Classification enum with unique literals for consistency
enum Level { High, Medium, Low }

// === Time signature for temporal modeling ===
sig Time {}

// Injective function mapping Time atoms to integers for ordering and arithmetic
fun timeValue(t: Time): Int { 
  // Abstract uninterpreted function
  Int
}

// Assume timeValue is total and injective: no two Time have same integer value
fact TimeValueInjective {
  all t1, t2: Time | (timeValue[t1] = timeValue[t2]) implies t1 = t2
}

// Ordering of Time atoms respects timeValue ordering
fact TimeOrdering {
  all t1, t2: Time | (TO/ord[t1] < TO/ord[t2]) iff (timeValue[t1] < timeValue[t2])
}

// === Users and Roles ===
sig User {
  clearance: one Level,
  assignedRoles: set Role,       // Roles assigned permanently
  delegatedRoles: set Delegation // Delegated roles currently held (abstract)
}

sig Administrator extends User {} // subset of Users with High clearance and admin privileges

sig Role {
  minClearance: one Level
}

// Abstract mutual exclusivity defined between specific pairs of roles only
sig MutuallyExclusivePair {
  r1, r2: one Role
}

// === Delegations ===
sig Delegation {
  role: one Role,
  delegatee: one User,
  delegator: one User,
  assignedAt: one Time,
  expiresAt: lone Time,        // optional expiration time
  revoked: set Time            // times of revocation (empty if none)
}

// === System Objects ===
sig SysObject {
  classification: one Level
}

// === Requests ===
sig Request {
  submitter: one User,
  affectedObjects: set SysObject,
  classification: one Level,
  submittedAt: one Time,
  processedAt: lone Time       // processing time, if processed
}

// === Emergency Privileges and Credential Update Events ===
sig EmergencyPrivilege {
  holder: one Administrator,
  activeAt: set Time
}

sig CredentialUpdateEvent {
  admin: one Administrator,
  eventTime: one Time
}

// === System Operational Mode ===
enum Mode { Normal, Emergency }

// Current system mode and temporal markers (mode start/end times)
var Mode currentMode
var Mode previousMode
var Time modeStartTime          // time Emergency mode started (none if Normal)
var Time modeEndTime            // time Emergency mode ended (none if ongoing)

// Current time for modeling temporal state
var Time currentTime

// Fixed Emergency mode duration (integer, in time units)
one sig EmergencyDuration {
  duration: one Int
}
// Fact: EmergencyDuration.duration > 0
fact EmergencyDurationPositive {
  EmergencyDuration.duration > 0
}

// === Helper predicates and functions ===

// clearanceGE: clearance level greater or equal (High > Medium > Low)
pred clearanceGE(c1, c2: Level) {
  (c1 = High) or
  (c1 = Medium and c2 != High) or
  (c1 = Low and c2 = Low)
}

// highestClassification: returns highest Level among a set of SysObjects
fun highestClassification(objs: set SysObject): Level {
  (objs & SysObject.classification = High) => High else
  (objs & SysObject.classification = Medium) => Medium else
  Low
}

// revokedAt: true if delegation revoked at or before time t
pred revokedAt(d: Delegation, t: Time) {
  some revTime: d.revoked | timeValue[revTime] <= timeValue[t]
}

// expiredAt: true if delegation expired at or before time t
pred expiredAt(d: Delegation, t: Time) {
  d.expiresAt != none and timeValue[d.expiresAt] <= timeValue[t]
}

// delegatedRolesAt: roles delegated to a user u at time t, not expired or revoked
fun delegatedRolesAt(u: User, t: Time): set Role {
  { d: Delegation | d.delegatee = u and not revokedAt[d, t] and not expiredAt[d, t] }.role
}

// assignedDuringEmergency: delegation assigned during Emergency mode interval
pred assignedDuringEmergency(d: Delegation) {
  modeStartTime != none and modeEndTime != none and
  timeValue[modeStartTime] <= timeValue[d.assignedAt] and
  timeValue[d.assignedAt] < timeValue[modeEndTime]
}

// currentModeAt: abstract function returning system Mode at time t
fun currentModeAt(t: Time): Mode {
  // Conservative placeholder: actual mode depends on t relative to modeStartTime/EndTime
  if modeStartTime != none and modeEndTime != none then
    if timeValue[t] >= timeValue[modeStartTime] and timeValue[t] < timeValue[modeEndTime] then Emergency else Normal
  else if modeStartTime != none and modeEndTime = none then Emergency else Normal
}

// emergencyTriggerEvent: atomic event where exactly two admins trigger emergency at same time
sig EmergencyTriggerEvent {
  atTime: one Time,
  triggers: set Administrator
}
fact EmergencyTriggerEventFacts {
  all e: EmergencyTriggerEvent | #e.triggers = 2
}

// manualEarlyTerminationEvents: atomic events by admins to manually end Emergency mode early
sig ManualEarlyTerminationEvent {
  atTime: one Time,
  terminators: set Administrator
}
fact ManualEarlyTerminationEventFacts {
  all e: ManualEarlyTerminationEvent | some e.terminators and all a: e.terminators | a in Administrator
}

// === Facts: Existing system assumptions ===

fact AdminClearance {
  all a: Administrator | a.clearance = High
  some u: User | u.clearance = High and not (u in Administrator)
}

fact DelegationClearanceConstraints {
  all d: Delegation |
    clearanceGE[d.delegator.clearance, d.delegatee.clearance] and d.delegator != d.delegatee and
    clearanceGE[d.delegatee.clearance, d.role.minClearance]
}

fact AssignedRolesClearance {
  all u: User, r: Role | r in u.assignedRoles implies clearanceGE[u.clearance, r.minClearance]
}

fact RequestClassificationCorrectness {
  all r: Request | r.classification = highestClassification[r.affectedObjects]
}

fact RequestClearanceLimit {
  all r: Request | clearanceGE[r.submitter.clearance, r.classification]
}

// Mutual exclusivity under Normal mode only
fact MutualExclusivityNormal {
  currentMode = Normal =>
    all u: User |
      all p: MutuallyExclusivePair |
        not (p.r1 in u.assignedRoles + delegatedRolesAt[u, currentTime] and p.r2 in u.assignedRoles + delegatedRolesAt[u, currentTime])
}

// === Emergency Mode Requirements ===

// R1: Emergency Mode Activation
pred R1 {
  currentMode = Normal
  // There exists an EmergencyTriggerEvent at some time t with exactly two admins triggering simultaneously
  some e: EmergencyTriggerEvent |
    e.atTime = currentTime and
    currentMode' = Emergency and modeStartTime' = e.atTime and
    // previousMode updated accordingly
    previousMode' = Normal and
    modeEndTime' = none
}

// R2: Emergency Mode Duration and Termination
pred R2 {
  currentMode = Emergency
  // modeEndTime = modeStartTime + EmergencyDuration.duration
  modeStartTime != none and modeEndTime != none and
  timeValue[modeEndTime] = timeValue[modeStartTime] + EmergencyDuration.duration

  // Manual early termination allowed by either administrator before fixed duration
  // If any ManualEarlyTerminationEvent occurs at t with t < modeEndTime, modeEndTime updated to t
  all t: Time | 
    (some e: ManualEarlyTerminationEvent | e.atTime = t and t >= modeStartTime and t < modeEndTime) =>
      (modeEndTime = t)

  // System returns to Normal mode at or after modeEndTime
  some t: Time | timeValue[t] >= timeValue[modeEndTime] and currentModeAt[t] = Normal
}

// R3: Emergency Mode Operational Changes

// R3.1: Request processing order by classification (High first, then Medium, then Low), concurrent within classes
pred R3_1 {
  currentMode = Emergency
  all r1, r2: Request |
    r1.processedAt != none and r2.processedAt != none =>
      (r1.classification = High and r2.classification != High) => timeValue[r1.processedAt] <= timeValue[r2.processedAt]
      and
      (r1.classification = Medium and r2.classification = Low) => timeValue[r1.processedAt] <= timeValue[r2.processedAt]
}

// R3.2: Mutual exclusivity relaxed during Emergency mode (no constraint needed)

// R3.3: Administrators hold emergency privileges as atomic privilege states during Emergency mode
fact EmergencyPrivilegesActiveDuringEmergency {
  all a: Administrator | 
    some ep: EmergencyPrivilege | ep.holder = a and currentTime in ep.activeAt
}

// R4: Post Emergency Mode Actions

// R4.1: Emergency privileges revoked immediately after Emergency mode ends
pred R4_1 {
  currentMode = Normal and previousMode = Emergency
  all ep: EmergencyPrivilege | no ep.activeAt & {currentTime}
}

// R4.2: Delegated roles assigned during Emergency mode revoked immediately at Emergency end
pred R4_2 {
  currentMode = Normal and previousMode = Emergency
  all d: Delegation | assignedDuringEmergency(d) => revokedAt(d, currentTime)
}

// R4.3: Administrators update credentials via atomic credential update event immediately after Emergency mode ends
pred R4_3 {
  currentMode = Normal and previousMode = Emergency
  all a: Administrator | some e: CredentialUpdateEvent | e.admin = a and e.eventTime = currentTime
}

// === Incremental predicates for verification ===
pred R1_run {
  R1
}

pred R1R2_run {
  R1 and R2
}

pred R1R2R3_run {
  R1 and R2 and R3_1
  // R3.2 is relaxation - no constraints
  // R3.3 is modeled as fact EmergencyPrivilegesActiveDuringEmergency
}

pred All_Requirements {
  R1 and R2 and R3_1 and R4_1 and R4_2 and R4_3
}

// === Assertions to verify ===

// Mutual exclusivity enforced only in Normal mode
assert assertMutualExclusivityNormal {
  currentMode = Normal =>
    all u: User |
      all p: MutuallyExclusivePair |
        not (p.r1 in u.assignedRoles + delegatedRolesAt[u, currentTime] and p.r2 in u.assignedRoles + delegatedRolesAt[u, currentTime])
}

// Emergency privileges only held during Emergency mode
assert assertEmergencyPrivilegeDuration {
  all ep: EmergencyPrivilege |
    all t: Time | (t in ep.activeAt) => currentModeAt[t] = Emergency
}

// Delegated roles assigned during Emergency revoked after Emergency ends
assert assertDelegationRevocationAfterEmergency {
  currentMode = Normal and previousMode = Emergency =>
    all d: Delegation | assignedDuringEmergency(d) => revokedAt(d, currentTime)
}

// Administrators update credentials after Emergency mode ends
assert assertCredentialUpdateAfterEmergency {
  currentMode = Normal and previousMode = Emergency =>
    all a: Administrator | some e: CredentialUpdateEvent | e.admin = a and e.eventTime = currentTime
}

// Request processing order respected during Emergency mode (R3.1)
assert assertRequestProcessingOrderEmergency {
  currentMode = Emergency =>
    all r1, r2: Request |
      r1.processedAt != none and r2.processedAt != none =>
        (r1.classification = High and r2.classification != High) => timeValue[r1.processedAt] <= timeValue[r2.processedAt] and
        (r1.classification = Medium and r2.classification = Low) => timeValue[r1.processedAt] <= timeValue[r2.processedAt]
}

// Emergency mode activation requires exactly two admins triggering simultaneously
assert assertEmergencyActivationRequiresTwoAdmins {
  currentMode = Emergency =>
    some e: EmergencyTriggerEvent | e.atTime = modeStartTime and #e.triggers = 2
}

// Emergency mode terminates after fixed duration or manual early termination by admins
assert assertEmergencyEventuallyTerminates {
  currentMode = Normal and previousMode = Emergency =>
    modeStartTime != none and modeEndTime != none and
    (timeValue[modeEndTime] >= timeValue[modeStartTime] + EmergencyDuration.duration)
}

// Delegated roles assigned before Emergency are not revoked at Emergency end by R4.2
assert assertPreEmergencyDelegationsNotRevoked {
  currentMode = Normal and previousMode = Emergency =>
    all d: Delegation | not assignedDuringEmergency(d) => not revokedAt(d, currentTime)
}

