   - Using True/False as boolean values

**Current Model:**
```alloy
// Alloy 6 model for RBAC system with Emergency module prospective requirements

open util/ordering[Time] as TO

// === Basic Types and Enums ===
enum Clearance { High, Medium, Low }
enum Classification { High, Medium, Low }
enum Mode { Normal, Emergency }

// Time signature for temporal modeling
sig Time {}

// === Users and Roles ===
sig User {
  clearance: one Clearance,
  assignedRoles: set Role,       // Roles assigned permanently
  delegatedRoles: set Delegation // Delegated roles currently held
}

sig Administrator extends User {} // subset of Users with High clearance and admin flag

// Roles with minimum clearance requirement
sig Role {
  minClearance: one Clearance
}

// Delegation of Role from a delegator to a delegatee at a Time with expiration and revocation flags
sig Delegation {
  role: one Role,
  delegatee: one User,
  delegator: one User,
  assignedAt: one Time,
  expiresAt: lone Time,        // optional expiration time (if none, no fixed expiration)
  revoked: set Time            // times at which revocation happened (empty if not revoked)
}

// Mutual exclusive pairs of roles under normal operation only
sig MutuallyExclusivePair {
  r1, r2: one Role
}

// System Objects
sig SysObject {
  classification: one Classification
}

// Requests
sig Request {
  submitter: one User,
  affectedObjects: set SysObject,
  classification: one Classification,
  submittedAt: one Time,
  processedAt: lone Time       // time when processed (lone means maybe not processed yet)
}

// Emergency Privileges - atomic privilege states held by administrators during Emergency mode
sig EmergencyPrivilege {
  holder: one Administrator,
  activeAt: set Time          // times when privilege is active
}

// Credential Update Events - atomic events after Emergency mode ends
sig CredentialUpdateEvent {
  admin: one Administrator,
  eventTime: one Time
}

// === Facts: Existing system assumptions and baseline constraints ===
fact ClearanceOrdering {
  // Clearance order: High > Medium > Low (for comparison purposes, modeled abstractly)
  // We encode partial ordering via predicates below; Alloy 6 does not support direct ordering on enums
}

pred clearanceGE(c1,c2: Clearance) {
  (c1 = High) or
  (c1 = Medium and c2 != High) or
  (c1 = Low and c2 = Low)
}

fact AdminClearance {
  all a: Administrator | a.clearance = High
  // Not all High clearance users are administrators
  some u: User | u.clearance = High and not (u in Administrator)
}

fact DelegationClearanceConstraints {
  // Delegator must have higher clearance than delegatee
  all d: Delegation | clearanceGE[d.delegator.clearance, d.delegatee.clearance] and d.delegator != d.delegatee
  // Delegatee meets minimum clearance for delegated role
  all d: Delegation | clearanceGE[d.delegatee.clearance, d.role.minClearance]
}

fact RequestClassificationCorrectness {
  // Classification of a request is the highest classification among its affected objects
  all r: Request | r.classification = highestClassification[r.affectedObjects]
}

fun highestClassification(objs: set SysObject): Classification {
  // Abstract function to determine highest classification among objs
  // Priority: High > Medium > Low
  // If objs empty, default Low (safe default)
  (objs & SysObject.classification = High) => High else
  (objs & SysObject.classification = Medium) => Medium else
  Low
}

fact RequestClearanceLimit {
  // Users may only submit requests with classification <= their clearance
  all r: Request | clearanceGE[r.submitter.clearance, r.classification]
}

fact AdminRequestProcessingRights {
  // Higher-clearance users may approve/reject requests from lower-clearance users (modeled abstractly)
  // For simplicity, implicitly allowed
}

// Request processing in FIFO order under Normal mode (abstractly modeled)
// Concurrent processing modeled via sets of requests processed at same Time

// Role hierarchy and inheritance abstracted as needed (not detailed in this model)

// === System Operational Mode ===
var Mode currentMode
var Time modeStartTime           // time when Emergency mode started (if in Emergency)
var Time modeEndTime             // time when Emergency mode ended (if returned to Normal)

// To model atomic simultaneous triggering, we model an atomic event where exactly two administrators trigger Emergency mode at the same time

// === Facts: Structural and baseline constraints ===
fact AssignedRolesClearance {
  all u: User, r: Role | r in u.assignedRoles implies clearanceGE[u.clearance, r.minClearance]
}

// Mutual exclusivity under Normal mode
fact MutualExclusivityNormal {
  currentMode = Normal => 
  all u: User |
    all p: MutuallyExclusivePair |
      not (p.r1 in u.assignedRoles + delegatedRolesAt(u, currentTime) and p.r2 in u.assignedRoles + delegatedRolesAt(u, currentTime))
}

// delegatedRolesAt(u,t): helper function returns delegated roles held by user u at time t (not revoked or expired)
fun delegatedRolesAt(u: User, t: Time): set Role {
  { d: Delegation | d.delegatee = u and not revokedAt(d, t) and not expiredAt(d, t) }.role
}

// revokedAt: true if delegation revoked at or before time t
pred revokedAt(d: Delegation, t: Time) {
  some revTime: d.revoked | TO/ord[revTime] <= TO/ord[t]
}

// expiredAt: true if delegation expired at or before t
pred expiredAt(d: Delegation, t: Time) {
  d.expiresAt != none and TO/ord[d.expiresAt] <= TO/ord[t]
}

// === Emergency Mode Requirements ===

// R1: Emergency Mode Activation (exactly two administrators trigger simultaneously atomic event)
pred R1 {
  currentMode = Normal
  // There exists a time t and exactly two distinct administrators a1,a2 who simultaneously trigger emergency at time t
  some t: Time | 
    let triggers = { a: Administrator | emergencyTrigger(a, t) } | 
    #triggers = 2 and currentMode' = Emergency and modeStartTime' = t
}

// emergencyTrigger(a,t): predicate that administrator a triggers emergency at time t (atomic event)
pred emergencyTrigger(a: Administrator, t: Time) { 
  // abstract predicate: modeled as a set of admins triggering at t
  // For R1, exactly two admins must trigger at same time
  true
}

// currentMode' and modeStartTime' represent next state variables; modeled abstractly here

// R2: Emergency Mode Duration and Termination
pred R2 {
  currentMode = Emergency
  // Emergency mode active for fixed limited duration from modeStartTime to modeEndTime
  // modeEndTime = modeStartTime + fixedDuration (abstract)
  // Optionally, manual early termination allowed before fixedDuration ends
  modeEndTime != none and TO/ord[modeStartTime] < TO/ord[modeEndTime] and
  // Eventually system returns to Normal mode after modeEndTime
  (some t: Time | TO/ord[t] >= TO/ord[modeEndTime] and currentModeAt(t) = Normal)
}

// currentModeAt(t): function returning Mode at time t (abstract)
fun currentModeAt(t: Time): Mode { currentMode } // placeholder

// R3: Emergency Mode Operational Changes
pred R3_1 {
  currentMode = Emergency
  // Request processing may bypass FIFO to prioritize processing:
  // All High classification requests processed concurrently first,
  // then all Medium concurrently, then all Low concurrently.
  // Modeled abstractly as processedAt times respecting this order
  all r1, r2: Request |
    r1.processedAt != none and r2.processedAt != none =>
    // If r1.classification = High and r2.classification != High then 
    // r1.processedAt <= r2.processedAt
    (r1.classification = High and r2.classification != High) => TO/ord[r1.processedAt] <= TO/ord[r2.processedAt] and
    // If r1.classification = Medium and r2.classification = Low then 
    (r1.classification = Medium and r2.classification = Low) => TO/ord[r1.processedAt] <= TO/ord[r2.processedAt]
}

pred R3_2 {
  currentMode = Emergency
  // Users may temporarily hold mutually exclusive roles (relax mutual exclusivity)
  // So mutual exclusivity constraints are suspended during Emergency mode
  // Implies mutual exclusivity fact does not hold in Emergency mode (already done)
  no additional constraint needed here
}

pred R3_3 {
  currentMode = Emergency
  // Administrators hold emergency privileges as atomic privilege states
  // For each administrator, emergency privilege active during Emergency mode
  all a: Administrator | some ep: EmergencyPrivilege | ep.holder = a and currentTime in ep.activeAt
}

// currentTime abstract variable for modeling time steps
var Time currentTime

// R4: Post Emergency Mode Actions
pred R4_1 {
  currentMode = Normal and previousMode = Emergency
  // Emergency privileges held by administrators revoked immediately
  all ep: EmergencyPrivilege | no ep.activeAt & {currentTime}
}

pred R4_2 {
  currentMode = Normal and previousMode = Emergency
  // Delegated roles assigned during Emergency mode revoked immediately at Emergency end
  all d: Delegation | 
    assignedDuringEmergency(d) => revokedAt(d, currentTime)
}

// assignedDuringEmergency(d): delegation assigned during Emergency mode interval
pred assignedDuringEmergency(d: Delegation) {
  modeStartTime != none and modeEndTime != none and
  TO/ord[modeStartTime] <= TO/ord[d.assignedAt] and TO/ord[d.assignedAt] < TO/ord[modeEndTime]
}

pred R4_3 {
  currentMode = Normal and previousMode = Emergency
  // Administrators update credentials via atomic credential update event
  all a: Administrator | some e: CredentialUpdateEvent | e.admin = a and e.eventTime = currentTime
}

// === Incremental predicates for verification ===
// R1: Emergency mode activation predicate
pred R1_run {
  R1
}

// R1R2: R1 and R2 combined
pred R1R2_run {
  R1 and R2
}

// R1R2R3: R1,R2,R3 combined
pred R1R2R3_run {
  R1 and R2 and R3_1 and R3_2 and R3_3
}

// R1R2R3R4: All requirements combined
pred All_Requirements {
  R1 and R2 and R3_1 and R3_2 and R3_3 and R4_1 and R4_2 and R4_3
}

// === Assertions to verify ===

// Authorization correctness preserved in Normal mode (mutual exclusivity holds)
assert assertMutualExclusivityNormal {
  currentMode = Normal =>
  all u: User |
    all p: MutuallyExclusivePair |
      not (p.r1 in u.assignedRoles + delegatedRolesAt(u, currentTime) and p.r2 in u.assignedRoles + delegatedRolesAt(u, currentTime))
}

// Emergency privileges only held during Emergency mode
assert assertEmergencyPrivilegeDuration {
  all ep: EmergencyPrivilege |
    all t: Time | (t in ep.activeAt) => currentModeAt(t) = Emergency
}

// Delegated roles assigned during Emergency revoked after Emergency ends
assert assertDelegationRevocationAfterEmergency {
  currentMode = Normal and previousMode = Emergency =>
  all d: Delegation | assignedDuringEmergency(d) => revokedAt(d, currentTime)
}

// Administrators update credentials after Emergency mode ends
assert assertCredentialUpdateAfterEmergency {
  currentMode = Normal and previousMode = Emergency =>
  all a: Administrator | some e: CredentialUpdateEvent | e.admin = a and e.eventTime = currentTime
}

// Request processing order respected in Emergency mode (R3.1)
assert assertRequestProcessingOrderEmergency {
  currentMode = Emergency =>
  all r1, r2: Request |
    r1.processedAt != none and r2.processedAt != none =>
    (r1.classification = High and r2.classification != High) => TO/ord[r1.processedAt] <= TO/ord[r2.processedAt] and
    (r1.classification = Medium and r2.classification = Low) => TO/ord[r1.processedAt] <= TO/ord[r2.processedAt]
}
