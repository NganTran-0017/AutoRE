**Current Alloy Model:**
```alloy
// Alloy 6 model for RBAC system with Emergency Module per specified requirements

/////////////////////
// OPEN STATEMENTS //
/////////////////////

open util/ordering[Time]

//////////////////////
// BASIC SIGNATURES //
//////////////////////

// Time signature to model discrete time points, with ordering
sig Time {}

// Security clearance levels
abstract sig Clearance {}
one sig High, Medium, Low extends Clearance {}

// Role with possible mutual exclusive roles
sig Role {
  // set of roles mutually exclusive with this role (symmetric relation)
  mutuallyExclusive: set Role,
  minClearance: one Clearance
}

// Privilege set, including normal privileges and emergency privileges
abstract sig PrivilegeSet {}
one sig NormalPrivileges extends PrivilegeSet {}
one sig EmergencyPrivileges extends PrivilegeSet {} // special privilege set for emergency

// System mode: Normal or Emergency
abstract sig SystemMode {}
one sig NormalMode extends SystemMode {}
one sig EmergencyMode extends SystemMode {}

////////////////
// USERS & ADMINISTRATORS

sig User {
  clearance: one Clearance,
  assignedRoles: set Role,        // roles assigned permanently
  delegatedRoles: set Role,       // roles delegated temporarily
  delegatedRoleInfo: set DelegatedRoleInfo, // temporal info for delegated roles
  privileges: set PrivilegeSet,
  isAdmin: lone Admin            // link to Admin if user is administrator; none otherwise
}

// Administrator is a user with High clearance and admin privileges
sig Admin {
  user: one User
} {
  user.clearance = High
}

// Each Admin user must have a link back to Admin
fact AdminUserLink {
  all a: Admin | a.user.isAdmin = a
}

/////////////////
// Delegated role info to track delegation time and expiration
sig DelegatedRoleInfo {
  role: one Role,
  delegatedTo: one User,
  delegatedBy: one User,   // delegator with higher clearance
  delegatedAt: one Time,
  expiresAt: lone Time,    // expiration time (optional)
  revokedAt: lone Time     // revocation time (optional)
}

// Object with classification level
sig Obj {
  classification: one Clearance
}

// Request with submitter, affected objects, submission and approval info
sig Request {
  submittedBy: one User,
  affectedObjects: set Obj,
  submittedAt: one Time,
  approvedBy: lone User,
  approvedAt: lone Time,
  rejectedBy: lone User,
  rejectedAt: lone Time
}

// System state at a time point
sig SystemState {
  time: one Time,
  mode: one SystemMode,
  users: set User,
  admins: set Admin,
  requests: set Request,
  // Requests pending processing at this time
  pendingRequests: set Request,
  // Requests processed at this time
  processedRequests: set Request,
  // Emergency mode start and end times
  emergencyStart: lone Time,
  emergencyEnd: lone Time,
  // Emergency triggers at this time (admins triggering emergency)
  emergencyTriggers: set Admin,
  // Credential update event by admins at this time (admins who updated credentials immediately post-emergency)
  credentialUpdates: set Admin
}

//////////////////////
// FACTS: EXISTING SYSTEM ASSUMPTIONS
//////////////////////

// Fixed clearances for users and admin clearance condition
fact FUserClearance {
  all u: User | u.clearance in Clearance
}

fact FAdminClearance {
  all a: Admin | a.user.clearance = High
}

// Users may hold assigned or delegated roles; delegation respects minimum clearance requirements
fact FDelegationClearance {
  all dri: DelegatedRoleInfo |
    dri.delegatedBy.clearance > dri.delegatedTo.clearance and
    dri.role.minClearance <= dri.delegatedTo.clearance
}

// Requests classification is the highest classification among affected objects
fun requestClassification(r: Request): one Clearance {
  // Highest clearance among r.affectedObjects.classification
  // High > Medium > Low, so pick max by ordering High > Medium > Low
  // We define an order: High > Medium > Low to compare
  // Implemented via ordering set
  let clsSet = r.affectedObjects.classification |
    if High in clsSet then High
    else if Medium in clsSet then Medium
    else Low
}

// Users may submit requests only if request classification ≤ user's clearance
fact FRequestSubmissionClearance {
  all r: Request |
    requestClassification[r] in Clearance and
    // clearance ordering: High > Medium > Low
    clearanceOrder(requestClassification[r]) <= clearanceOrder(r.submittedBy.clearance)
}

// Higher-clearance users may approve or reject requests from lower-clearance users
fact FApprovalClearance {
  all r: Request | 
    (some r.approvedBy implies clearanceOrder(r.approvedBy.clearance) > clearanceOrder(r.submittedBy.clearance)) and
    (some r.rejectedBy implies clearanceOrder(r.rejectedBy.clearance) > clearanceOrder(r.submittedBy.clearance))
}

// Requests are processed concurrently in FIFO order in Normal mode
// FIFO order: requests processed in order of submittedAt
fact FFIFOProcessingNormal {
  all s: SystemState | 
    s.mode = NormalMode implies
      // processedRequests processed in order of submission time
      // For any two requests processed concurrently, their processing order respects submission order
      all r1, r2: s.processedRequests |
        (r1.submittedAt.time < r2.submittedAt.time) implies
          // r1 processed before or at same time as r2
          r1.processedAtTime[s.time] <= r2.processedAtTime[s.time]
}

// Delegated roles expire after fixed time or can be revoked by admins
// Modeled by expiresAt and revokedAt times in DelegatedRoleInfo
fact FDelegatedRoleExpirationRevocation {
  all dri: DelegatedRoleInfo |
    // expiration or revocation implies role no longer held after that time
    (some dri.expiresAt or some dri.revokedAt) implies
      // role no longer held by delegatedTo after min(expiresAt, revokedAt)
      true // captured in predicates below for role holding over time
}

// Role delegation is temporary
fact FDelegatedRoleTemporary {
  all dri: DelegatedRoleInfo | 
    // delegated roles have finite time span (from delegatedAt to expiresAt or revokedAt)
    some dri.expiresAt or some dri.revokedAt
}

// System preserves authorization correctness, permission consistency, and concurrency safety
// Abstract property assumed; no direct fact here.

/////////////////////////
// AUXILIARY FUNCTIONS //
/////////////////////////

// Clearance ordering: High=3, Medium=2, Low=1 for comparison
fun clearanceOrder(c: Clearance): Int {
  c = High => 3 else c = Medium => 2 else 1
}

// To check if a role pair is mutually exclusive
fun isMutuallyExclusive(r1, r2: Role): Bool {
  r1 != r2 and (r2 in r1.mutuallyExclusive or r1 in r2.mutuallyExclusive)
}

// Check if user u holds role r at time t, including assigned and delegated roles currently active
pred holdsRole[u: User, r: Role, t: Time, ss: SystemState] {
  r in u.assignedRoles or
  some dri: DelegatedRoleInfo |
    dri.role = r and
    dri.delegatedTo = u and
    dri.delegatedAt <= t and
    (no dri.expiresAt or dri.expiresAt > t) and
    (no dri.revokedAt or dri.revokedAt > t)
}

///////////////////////
// EMERGENCY MODULE FACTS
///////////////////////

// R1: Emergency Mode Triggering  
// While in Normal mode, exactly two administrators acting concurrently trigger Emergency mode
fact R1_EmergencyTriggering {
  all s: SystemState |
    s.mode = NormalMode implies
      (some s'.SystemState | 
        s'.time > s.time and
        s'.mode = EmergencyMode and
        // At s'.time emergency triggered by exactly two admins concurrently
        #s'.emergencyTriggers = 2 and
        all a: s'.emergencyTriggers | a in s'.admins
      )
}

// R2: Emergency Mode Duration  
// Emergency mode is limited to max temporal bound with possible earlier termination; system returns to Normal mode eventually
fact R2_EmergencyDuration {
  // There is a maximum allowed emergency duration bound (e.g., EmergencyDurationMax)
  let EmergencyDurationMax = 10 // abstract max duration, arbitrary number
  all s1, s2: SystemState |
    s1.mode = EmergencyMode and s2.mode = EmergencyMode and s1.time < s2.time implies
      s2.time - s1.time <= EmergencyDurationMax
  // Eventually system returns to Normal mode
  all s: SystemState | s.mode = EmergencyMode implies
    some s2: SystemState | s2.time > s.time and s2.mode = NormalMode
}

// R3: Emergency Mode Behavior

// R3.1: Request processing bypasses FIFO, prioritizing classification order: High first, then Medium, then Low
fact R3_1_RequestProcessingPriority {
  all s: SystemState |
    s.mode = EmergencyMode implies
      // processedRequests ordered by classification priority, not submission time
      all r1, r2: s.processedRequests |
        clearanceOrder(requestClassification[r1]) > clearanceOrder(requestClassification[r2]) implies
          r1.processedAtTime[s.time] < r2.processedAtTime[s.time]
}

// R3.2: Users may temporarily hold mutually exclusive roles concurrently during Emergency mode
fact R3_2_MutualExclusionRelaxed {
  all s: SystemState |
    s.mode = EmergencyMode implies
      all u: s.users |
        // User may hold mutually exclusive role pairs concurrently only during Emergency mode
        all r1, r2: u.assignedRoles + u.delegatedRoles |
          isMutuallyExclusive(r1,r2) implies true // no restriction during Emergency
}

// R3.3: Administrators temporarily hold emergency privileges during Emergency mode
fact R3_3_EmergencyPrivileges {
  all s: SystemState |
    s.mode = EmergencyMode implies
      all a: s.admins | EmergencyPrivileges in a.user.privileges
}

//////////////////////
// R4: Post Emergency Mode Actions

// R4.1: Emergency privileges revoked from administrators after Emergency ends
fact R4_1_EmergencyPrivilegesRevoked {
  all s1, s2: SystemState |
    s1.mode = EmergencyMode and s2.mode = NormalMode and s2.time > s1.time implies
      all a: s2.admins | EmergencyPrivileges not in a.user.privileges
}

// R4.2: Roles delegated during Emergency revoked after Emergency; roles delegated before remain unless expired or revoked
fact R4_2_DelegatedRoleRevocation {
  all s: SystemState |
    s.mode = NormalMode implies
      all u: s.users |
        all dri: DelegatedRoleInfo |
          dri.delegatedTo = u implies
            // If delegated during Emergency period, must be revoked by now
            ((some s.emergencyStart and some s.emergencyEnd) and
             dri.delegatedAt >= s.emergencyStart and dri.delegatedAt <= s.emergencyEnd) implies
              (some dri.revokedAt and dri.revokedAt <= s.time)
}

// R4.3: Administrators must update credentials immediately after returning to Normal mode from Emergency mode
fact R4_3_AdminCredentialUpdate {
  all s1, s2: SystemState |
    s1.mode = EmergencyMode and s2.mode = NormalMode and s2.time = s1.time + 1 implies
      // All admins updated credentials at s2.time
      s2.credentialUpdates = s2.admins
}

/////////////////////////
// CONCURRENCY AND LIVENESS

// Every submitted request is eventually processed
fact FRequestLiveness {
  all r: Request |
    some s1, s2: SystemState |
      r in s1.pendingRequests and
      r in s2.processedRequests and
      s1.time < s2.time
}

// Concurrency safety abstractly assumed; not explicitly modeled here

///////////////////////
// PREDICATES FOR VERIFICATION

// R1 predicate: emergency triggered by exactly two admins concurrently in Normal mode
pred R1 {
  some s: SystemState |
    s.mode = NormalMode and
    #s.emergencyTriggers = 2 and
    all a: s.emergencyTriggers | a in s.admins
}

// R2 predicate: emergency mode duration within max bound and system returns to Normal mode
pred R2 {
  all s1, s2: SystemState |
    s1.mode = EmergencyMode and s2.mode = EmergencyMode and s1.time < s2.time implies
      s2.time - s1.time <= 10 and
      some s3: SystemState | s3.time > s2.time and s3.mode = NormalMode
}

// R3 predicate: emergency behaviors during Emergency mode
pred R3 {
  all s: SystemState | s.mode = EmergencyMode implies (
    // R3.1
    all r1, r2: s.processedRequests |
      clearanceOrder(requestClassification[r1]) > clearanceOrder(requestClassification[r2]) implies
        r1.processedAtTime[s.time] < r2.processedAtTime[s.time]
    and
    // R3.2
    all u: s.users |
      all r1, r2: u.assignedRoles + u.delegatedRoles |
        isMutuallyExclusive(r1,r2) implies true
    and
    // R3.3
    all a: s.admins | EmergencyPrivileges in a.user.privileges
  )
}

// R4 predicate: post emergency actions hold
pred R4 {
  all s1, s2: SystemState |
    s1.mode = EmergencyMode and s2.mode = NormalMode and s2.time = s1.time + 1 implies (
      // R4.1
      all a: s2.admins | EmergencyPrivileges not in a.user.privileges
      and
      // R4.2
      all u: s2.users |
        all dri: DelegatedRoleInfo |
          dri.delegatedTo = u implies
            ((some s1.emergencyStart and some s1.emergencyEnd) and
             dri.delegatedAt >= s1.emergencyStart and dri.delegatedAt <= s1.emergencyEnd) implies
              (some dri.revokedAt and dri.revokedAt <= s2.time)
      and
      // R4.3
      s2.credentialUpdates = s2.admins
    )
}

// Combined predicates
pred R1R2 {
  R1 and R2
}

pred R1R2R3 {
  R1 and R2 and R3
}

pred All_Requirements {
  R1 and R2 and R3 and R4 and FUserClearance and FAdminClearance and FDelegationClearance and
  FRequestSubmissionClearance and FApprovalClearance and FDelegatedRoleExpirationRevocation and
  FDelegatedRoleTemporary and FRequestLiveness
}

//////////////////////
// ASSERTIONS TO CHECK

assert assertR1 {
  R1
}

assert assertR2 {
  R2
}

assert assertR3 {
  R3
}

assert assertR4 {
  R4
}

assert assertAll {
  All_Requirements
}

//////////////////////
// RUNS AND CHECKS

// Run predicates incrementally
run R1 for 5 Time, 3 User, 3 Admin, 5 Role, 5 Request, 5 Obj
run R1R2 for 10 Time, 3 User, 3 Admin, 5 Role, 5 Request, 5 Obj
run R1R2R3 for 10 Time, 4 User, 4 Admin, 6 Role, 6 Request, 6 Obj
run All_Requirements for 15 Time, 5 User, 5 Admin, 7 Role, 7 Request, 7 Obj

// Check assertions
check assertR1 for 5 Time, 3 User, 3 Admin, 5 Role, 5 Request, 5 Obj
check assertR2 for 10 Time, 3 User, 3 Admin, 5 Role, 5 Request, 5 Obj
check assertR3 for 10 Time, 4 User, 4 Admin, 6 Role, 6 Request, 6 Obj
check assertR4 for 10 Time, 4 User, 4 Admin, 6 Role, 6 Request, 6 Obj
check assertAll for 15 Time, 5 User, 5 Admin, 7 Role, 7 Request, 7 Obj
```

