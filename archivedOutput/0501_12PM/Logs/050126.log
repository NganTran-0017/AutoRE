// Alloy 6 model of RBAC system with Emergency Module per given requirements

open util/ordering[Time] // for linear time modeling

//////////////////////////////
// Basic sets and ordering //
//////////////////////////////

abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

fact ClearanceOrder {
  High != Medium && Medium != Low && High != Low
}

// Define a total order High > Medium > Low for clearance comparison
pred clearanceLeq[c1,c2: ClearanceLevel] {
  (c1 = Low) => (c2 = Low || c2 = Medium || c2 = High)
  (c1 = Medium) => (c2 = Medium || c2 = High)
  (c1 = High) => (c2 = High)
}

pred clearanceLess[c1,c2: ClearanceLevel] {
  clearanceLeq[c1,c2] && c1 != c2
}

/////////////////////////
// Roles and Permissions//
/////////////////////////

sig Permission {} // abstract permissions including emergency privileges

sig Role {
  minClearance: one ClearanceLevel,
  permissions: set Permission
}

/////////////////////////
// Users and Administrators //
/////////////////////////

sig User {
  clearance: one ClearanceLevel,
  assignedRoles: set Role,
  delegatedRoles: set DelegatedRole,
  updatedCredentialsAfterEmergency: set Time // times when credentials updated after emergency
}

sig Administrator in User {} // subset of User: high clearance & admins

fact AdminClearance {
  all a: Administrator | a.clearance = High
  // Not all high clearance users are admins:
  some u: User | u.clearance = High && u not in Administrator
}

////////////////////
// Delegations //
////////////////////

sig DelegatedRole {
  role: one Role,
  delegatedBy: one User, // must have higher clearance
  delegatedTo: one User,
  delegatedAt: one Time,
  expiresAt: one Time,
  revokedAt: lone Time // optional revocation time; none means not revoked
}

////////////////////
// System Objects //
////////////////////

sig SysObject {
  classification: one ClearanceLevel
}

////////////////////
// Requests //
////////////////////

sig Request {
  submittedBy: one User,
  affectedObjects: set SysObject,
  submittedAt: one Time,
  processedAt: lone Time, // none means not processed yet
  status: one RequestStatus
}

abstract sig RequestStatus {}
one sig Pending, Approved, Rejected extends RequestStatus {}

/////////////////////
// Request Classification //
/////////////////////

fun requestClassification[r: Request]: ClearanceLevel {
  // highest classification among affected objects
  let cls = r.affectedObjects.classification |
  if High in cls then High
  else if Medium in cls then Medium
  else Low
}

/////////////////////
// Emergency Mode //
/////////////////////

// System mode at each time point
abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// Emergency triggering event: a concurrency event of exactly two admins triggering emergency
sig EmergencyTriggerEvent {
  triggers: set Administrator, // exactly two admins
  occursAt: one Time
}

fact EmergencyTriggerEventCardinality {
  all ete: EmergencyTriggerEvent | #ete.triggers = 2
}

/////////////////////
// Mutual Exclusion of Roles //
/////////////////////

sig MutualExclusivePair {
  r1, r2: one Role
}

fact MutualExclusiveDistinct {
  all mep: MutualExclusivePair | mep.r1 != mep.r2
}

///////////////////////
// Emergency Privileges //
///////////////////////

sig EmergencyPrivilege extends Permission {}

///////////////////////
// Global Time and Mode //
///////////////////////

sig Time {}

one sig TimeOrdering {
  first: one Time,
  next: Time -> lone Time
}

///////////////////////
// Temporal States //
///////////////////////

// We model system state as a mapping from Time to system mode, requests, delegations, user roles, etc.

// For mutable info per time, we use var fields or relations indexed by Time

///////////////////////////
// System state per Time  //
///////////////////////////

sig State {
  time: one Time,
  mode: one SystemMode,
  activeDelegations: set DelegatedRole, // delegations active at this time (not expired or revoked)
  processedRequests: set Request, // requests processed at or before this time
  emergencyTriggers: set EmergencyTriggerEvent, // triggers occurred at or before this time
  users: set User,
  // user roles at time: assignedRoles are static, delegatedRoles change
  delegatedRolesAt: User -> set Role, // roles delegated and active (from activeDelegations)
  emergencyPrivilegesAt: set Permission, // emergency privileges granted now
  credentialsUpdatedAfterEmergencyAt: User -> set Time // per user, times of credential update after emergency ended
}

///////////////////////////
// Facts about clearance //
///////////////////////////

fact ClearanceTotalOrder {
  // For modeling clearance comparisons, define ordering relations:
  // Use helper predicates clearanceLeq and clearanceLess above
  all c: ClearanceLevel | clearanceLeq[c,c]
}

///////////////////////////
// Users and roles facts //
///////////////////////////

fact UserRolesContainment {
  all s: State, u: User |
    s.delegatedRolesAt[u] = { dr: DelegatedRole | dr.delegatedTo = u && dr in s.activeDelegations } .role
}

///////////////////////////
// Delegation constraints //
///////////////////////////

fact DelegationClearanceConstraint {
  all s: State, dr: DelegatedRole |
    dr in s.activeDelegations =>
      clearanceLess[dr.delegatedBy.clearance, dr.delegatedTo.clearance] = false and
      clearanceLeq[dr.role.minClearance, dr.delegatedTo.clearance]
}

///////////////////////////
// Delegation expiry and revocation //
///////////////////////////

fact DelegationActiveIfNotExpiredOrRevoked {
  all s: State, dr: DelegatedRole |
    dr in s.activeDelegations =>
      dr.delegatedAt in Time and dr.expiresAt in Time and
      // s.time between delegatedAt and expiresAt and before revokedAt if any
      let t = s.time |
        (dr.delegatedAt <= t and t < dr.expiresAt) and
        (no dr.revokedAt or t < dr.revokedAt)
}

///////////////////////////
// Request submission constraints //
///////////////////////////

fact RequestSubmissionClearance {
  all s: State, r: Request |
    r.submittedAt = s.time =>
      clearanceLeq[requestClassification[r], r.submittedBy.clearance]
}

///////////////////////////
// Request processing FIFO and concurrency //
///////////////////////////

fact RequestProcessingNormalModeFIFO {
  all s: State |
    s.mode = Normal =>
      // Requests processed in FIFO order
      all r1, r2: Request |
        r1 in s.processedRequests && r2 in s.processedRequests &&
        r1.submittedAt < r2.submittedAt =>
        r1.processedAt <= r2.processedAt
}

///////////////////////////
// Request processing Emergency mode priority and concurrency //
///////////////////////////

fact RequestProcessingEmergencyPriority {
  all s: State |
    s.mode = Emergency =>
      // Requests processed in priority order by classification: High > Medium > Low
      // All requests of higher priority must be processed before any of lower priority
      all r1, r2: Request |
        r1 in s.processedRequests && r2 in s.processedRequests &&
        let c1 = requestClassification[r1], c2 = requestClassification[r2] |
          clearanceLess[c2, c1] => // c1 > c2
          r2.processedAt > r1.processedAt
}

///////////////////////////
// Mutual exclusivity of roles //
///////////////////////////

fact MutualExclusivityNormal {
  all s: State, u: User |
    s.mode = Normal =>
      // user cannot hold any pair of mutually exclusive roles simultaneously
      all mep: MutualExclusivePair |
        not (mep.r1 in u.assignedRoles + s.delegatedRolesAt[u] &&
             mep.r2 in u.assignedRoles + s.delegatedRolesAt[u])
}

fact MutualExclusivityRelaxedEmergency {
  all s: State |
    s.mode = Emergency =>
      // mutual exclusivity constraints are lifted; no restriction here
      // So no fact forbidding it
      true
}

///////////////////////////
// Emergency privileges //
///////////////////////////

fact EmergencyPrivilegesGranted {
  all s: State |
    s.mode = Emergency =>
      s.emergencyPrivilegesAt = (Administrator & s.users).permissions & EmergencyPrivilege
}

fact EmergencyPrivilegesRevokedAfter {
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      no p: EmergencyPrivilege | p in s2.emergencyPrivilegesAt
}

///////////////////////////
// Delegated roles during Emergency //
///////////////////////////

fact DelegatedRoleRevocationAfterEmergency {
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      // Delegated roles granted during Emergency are revoked after Emergency ends
      all dr: DelegatedRole |
        (dr.delegatedAt in (s1.time..s2.time) && dr in s1.activeDelegations) =>
          dr not in s2.activeDelegations
}

///////////////////////////
// Credential update after Emergency //
///////////////////////////

fact AdminCredentialUpdateAfterEmergency {
  all s: State |
    s.mode = Normal =>
      all a: Administrator & s.users |
        some t: Time | t > s.time && t in a.updatedCredentialsAfterEmergency
}

///////////////////////////
// Emergency triggering //
///////////////////////////

fact EmergencyTriggeredByTwoAdminsConcurrently {
  // Emergency mode only entered if exactly two admins triggered emergency concurrently
  all s1, s2: State |
    s1.mode = Normal && s2.mode = Emergency && s1.time < s2.time =>
      some ete: EmergencyTriggerEvent |
        ete.occursAt = s2.time &&
        #ete.triggers = 2 &&
        all a: ete.triggers | a in Administrator
}

///////////////////////////
// Emergency mode duration and recovery //
///////////////////////////

fact EmergencyDurationFixedAndEventuallyEnds {
  // Emergency mode active for fixed duration but can be ended earlier manually
  // Model with facts ensuring eventually recovery to Normal mode
  all s: State |
    s.mode = Emergency =>
      some s2: State | s2.mode = Normal && s2.time > s.time
}

///////////////////////////
// Delegation clearance ordering //
// Delegate must have clearance >= role minClearance and delegator must have higher clearance than delegate
///////////////////////////

fact DelegationClearanceOrdering {
  all dr: DelegatedRole |
    clearanceLess[dr.delegatedBy.clearance, dr.delegatedTo.clearance] = false and
    clearanceLeq[dr.role.minClearance, dr.delegatedTo.clearance]
}

///////////////////////////
// Run predicates for incremental verification //
///////////////////////////

pred R1 {
  // R1: Emergency Triggering by exactly two admins simultaneously from Normal to Emergency
  some s1, s2: State |
    s1.mode = Normal && s2.mode = Emergency && s1.time < s2.time &&
    some ete: EmergencyTriggerEvent |
      ete.occursAt = s2.time &&
      #ete.triggers = 2 &&
      all a: ete.triggers | a in Administrator
}

pred R1R2 {
  // R1 + R2: Emergency Triggering + Emergency mode duration and recovery to Normal mode
  R1 &&
  all s: State |
    s.mode = Emergency =>
      some s2: State | s2.mode = Normal && s2.time > s.time
}

pred R1R2R3 {
  // R1 + R2 + R3: Emergency Triggering, Duration, and Emergency Mode Behavior

  R1R2 &&

  // R3.1: Emergency mode request processing priority and concurrency
  all s: State |
    s.mode = Emergency =>
      // Requests processed in priority order High > Medium > Low
      all r1, r2: Request |
        r1 in s.processedRequests && r2 in s.processedRequests &&
        let c1 = requestClassification[r1], c2 = requestClassification[r2] |
          clearanceLess[c2, c1] =>
          r2.processedAt > r1.processedAt

  &&

  // R3.2: Mutual exclusivity lifted during Emergency
  all s: State, u: User |
    s.mode = Emergency =>
      no mep: MutualExclusivePair |
        mep.r1 in u.assignedRoles + s.delegatedRolesAt[u] &&
        mep.r2 in u.assignedRoles + s.delegatedRolesAt[u]

  &&

  // R3.3: Emergency privileges granted to admins during Emergency
  all s: State |
    s.mode = Emergency =>
      s.emergencyPrivilegesAt = (Administrator & s.users).permissions & EmergencyPrivilege
}

pred R1R2R3R4 {
  // R1 to R4: All requirements including Post-Emergency actions

  R1R2R3 &&

  // R4.1: Emergency privileges revoked after Emergency ends
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      no p: EmergencyPrivilege | p in s2.emergencyPrivilegesAt

  &&

