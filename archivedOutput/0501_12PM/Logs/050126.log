  all s: State |
    s.mode = Normal =>
      all a: Administrator & s.users |
        some t: Time | t > s.time && t in a.updatedCredentialsAfterEmergency
}

pred All_Requirements {
  R1R2R3R4
}

///////////////////////////
// Assertions to check //
///////////////////////////

assert assertR1 {
  R1
}

assert assertR2 {
  R1R2
}

assert assertR3 {
  R1R2R3
}

assert assertR4 {
  R1R2R3R4
}

