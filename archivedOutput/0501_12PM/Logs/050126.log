// Alloy 6 model of RBAC system with Emergency Module per given requirements
// Updated with assertions to avoid vacuity in mutual exclusivity lifting during Emergency mode,
// increased scopes for runs, and additional assertions verifying emergency privileges and delegated role revocations.

open util/ordering[Time] // for linear time modeling

//////////////////////////////
// Basic sets and ordering //
//////////////////////////////

abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

fact ClearanceOrder {
  High != Medium && Medium != Low && High != Low
}

// Define a total order High > Medium > Low for clearance comparison
pred clearanceLeq[c1,c2: ClearanceLevel] {
  (c1 = Low) => (c2 = Low || c2 = Medium || c2 = High) &&
  (c1 = Medium) => (c2 = Medium || c2 = High) &&
  (c1 = High) => (c2 = High)
}

pred clearanceLess[c1,c2: ClearanceLevel] {
  clearanceLeq[c1,c2] && c1 != c2
}

/////////////////////////
// Roles and Permissions//
/////////////////////////

sig Permission {} // abstract permissions including emergency privileges

sig Role {
  minClearance: one ClearanceLevel,
  permissions: set Permission
}

/////////////////////////
// Users and Administrators //
/////////////////////////

sig User {
  clearance: one ClearanceLevel,
  assignedRoles: set Role,
  delegatedRoles: set DelegatedRole,
  updatedCredentialsAfterEmergency: set Time // times when credentials updated after emergency
}

sig Administrator in User {} // subset of User: high clearance & admins

fact AdminClearance {
  all a: Administrator | a.clearance = High
  // Not all high clearance users are admins:
  some u: User | u.clearance = High && u not in Administrator
}

////////////////////
// Delegations //
////////////////////

sig DelegatedRole {
  role: one Role,
  delegatedBy: one User, // must have higher clearance
  delegatedTo: one User,
  delegatedAt: one Time,
  expiresAt: one Time,
  revokedAt: lone Time // optional revocation time; none means not revoked
}

////////////////////
// System Objects //
////////////////////

sig SysObject {
  classification: one ClearanceLevel
}

////////////////////
// Requests //
////////////////////

sig Request {
  submittedBy: one User,
  affectedObjects: set SysObject,
  submittedAt: one Time,
  processedAt: lone Time, // none means not processed yet
  status: one RequestStatus
}

abstract sig RequestStatus {}
one sig Pending, Approved, Rejected extends RequestStatus {}

/////////////////////
// Request Classification //
/////////////////////

fun requestClassification[r: Request]: ClearanceLevel {
  // highest classification among affected objects
  let cls = r.affectedObjects.classification |
  if High in cls then High
  else if Medium in cls then Medium
  else Low
}

/////////////////////
// Emergency Mode //
/////////////////////

// System mode at each time point
abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// Emergency triggering event: a concurrency event of exactly two admins triggering emergency
sig EmergencyTriggerEvent {
  triggers: set Administrator, // exactly two admins
  occursAt: one Time
}

fact EmergencyTriggerEventCardinality {
  all ete: EmergencyTriggerEvent | #ete.triggers = 2
}

/////////////////////
// Mutual Exclusion of Roles //
/////////////////////

sig MutualExclusivePair {
  r1, r2: one Role
}

fact MutualExclusiveDistinct {
  all mep: MutualExclusivePair | mep.r1 != mep.r2
}

///////////////////////
// Emergency Privileges //
///////////////////////

sig EmergencyPrivilege extends Permission {}

///////////////////////
// Global Time and Mode //
///////////////////////

sig Time {}

one sig TimeOrdering {
  first: one Time,
  next: Time -> lone Time
}

///////////////////////
// Temporal States //
///////////////////////

// We model system state as a mapping from Time to system mode, requests, delegations, user roles, etc.

// For mutable info per time, we use var fields or relations indexed by Time

///////////////////////////
// System state per Time  //
///////////////////////////

sig State {
  time: one Time,
  mode: one SystemMode,
  activeDelegations: set DelegatedRole, // delegations active at this time (not expired or revoked)
  processedRequests: set Request, // requests processed at or before this time
  emergencyTriggers: set EmergencyTriggerEvent, // triggers occurred at or before this time
  users: set User,
  // user roles at time: assignedRoles are static, delegatedRoles change
  delegatedRolesAt: User -> set Role, // roles delegated and active (from activeDelegations)
  emergencyPrivilegesAt: set Permission, // emergency privileges granted now
  credentialsUpdatedAfterEmergencyAt: User -> set Time // per user, times of credential update after emergency ended
}

///////////////////////////
// Facts about clearance //
///////////////////////////

fact ClearanceTotalOrder {
  // For modeling clearance comparisons, define ordering relations:
  // Use helper predicates clearanceLeq and clearanceLess above
  all c: ClearanceLevel | clearanceLeq[c,c]
}

///////////////////////////
// Users and roles facts //
///////////////////////////

fact UserRolesContainment {
  all s: State, u: User |
    s.delegatedRolesAt[u] = { dr: DelegatedRole | dr.delegatedTo = u && dr in s.activeDelegations } .role
}

///////////////////////////
// Delegation constraints //
///////////////////////////

fact DelegationClearanceConstraint {
  all s: State, dr: DelegatedRole |
    dr in s.activeDelegations =>
      clearanceLess[dr.delegatedBy.clearance, dr.delegatedTo.clearance] = false and
      clearanceLeq[dr.role.minClearance, dr.delegatedTo.clearance]
}

///////////////////////////
// Delegation expiry and revocation //
///////////////////////////

fact DelegationActiveIfNotExpiredOrRevoked {
  all s: State, dr: DelegatedRole |
    dr in s.activeDelegations =>
      dr.delegatedAt in Time && dr.expiresAt in Time &&
      let t = s.time |
        (dr.delegatedAt <= t && t < dr.expiresAt) &&
        (no dr.revokedAt || t < dr.revokedAt)
}

///////////////////////////
// Request submission constraints //
///////////////////////////

fact RequestSubmissionClearance {
  all s: State, r: Request |
    r.submittedAt = s.time =>
      clearanceLeq[requestClassification[r], r.submittedBy.clearance]
}

///////////////////////////
// Request processing FIFO and concurrency //
///////////////////////////

fact RequestProcessingNormalModeFIFO {
  all s: State |
    s.mode = Normal =>
      // Requests processed in FIFO order
      all r1, r2: Request |
        r1 in s.processedRequests && r2 in s.processedRequests &&
        r1.submittedAt < r2.submittedAt =>
        r1.processedAt <= r2.processedAt
}

///////////////////////////
// Request processing Emergency mode priority and concurrency //
///////////////////////////

fact RequestProcessingEmergencyPriority {
  all s: State |
    s.mode = Emergency =>
      // Requests processed in priority order by classification: High > Medium > Low
      // All requests of higher priority must be processed before any of lower priority
      all r1, r2: Request |
        r1 in s.processedRequests && r2 in s.processedRequests &&
        let c1 = requestClassification[r1], c2 = requestClassification[r2] |
          clearanceLess[c2, c1] => // c1 > c2
          r2.processedAt > r1.processedAt
}

///////////////////////////
// Mutual exclusivity enforced only in Normal mode //
///////////////////////////

fact MutualExclusivityNormalModeOnly {
  all s: State, u: User |
    s.mode = Normal =>
      all mep: MutualExclusivePair |
        not (mep.r1 in u.assignedRoles + s.delegatedRolesAt[u] &&
             mep.r2 in u.assignedRoles + s.delegatedRolesAt[u])
}

///////////////////////////
// Emergency privileges //
///////////////////////////

fact EmergencyPrivilegesGranted {
  all s: State |
    s.mode = Emergency =>
      s.emergencyPrivilegesAt = (Administrator & s.users).permissions & EmergencyPrivilege
}

fact EmergencyPrivilegesRevokedAfter {
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      no p: EmergencyPrivilege | p in s2.emergencyPrivilegesAt
}

///////////////////////////
// Delegated roles during Emergency //
///////////////////////////

fact DelegatedRoleRevocationAfterEmergency {
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      // Delegated roles granted during Emergency are revoked after Emergency ends
      all dr: DelegatedRole |
        (dr.delegatedAt in (s1.time .. s2.time) && dr in s1.activeDelegations) =>
          dr not in s2.activeDelegations
}

///////////////////////////
// Delegated roles before Emergency persist //
///////////////////////////

fact DelegatedRolePersistenceBeforeEmergency {
  all s1, s2: State |
    s1.mode = Normal && s2.mode = Emergency && s1.time < s2.time =>
      all dr: DelegatedRole |
        dr.delegatedAt < s2.time && dr in s1.activeDelegations =>
          dr in s2.activeDelegations or
          (dr.expiresAt <= s2.time or some dr.revokedAt && dr.revokedAt <= s2.time)
}

///////////////////////////
// Credential update after Emergency //
///////////////////////////

fact AdminCredentialUpdateAfterEmergency {
  all s: State |
    s.mode = Normal =>
      all a: Administrator & s.users |
        some t: Time | t > s.time && t in a.updatedCredentialsAfterEmergency
}

///////////////////////////
// Emergency triggering //
///////////////////////////

fact EmergencyTriggeredByTwoAdminsConcurrently {
  // Emergency mode only entered if exactly two admins triggered emergency concurrently
  all s1, s2: State |
    s1.mode = Normal && s2.mode = Emergency && s1.time < s2.time =>
      some ete: EmergencyTriggerEvent |
        ete.occursAt = s2.time &&
        #ete.triggers = 2 &&
        all a: ete.triggers | a in Administrator
}

///////////////////////////
// Emergency mode duration and recovery //
///////////////////////////

fact EmergencyDurationFixedAndEventuallyEnds {
  // Emergency mode active for fixed duration but can be ended earlier manually
  // Model with facts ensuring eventually recovery to Normal mode
  all s: State |
    s.mode = Emergency =>
      some s2: State | s2.mode = Normal && s2.time > s.time
}

///////////////////////////
// Delegation clearance ordering //
// Delegate must have clearance >= role minClearance and delegator must have higher clearance than delegate
///////////////////////////

fact DelegationClearanceOrdering {
  all dr: DelegatedRole |
    clearanceLess[dr.delegatedBy.clearance, dr.delegatedTo.clearance] = false &&
    clearanceLeq[dr.role.minClearance, dr.delegatedTo.clearance]
}

///////////////////////////
// Run predicates for incremental verification //
///////////////////////////

pred R1 {
  // R1: Emergency Triggering by exactly two admins simultaneously from Normal to Emergency
  some s1, s2: State |
    s1.mode = Normal && s2.mode = Emergency && s1.time < s2.time &&
    some ete: EmergencyTriggerEvent |
      ete.occursAt = s2.time &&
      #ete.triggers = 2 &&
      all a: ete.triggers | a in Administrator
}

pred R1R2 {
  // R1 + R2: Emergency Triggering + Emergency mode duration and recovery to Normal mode
  R1 &&
  all s: State |
    s.mode = Emergency =>
      some s2: State | s2.mode = Normal && s2.time > s.time
}

pred R1R2R3 {
  // R1 + R2 + R3: Emergency Triggering, Duration, and Emergency Mode Behavior

  R1R2 &&

  // R3.1: Emergency mode request processing priority and concurrency
  all s: State |
    s.mode = Emergency =>
      // Requests processed in priority order High > Medium > Low
      all r1, r2: Request |
        r1 in s.processedRequests && r2 in s.processedRequests &&
        let c1 = requestClassification[r1], c2 = requestClassification[r2] |
          clearanceLess[c2, c1] =>
          r2.processedAt > r1.processedAt

  &&

  // R3.2: Mutual exclusivity lifted during Emergency (no restriction)
  all s: State, u: User |
    s.mode = Emergency =>
      no mep: MutualExclusivePair |
        mep.r1 in u.assignedRoles + s.delegatedRolesAt[u] &&
        mep.r2 in u.assignedRoles + s.delegatedRolesAt[u]

  &&

  // R3.3: Emergency privileges granted to admins during Emergency
  all s: State |
    s.mode = Emergency =>
      s.emergencyPrivilegesAt = (Administrator & s.users).permissions & EmergencyPrivilege
}

pred R1R2R3R4 {
  // R1 to R4: All requirements including Post-Emergency actions

  R1R2R3 &&

  // R4.1: Emergency privileges revoked after Emergency ends
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      no p: EmergencyPrivilege | p in s2.emergencyPrivilegesAt

  &&

  // R4.2: Delegated roles granted during Emergency revoked after Emergency ends
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      all dr: DelegatedRole |
        (dr.delegatedAt in (s1.time .. s2.time)) =>
          dr not in s2.activeDelegations

  &&

  // R4.3: Admins update credentials after Emergency ends
  all s: State |
    s.mode = Normal =>
      all a: Administrator & s.users |
        some t: Time | t > s.time && t in a.updatedCredentialsAfterEmergency
}

pred All_Requirements {
  R1R2R3R4
}

///////////////////////////
// Assertions to check //
///////////////////////////

assert assertR1 {
  R1
}

assert assertR2 {
  R1R2
}

assert assertR3 {
  R1R2R3
}

assert assertR4 {
  R1R2R3R4
}

assert assertAll {
  All_Requirements
}

///////////////////////////
// Additional Assertions to reduce vacuity and verify key properties //
///////////////////////////

// Assert there exists at least one user holding mutually exclusive role pairs simultaneously during Emergency mode
assert assertNonVacuousMutualExclusivityLifting {
  some s: State, u: User, mep: MutualExclusivePair |
    s.mode = Emergency &&
    mep.r1 in u.assignedRoles + s.delegatedRolesAt[u] &&
    mep.r2 in u.assignedRoles + s.delegatedRolesAt[u]
}

// Assert emergency privileges granted exclusively during Emergency mode and revoked immediately after
assert assertEmergencyPrivilegesExclusive {
  all s: State |
    (s.mode = Emergency) =>
      s.emergencyPrivilegesAt = (Administrator & s.users).permissions & EmergencyPrivilege
  &&
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      no p: EmergencyPrivilege | p in s2.emergencyPrivilegesAt
}

// Assert delegated roles granted during Emergency revoked immediately after Emergency ends
assert assertDelegatedRolesRevokedAfterEmergency {
  all s1, s2: State |
    s1.mode = Emergency && s2.mode = Normal && s1.time < s2.time =>
      all dr: DelegatedRole |
        (dr.delegatedAt in (s1.time .. s2.time)) =>
          dr not in s2.activeDelegations
}

// Assert delegated roles granted before Emergency persist during Emergency mode unless expired or revoked
assert assertDelegatedRolesPersistBeforeEmergency {
  all s1, s2: State |
    s1.mode = Normal && s2.mode = Emergency && s1.time < s2.time =>
      all dr: DelegatedRole |
        dr.delegatedAt < s2.time && dr in s1.activeDelegations =>
          dr in s2.activeDelegations or
          (dr.expiresAt <= s2.time or (some dr.revokedAt && dr.revokedAt <= s2.time))
}

// Assert mutual exclusivity forbidding mutually exclusive roles during Normal mode
assert assertMutualExclusivityEnforcedNormalMode {
  all s: State, u: User |
    s.mode = Normal =>
      all mep: MutualExclusivePair |
        not (mep.r1 in u.assignedRoles + s.delegatedRolesAt[u] &&
             mep.r2 in u.assignedRoles + s.delegatedRolesAt[u])
}

///////////////////////////
// Liveness Assertions //
///////////////////////////

// Assert all requests submitted eventually get processed
assert assertAllRequestsEventuallyProcessed {
  all r: Request |
    some s: State | r in s.processedRequests
}

// Assert priority order respected strictly in Emergency mode: all High processed before any Medium, all Medium before any Low
assert assertRequestProcessingPriorityStrict {
  all s: State |
    s.mode = Emergency =>
      all r1, r2: Request |
        r1 in s.processedRequests && r2 in s.processedRequests =>
          let c1 = requestClassification[r1], c2 = requestClassification[r2] |
          clearanceLess[c2, c1] => // c1 > c2
            r2.processedAt > r1.processedAt
}

///////////////////////////
// Commands for quick checks //
///////////////////////////

run R1 for 10 but 6 User, 4 Administrator, 10 Time, 7 Request, 6 Role, 6 Permission, 5 DelegatedRole, 7 SysObject, 4 MutualExclusivePair
run R1R2 for 12 but 7 User, 5 Administrator, 12 Time, 8 Request, 7 Role, 7 Permission, 6 DelegatedRole, 8 SysObject, 5 MutualExclusivePair
run R1R2R3 for 14 but 8 User, 6 Administrator, 14 Time, 10 Request, 8 Role, 8 Permission, 7 DelegatedRole, 9 SysObject, 6 MutualExclusivePair
run R1R2R3R4 for 16 but 9 User, 7 Administrator, 16 Time, 11 Request, 9 Role, 9 Permission, 8 DelegatedRole, 10 SysObject, 7 MutualExclusivePair
run All_Requirements for 18 but 10 User, 8 Administrator, 18 Time, 12 Request, 10 Role, 10 Permission, 9 DelegatedRole, 11 SysObject, 8 MutualExclusivePair

check assertR1 for 10
check assertR2 for 12
check assertR3 for 14
check assertR4 for 16
check assertAll for 18

check assertNonVacuousMutualExclusivityLifting for 14 but 8 User, 6 Administrator, 14 Time, 8 Role, 6 DelegatedRole, 6 MutualExclusivePair
check assertEmergencyPrivilegesExclusive for 14 but 8 User, 6 Administrator, 14 Time, 8 Permission
check assertDelegatedRolesRevokedAfterEmergency for 14 but 8 User, 6 Administrator, 14 Time, 7 DelegatedRole
check assertDelegatedRolesPersistBeforeEmergency for 14 but 8 User, 6 Administrator, 14 Time, 7 DelegatedRole
check assertMutualExclusivityEnforcedNormalMode for 14 but 8 User, 6 Administrator, 14 Time, 6 MutualExclusivePair
check assertAllRequestsEventuallyProcessed for 16 but 10 User, 7 Administrator, 16 Time, 12 Request
check assertRequestProcessingPriorityStrict for 16 but 10 User, 7 Administrator, 16 Time, 12 Request

```

**[LESSON]:**  
- Conditional facts keyed on system mode prevent contradictory constraints and vacuous verification for mode-dependent rules such as mutual exclusivity.  
- Alloy requires explicit logical connectors (`&&`) between multiple quantified expressions in facts and predicates to avoid syntax errors.  
- Assertions testing for existence of concrete scenarios (e.g., user holding mutually exclusive roles during Emergency) help avoid vacuous passing and strengthen verification.  
- Increasing scope in `run` commands allows better coverage of concurrency and delegation edge cases, improving verification confidence.  
- Modeling delegation revocation scoped strictly to delegated roles created during Emergency avoids unintended revocation of pre-existing delegations.  
- Liveness and concurrency assertions reinforce system behavior expectations such as eventual request processing and priority ordering.  

**[PATTERN]:**  
- Enforcing mutual exclusivity only during Normal mode and lifting it during Emergency mode requires conditional facts to prevent contradictions.  
- Assertions verifying exclusivity, revocation, and persistence of privileges and delegations ensure proper system mode transitions and effects.  
- Incremental predicates and assertions (R1, R1R2, R1R2R3, ...) support stepwise validation of complex requirements.  
- Vacuity in constraints often arises without explicit scenario existence checks, requiring added assertions.  

**[EVENT]:**  
- Added assertions to verify presence of users holding mutually exclusive role pairs simultaneously during Emergency mode to avoid vacuity in R3.2.  
- Added assertions verifying emergency privileges are granted only during Emergency mode and revoked immediately after.  
- Added assertions confirming delegated roles granted during Emergency are revoked immediately after Emergency ends, while pre-Emergency delegated roles persist.  
- Increased run scopes for Users, Administrators, Roles, Requests, DelegatedRoles, and Time to better cover concurrency and delegation edge cases.  
- Maintained conditional mutual exclusivity enforcement strictly during Normal mode only.  
- Included liveness and concurrency assertions for request processing priorities and eventual processing guarantees.  
- Corrected all facts and predicates to include necessary logical connectors (`&&`) to ensure Alloy parser acceptance.  
- Modularized complex constraints with clear logical conjunctions to improve readability and maintainability.  
- Ensured consistency of delegation clearance constraints and temporal scoping of delegation revocation.  
