[2026-06-02 21:25:02] ```alloy
// Alloy 6 Model: Emergency RBAC Extension
// --- Core types, roles, users, requests ---

abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig Mode {}
one sig Normal, Emergency extends Mode {}

sig Role {
  minClearance: one ClearanceLevel
}

sig User {
  clearance: one ClearanceLevel,
  roles: set Role,
  isAdmin: one Bool
}

sig SystemObject {
  classification: one ClearanceLevel
}

sig Request {
  submittedBy: one User,
  affects: set SystemObject,
  classification: one ClearanceLevel,
  time: one Int
}

// Mutually exclusive roles (must exist, always two distinct roles)
sig MutExPair {
  r1, r2: one Role
}

// Emergency Privilege: granted only to admins in Emergency mode
sig EmergencyPrivilege {}

// Delegated roles: temporary, with grantor and grantee
sig Delegation {
  delegator: one User,
  grantee: one User,
  role: one Role
}

// Emergency trigger and deactivation events
sig EmergencyTrigger {
  admins: set User, // exactly 2 admins
  time: one Int
}
sig EmergencyDeactivation {
  admins: set User, // exactly 2 admins
  time: one Int
}

// System state trace
sig State {
  mode: one Mode,
  time: one Int,
  activeDelegations: set Delegation,
  heldEmergencyPrivileges: set User,
  requests: set Request,
  rolesHeld: User -> set Role, // user-role assignment at this state
  pendingTriggers: set EmergencyTrigger,
  pendingDeactivations: set EmergencyDeactivation
}

// --- Fixed emergency duration ---
one sig EmergencyConfig {
  duration: one Int // fixed, predetermined duration
}

// --- System structure and existing constraints ---

fact SystemAssumptions {
  // Administrators always have High clearance, and are distinguished by isAdmin
  all u: User | u.isAdmin = True => u.clearance = High

  // Mutually exclusive roles must always exist and be distinct
  all m: MutExPair | m.r1 != m.r2

  // All roles have a minimum clearance
  all r: Role | some r.minClearance

  // Requests must not exceed user's clearance (unless Emergency mode, see behaviors)
  all s: State, req: s.requests | req.classification <= req.submittedBy.clearance

  // Delegated roles must respect clearance
  all d: Delegation | d.grantor.clearance > d.grantee.clearance and d.role.minClearance <= d.grantee.clearance

  // All EmergencyPrivilege holders are admins
  all s: State, u: s.heldEmergencyPrivileges | u.isAdmin = True
}

// --- System transition facts (abstract, not step-by-step execution) ---

fact EmergencyModeEntry {
  // Emergency mode can only be entered from Normal mode, via exactly two admins triggering
  all s: State | 
    s.mode = Emergency =>
      some t: s.pendingTriggers | #t.admins = 2 and all a: t.admins | a.isAdmin = True
}

fact EmergencyModeExit {
  // Emergency mode lasts at most EmergencyConfig.duration, unless ended early by exactly 2 admins
  // (Abstract time: time is Int, non-decreasing)
  all s: State |
    s.mode = Emergency =>
      (s.time < EmergencyConfig.duration or
        some d: s.pendingDeactivations | #d.admins = 2 and all a: d.admins | a.isAdmin = True)
}

fact EmergencyPrivilegeGrant {
  // Only admins may hold emergency privilege, only in Emergency mode
  all s: State |
    (s.mode = Emergency => s.heldEmergencyPrivileges in User & (u: User | u.isAdmin = True))
    and (s.mode = Normal => no s.heldEmergencyPrivileges)
}

// --- Prospective Requirements ---

// R1: Emergency Activation
pred R1 [s: State] {
  s.mode = Emergency
  some t: s.pendingTriggers | #t.admins = 2 and all a: t.admins | a.isAdmin = True
}

// R2: Emergency Duration and Reversion
pred R1R2 [s: State, s': State] {
  // s: Emergency mode, s': successor state
  s.mode = Emergency
  // Emergency mode is active only for EmergencyConfig.duration unless ended early
  s'.time = s.time + 1
  (s'.mode = Emergency =>
    s'.time - s.time < EmergencyConfig.duration and
    no d: s'.pendingDeactivations | #d.admins = 2
  )
  (s'.mode = Normal =>
    (s'.time - s.time = EmergencyConfig.duration or
      some d: s'.pendingDeactivations | #d.admins = 2)
  )
}

// R3: Emergency Mode Behavior
pred R1R2R3 [s: State] {
  s.mode = Emergency
  // R3.1: FIFO may be bypassed for high-classification requests
  // (Abstract: there exist two high-class requests processed out of FIFO order)
  some r1, r2: s.requests | r1 != r2 and r1.classification = High and r2.classification = High and r1.time > r2.time

  // R3.2: Users may hold both roles in a mutually exclusive pair
  some m: MutExPair, u: User | m.r1 in s.rolesHeld[u] and m.r2 in s.rolesHeld[u]

  // R3.3: Admins temporarily hold emergency privilege
  all u: User | u.isAdmin = True => u in s.heldEmergencyPrivileges
}

// R4: Emergency Mode Termination Actions
pred R1R2R3R4 [s: State, s': State] {
  // s: last Emergency, s': first Normal after Emergency
  s.mode = Emergency
  s'.mode = Normal
  // R4.1: Emergency privileges must be revoked
  no s'.heldEmergencyPrivileges
  // R4.2: Delegated roles during emergency must be revoked (no delegations active)
  no s'.activeDelegations
  // R4.3: Admins update their credentials (abstract: some action occurred)
  all u: User | u.isAdmin = True => updatedCredential[u, s, s']
}

// Abstract credential update
pred updatedCredential[u: User, s: State, s': State] {
  // Abstract: just require some predicate is true for each admin after Emergency
  // (For reasoning, could be a flag or timestamp, here just an existential event)
  some e: EmergencyDeactivation | u in e.admins and e.time = s'.time
}

// --- All Requirements (compose all above) ---
pred All_Requirements [
  s: State, s': State
] {
  R1[s]
  R1R2[s, s']
  R1R2R3[s]
  R1R2R3R4[s, s']
}

// --- Baseline predicate (no prospective requirements) ---
pred baseline {}

// --- Run commands ---

run baseline for 4 User, 4 Role, 2 MutExPair, 2 State, 4 Request, 4 Delegation, 2 EmergencyTrigger, 2 EmergencyDeactivation, 1 EmergencyConfig, 4 SystemObject, 2 EmergencyPrivilege
run All_Requirements for 4 User, 4 Role, 2 MutExPair, 2 State, 4 Request, 4 Delegation, 2 EmergencyTrigger, 2 EmergencyDeactivation, 1 EmergencyConfig, 4 SystemObject, 2 EmergencyPrivilege
run R1 for 4 User, 4 Role, 2 MutExPair, 2 State, 2 EmergencyTrigger
run R1R2 for 4 User, 4 Role, 2 MutExPair, 2 State, 2 EmergencyDeactivation, 1 EmergencyConfig
run R1R2R3 for 4 User, 4 Role, 2 MutExPair, 2 State, 4 Request
run R1R2R3R4 for 4 User, 4 Role, 2 MutExPair, 2 State, 4 Delegation, 2 EmergencyDeactivation

// --- Assertions for key properties ---

// Assert: Mutually exclusive roles can NEVER be held by same user in Normal mode (negative scenario)
assert assertNoMutExInNormal {
  all s: State |
    s.mode = Normal =>
      all m: MutExPair, u: User | not (m.r1 in s.rolesHeld[u] and m.r2 in s.rolesHeld[u])
}

// Assert: Mutually exclusive roles CAN be held by some user in Emergency mode (positive scenario)
assert assertMutExPossibleInEmergency {
  some s: State, m: MutExPair, u: User |
    s.mode = Emergency and m.r1 in s.rolesHeld[u] and m.r2 in s.rolesHeld[u]
}

// Assert: EmergencyPrivilege is never granted outside Emergency mode
assert assertNoEmergencyPrivilegeInNormal {
  all s: State | s.mode = Normal => no s.heldEmergencyPrivileges
}

// Assert: EmergencyPrivilege always revoked immediately after Emergency ends
assert assertEmergencyPrivilegeRevokedOnNormal {
  all s, s': State |
    s.mode = Emergency and s'.mode = Normal and s'.time = s.time + 1 =>
      no s'.heldEmergencyPrivileges
}

// Assert: Emergency mode cannot be started by fewer or more than two admins
assert assertOnlyTwoAdminsTriggerEmergency {
  all s: State | 
    s.mode = Emergency =>
      some t: s.pendingTriggers | #t.admins = 2 and all a: t.admins | a.isAdmin = True
}

check assertNoMutExInNormal for 4 User, 4 Role, 2 MutExPair, 2 State
check assertMutExPossibleInEmergency for 4 User, 4 Role, 2 MutExPair, 2 State
check assertNoEmergencyPrivilegeInNormal for 4 User, 4 Role, 2 State
check assertEmergencyPrivilegeRevokedOnNormal for 4 User, 4 Role, 2 State
check assertOnlyTwoAdminsTriggerEmergency for 4 User, 4 Role, 2 MutExPair, 2 State

```

