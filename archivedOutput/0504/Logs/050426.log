```alloy
// Alloy 6 model of RBAC system with Emergency Module per updated requirements and feedback

open util/ordering[Time];

// === Signatures ===
// Time for temporal modeling
// SystemMode is either Normal or Emergency at each Time
abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// Security clearance levels
abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

// User with clearance; some users are administrators
sig User {
  clearance: one ClearanceLevel,
  assignedRoles: set Role,            // assigned roles (non-delegated)
  delegatedRoles: set DelegatedRole  // delegated roles currently held
}
// Administrator: subset of users with High clearance and admin privilege
sig Administrator in User {}
fact AdminClearance { all a: Administrator | a.clearance = High }

// Role with minimum clearance and mutual exclusion constraints
sig Role {
  minClearance: one ClearanceLevel,
  mutuallyExclusive: set Role
}

// DelegatedRole links a Role to a User with delegation metadata
sig DelegatedRole {
  role: one Role,
  delegate: one User,
  delegatedBy: one User,       // delegator with higher clearance
  delegationTime: one Time,
  expiryTime: one Time,
  revoked: Bool               // use Alloy built-in Bool type for revoked flag
}

// SystemObject with classification
sig SystemObject {
  classification: one ClearanceLevel
}

// Request submitted by a user, operates on objects, with classification derived
sig Request {
  submitter: one User,
  objects: set SystemObject,
  classification: one ClearanceLevel,
  submittedAt: one Time,
  processedAt: lone Time       // time when processed; none if not yet processed
}

// Emergency Privileges: abstract permissions granted only in Emergency mode to admins
sig EmergencyPrivilege {}
// Emergency privileges granted to administrators during Emergency mode
sig EmergencyPrivilegeGrant {
  admin: one Administrator,
  privilege: one EmergencyPrivilege,
  grantedAt: one Time,
  revokedAt: lone Time
}

// System state at each Time: mode, requests queue, credential update state
sig SystemState {
  time: one Time,
  mode: one SystemMode,
  requests: set Request,
  // Credential update flags for administrators after Emergency mode ends
  credentialUpdated: User -> one Bool
}

// === Facts encoding existing system assumptions and constraints ===

// Clearance ordering helper predicate
pred clearanceAtLeast[c1, c2: ClearanceLevel] {
  (c1 = c2) or
  (c1 = High and c2 != High) or
  (c1 = Medium and c2 = Low)
}

// Administrator definition (subset of users with High clearance)
fact AdminDefinition {
  all a: Administrator | a in User and a.clearance = High
}

// Users hold roles subject to clearance constraints (except during Emergency mode)
fact UserRoleClearanceConstraint {
  all s: SystemState | all u: User | 
    (s.mode = Normal => (
      // Assigned roles min clearance <= user clearance
      all r: u.assignedRoles | clearanceAtLeast[u.clearance, r.minClearance] and
      // Delegated roles also respect clearance at delegation time outside Emergency mode
      all dr: u.delegatedRoles | clearanceAtLeast[u.clearance, dr.role.minClearance]
    )) or
    (s.mode = Emergency => true) // No clearance check enforced during Emergency mode here
}

// Mutual exclusion of roles enforced only in Normal mode
fact MutualExclusionNormalMode {
  all s: SystemState | s.mode = Normal =>
    all u: User |
      // Collect all roles assigned and delegated roles' roles of user u
      all r1, r2: u.assignedRoles + u.delegatedRoles.role |
        r1 != r2 implies no (r1.mutuallyExclusive & r2.mutuallyExclusive)
}

// Requests classification equals highest classification of affected objects
fact RequestClassification {
  all req: Request | 
    // If no objects, classification is Low
    (no req.objects => req.classification = Low) and
    // If some objects, classification is highest among them
    (some req.objects => {
      let cls = req.objects.classification | 
        (High in cls => req.classification = High) and
        ((High not in cls) and (Medium in cls) => req.classification = Medium) and
        ((High not in cls) and (Medium not in cls) => req.classification = Low)
    })
}

// Users can only submit requests with classification <= their clearance
fact RequestSubmissionClearance {
  all req: Request | clearanceAtLeast[req.submitter.clearance, req.classification]
}

// Requests are processed concurrently but in FIFO order in Normal mode
fact RequestFIFOProcessingNormalMode {
  all s: SystemState | s.mode = Normal =>
    all req1, req2: s.requests | 
      (req1.submittedAt < req2.submittedAt and req2.processedAt != none) implies
      (req1.processedAt != none and req1.processedAt < req2.processedAt)
}

// Delegated roles expire after fixed period or revoked anytime by admins
fact DelegatedRoleValidity {
  all dr: DelegatedRole | dr.revoked = False implies
    dr.expiryTime > dr.delegationTime
}

// === Prospective component requirements ===

// R1: Emergency Mode Triggering
// Exactly two administrators must simultaneously trigger emergency in Normal mode to enter Emergency mode
pred R1TriggerEmergency[s1, s2: SystemState] {
  s1.mode = Normal and s2.mode = Emergency and s1.time < s2.time and
  // Exactly two distinct administrators trigger emergency simultaneously at s2.time
  let triggers = { a: Administrator | TriggeredEmergency[a, s2.time] } |
  #triggers = 2 and
  all a: triggers | a in Administrator
}
// Abstract predicate for an administrator triggering emergency at a time
pred TriggeredEmergency[a: Administrator, t: Time] { some a } // placeholder for concurrency abstraction

// R2: Emergency Mode Duration and Recovery
fact R2EmergencyDuration {
  all s1, s2: SystemState | 
    (s1.mode = Emergency and s2.mode = Normal and s1.time < s2.time) implies
    some t: Time | t > s1.time and s2.time = t
}

// R3: Emergency Mode Operations

// R3.1: Request processing may bypass FIFO to prioritize high-classification requests
fact R3_1_RequestProcessingEmergency {
  all s: SystemState | s.mode = Emergency =>
    // No strict FIFO order required; high-class requests may be processed concurrently
    no disj req1, req2: s.requests | 
      req1.submittedAt < req2.submittedAt and req2.processedAt != none and req1.processedAt != none and
      req1.processedAt > req2.processedAt and req1.classification = High and req2.classification != High
}

// R3.2: Mutual exclusion relaxed during Emergency mode
fact MutualExclusionRelaxedEmergency {
  all s: SystemState | s.mode = Emergency =>
    // No mutual exclusion enforced; trivially true, so no constraint needed
    true
}

// R3.3: Administrators temporarily hold emergency privileges during Emergency mode
fact R3_3_EmergencyPrivileges {
  all epg: EmergencyPrivilegeGrant | 
    epg.grantedAt in Time and
    // emergency privileges granted only during Emergency mode time window
    some s: SystemState | s.time = epg.grantedAt and s.mode = Emergency and
    // revoked at or before emergency end time
    (epg.revokedAt != none implies epg.revokedAt > epg.grantedAt)
}

// R3.4: Requests submitted exactly at Normal-to-Emergency boundary are held and processed by priority
fact R3_4_RequestHoldAndPriorityAtBoundary {
  // Requests submitted exactly at s2.time (Normal->Emergency boundary) are not processed at s1.time (Normal)
  all s1, s2: SystemState | s1.mode = Normal and s2.mode = Emergency and s1.time < s2.time =>
    all req: s1.requests | req.submittedAt = s2.time => req.processedAt = none

  // Once Emergency mode is active, requests at boundary processed in priority order:
  // all High first, then Medium, then Low
  all s: SystemState | s.mode = Emergency => (
    // For any two requests at s.time with submittedAt = s.time:
    all req1, req2: s.requests | req1.submittedAt = s.time and req2.submittedAt = s.time and req1 != req2 =>
      (clearanceAtLeast[req1.classification, req2.classification] => 
        // req1 processed before or concurrently with req2 (processedAt <= processedAt)
        req1.processedAt != none and req2.processedAt != none and req1.processedAt <= req2.processedAt)
  )
}

// R4: Post-Emergency Cleanup and Updates

// R4.1: Emergency privileges revoked when Emergency mode ends
fact R4_1_EmergencyPrivilegesRevokedAtEnd {
  all epg: EmergencyPrivilegeGrant | 
    some endTime: Time | 
      // endTime is the time when emergency mode ends
      ((some s1, s2: SystemState | s1.mode = Emergency and s2.mode = Normal and s1.time < s2.time and endTime = s2.time) =>
      epg.revokedAt = endTime)
}

// R4.2: Roles delegated during Emergency mode revoked at emergency end; prior delegated roles continue
fact R4_2_DelegatedRolesRevokedAtEnd {
  all dr: DelegatedRole |
    // If delegated during Emergency mode, revoked at emergency end
    (some s1, s2: SystemState | s1.mode = Emergency and s2.mode = Normal and
      s1.time <= dr.delegationTime and dr.delegationTime < s2.time) =>
      dr.revoked = True
}

// R4.3: Administrators must update credentials immediately after Emergency mode ends (soft constraint)
// Modeled as a fact but will be verified as a soft constraint via assertion
fact R4_3_CredentialUpdateRequired {
  all s1, s2: SystemState |
    s1.mode = Emergency and s2.mode = Normal and s1.time < s2.time =>
      // At s2.time, credentialUpdated flag for all admins is True
      all a: Administrator | s2.credentialUpdated[a] = True
}

// === Predicates for scenarios and transitions ===

// Incremental predicates for stepwise verification

pred R1 {
  // Model initial Normal mode system state and simultaneous trigger by exactly two admins to Emergency mode
  some s1, s2: SystemState | 
    s1.mode = Normal and s2.mode = Emergency and s1.time < s2.time and
    R1TriggerEmergency[s1, s2]
}

pred R1R2 {
  R1 and
  // Emergency mode duration finite and recovery to Normal mode
  some s1, s2: SystemState | s1.mode = Emergency and s2.mode = Normal and s1.time < s2.time and
    s2.time != s1.time  // abstract finite duration, time difference unspecified
}

pred R1R2R3 {
  R1R2 and
  // Emergency mode operational changes apply
  all s: SystemState | s.mode = Emergency => (
    // Request processing may bypass FIFO
    R3_1_RequestProcessingEmergency and
    // Mutual exclusion relaxed (documented; no constraint needed)
    true and
    // Emergency privileges granted
    some epg: EmergencyPrivilegeGrant | epg.grantedAt = s.time
  )
}

pred All_Requirements {
  R1R2R3 and
  // Post-emergency cleanup and credential updates enforced
  all s1, s2: SystemState | s1.mode = Emergency and s2.mode = Normal and s1.time < s2.time => (
    R4_1_EmergencyPrivilegesRevokedAtEnd and
    R4_2_DelegatedRolesRevokedAtEnd and
    R4_3_CredentialUpdateRequired
  )
}

// === Assertions to verify key properties ===

// Assert exactly two admins trigger emergency simultaneously
assert assertR1_TriggerSimultaneity {
  all s1, s2: SystemState | s1.mode = Normal and s2.mode = Emergency and s1.time < s2.time =>
    let triggers = { a: Administrator | TriggeredEmergency[a, s2.time] } |
    #triggers = 2
}

// Assert emergency duration finite and system returns to Normal eventually
assert assertR2_EmergencyFiniteDuration {
  all s1: SystemState | s1.mode = Emergency =>
    some s2: SystemState | s2.mode = Normal and s2.time > s1.time
}

// Assert mutual exclusion enforced only outside Emergency mode
assert assertR3_MutualExclusionRelaxedOnlyEmergency {
  all s: SystemState | (
    s.mode = Emergency or
    (all u: User | all r1, r2: u.assignedRoles + u.delegatedRoles.role | 
      r1 != r2 implies no (r1.mutuallyExclusive & r2.mutuallyExclusive))
  )
}

// Assert post-emergency cleanup: emergency privileges revoked, delegated roles revoked, credentials updated
assert assertR4_PostEmergencyCleanup {
  all s1, s2: SystemState | s1.mode = Emergency and s2.mode = Normal and s1.time < s2.time =>
    // Emergency privileges revoked
    all epg: EmergencyPrivilegeGrant | epg.revokedAt = s2.time and
    // Emergency delegated roles revoked
    all dr: DelegatedRole | (dr.delegationTime >= s1.time and dr.delegationTime < s2.time) implies dr.revoked = True and
    // Admins updated credentials (soft constraint)
    all a: Administrator | s2.credentialUpdated[a] = True
}

// Additional assertions to strengthen verification

// Assert that fewer than two admins cannot trigger emergency mode
assert assertR1_NoLessThanTwoAdminsTrigger {
  all s1, s2: SystemState | s1.mode = Normal and s2.mode = Emergency and s1.time < s2.time =>
    let triggers = { a: Administrator | TriggeredEmergency[a, s2.time] } |
    #triggers >= 2
}

// Assert delegated roles assigned before Emergency mode remain after Emergency ends
assert assertR4_DelegatedRolesBeforeRemain {
  all dr: DelegatedRole |
    (some s1, s2: SystemState | s1.mode = Emergency and s2.mode = Normal and s1.time < s2.time and dr.delegationTime < s1.time) =>
    dr.revoked = False
}

// Assert all requests are eventually processed (liveness) in Normal and Emergency modes
assert assertLiveness {
  all req: Request | some s: SystemState | req in s.requests and req.processedAt != none
}

// Assert requests submitted at Normal->Emergency boundary are held at Normal and processed by priority in Emergency
assert assertR3_4_BoundaryRequestHandling {
  all s1, s2: SystemState | s1.mode = Normal and s2.mode = Emergency and s1.time < s2.time =>
    all req: s1.requests | req.submittedAt = s2.time => req.processedAt = none
}

// === Run and check commands for verification ===

run R1 for 5 but 3 User, 3 Administrator, 5 Role, 5 SystemObject, 3 Request, 5 Time, 5 DelegatedRole, 3 EmergencyPrivilegeGrant
run R1R2 for 5 but 3 User, 3 Administrator, 5 Role, 5 SystemObject, 3 Request, 5 Time, 5 DelegatedRole, 3 EmergencyPrivilegeGrant
run R1R2R3 for 5 but 3 User, 3 Administrator, 5 Role, 5 SystemObject, 3 Request, 5 Time, 5 DelegatedRole, 3 EmergencyPrivilegeGrant
run All_Requirements for 6 but 4 User, 4 Administrator, 6 Role, 6 SystemObject, 4 Request, 6 Time, 6 DelegatedRole, 4 EmergencyPrivilegeGrant

check assertR1_TriggerSimultaneity for 5 but 3 User, 3 Administrator, 5 Role, 5 SystemObject, 3 Request, 5 Time, 5 DelegatedRole, 3 EmergencyPrivilegeGrant
check assertR2_EmergencyFiniteDuration for 5 but 3 User, 3 Administrator, 5 Role, 5 SystemObject, 3 Request, 5 Time, 5 DelegatedRole, 3 EmergencyPrivilegeGrant
check assertR3_MutualExclusionRelaxedOnlyEmergency for 5 but 3 User, 3 Administrator, 5 Role, 5 SystemObject, 3 Request, 5 Time, 5 DelegatedRole, 3 EmergencyPrivilegeGrant
check assertR4_PostEmergencyCleanup for 6 but 4 User, 4 Administrator, 6 Role, 6 SystemObject, 4 Request, 6 Time, 6 DelegatedRole, 4 EmergencyPrivilegeGrant
check assertR1_NoLessThanTwoAdminsTrigger for 5 but 3 User, 3 Administrator, 5 Role, 5 SystemObject, 3 Request, 5 Time, 5 DelegatedRole, 3 EmergencyPrivilegeGrant
check assertR4_DelegatedRolesBeforeRemain for 6 but 4 User, 4 Administrator, 6 Role, 6 SystemObject, 4 Request, 6 Time, 6 DelegatedRole, 4 EmergencyPrivilegeGrant
check assertLiveness for 6 but 4 User, 4 Administrator, 6 Role, 6 SystemObject, 4 Request, 6 Time, 6 DelegatedRole, 4 EmergencyPrivilegeGrant
check assertR3_4_BoundaryRequestHandling for 6 but 4 User, 4 Administrator, 6 Role, 6 SystemObject, 4 Request, 6 Time, 6 DelegatedRole, 4 EmergencyPrivilegeGrant
```

- `open` statements must be placed at the very beginning of the Alloy model file before any comments or code, and must be terminated with a semicolon (`;`) in Alloy 6 syntax.  
- Comments can be placed after the `open` statements but not before them to avoid syntax errors.  
- All conditional logic must be expressed using relational logic and guarded formulas; inline `if-then-else` expressions are not supported.  
