```alloy
// Alloy 6 model for Role-based Access Control (RBAC) system with Emergency Mode

open util/ordering[Time] as ord

// Signatures
abstract sig User {
  clearance: one Clearance,
  roles: set Role
}

sig Administrator extends User {}

abstract sig Role {}

abstract sig Clearance {}

one sig High, Medium, Low extends Clearance {}

sig Request {
  classification: one Clearance,
  submittedBy: one User
}

abstract sig Mode {}

one sig Normal, Emergency extends Mode {}

// Time signature for temporal modeling
sig Time {}

// Facts
fact ExistingSystemAssumptions {
  // Users can only submit requests that match or are below their security clearance level
  all r: Request | r.classification in ord/first(clearance).closure[*]
  
  // Delegated roles must be revoked after a fixed time or by an administrator
  // (Modeled abstractly without concrete time arithmetic)
}

// Predicates
pred R1 {
  // Triggering Emergency Mode
  some a1, a2: Administrator | a1 != a2
}

pred R1R2 {
  // Emergency mode remains active for a fixed duration or can be ended early by two administrators
  some t: Time | some a1, a2: Administrator | a1 != a2
}

pred R1R2R3 {
  // Behavior During Emergency Mode
  R1R2 and
  // R3.1: Bypass FIFO order for high classification requests
  all r: Request | r.classification = High => /* bypass FIFO */
  // R3.2: Users may temporarily hold mutually exclusive roles
  // R3.3: Administrators temporarily hold emergency privileges
}

pred R1R2R3R4 {
  // Post-Emergency Mode Operations
  R1R2R3 and
  // R4.1: Revoke emergency privileges
  // R4.2: Revoke roles delegated during the emergency
  // R4.3: Administrators must update their credentials
}

pred All_Requirements {
  R1R2R3R4
}

// Assertions for verification
assert assertR1 {
  R1 implies /* Condition under which Emergency Mode can be triggered */
}

assert assertR2 {
  R1R2 implies /* Emergency Mode duration constraints */
}

assert assertR3 {
  R1R2R3 implies /* Correct behavior during Emergency Mode */
}

assert assertR4 {
  R1R2R3R4 implies /* Correct operations post-Emergency Mode */
}

// Run predicates for verification
run R1
run R1R2
run R1R2R3
run R1R2R3R4
run All_Requirements

// Check assertions
check assertR1
check assertR2
check assertR3
check assertR4
```

