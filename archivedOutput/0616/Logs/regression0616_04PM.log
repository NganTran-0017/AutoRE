eck assertDelegationRevokedAtEmergencyExit\n-check assertDelegationRetainedAfterEmergencyIfNotDuring\n-check assertRequestStatusMonotonic\n-check assertNormalModeFIFO\n-check assertEmergencyProcessingPriority\n-check assertRequestProcessorClearance\n-check assertRoleAssignmentClearance\n-check assertRolePersistence\n\\ No newline at end of file\n+pred EmergencyDelegationRevocationScenario {\n+    some s, s2: State, d: Delegation |\n+        s.mode = Emergency and s2.mode = Normal and Next[s, s2] and\n+        d.duringEmergency = True and\n+        d in s.activeDelegations and\n+        d not in s2.activeDelegations\n+}\n+\n+pred PreEmergencyDelegationPersistenceScenario {\n+    some s0, sE, sN: State, d: Delegation |\n+        s0.mode = Normal and\n+        d.duringEmergency = False and\n+        d in s0.activeDelegations and\n+        -- Enter Emergency\n+        sE.mode = Emergency and Next[s0, sE] and\n+        d in sE.activeDelegations and\n+        -- Exit Emergency\n+        sN.mode = Normal and Next[sE, sN] and\n+        d in sN.activeDelegations\n+}\n+\n+pred EmergencyBypassFIFOScenario {\n+    some s, s2: State, r1, r2: Request |\n+        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] and\n+        r1 != r2 and\n+        s.reqStatus[r1] = Pending and s.reqStatus[r2] = Pending and\n+        requestClassification[r1] = High and\n+        requestClassification[r2] != High and\n+        s2.reqStatus[r1] = Processed and\n+        s2.reqStatus[r2] = Pending\n+}\n+\n+\n+run baseline for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance\n+run All_Requirements for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance\n+run R1 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 EmergencyPrivilege, 3 Clearance\n+run R1R2 for 5 State, 3 User, 2 Administrator, 3 Role, 3 Request, 3 Delegation, 3 Object, 1 Emerge