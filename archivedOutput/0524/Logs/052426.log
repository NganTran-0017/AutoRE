// Alloy 6 Model for RBAC Emergency Module (Abstract, for Verification)
// =======================================================

// Utility modules
open util/ordering[Time]

// ==== ADDITION: EmergencyFlag ENUM (RENAMED TO AVOID CONFLICT) ====
abstract sig EmergencyFlag {}
one sig EFlag_Emergency, EFlag_NormalOp extends EmergencyFlag {}

// ==== SIGNATURES ====

// Time for modeling mode transitions/temporal properties
sig Time {}

// Clearance levels (High > Medium > Low)
abstract sig Clearance {}
one sig High, Medium, Low extends Clearance {}

// System operational mode
abstract sig Mode {}
one sig Normal, Emergency extends Mode {}

// Users and administrators
sig User {
    clearance: one Clearance,
    roles: set Role,
    delegated: set Role   // roles delegated to this user (temporary)
}

sig Administrator extends User {
    credentials: one Credential
}

// Credential (for admin updates post-emergency)
sig Credential {}

// Roles, with mutual exclusion relation
sig Role {
    minClearance: one Clearance
}
sig MutExPair {
    r1, r2: one Role
}

// Object and classification
sig Object {
    classification: one Clearance
}

// Request: action by user, with classification, on objects
sig Request {
    submitter: one User,
    classification: one Clearance,
    targets: some Object
}

// Delegation relation (who delegated which role to whom)
sig Delegation {
    from: one User,
    to: one User,
    role: one Role,
    duringEmergency: one EmergencyFlag // replaced 'one Bool', values now EFlag_Emergency/EFlag_NormalOp
}

// Emergency privilege (abstract, granted to admins only during Emergency)
sig EmergencyPrivilege {}

// System state at time t
sig SystemState {
    time: one Time, // === FIX: Added explicit bijection Time <-> SystemState ===
    mode: one Mode,
    // Which requests are pending, in queue order (FIFO)
    pending: seq Request,
    // Which requests are being processed at this moment
    processing: set Request,
    // Which roles are held by each user at this time
    userRoles: User -> set Role,
    // Delegations in effect at this time
    activeDelegations: set Delegation,
    // Admins holding emergency privilege at this time
    adminWithEmergencyPriv: set Administrator,
    // Which admins need to update credentials
    adminNeedsCredentialUpdate: set Administrator
}

// === FIX: Bijective mapping between Time and SystemState ===
fact TimeStateBijection {
    all t: Time | one s: SystemState | s.time = t
    all s: SystemState | one t: Time | s.time = t
}

// Map Time to SystemState
fun snapshot[t: Time]: one SystemState { one s: SystemState | s.time = t }

// === FIX: systemStateAt is now obsolete, replaced by snapshot. Remove obsolete function. ===

// ==== EXISTING SYSTEM FACTS ====

// Baseline RBAC facts (as needed for verification)
fact RBAC_Baseline {
    // Only administrators have High clearance and admin privileges
    all a: Administrator | a.clearance = High
    // Users cannot have clearance above High
    all u: User | u.clearance in Clearance
    // Each role has a minimum clearance
    all r: Role | r.minClearance in Clearance

    // No user can hold a role below their clearance
    all t: Time, u: User, r: Role |
      r in snapshot[t].userRoles[u] => u.clearance >= r.minClearance

    // No user can submit a request with classification above their clearance
    all t: Time, req: Request |
      req in snapshot[t].pending + snapshot[t].processing =>
        req.submitter.clearance >= req.classification

    // Delegation: only from higher to lower or equal clearance
    all t: Time, d: Delegation |
      d in snapshot[t].activeDelegations =>
        d.from.clearance >= d.to.clearance

    // Mutual exclusion: In Normal mode, no user holds both roles in any MutExPair
    all t: Time | snapshot[t].mode = Normal =>
      all p: MutExPair, u: User |
        not (p.r1 in snapshot[t].userRoles[u] and p.r2 in snapshot[t].userRoles[u])

    // At all times, at least one MutExPair exists
    some MutExPair

    // Mode can only be Normal or Emergency
    all t: Time | snapshot[t].mode in Mode

    // EmergencyPrivilege only granted to admins during Emergency
    all t: Time | snapshot[t].adminWithEmergencyPriv in Administrator
    all t: Time | snapshot[t].mode = Emergency iff some snapshot[t].adminWithEmergencyPriv
}

// ==== PROSPECTIVE REQUIREMENTS ====

// --- R1: Emergency Triggering ---
// Exactly 2 admins, joint simultaneous action, triggers Emergency mode from Normal

pred R1 {
    // Find t0 in Normal, t1 the next time instant, where Emergency is triggered
    some t0, t1: Time | ord/next[t0] = t1 and
        snapshot[t0].mode = Normal and
        snapshot[t1].mode = Emergency and
        // Exactly two admins jointly trigger at t0 (simultaneously)
        let admins = {a: Administrator | /* joint action performed at t0 by a */ true} |
            #admins = 2
        // Only admins can trigger
}

// --- R2: Emergency Duration and Reversion ---
// Emergency mode has a strict, bounded duration, then system reverts to Normal

pred R1R2 {
    // Emergency mode entered at t1, must revert to Normal at some t2 > t1
    some t1, t2: Time | 
        snapshot[t1].mode = Emergency and
        t1 in Time and
        t2 in Time and
        ord/lt[t1,t2] and
        // For all t: t1 <= t < t2, mode = Emergency
        all t: Time | (ord/lte[t1,t] and ord/lt[t,t2]) => snapshot[t].mode = Emergency
        // At t2, mode returns to Normal
        snapshot[t2].mode = Normal
}

// --- R3: Emergency Mode Behavior ---

pred R1R2R3 {
    R1R2[]
    // R3.1: In Emergency mode, FIFO may be bypassed for high-classification requests
    some t: Time | snapshot[t].mode = Emergency and
      some reqs: set Request | 
        all req: reqs | req.classification = High and
        reqs in snapshot[t].processing and
        // Not required to be in FIFO order
        #reqs >= 2

    // R3.2: In Emergency, users may hold mutually exclusive roles simultaneously
    some t: Time | snapshot[t].mode = Emergency and
      some p: MutExPair, u: User |
        p.r1 in snapshot[t].userRoles[u] and p.r2 in snapshot[t].userRoles[u]

    // R3.3: Admins acquire emergency privilege during Emergency
    all t: Time | snapshot[t].mode = Emergency =>
        snapshot[t].adminWithEmergencyPriv = Administrator
}

// --- R4: Post-Emergency Restoration ---

pred R1R2R3R4 {
    R1R2R3[]
    // After Emergency ends, admin emergency privileges revoked, delegated roles revoked, admins must update credentials
    some tE, tN: Time |
      snapshot[tE].mode = Emergency and
      ord/next[tE] = tN and
      snapshot[tN].mode = Normal and
      // Immediately after Emergency ends:
      no snapshot[tN].adminWithEmergencyPriv
      // All delegations during Emergency are revoked at tN
      all d: Delegation | d.duringEmergency = EFlag_Emergency => d not in snapshot[tN].activeDelegations
      // All admins must update credentials at tN
      snapshot[tN].adminNeedsCredentialUpdate = Administrator
}

// --- All Requirements ---
pred All_Requirements {
    R1[]
    R1R2[]
    R1R2R3[]
    R1R2R3R4[]
}

// ==== BASELINE SCENARIO ====
pred baseline {}

// ==== INCREMENTAL RUN COMMANDS ====
run baseline
run All_Requirements
run R1
run R1R2
run R1R2R3
run R1R2R3R4

// ==== ASSERTIONS FOR VERIFICATION ====

// 1. Mutual exclusion positive/negative: In Emergency, mutual exclusion can be violated; in Normal, cannot
assert assertMutEx_Positive {
    some t: Time | snapshot[t].mode = Emergency and
      some p: MutExPair, u: User |
        p.r1 in snapshot[t].userRoles[u] and p.r2 in snapshot[t].userRoles[u]
}
assert assertMutEx_Negative {
    all t: Time | snapshot[t].mode = Normal =>
      all p: MutExPair, u: User |
        not (p.r1 in snapshot[t].userRoles[u] and p.r2 in snapshot[t].userRoles[u])
}

// 2. Emergency privilege only during Emergency mode
assert assertEmergencyPrivilegeOnlyInEmergency {
    all t: Time |
        snapshot[t].adminWithEmergencyPriv != none
            iff snapshot[t].mode = Emergency
}

// 3. Emergency privilege always revoked after Emergency
assert assertEmergencyPrivilegeRevokedAfterEmergency {
    all t, tNext: Time | ord/next[t] = tNext =>
      snapshot[t].mode = Emergency and snapshot[tNext].mode = Normal implies
        no snapshot[tNext].adminWithEmergencyPriv
}

// 4. Role delegations during Emergency revoked after Emergency ends
assert assertDelegationRevokedAfterEmergency {
    all t, tNext: Time | ord/next[t] = tNext =>
      snapshot[t].mode = Emergency and snapshot[tNext].mode = Normal implies
        all d: Delegation | d.duringEmergency = EFlag_Emergency implies d not in snapshot[tNext].activeDelegations
}

// 5. Admins must update credentials after Emergency
assert assertAdminCredentialUpdateAfterEmergency {
    all t, tNext: Time | ord/next[t] = tNext =>
      snapshot[t].mode = Emergency and snapshot[tNext].mode = Normal implies
        snapshot[tNext].adminNeedsCredentialUpdate = Administrator
}

// ==== CHECK COMMANDS ====
check assertMutEx_Positive
check assertMutEx_Negative
check assertEmergencyPrivilegeOnlyInEmergency
check assertEmergencyPrivilegeRevokedAfterEmergency
check assertDelegationRevokedAfterEmergency
check assertAdminCredentialUpdateAfterEmergency
```

**Current Requirements:**
```
SYSTEM OVERVIEW
===============
The Role-based Access Control (RBAC) system operates in a multi-user environment that enforces authorization via roles, role hierarchies, security clearance levels, and object classifications. It supports temporary delegation and revocation of roles, concurrent request processing in FIFO order, and ensures correctness, liveness, and safety under concurrency. The new Emergency Module introduces emergency operations, allowing temporary privilege escalation, altered request processing rules, and additional administrative requirements during emergencies.

PROSPECTIVE FUNCTIONAL REQUIREMENTS
=======================
R1: Emergency Triggering
While in Normal mode, exactly two administrators are required to jointly trigger an emergency, causing the system to enter Emergency mode. Both administrators must perform the triggering action simultaneously (i.e., within a strictly enforced, minimal time window), constituting a joint action.

R2: Emergency Duration and Reversion
The Emergency mode remains active only for a limited, bounded period, after which the system must return to Normal mode.

R3: Emergency Mode Behavior
During Emergency mode:
  R3.1: Request processing may bypass the FIFO order, permitting prioritization and simultaneous processing of multiple high-classification requests.
  R3.2: Users may temporarily hold roles that are normally mutually exclusive.
  R3.3: Administrators temporarily acquire emergency privileges.

R4: Post-Emergency Restoration
After Emergency mode ends:
  R4.1: All emergency privileges are revoked from administrators.
  R4.2: Any roles delegated during the emergency are revoked.
  R4.3: Administrators must update their credentials.

KEY CONCEPTS AND ENTITIES
==========================
- User: An individual assigned roles and a clearance level.
- Administrator: A user with High clearance and administrative privileges.
- Role: A set of permissions, which can be assigned or delegated, with possible mutual exclusivity and minimum clearance requirements.
- Delegated Role: A temporary role assignment from a higher-clearance to a lower-clearance user.
- Clearance Level: High, Medium, or Low; determines access and delegation eligibility.
- Object: A system entity with a classification (High, Medium, Low).
- Request: An action submitted by a user, affecting one or more objects, with a classification.
- Emergency Mode: A system state with altered operational rules, triggered jointly and simultaneously by two administrators.
- Emergency Privilege: Temporary privileges granted to administrators during Emergency mode.
- Mutual Exclusive Roles: Roles that cannot be held by the same user in Normal mode.
- Credential: Authentication or authorization data associated with an administrator.
- Mode: System operational state (Normal or Emergency).

ASSUMPTIONS REQUIRING CLARIFICATION
====================================
None. All previously identified assumptions have been clarified: Emergency mode triggering requires a joint, simultaneous action by exactly two administrators.

CONSTRAINTS
===========
- Only users with Administrator status (High clearance) may participate in triggering Emergency mode.
- Emergency mode may only be activated from Normal mode, not recursively or from other states.
- Emergency mode has a strictly bounded duration; system must guarantee reversion to Normal mode.
- During Emergency mode, normal constraints on mutual exclusive roles are suspended.
- Any roles delegated during Emergency mode are revoked upon its conclusion.
- Emergency privileges for administrators are granted only during Emergency mode and revoked immediately after.
- Administrators are required to update their credentials after Emergency mode ends, prior to resuming standard administrative actions.
- Request processing order (FIFO) may be bypassed only in Emergency mode and only for high-classification requests.
- No user may submit a request with a classification exceeding their clearance level, regardless of mode.
- Delegation and clearance constraints remain enforced unless explicitly suspended by Emergency mode behavior.
- The triggering of Emergency mode requires a joint, simultaneous action by exactly two administrators, performed within a strictly enforced minimal time window.
```

Previous Lessons:
1. Alloy does not support arithmetic operations on abstract signature atoms; time and duration constraints require numeric time representations or mapping functions.
2. Alloy does not support arithmetic directly on abstract signature atoms; temporal constraints require mapping time atoms to integers or modeling time as integers.
3. ** Alloy models involving temporal properties must use numeric or ordered integer time representations to support arithmetic and comparisons; abstract atoms alone are inadequate.
4. ** Modeling Time as discrete integer steps with an injective mapping function `timeValue` enables precise temporal arithmetic and ordering, resolving syntax errors and supporting complex temporal constraints in Alloy.
