// Mutual exclusion: it is possible for some user to hold both roles in Emergency (positive)
assert assertMutExEmergency {
  some s: State | s.mode = Emergency and
    some p: MutExPair | some u: User | (p.r1 in s.assigned[u] and p.r2 in s.assigned[u])
}
check assertMutExEmergency for 8 State

// Emergency privilege always granted to exactly the two emAdmins in Emergency
assert assertEmergencyPrivilegeGrant {
  all s: State | s.mode = Emergency => s.emergencyPrivs = s.emAdmins and #s.emAdmins = 2
}
check assertEmergencyPrivilegeGrant for 8 State

// Delegated roles granted in Emergency are revoked at exit
assert assertDelegatedRoleRevocation {
  all sE, sN: State | 
    sE.mode = Emergency and
    next[sE] = sN and
    sN.mode = Normal => no sN.delegated
}
