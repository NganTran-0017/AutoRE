run R1R2 for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time
run R1R2R3 for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time
run R1R2R3R4 for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time

// ---------- ASSERTIONS TO CHECK PROPERTIES ----------

// Emergency privilege never exists outside Emergency (negative scenario)
assert assertNoEmergencyPrivOutsideEmergency {
  all s: State | s.mode != Emergency => no s.emergencyPrivs
}
check assertNoEmergencyPrivOutsideEmergency for 8 State

// Mutual exclusion: no user can hold both roles of any MutExPair in Normal mode (positive/negative)
assert assertMutExNormal {
  all s: State | s.mode = Normal =>
    all p: MutExPair | all u: User | not (p.r1 in s.assigned[u] and p.r2 in s.assigned[u])
}
