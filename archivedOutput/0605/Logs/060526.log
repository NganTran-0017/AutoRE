// RBAC Emergency Mode: Alloy 6 Abstract Model

open util/ordering[Time] as TO
open util/seq[Request]

// ---------- BASIC STRUCTURE ----------

abstract sig User {}
one sig Admin extends User {} // Abstract group for all admins
sig Administrator extends Admin {} // Actual administrator users

abstract sig Clearance { }
one sig High, Medium, Low extends Clearance {}

sig Role {
  reqClearance: one Clearance
}

sig Object {
  classification: one Clearance
}

sig Request {
