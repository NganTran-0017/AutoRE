    s'.emergencyPrivs = s'.emAdmins
}

// R2: Emergency Mode Duration and Early Deactivation
pred R1R2 {
  R1[]
  // Emergency can end after fixed duration or upon early concurrent action by same admins
  some s0, s1, s2: State |
