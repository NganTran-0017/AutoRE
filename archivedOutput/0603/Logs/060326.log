    s0.mode = Normal and
    s1.mode = Emergency and
    // Either duration expires:
      (TO/ord[s2.t] - TO/ord[s1.t] >= emDuration and s2.mode = Normal)
      // Or early deactivation:
      or (s2.mode = Normal and s2.emAdmins = s1.emAdmins and #s1.emAdmins = 2)
}

// R3: Emergency Behaviors (Bypass FIFO, MutEx, Emergency Priv)
pred R1R2R3 {
