// RBAC Emergency Mode: Alloy 6 Abstract Model

open util/ordering[Time] as TO
open util/seq as seq // Correct idiom for Alloy 6 (lowercase alias)

// ---------- BASIC STRUCTURE ----------

abstract sig User {}
one sig Admin extends User {} // Abstract group for all admins
sig Administrator extends Admin {} // Actual administrator users

abstract sig Clearance { }
one sig High, Medium, Low extends Clearance {}

sig Role {
  reqClearance: one Clearance
}

sig Object {
  classification: one Clearance
}

sig Request {
  user: one User,
  target: one Object,
  classif: one Clearance
}

// Exclusive role pairs (always present, as per user review)
sig MutExPair {
  r1, r2: one Role
}

// Abstract notion of Emergency Privilege
one sig EmergencyPrivilege {}

// System modes
abstract sig Mode {}
one sig Normal, Emergency extends Mode {}

// Time modeling
sig Time {}

// System state at each time
sig State {
  t: one Time,
  mode: one Mode,
  // Role assignments: user → role (includes delegated roles)
  assigned: User -> Role,
  // Delegated roles (subset of assigned, for tracking emergency revocation)
  delegated: User -> Role,
  // FIFO queue of requests (abstract)
  requestQueue: seq/Seq[Request], // changed here
  // Emergency privilege holders
  emergencyPrivs: set User,
  // Admins who triggered current Emergency (set of exactly 2 during Emergency, else empty)
  emAdmins: set Administrator,
  // For each admin: did they update credentials at this step after Emergency ends
  adminUpdated: Administrator -> one Time
}

// Emergency duration (fixed length, system-defined)
fun emDuration: Int { 3 } // Abstract: Emergency lasts 3 time steps unless ended early

// Helper: next state
fun next[s: State]: lone State {
  { s': State | TO/next[s.t] = s'.t }
}

// The system trace: total order of States over Time
fact TraceInit {
  // Initial state is in Normal mode, no emergency, empty privilege set, no admins set, etc.
  let s0 = TO/first | 
    s0.mode = Normal and
    no s0.emAdmins and
    no s0.emergencyPrivs and
    no s0.delegated and
    no s0.adminUpdated
}

// ---------- EXISTING SYSTEM INVARIANTS ----------

fact RBAC_Structure {
  // All administrators have High clearance
  all a: Administrator | a in Admin and all r: a.(assigned) | r.reqClearance = High
  // Roles require a clearance
  all r: Role | one r.reqClearance
  // Every MutExPair is two distinct roles
  all p: MutExPair | p.r1 != p.r2
  // At least one MutExPair always exists
  some MutExPair
}

// Mutual exclusion: in Normal, no user may hold both roles of any MutExPair
fact MutEx_Normal {
  all s: State | s.mode = Normal =>
    all p: MutExPair |
      all u: User | not (p.r1 in s.assigned[u] and p.r2 in s.assigned[u])
}

// Mutual exclusion: in Emergency, this constraint is lifted
fact MutEx_Emergency {
  all s: State | s.mode = Emergency =>
    some p: MutExPair |
      some u: User | (p.r1 in s.assigned[u] and p.r2 in s.assigned[u])
}

// Emergency privileges only exist for the two triggering admins, only in Emergency
fact EmergencyPrivilegeGrant {
  all s: State | 
    s.mode = Emergency => s.emergencyPrivs = s.emAdmins and #s.emAdmins = 2
  all s: State | 
    s.mode = Normal => no s.emergencyPrivs and no s.emAdmins
}

// Emergency privilege must never exist outside Emergency
fact EmergencyPrivilegeSafety {
  all s: State | (s.mode != Emergency) => no s.emergencyPrivs
}

// Delegated roles granted during Emergency are tracked for revocation
fact DelegationInvariant {
  all s: State | s.delegated in s.assigned
}

// ---------- PREDICATES FOR REQUIREMENTS/SCENARIOS ----------

// Empty: baseline for facts only
pred baseline {}

// R1: Emergency Mode Trigger
pred R1 {
  // There exists a transition from Normal to Emergency, triggered by exactly two admins
  some s, s': State | 
    next[s] = s' and
    s.mode = Normal and
    s'.mode = Emergency and
    #s'.emAdmins = 2 and
    // Only these two admins received emergency privilege in s'
    s'.emergencyPrivs = s'.emAdmins
}

// R2: Emergency Mode Duration and Early Deactivation
pred R1R2 {
  R1[]
  // Emergency can end after fixed duration or upon early concurrent action by same admins
  some s0, s1, s2: State |
    next[s0] = s1 and next[s1] = s2 and
    s0.mode = Normal and
    s1.mode = Emergency and
    // Either duration expires:
      (TO/ord[s2.t] - TO/ord[s1.t] >= emDuration and s2.mode = Normal)
      // Or early deactivation:
      or (s2.mode = Normal and s2.emAdmins = s1.emAdmins and #s1.emAdmins = 2)
}

// R3: Emergency Behaviors (Bypass FIFO, MutEx, Emergency Priv)
pred R1R2R3 {
  R1R2[]
  // R3.1: In Emergency, high classification requests may be processed out of FIFO order
  some s: State | 
    s.mode = Emergency and
    some rq1, rq2: Request |
      rq1.classif = High and rq2.classif = High and
      rq1 in s.requestQueue.elems and rq2 in s.requestQueue.elems and
      // Both can be processed concurrently (abstract: may be not FIFO)
      rq1 != rq2
  // R3.2: In Emergency, mutual exclusion is lifted (already enforced by fact)
  // R3.3: Only the admins who triggered Emergency hold EmergencyPrivilege (already enforced by fact)
}

// R4: Emergency End - Privilege & Delegated Role Revocation, Admin Credential Update
pred R1R2R3R4 {
  R1R2R3[]
  // At first state after Emergency ends, all emergency privileges are revoked, delegated roles revoked, admins must update credentials
  some sE, sN: State |
    sE.mode = Emergency and
    next[sE] = sN and
    sN.mode = Normal and
    no sN.emergencyPrivs and
    no sN.delegated and
    // All emAdmins must update credentials at sN
    all a: sE.emAdmins | sN.adminUpdated[a] = sN.t
}

// All requirements together
pred All_Requirements {
  R1R2R3R4[]
}

// ---------- RUN COMMANDS ----------

run baseline for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time

run All_Requirements for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time

run R1 for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time
run R1R2 for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time
run R1R2R3 for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time
run R1R2R3R4 for 6 User, 4 Administrator, 4 Role, 2 MutExPair, 5 Object, 6 Request, 8 State, 8 Time

// ---------- ASSERTIONS TO CHECK PROPERTIES ----------

// Emergency privilege never exists outside Emergency (negative scenario)
assert assertNoEmergencyPrivOutsideEmergency {
  all s: State | s.mode != Emergency => no s.emergencyPrivs
}
check assertNoEmergencyPrivOutsideEmergency for 8 State

// Mutual exclusion: no user can hold both roles of any MutExPair in Normal mode (positive/negative)
assert assertMutExNormal {
  all s: State | s.mode = Normal =>
    all p: MutExPair | all u: User | not (p.r1 in s.assigned[u] and p.r2 in s.assigned[u])
}
check assertMutExNormal for 8 State

// Mutual exclusion: it is possible for some user to hold both roles in Emergency (positive)
assert assertMutExEmergency {
  some s: State | s.mode = Emergency and
    some p: MutExPair | some u: User | (p.r1 in s.assigned[u] and p.r2 in s.assigned[u])
}
check assertMutExEmergency for 8 State

// Emergency privilege always granted to exactly the two emAdmins in Emergency
assert assertEmergencyPrivilegeGrant {
  all s: State | s.mode = Emergency => s.emergencyPrivs = s.emAdmins and #s.emAdmins = 2
}
check assertEmergencyPrivilegeGrant for 8 State

// Delegated roles granted in Emergency are revoked at exit
assert assertDelegatedRoleRevocation {
  all sE, sN: State | 
    sE.mode = Emergency and
    next[sE] = sN and
    sN.mode = Normal => no sN.delegated
}
check assertDelegatedRoleRevocation for 8 State

// Admins triggering Emergency update credentials at first step after Emergency ends
assert assertAdminCredentialUpdate {
  all sE, sN: State | 
    sE.mode = Emergency and
    next[sE] = sN and sN.mode = Normal =>
      all a: sE.emAdmins | sN.adminUpdated[a] = sN.t
}
check assertAdminCredentialUpdate for 8 State

// Request FIFO may be bypassed for High classif requests in Emergency
assert assertEmergencyRequestBypassFIFO {
  some s: State | s.mode = Emergency and
    some rq1, rq2: Request |
      rq1.classif = High and rq2.classif = High and
      rq1 in s.requestQueue.elems and
      rq2 in s.requestQueue.elems and
      rq1 != rq2
}
check assertEmergencyRequestBypassFIFO for 8 State

// ---------- END ----------
