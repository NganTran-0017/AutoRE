[2026-05-07 12:45:09] ```alloy
// Alloy 6 model for RBAC system with Emergency Mode

open util/ordering[Time] as ord

// Signatures
abstract sig User {}
sig Administrator extends User {}
sig Role {}
sig Request { classification: Int }
sig EmergencyMode { active: Bool }

one sig System {
  admins: set Administrator,
  users: set User,
  roles: set Role,
  requests: set Request,
  emergency: EmergencyMode
}

// Facts for existing system assumptions
fact ExistingSystem {
  // There are at least two administrators
  #System.admins >= 2
  // Each user has a unique role
  all u: User | lone r: Role | r in System.roles
}

// Predicates for Requirements
pred R1 {
  // Emergency Mode Activation
  let activeAdmins = System.admins & User {
    #activeAdmins = 2 implies System.emergency.active = True
  }
}

pred R2 {
  // Emergency Mode Duration
  System.emergency.active = True implies eventually (System.emergency.active = False)
  // Early termination by both administrators
  let activeAdmins = System.admins & User {
    #activeAdmins = 2 implies System.emergency.active = False
  }
}

pred R3 {
  // Emergency Mode Operations
  System.emergency.active = True implies {
    // R3.1: Bypass FIFO for high classification requests
    some req: Request | req.classification > 5
    // R3.2: Users may temporarily hold mutually exclusive roles
    some u: User | some r1, r2: Role | r1 != r2
    // R3.3: Administrators temporarily hold emergency privileges
    all a: Administrator | a in System.admins
  }
}

pred R4 {
  // Post-Emergency Mode Actions
  System.emergency.active = False implies {
    // R4.1: Revoke emergency privileges
    all a: Administrator | a not in System.admins
    // R4.2: Revoke delegated roles
    all u: User | no r: Role | r in System.roles
    // R4.3: Administrators must update credentials
    all a: Administrator | a in System.admins
  }
}

// Comprehensive predicate
pred All_Requirements {
  R1 and R2 and R3 and R4
}

// Assertions to verify properties
assert assertR1 {
  R1
}

assert assertR2 {
  R2
}

assert assertR3 {
  R3
}

assert assertR4 {
  R4
}

// Run and Check commands
run R1
run R1R2
run R1R2R3
run All_Requirements

check assertR1
check assertR2
check assertR3
check assertR4
```

**[LESSON]: Can't use 'if-then-else' in facts → Must use implication (=>)**
**[LESSON]: Alloy 6 does not support native booleans or arithmetic on enums → Use predicates for ordering/comparisons and sets for booleans.**
**[EVENT]: Used implication to model Emergency Mode activation condition in R1**
