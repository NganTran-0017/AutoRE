// ====================================================
// RBAC Emergency Model (Alloy 6) -- Syntax and Requirements Fixed per Evaluator Feedback
// STRUCTURE, BEHAVIOR, CONSTRAINTS ONLY (Abstract, Verifiable)
// ====================================================

// ======= OPEN STATEMENTS =======
open util/ordering[ClearanceLevel] as ClearanceOrd
open util/ordering[State] as Time

// =================================================
// ENUMS AND MODES
// =================================================
abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig C_High, C_Medium, C_Low extends ClassificationLevel {}

abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// =================================================
// CORE ENTITIES
// =================================================
sig User {
    clearance: one ClearanceLevel
}
sig Administrator in User {}

sig Role {
    mutuallyExclusiveWith: set Role,     // symmetric, irreflexive
    minClearance: one ClearanceLevel
}

sig Object {
    classification: one ClassificationLevel
}

sig Request {
    requestedBy: one User,
    affects: some Object,
    classification: one ClassificationLevel
}

sig Delegation {
    delegator: one User,
    delegatee: one User,
    role: one Role,
    delegatedAt: one State,
    expiresAt: lone State // None if non-expiring
}

sig EmergencyPrivilege {
    admin: one Administrator,
    grantedAt: one State,
    revokedAt: lone State
}

// =================================================
// SYSTEM STATE (Time-Indexed)
// =================================================
sig State {
    mode: one SystemMode,
    emAdmins: set Administrator,               // The two who triggered Emergency (empty in Normal)
    requests: set Request,
    delegations: set Delegation,
    emPrivs: set EmergencyPrivilege,
    needsCredentialUpdate: set Administrator
}

// =================================================
// ADMINISTRATOR CARDINALITY CONSTRAINT (SCENARIO SPECIFIC)
// =================================================
fact AdminCountRange {
    #Administrator >= 0 and #Administrator <= 4
}

// =================================================
// EXISTING SYSTEM FACTS AND INVARIANTS
// =================================================

// Admins always have High clearance
fact AdminDefinition {
    all a: Administrator | a.clearance = High
}

// Mutual exclusion structure: irreflexive, symmetric
fact MutExSymmIrreflexive {
    all r: Role | r not in r.mutuallyExclusiveWith
    all r1, r2: Role | r1 in r2.mutuallyExclusiveWith iff r2 in r1.mutuallyExclusiveWith
}

// Role holding function (only valid, non-expired delegations)
fun rolesHeld[u: User, s: State]: set Role {
    { r: Role |
        some d: s.delegations |
            d.delegatee = u and
            d.role = r and
            d.delegatedAt in pastOrEqual[s] and
            (no d.expiresAt or lt[s, d.expiresAt])
    }
}

// Normal mode: enforce mutual exclusion
fact MutualExclusionNormalOnly {
    all s: State |
        (s.mode = Normal) =>
            all u: User |
                // It is NOT possible for any user to hold both roles of a mutually exclusive pair
                all r1, r2: Role |
                    not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and
                        r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s])
}
// [EVENT]: Fixed syntax error in mutual exclusion by replacing '=> false' with negated conjunction per Alloy idiom.

// Emergency trigger: only from Normal, exactly two distinct admins
fact EmergencyTriggerStrict {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and prevModeIsNormal[s] and all a: s.emAdmins | a in Administrator)
        else
            s.emAdmins = none
}

// EmergencyPrivilege: only emAdmins, only during Emergency, granted at s
fact EmergencyPrivilegeAssignment {
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs | ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt)
        else
            s.emPrivs = none
}

// EmergencyPrivilege never granted outside Emergency, always revoked after Emergency
fact EmergencyPrivilegeRevocationTotal {
    all s: State |
        (s.mode != Emergency) => s.emPrivs = none
}

// Request classification equals highest class of affected objects
fun highestClass[os: set Object]: one ClassificationLevel {
    (some o: os | o.classification = C_High) => C_High
    else (some o: os | o.classification = C_Medium) => C_Medium
    else C_Low
}
fact RequestClassification {
    all req: Request |
        req.classification = highestClass[req.affects]
}

// FIFOEnforced in Normal mode (abstract)
fact FIFOEnforcedExceptEmergency {
    all s: State | (s.mode = Normal) => FIFOProcessing[s]
}
// Abstract FIFO placeholder
pred FIFOProcessing[s: State] { }

// Emergency: ordering by classification (high, then medium, then low)
fact EmergencyRequestClassOrdering {
    all s: State | (s.mode = Emergency) => EmergencyClassOrder[s]
}
pred EmergencyClassOrder[s: State] {
    // If any C_Medium request is present, all C_High requests must already be processed (not present in s.requests)
    all r: s.requests | 
        (r.classification = C_Medium) =>
            no r2: s.requests | r2.classification = C_High
    // If any C_Low request is present, all higher-classification requests must already be processed
    all r: s.requests | 
        (r.classification = C_Low) =>
            no r2: s.requests | r2.classification in (C_High + C_Medium)
}

// Emergency liveness: Emergency must always eventually return to Normal
fact EmergencyLiveness {
    all s: State | (s.mode = Emergency) => some s2: future[s] | s2.mode = Normal
}

// Delegation validity and timing (cannot expire before granted, must meet clearance at time of delegation)
fact DelegationValidity {
    all d: Delegation | 
        // Delegation cannot expire before being granted
        (no d.expiresAt or lt[d.delegatedAt, d.expiresAt]) and
        // Delegator holds the role at delegation, delegatee meets clearance
        some s: State |
            d in s.delegations and
            d.delegatedAt = s and
            d.role in rolesHeld[d.delegator, s] and
            ClearanceOrd/lte[d.role.minClearance, d.delegatee.clearance]
}

// Delegation expiry rules R4.2a, R4.2b
fact EmergencyDelegationRevocation {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s)
}
fact PreEmergencyDelegationsRemain {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Normal) =>
                    (no d.expiresAt) or (d.expiresAt != s)
}

// Credential update post-Emergency
fact EmergencyCredentialUpdate {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            (Time/prev[s].emAdmins in s.needsCredentialUpdate and
             all a: s.needsCredentialUpdate | a in Time/prev[s].emAdmins))
}

// =========================================================
// TIME HELPERS/ORDERING
// =========================================================
fun pastOrEqual[s: State]: set State { { s2: State | lte[s2, s] } }
fun past[s: State]: set State { { s2: State | lt[s2, s] } }
fun future[s: State]: set State { { s2: State | gt[s2, s] } }

pred prevModeIsNormal[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Normal
}
pred prevModeIsEmergency[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Emergency
}

// =========================================================
// EMERGENCY VERIFICATION SCENARIO CONSTRAINTS (Coverage Only)
// =========================================================

// At least one pair of mutually exclusive roles exists in the system
pred MutExRolesExist {
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
}

// At least one Emergency state, mut-ex role pair present, and a user holds both during Emergency
pred EmergencyScenario_Positive {
    some s: State | s.mode = Emergency
    MutExRolesExist
    some s: State |
        s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and
            r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// At least one Emergency state, mut-ex roles exist, but no user ever holds both mut-ex roles during Emergency (for negative scenario)
pred EmergencyScenario_Negative {
    some s: State | s.mode = Emergency
    MutExRolesExist
    all s: State | s.mode = Emergency =>
        all u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith =>
                not (r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s])
}

// For Normal mode assertions: do not require Emergency to be exercised, mut-ex roles may or may not exist
pred NormalScenario_Generic { }

// Delegation edge-case: at least one delegation expires exactly at Emergency exit
pred DelegationExpiresAtEmergencyExit_Positive {
    EmergencyScenario_Positive
    some s: State |
        s.mode = Normal and prevModeIsEmergency[s] and
        some d: Time/prev[s].delegations |
            d.delegatedAt.mode = Emergency and
            d.expiresAt = s
}

// Delegation edge-case: no delegations expire at Emergency exit (for negative scenario)
pred DelegationExpiresAtEmergencyExit_Negative {
    EmergencyScenario_Positive
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                not (d.delegatedAt.mode = Emergency and d.expiresAt = s)
}

// Delegation: minimum-clearance user attempts to receive a delegated role (should succeed if clearance sufficient, fail otherwise)
pred DelegationMinClearance_Positive {
    EmergencyScenario_Positive
    some d: Delegation | d.delegatee.clearance = d.role.minClearance
}
pred DelegationMinClearance_Negative {
    EmergencyScenario_Positive
    all d: Delegation | d.delegatee.clearance != d.role.minClearance
}

// Scenario with multiple Emergency-Normal transitions
pred MultipleEmergencyTransitions_Positive {
    some s1, s2, s3: State |
        Time/lt[s1, s2] and Time/lt[s2, s3] and
        s1.mode = Emergency and
        s2.mode = Normal and
        s3.mode = Emergency
    MutExRolesExist
    some s: State | s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// =========================================================
// ======= REQUIREMENT PREDICATES (incremental) ============
// =========================================================

// R1: Emergency only triggered from Normal mode, by exactly two admins
pred R1 {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and prevModeIsNormal[s] and all a: s.emAdmins | a in Administrator)
}

// R2: Emergency mode must eventually return to Normal (liveness)
pred R1R2 {
    R1 and
    (all s: State |
        (s.mode = Emergency) =>
            some s2: future[s] | s2.mode = Normal)
}

// R3: Emergency behavior (Request ordering, mutual exclusion, privileges)
pred R1R2R3 {
    R1R2 and
    // R3.1: Emergency request class ordering
    (all s: State |
        (s.mode = Emergency) => EmergencyClassOrder[s]) and
    // R3.2: Mutual exclusion suspended; at least one user holds two mutually exclusive roles in Emergency (scenario constraint in EmergencyScenario_Positive)
    // R3.3: emAdmins have EmergencyPrivilege during Emergency, and only during Emergency
    (all s: State |
        (s.mode = Emergency) =>
            (all a: s.emAdmins | some ep: s.emPrivs | ep.admin = a and ep.grantedAt = s and no ep.revokedAt)) and
    (all s: State | (s.mode != Emergency) => s.emPrivs = none)
}

// R4: Post-Emergency Restoration (EmergencyPrivilege revoked, Emergency-delegated roles expired, Pre-Emergency delegations remain unless expired, credentials update)
pred R1R2R3R4 {
    R1R2R3 and
    // R4.1: emAdmins lose EmergencyPrivilege after Emergency
    (all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            s.emPrivs = none)) and
    // R4.2a: Only delegations assigned during Emergency are revoked when Emergency ends
    (all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s))) and
    // R4.2b: Delegations assigned before Emergency are *not* revoked at Emergency end (unless expired by their own expiry)
    (all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Normal) =>
                    (no d.expiresAt) or (d.expiresAt != s))) and
    // R4.3: Only the two emAdmins must update credentials after Emergency
    (all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            (Time/prev[s].emAdmins in s.needsCredentialUpdate and
             all a: s.needsCredentialUpdate | a in Time/prev[s].emAdmins)))
