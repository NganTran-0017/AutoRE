```alloy
// =================================================
// RBAC Emergency Model [Alloy 6, Emergency Observability, Delegation, Mutual Exclusion, Classification Ordering]
// Abstract, verifiable, formal requirements model (structure, behavior, constraints)
// =================================================

// ======= OPEN STATEMENTS =======
open util/ordering[ClearanceLevel] as ClearanceOrd
open util/ordering[State] as Time

// =================================================
// ENUMS AND MODES
// =================================================
abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig C_High, C_Medium, C_Low extends ClassificationLevel {}

abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// =================================================
// CORE ENTITIES
// =================================================
sig User {
    clearance: one ClearanceLevel
}

sig Administrator in User {}

sig Role {
    mutuallyExclusiveWith: set Role,     // symmetric, irreflexive
    minClearance: one ClearanceLevel
}

sig Object {
    classification: one ClassificationLevel
}

sig Request {
    requestedBy: one User,
    affects: some Object,
    classification: one ClassificationLevel
}

sig Delegation {
    delegator: one User,
    delegatee: one User,
    role: one Role,
    delegatedAt: one State,
    expiresAt: lone State // None if non-expiring
}

sig EmergencyPrivilege {
    admin: one Administrator,
    grantedAt: one State,
    revokedAt: lone State
}

// =================================================
// SYSTEM STATE (Time-Indexed)
// =================================================
sig State {
    mode: one SystemMode,
    emAdmins: set Administrator,               // The two who triggered Emergency (empty in Normal)
    requests: set Request,
    delegations: set Delegation,
    emPrivs: set EmergencyPrivilege,
    needsCredentialUpdate: set Administrator
}

// =================================================
// ADMINISTRATOR CARDINALITY CONSTRAINT (SCENARIO SPECIFIC)
// =================================================
fact AdminCountRange {
    #Administrator >= 0 and #Administrator <= 4
}

// =================================================
// EXISTING SYSTEM FACTS AND INVARIANTS
// =================================================

// Admins always have High clearance
fact AdminDefinition {
    all a: Administrator | a.clearance = High
}

// Emergency trigger: only from Normal, exactly two distinct admins
fact EmergencyTriggerStrict {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and prevModeIsNormal[s] and all a: s.emAdmins | a in Administrator)
        else
            no s.emAdmins
}

// EmergencyPrivilege: only emAdmins, only during Emergency, granted at s
fact EmergencyPrivilegeAssignment {
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs | ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt)
        else
            no s.emPrivs
}

// Mutual exclusion enforced except during Emergency
fact MutualExclusionEnforced {
    all s: State |
        (s.mode = Normal) =>
            all u: User |
                all r1, r2: Role |
                    r1 != r2 and
                    r1 in rolesHeld[u,s] and r2 in rolesHeld[u,s] =>
                        not (r1 in r2.mutuallyExclusiveWith)
    // During Emergency, no restriction (see scenario predicates/assertions)
}

// Role holding function (only valid, non-expired delegations)
fun rolesHeld[u: User, s: State]: set Role {
    { r: Role |
        some d: s.delegations |
            d.delegatee = u and
            d.role = r and
            d.delegatedAt in pastOrEqual[s] and
            (no d.expiresAt or lt[s, d.expiresAt])
    }
}

// ========================
// MUTUAL EXCLUSION STRUCTURE [REQ: Symmetry, Irreflexivity, Existence]
// ========================
fact MutExSymmIrreflexive {
    all r: Role | r not in r.mutuallyExclusiveWith
    all r1, r2: Role | r1 in r2.mutuallyExclusiveWith iff r2 in r1.mutuallyExclusiveWith
}
// At least one pair of mutually exclusive roles must exist for Emergency verification
pred MutExRolesExist {
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
}

// ========================
// TEMPORAL HELPERS AND ORDERING
// ========================
fun pastOrEqual[s: State]: set State { { s2: State | lte[s2, s] } }
fun past[s: State]: set State { { s2: State | lt[s2, s] } }
fun future[s: State]: set State { { s2: State | gt[s2, s] } }

// Helper: previous mode is Normal
pred prevModeIsNormal[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Normal
}
// Helper: previous mode is Emergency
pred prevModeIsEmergency[s: State] {
    some Time/prev[s] and Time/prev[s].mode = Emergency
}

// ========================
// REQUEST CLASSIFICATION
// ========================
fun highestClass[os: set Object]: one ClassificationLevel {
    (some o: os | o.classification = C_High) => C_High
    else (some o: os | o.classification = C_Medium) => C_Medium
    else C_Low
}

fact RequestClassification {
    all req: Request |
        req.classification = highestClass[req.affects]
}

// ========================
// FIFO ENFORCEMENT (Normal); EMERGENCY: BY CLASSIFICATION ORDER
// ========================
fact FIFOEnforcedExceptEmergency {
    all s: State |
        (s.mode = Normal) => FIFOProcessing[s]
}

// FIFOProcessing is abstract (not modeled in detail)
pred FIFOProcessing[s: State] { }

// Request processing in Emergency: all high concurrently, then medium, then low
fact EmergencyRequestClassOrdering {
    all s: State |
        (s.mode = Emergency) =>
            EmergencyClassOrder[s]
}
pred EmergencyClassOrder[s: State] {
    // If any C_Medium request is processed, all C_High requests must already be processed (i.e., not present in s.requests)
    all r: s.requests | 
        (r.classification = C_Medium) =>
            no r2: s.requests | r2.classification = C_High
    // If any C_Low request is processed, all higher-classification requests must already be processed
    all r: s.requests | 
        (r.classification = C_Low) =>
            no r2: s.requests | r2.classification in (C_High + C_Medium)
}

// ========================
// EMERGENCY LIVENESS (must return to Normal eventually)
// ========================
fact EmergencyLiveness {
    all s: State |
        (s.mode = Emergency) =>
            some s2: future[s] | s2.mode = Normal
}

// ========================
// DELEGATION VALIDITY AND TIMING
// ========================
// Delegations must be granted before they expire; delegator must hold the role; delegatee must meet clearance
fact DelegationValidity {
    all d: Delegation | 
        // Delegation cannot expire before being granted
        (no d.expiresAt or lt[d.delegatedAt, d.expiresAt]) and
        // At delegation time, delegator must hold the role and delegatee meets clearance
        some s: State |
            d in s.delegations and
            d.delegatedAt = s and
            d.role in rolesHeld[d.delegator, s] and
            ClearanceOrd/lte[d.role.minClearance, d.delegatee.clearance]
}

// ========================
// DELEGATION EXPIRY RULES (R4.2a & R4.2b)
// ========================
// After Emergency, only Emergency-delegated roles are revoked (expire at first Normal after Emergency)
// Pre-Emergency delegations are not auto-revoked on Emergency exit
fact EmergencyDelegationRevocation {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s)
}
fact PreEmergencyDelegationsRemain {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Normal) =>
                    (no d.expiresAt) or (d.expiresAt != s)
}

// ========================
// CREDENTIAL UPDATE POST-EMERGENCY
// ========================
fact EmergencyCredentialUpdate {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            (Time/prev[s].emAdmins in s.needsCredentialUpdate and
             all a: s.needsCredentialUpdate | a in Time/prev[s].emAdmins)
        )
}

// EmergencyPrivilege is revoked immediately after Emergency ends
fact EmergencyPrivilegeRevocation {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            no s.emPrivs
}

// =========================================================
// ======= REQUIREMENT PREDICATES (incremental) ============
// =========================================================

// R1: Emergency only triggered from Normal mode, by exactly two admins
pred R1 {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and prevModeIsNormal[s] and all a: s.emAdmins | a in Administrator)
}

// R2: Emergency mode must eventually return to Normal (liveness)
pred R1R2 {
    R1 and
    (all s: State |
        (s.mode = Emergency) =>
            some s2: future[s] | s2.mode = Normal)
}

// R3: Emergency behavior (Request ordering, mutual exclusion, privileges)
pred R1R2R3 {
    R1R2 and
    // R3.1: Emergency request class ordering
    (all s: State |
        (s.mode = Emergency) => EmergencyClassOrder[s]) and
    // R3.2: Mutual exclusion suspended; at least one user holds two mutually exclusive roles in Emergency
    (some s: State |
        s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and
            r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
    ) and
    // R3.3: emAdmins have EmergencyPrivilege during Emergency
    (all s: State |
        (s.mode = Emergency) =>
            (all a: s.emAdmins | some ep: s.emPrivs | ep.admin = a and ep.grantedAt = s and no ep.revokedAt))
}

// R4: Post-Emergency Restoration (EmergencyPrivilege revoked, Emergency-delegated roles expired, Pre-Emergency delegations remain unless expired, credentials update)
pred R1R2R3R4 {
    R1R2R3 and
    // R4.1: emAdmins lose EmergencyPrivilege after Emergency
    (all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            no s.emPrivs)) and
    // R4.2a: Only delegations assigned during Emergency are revoked when Emergency ends
    (all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s))) and
    // R4.2b: Delegations assigned before Emergency are *not* revoked at Emergency end (unless expired by their own expiry)
    (all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Normal) =>
                    (no d.expiresAt) or (d.expiresAt != s))) and
    // R4.3: Only the two emAdmins must update credentials after Emergency
    (all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            (Time/prev[s].emAdmins in s.needsCredentialUpdate and
             all a: s.needsCredentialUpdate | a in Time/prev[s].emAdmins)))
}

// All requirements predicate
pred All_Requirements { R1R2R3R4 }

// ========================
// EMERGENCY OBSERVABILITY PREDICATE (Scenario constraint for model checking)
// Ensures at least one Emergency state, at least one pair of mutually exclusive roles, and at least one user holding two mutually exclusive roles during Emergency.
// ========================
pred EmergencyScenario_Observable {
    some s: State | s.mode = Emergency
    MutExRolesExist
    some s: State |
        s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// =========================================================
// =================== ASSERTIONS FOR VERIFICATION =========
// =========================================================

// R1: Emergency only by two admins, from Normal mode
assert assertR1 {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and prevModeIsNormal[s] and all a: s.emAdmins | a in Administrator)
}

// R1b: It is impossible to have Emergency with more/fewer than two admins or not from Normal mode
assert assertR1b_strict {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and prevModeIsNormal[s])
}

// R2: Emergency mode is always exited (liveness)
assert assertR2 {
    all s: State |
        (s.mode = Emergency) =>
            some s2: future[s] | s2.mode = Normal
}

// R3.1: Emergency request processing is by class ordering
assert assertEmergencyClassOrder {
    all s: State |
        (s.mode = Emergency) => EmergencyClassOrder[s]
}

// R3.2: In Emergency, at least one user holds two mutually exclusive roles
assert assertMutExRolesCanBeHeldEmergency {
    some s: State |
        s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and
            r1 in r2.mutuallyExclusiveWith and
            r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// R3-Normal: In Normal mode, no user ever holds two mutually exclusive roles
assert assertNoMutExRolesNormal {
    all s: State |
        (s.mode = Normal) =>
            all u: User |
                all r1, r2: Role |
                    r1 != r2 and r1 in r2.mutuallyExclusiveWith =>
                        not (r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s])
}

// Delegation cannot expire before it is granted
assert assertDelegationNoEarlyExpiry {
    all d: Delegation | no d.expiresAt or lt[d.delegatedAt, d.expiresAt]
}

// Delegation only possible if delegator holds the role and delegatee meets clearance at delegation
assert assertDelegationAssignmentValid {
    all d: Delegation |
        some s: State |
            d in s.delegations and d.delegatedAt = s and
            d.role in rolesHeld[d.delegator, s] and
            ClearanceOrd/lte[d.role.minClearance, d.delegatee.clearance]
}

// R4.1: After Emergency, ALL EmergencyPrivileges must be revoked from emAdmins
assert assertR4_1 {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            no s.emPrivs)
}

// R4.2a: After Emergency, ONLY Emergency-delegated roles revoked
assert assertR4_2a {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s))
}

// R4.2b: Delegations assigned before Emergency are NOT revoked at Emergency end
assert assertR4_2b {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Normal) =>
                    (no d.expiresAt) or (d.expiresAt != s))
}

// R4.3: Only emAdmins must update credentials after Emergency
assert assertR4_3 {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            (Time/prev[s].emAdmins in s.needsCredentialUpdate and
             all a: s.needsCredentialUpdate | a in Time/prev[s].emAdmins))
}

// Liveness: Emergency must always eventually return to Normal somewhere in the trace
assert assertEmergencyLiveness {
    all s: State |
        (s.mode = Emergency) =>
            some s2: future[s] | s2.mode = Normal
}

// ========================
// RUN/CHECK COMMANDS
// ========================

// Emergency scenario: enforce at least one Emergency state, at least one pair mut-ex roles, at least one user holding two mut-ex roles in Emergency
pred EmergencyVerificationScenario {
    EmergencyScenario_Observable
    All_Requirements
}

// For normal mode runs: do NOT force Emergency, so mutual exclusion may not be exercised

run EmergencyVerificationScenario for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

check assertR1 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR1b_strict for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR2 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertEmergencyClassOrder for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertMutExRolesCanBeHeldEmergency for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertNoMutExRolesNormal for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegationNoEarlyExpiry for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegationAssignmentValid for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_1 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_2a for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_2b for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_3 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertEmergencyLiveness for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

// [LESSON]: Can't use > or >= on enums or atoms in Alloy 6; must use util/ordering/lt, lte for ordering.
// [LESSON]: Alloy sets are always unique; set semantics mean no duplicates.
// [LESSON]: Alloy 6 requires facts for invariants and predicates for scenario constraints; do not duplicate.
// [EVENT]: Added MutExSymmIrreflexive fact to enforce symmetric, irreflexive mutuallyExclusiveWith, and MutExRolesExist predicate for non-vacuous Emergency scenario checking.
// [EVENT]: Added DelegationValidity fact to ensure delegation is only possible if delegator holds the role, delegatee meets clearance, and no early expiry.
// [EVENT]: Added EmergencyScenario_Observable predicate and EmergencyVerificationScenario predicate to guarantee Emergency and mutual exclusion are exercised in model checking.
// [EVENT]: Updated EmergencyClassOrder to model request handling by class (high, then medium, then low) in Emergency.
// [EVENT]: Refined R4.2b and corresponding fact/assertion to match requirement: Pre-Emergency delegations are *not* auto-revoked on Emergency exit.
// [EVENT]: Removed redundant predicates/facts and consolidated invariants vs. scenario constraints.
