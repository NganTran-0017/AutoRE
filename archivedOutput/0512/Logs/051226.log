    All_Requirements
}

// Delegation with min-clearance delegatee (negative)
pred DelegationMinClearanceVerification_Negative {
    DelegationMinClearance_Negative
    All_Requirements
}

// Multiple Emergency/Normal transitions (positive)
pred MultipleEmergencyTransitionsVerification_Positive {
    MultipleEmergencyTransitions_Positive
    All_Requirements
}

// Normal mode only (no Emergency enforced, mut-ex roles optional)
pred NormalVerificationScenario {
    NormalScenario_Generic
