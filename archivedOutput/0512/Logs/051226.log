// R3.2: In Emergency, at least one user holds two mutually exclusive roles (EmergencyScenario_Positive required)
assert assertMutExRolesCanBeHeldEmergency {
    EmergencyScenario_Positive =>
        some s: State |
            s.mode = Emergency and
            some u: User, r1, r2: Role |
