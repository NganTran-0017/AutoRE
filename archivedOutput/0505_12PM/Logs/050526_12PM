  High != Medium; Medium != Low; High != Low;
}

// Predicate for clearance comparison: c1 >= c2 (High > Medium > Low)
pred clearanceAtLeast[c1, c2: ClearanceLevel] {
  (c1 = High) or
  (c1 = Medium and c2 != High) or
  (c1 = Low and c2 = Low)
}

// Predicate for classification comparison: c1 <= c2 (CLow < CMedium < CHigh)
pred classificationAtMost[c1, c2: ClassificationLevel] {
  (c1 = CLow) or
  (c1 = CMedium and c2 != CLow) or
  (c1 = CHigh and c2 = CHigh)
}

// === Time modeled as ordered atoms with integer mapping for arithmetic ===

sig Time {}

fact TimeOrdering {
  // util/ordering provides 'next', 'first', 'last' relations on Time
  // The ordering is total and linear
}

// Define total, injective, strictly increasing function timeValue: Time -> Int
// We model timeValue as a total function with uniqueness and strict ordering matching util/ordering
fun timeValue [t: Time] : Int {
  // Use 'ord' predicate from util/ordering to assign integers 0..(n-1) to Time atoms in order
  // Alloy doesn't allow function bodies with iteration, so define as a relation below
  // Here, timeValue is declared as a function, but constrained by fact below
  // (Function body is abstracted; totality and injectivity enforced by facts)
  none // placeholder, actual definition via facts below
}

// timeValue relation to assign integer indices to Time atoms: use a fact to enforce injectivity and ordering
fact TimeValueProperties {
  // timeValue is total: for all t: Time, there exists exactly one Int that is timeValue[t]
  all t: Time | one i: Int | i = timeValue[t]

  // timeValue is injective: if two Times have same timeValue, they are equal
  all t1, t2: Time | timeValue[t1] = timeValue[t2] implies t1 = t2

  // timeValue strictly increases along next relation
  all t1, t2: Time |
    (t1 != t2 and t2 in t1.^next) implies timeValue[t1] < timeValue[t2]
}

// Since Alloy does not allow function body with iteration, we leave timeValue abstract but constrained above

// === Mode ===

abstract sig Mode {}
one sig Normal extends Mode {}
one sig Emergency extends Mode {}

// === System State ===

sig SystemState {
  mode: one Mode,
  time: one Time,

  // emergencyStartTime is defined exactly when mode = Emergency, none otherwise
  emergencyStartTime: lone Time,

  // emergencyDuration fixed duration in time units (non-negative Int)
  emergencyDuration: one Int,

  // manual termination flag: true if manual termination requested at current time
  emergencyManuallyEnded: Bool,

  // emergencyTriggers: exactly two administrators who triggered emergency simultaneously at time of transition
  emergencyTriggers: set Administrator,

  // admins who have updated credentials after emergency ends
  adminCredentialsUpdated: set Administrator
}

// Fact: emergencyTriggers must have exactly two admins when mode=Emergency start, else empty
fact EmergencyTriggersInvariant {
  all s: SystemState |
    (s.mode = Emergency => #s.emergencyTriggers = 2 and all a: s.emergencyTriggers | a in Administrator) and
    (s.mode = Normal => no s.emergencyTriggers)
}

// Fact: emergencyStartTime is defined iff mode=Emergency
fact EmergencyStartTimeDefined {
  all s: SystemState | (s.mode = Emergency) iff (some s.emergencyStartTime)
}

// Fact: emergencyDuration non-negative
fact EmergencyDurationNonNegative {
  all s: SystemState | s.emergencyDuration >= 0
}

// Fact: adminCredentialsUpdated subset of administrators
fact AdminCredentialsUpdatedSubset {
  all s: SystemState | s.adminCredentialsUpdated in Administrator
}

// === Users and Roles ===

sig User {
  clearance: one ClearanceLevel,
  assignedRoles: set Role,
  delegatedRoles: set DelegatedRole,
  submittedRequests: set Request
}

abstract sig Administrator extends User {}

fact AdminClearance {
  all a: Administrator | a.clearance = High
  // Some High clearance users are not admins
  some u: User - Administrator | u.clearance = High
}

// === Role ===

sig Role {
  minClearance: one ClearanceLevel,
  mutuallyExclusive: set Role
}

fact RoleExclusivityIrreflexive {
  all r: Role | r !in r.mutuallyExclusive
}

fact RoleExclusivitySymmetric {
  all r, r': Role | (r in r'.mutuallyExclusive) iff (r' in r.mutuallyExclusive)
}

// === Delegated Roles ===

sig DelegatedRole {
  role: one Role,
  fromUser: one User,
  toUser: one User,
  assignedAt: one Time,
  expiresAt: one Time,
  revoked: Bool
}

fact DelegationClearance {
  all d: DelegatedRole |
    clearanceAtLeast[d.fromUser.clearance, d.toUser.clearance] and
    d.fromUser != d.toUser and
    not clearanceAtLeast[d.toUser.clearance, d.fromUser.clearance]
}

fact DelegationMinClearance {
  all d: DelegatedRole | clearanceAtLeast[d.toUser.clearance, d.role.minClearance]
}

fact DelegationRevocation {
  all d: DelegatedRole | d.revoked implies timeValue[d.expiresAt] >= timeValue[d.assignedAt]
}

// === System Objects ===

sig SysObject {
  classification: one ClassificationLevel
}

// === Requests ===

sig Request {
  submittedBy: one User,
  affectedObjects: set SysObject,
  classification: one ClassificationLevel,
  submittedAt: one Time,
  processedAt: lone Time,
  approved: lone Bool
}

fact RequestClassification {
  all r: Request |
    (r.classification = CHigh) iff some o: r.affectedObjects | o.classification = CHigh
  all r: Request |
    (r.classification = CMedium) iff no o: r.affectedObjects | o.classification = CHigh and some o: r.affectedObjects | o.classification = CMedium
  all r: Request |
    (r.classification = CLow) iff no o: r.affectedObjects | o.classification in CHigh + CMedium and some o: r.affectedObjects | o.classification = CLow
}

fact RequestSubmissionClearance {
  all r: Request | classificationAtMost[r.classification, r.submittedBy.clearance]
}

// === Role Exclusivity Constraints ===

fact NormalModeRoleExclusivity {
  all s: SystemState | s.mode = Normal =>
    all u: User |
      no disj r1, r2: u.assignedRoles + (d: u.delegatedRoles | d.role) | r2 in r1.mutuallyExclusive
}

// === Emergency Mode Triggering and Duration ===

// Emergency triggering requires exactly two admins triggering simultaneously in the same Time atom (atomic event)
pred R1_TriggerEmergency (s, s': SystemState) {
  s.mode = Normal
  s'.mode = Emergency
  s'.time = s.time
  #s'.emergencyTriggers = 2
  all a: s'.emergencyTriggers | a in Administrator
  // emergencyTriggers are exactly the two admins who triggered now
  s'.emergencyStartTime = s'.time
  s'.emergencyDuration = s.emergencyDuration
  s'.emergencyManuallyEnded = False
  s'.adminCredentialsUpdated = none
  // Other fields unchanged except mode, time, emergencyStartTime, emergencyManuallyEnded, adminCredentialsUpdated, emergencyTriggers
}

// Predicate to check if manual termination requested at time t
pred ManualTerminationRequested(s: SystemState) {
  s.emergencyManuallyEnded = True
}

// Predicate for time difference in integer units
fun timeDifference(t1, t2: Time): Int {
  timeValue[t2] - timeValue[t1]
}

// Predicate R2: Emergency duration and termination, improved to handle manual early termination at any time,
// including exact boundary, and to allow time increments more than one unit.
pred R2_EmergencyDuration(s, s': SystemState) {
  s.mode = Emergency

  // Case 1: Manual termination requested, instant transition to Normal mode at s'.time >= s.time
  (s.emergencyManuallyEnded = True and s'.mode = Normal and
    timeValue[s'.time] >= timeValue[s.time] and
    s'.emergencyStartTime = none and
    s'.emergencyDuration = s.emergencyDuration and
    s'.emergencyManuallyEnded = False and
    s'.adminCredentialsUpdated = s.adminCredentialsUpdated and
    no s'.emergencyTriggers
  )
  or
  // Case 2: Automatic end after fixed duration if no manual termination
  (s.emergencyManuallyEnded = False and
   s'.mode = Normal and
   timeValue[s'.time] >= timeValue[s.time] + s.emergencyDuration and
   s'.emergencyStartTime = none and
   s'.emergencyDuration = s.emergencyDuration and
   s'.emergencyManuallyEnded = False and
   s'.adminCredentialsUpdated = s.adminCredentialsUpdated and
   no s'.emergencyTriggers
  )
  or
  // Case 3: Still in Emergency mode, time advanced by at least 1 unit (to allow skipping)
  (s'.mode = Emergency and
    timeValue[s'.time] > timeValue[s.time] and
    s'.emergencyStartTime = s.emergencyStartTime and
    s'.emergencyDuration = s.emergencyDuration and
    s'.emergencyManuallyEnded = s.emergencyManuallyEnded and
    s'.adminCredentialsUpdated = s.adminCredentialsUpdated and
    s'.emergencyTriggers = s.emergencyTriggers
  )
}

// === Emergency Privileges ===

sig EmergencyPrivilege {}

sig AdminEmergencyPrivilege {
  admin: one Administrator,
  heldDuring: one SystemState
}

// Predicate: Grant emergency privileges exactly once at Emergency mode start state s
pred GrantEmergencyPrivileges(s: SystemState) {
  s.mode = Emergency
  all a: Administrator | (a in s.emergencyTriggers) implies
    one ep: AdminEmergencyPrivilege | ep.admin = a and ep.heldDuring = s
}

// Predicate: Emergency privileges may be revoked anytime during Emergency mode
pred RevokeEmergencyPrivilegesAtAnyTime(s: SystemState, s': SystemState) {
  s.mode = Emergency and s'.mode = Emergency
  all ep: AdminEmergencyPrivilege | ep.heldDuring = s implies
    // ep either held or revoked in s'
    (some ep2: AdminEmergencyPrivilege | ep2.admin = ep.admin and ep2.heldDuring = s') or
    // revoked: no ep with same admin in s'
    no ep2: AdminEmergencyPrivilege | ep2.admin = ep.admin and ep2.heldDuring = s'
}

// Fact: Emergency privileges revoked immediately upon Emergency mode end
fact R4_1_RevokeEmergencyPrivileges {
  all s: SystemState | s.mode = Normal =>
    no AdminEmergencyPrivilege | AdminEmergencyPrivilege.heldDuring = s
}

// === Delegated Roles Assigned During Emergency ===

// Predicate: d assigned during emergency mode s if assignedAt >= emergencyStartTime and assignedAt <= s.time
pred DelegatedRoleAssignedDuringEmergency[d: DelegatedRole, s: SystemState] {
  some estart: Time | s.emergencyStartTime = estart and
  timeValue[d.assignedAt] >= timeValue[estart] and
  timeValue[d.assignedAt] <= timeValue[s.time]
}

// Fact: Delegated roles assigned during Emergency mode revoked immediately at Emergency mode exit
fact R4_2_DelegatedRoleRevocationPostEmergency {
  all s: SystemState | s.mode = Normal =>
    all d: DelegatedRole | DelegatedRoleAssignedDuringEmergency[d,s] => d.revoked = True
}

// === Admin Credential Update Step After Emergency ===

// Fact: adminCredentialsUpdated must include all administrators after Emergency mode ends (atomic blocking step)
fact R4_3_AdminCredentialUpdate {
  all s: SystemState | s.mode = Normal and no s.emergencyStartTime =>
    all a: Administrator | a in s.adminCredentialsUpdated
}

// Predicate: blocking condition - no system interaction (no requests processed, no role changes) before all admins updated credentials
// To model blocking, all transitions from state s where s.mode=Normal and s.emergencyStartTime=none require s.adminCredentialsUpdated includes all admins
pred BlockingCredentialUpdate(s: SystemState, s': SystemState) {
  s.mode = Normal and no s.emergencyStartTime and
  all a: Administrator | a in s.adminCredentialsUpdated
  // This predicate can be used to restrict allowed transitions after Emergency end before credential update
}

// === Request Processing ===

// R3.1: Request processing prioritizes classification with concurrency batches during Emergency mode
pred R3_1_RequestProcessing (s: SystemState, reqsHigh, reqsMed, reqsLow: set Request) {
  s.mode = Emergency

  all r: reqsHigh | r.classification = CHigh
  all r: reqsMed | r.classification = CMedium
  all r: reqsLow | r.classification = CLow

  // All processed requests have processedAt defined
  all r: reqsHigh + reqsMed + reqsLow | r.processedAt != none

  // No lower classification request starts before all higher classification requests complete
  // i.e., processedAt times: all High requests processed concurrently (same time)
  // then all Medium concurrently, then all Low concurrently
  all r1, r2: reqsHigh | r1.processedAt = r2.processedAt
  all r1, r2: reqsMed | r1.processedAt = r2.processedAt
  all r1, r2: reqsLow | r1.processedAt = r2.processedAt

  // All High processedAt < all Medium processedAt
  all rH: reqsHigh, rM: reqsMed | timeValue[rH.processedAt] < timeValue[rM.processedAt]

  // All Medium processedAt < all Low processedAt
  all rM: reqsMed, rL: reqsLow | timeValue[rM.processedAt] < timeValue[rL.processedAt]
}

// === Normal Mode FIFO ordering ===

fact NormalModeFIFO {
  all s: SystemState | s.mode = Normal =>
    all r1, r2: Request |
      timeValue[r1.submittedAt] < timeValue[r2.submittedAt] and r2.processedAt != none =>
      r1.processedAt != none and timeValue[r1.processedAt] <= timeValue[r2.processedAt]
}

// === Incremental predicates for verification ===

pred R1(s, s': SystemState) {
  R1_TriggerEmergency[s, s']
}

pred R2(s, s': SystemState) {
  R2_EmergencyDuration[s, s']
}

pred R3(s: SystemState, reqsHigh, reqsMed, reqsLow: set Request) {
  s.mode = Emergency
  R3_1_RequestProcessing[s, reqsHigh, reqsMed, reqsLow]
  // R3.2 exclusivity suspended (no fact)
  // R3.3 Emergency privileges granted at start and revoked during Emergency (see predicates/facts)
  // R3.4 delegation allowed (delegation facts apply)
}

pred R4(s: SystemState) {
  s.mode = Normal
  R4_1_RevokeEmergencyPrivileges
  R4_2_DelegatedRoleRevocationPostEmergency
  R4_3_AdminCredentialUpdate
}

// Comprehensive predicate: All requirements met for transition from s to s' and request processing sets
pred All_Requirements(s, s': SystemState, reqsHigh, reqsMed, reqsLow: set Request) {
  (R1[s, s'] and R2[s, s']) and
  (s'.mode = Emergency => R3[s', reqsHigh, reqsMed, reqsLow]) and
  (s'.mode = Normal => R4[s'])
}

