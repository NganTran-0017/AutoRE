// Alloy 6 model for RBAC system with Emergency Module prospective requirements

open util/ordering[Time]

// === Basic Enums and Ordering ===

abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig CHigh, CMedium, CLow extends ClassificationLevel {}

// Define ordering of ClearanceLevel: High > Medium > Low
fact ClearanceOrder {
  High != Medium && Medium != Low && High != Low
  // We model strict ordering by predicates below
}

// Predicate for clearance comparison: c1 >= c2
pred clearanceAtLeast[c1, c2: ClearanceLevel] {
  (c1 = High) or
  (c1 = Medium and c2 != High) or
  (c1 = Low and c2 = Low)
}

// Similarly for classification level
pred classificationAtMost[c1, c2: ClassificationLevel] {
  (c1 = CLow) or
  (c1 = CMedium and c2 != CLow) or
  (c1 = CHigh and c2 = CHigh)
}

// === Time for temporal modeling ===

sig Time {}
one sig InitTime extends Time {} // initial time

// === Mode ===

abstract sig Mode {}
one sig Normal extends Mode {}
one sig Emergency extends Mode {}

// === System State ===

sig SystemState {
  mode: one Mode,
  time: one Time,
  emergencyStartTime: lone Time, // defined when mode = Emergency
  emergencyDuration: lone Int,   // fixed duration in time units
  emergencyManuallyEnded: Bool,  // true if manually ended early
  // track admins who triggered emergency at this time (for R1)
  emergencyTriggers: set User,
  // track whether admins have updated credentials post-emergency
  adminCredentialsUpdated: set User
}

// === Users and Roles ===

sig User {
  clearance: one ClearanceLevel,
  assignedRoles: set Role,    // assigned roles (persistent)
  delegatedRoles: set DelegatedRole, // delegated roles currently held
  submittedRequests: set Request
}

abstract sig Administrator extends User {} // subset of Users with High clearance

fact AdminClearance {
  all a: Administrator | a.clearance = High
