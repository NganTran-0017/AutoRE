  (s.emergencyManuallyEnded = True and s'.mode = Normal and
    s'.time > s.time and
    s'.emergencyStartTime = none and
    s'.emergencyDuration = s.emergencyDuration and
    s'.emergencyManuallyEnded = False and
    s'.adminCredentialsUpdated = s.adminCredentialsUpdated)
