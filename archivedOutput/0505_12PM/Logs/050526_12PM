// R3.3: Administrators gain emergency privileges exclusive to Emergency mode
sig EmergencyPrivilege {}

sig AdminEmergencyPrivilege {
  admin: one Administrator,
  heldDuring: one SystemState
}

// R3.4: Delegated roles can be assigned as usual during Emergency mode respecting constraints (already modeled)

// Delegated roles assigned during Emergency mode may be revoked anytime before Emergency mode ends
// This is allowed by the revoked flag and DelegationRevocation fact.

// === Post-Emergency Restoration ===

// R4.1: All emergency privileges held by admins revoked at emergency end
fact R4_1_RevokeEmergencyPrivileges {
  all s: SystemState | s.mode = Normal =>
    no AdminEmergencyPrivilege | AdminEmergencyPrivilege.heldDuring = s
}

// R4.2: All delegated roles assigned during Emergency mode must be revoked after Emergency mode ends
// Delegated roles assigned before Emergency mode remain active unless expired or revoked by admin

pred DelegatedRoleAssignedDuringEmergency[d: DelegatedRole, s: SystemState] {
  some estart: Time | s.emergencyStartTime = estart and
  timeValue[d.assignedAt] >= timeValue[estart] and
  timeValue[d.assignedAt] <= timeValue[s.time]
}

// At emergency end state, delegated roles assigned during emergency revoked
fact R4_2_DelegatedRoleRevocationPostEmergency {
  all s: SystemState | s.mode = Normal =>
    all d: DelegatedRole | DelegatedRoleAssignedDuringEmergency[d,s] => d.revoked = True
}

// R4.3: Administrators must update credentials immediately after Emergency mode end and before any further interaction
// Abstract representation: adminCredentialsUpdated must include all admins after emergency ends
fact R4_3_AdminCredentialUpdate {
  all s: SystemState | s.mode = Normal and s.emergencyStartTime = none =>
    all a: Administrator | a in s.adminCredentialsUpdated
}

// No further system interaction allowed before credential update
// Modeled as a predicate requiring adminCredentialsUpdated includes all admins before any action after Emergency

// === Concurrency and FIFO during Normal mode ===

// During Normal mode: requests processed in strict FIFO order modeled via timestamps
fact NormalModeFIFO {
  all s: SystemState | s.mode = Normal =>
    all r1, r2: Request |
      timeValue[r1.submittedAt] < timeValue[r2.submittedAt] and r2.processedAt != none =>
      r1.processedAt != none and timeValue[r1.processedAt] <= timeValue[r2.processedAt]
}

