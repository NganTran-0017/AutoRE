// Alloy 6 model for RBAC system with Emergency Module prospective requirements

open util/ordering[Time]

// === Basic Enums and Ordering ===

abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig CHigh, CMedium, CLow extends ClassificationLevel {}

// Define ordering of ClearanceLevel: High > Medium > Low
fact ClearanceOrder {
  High != Medium && Medium != Low && High != Low
  // We model strict ordering by predicates below
}

// Predicate for clearance comparison: c1 >= c2
pred clearanceAtLeast[c1, c2: ClearanceLevel] {
  (c1 = High) or
  (c1 = Medium and c2 != High) or
  (c1 = Low and c2 = Low)
}

// Similarly for classification level
pred classificationAtMost[c1, c2: ClassificationLevel] {
  (c1 = CLow) or
  (c1 = CMedium and c2 != CLow) or
  (c1 = CHigh and c2 = CHigh)
}

// === Time for temporal modeling ===

sig Time {}
one sig InitTime extends Time {} // initial time

// === Mode ===

abstract sig Mode {}
one sig Normal extends Mode {}
one sig Emergency extends Mode {}

// === System State ===

sig SystemState {
  mode: one Mode,
  time: one Time,
  emergencyStartTime: lone Time, // defined when mode = Emergency
  emergencyDuration: lone Int,   // fixed duration in time units
  emergencyManuallyEnded: Bool,  // true if manually ended early
  // track admins who triggered emergency at this time (for R1)
  emergencyTriggers: set User,
  // track whether admins have updated credentials post-emergency
  adminCredentialsUpdated: set User
}

// === Users and Roles ===

sig User {
  clearance: one ClearanceLevel,
  assignedRoles: set Role,    // assigned roles (persistent)
  delegatedRoles: set DelegatedRole, // delegated roles currently held
  submittedRequests: set Request
}

abstract sig Administrator extends User {} // subset of Users with High clearance

fact AdminClearance {
  all a: Administrator | a.clearance = High
  // Not all High clearance users are administrators:
  some u: User - Administrator | u.clearance = High
}

// === Role ===

sig Role {
  minClearance: one ClearanceLevel,
  // Roles mutually exclusive pairs (static)
  // modeled as symmetric relation between roles
  mutuallyExclusive: set Role
}

// Mutual exclusivity symmetric and irreflexive
fact RoleExclusivitySymmetry {
  all r: Role | r !in r.mutuallyExclusive
  all r, r': Role | (r in r'.mutuallyExclusive) iff (r' in r.mutuallyExclusive)
}

// === Delegated Roles ===

sig DelegatedRole {
  role: one Role,
  fromUser: one User, // delegator, higher clearance user
  toUser: one User,   // delegatee, lower clearance user
  assignedAt: one Time,
  expiresAt: one Time,
  revoked: Bool
}

// Delegation clearance constraints: fromUser clearance > toUser clearance
fact DelegationClearance {
  all d: DelegatedRole | clearanceAtLeast[d.fromUser.clearance, d.toUser.clearance] and
    d.fromUser != d.toUser and
    // fromUser clearance strictly higher than toUser clearance
    not clearanceAtLeast[d.toUser.clearance, d.fromUser.clearance]
}

// Delegated role minimum clearance respected by toUser
fact DelegationMinClearance {
  all d: DelegatedRole | clearanceAtLeast[d.toUser.clearance, d.role.minClearance]
}

// Delegated roles can be revoked any time (revoked flag)
fact DelegationRevocation {
  all d: DelegatedRole | d.revoked => d.expiresAt >= d.assignedAt
}

// === System Objects ===

sig SysObject {
  classification: one ClassificationLevel
}

// === Requests ===

sig Request {
  submittedBy: one User,
  affectedObjects: set SysObject,
  classification: one ClassificationLevel,
  submittedAt: one Time,
  processedAt: lone Time,
  approved: lone Bool // none if not yet decided
}

// Request classification equals highest classification of affected objects
fact RequestClassification {
  all r: Request | 
    r.classification = CHigh iff some o: r.affectedObjects | o.classification = CHigh
  all r: Request | 
    r.classification = CMedium iff 
      (no o: r.affectedObjects | o.classification = CHigh) and
      some o: r.affectedObjects | o.classification = CMedium
  all r: Request |
    r.classification = CLow iff
      (no o: r.affectedObjects | o.classification in CHigh + CMedium) and
      some o: r.affectedObjects | o.classification = CLow
}

// Users may submit requests only if request classification <= user clearance
fact RequestSubmissionClearance {
  all r: Request | classificationAtMost[r.classification, r.submittedBy.clearance]
}

// === Role Exclusivity Constraints ===

// During Normal mode, users cannot hold mutually exclusive roles simultaneously
fact NormalModeRoleExclusivity {
  all s: SystemState | s.mode = Normal =>
    all u: User | no disj r1, r2: u.assignedRoles + (d: u.delegatedRoles | d.role) | r2 in r1.mutuallyExclusive
}

// During Emergency mode, exclusivity constraints suspended (no fact needed)

// === Emergency Mode Triggering and Duration ===

// Exactly two administrators must simultaneously trigger emergency to transition from Normal to Emergency immediately
pred R1_TriggerEmergency (s, s': SystemState) {
  s.mode = Normal
  s'.mode = Emergency
  // Exactly two admins triggered emergency simultaneously
  #s'.emergencyTriggers = 2
  all a: s'.emergencyTriggers | a in Administrator
  // emergencyTriggers distinct in s' (set)
  // The two admins triggered simultaneously (instant)
  // Other fields unchanged except time and mode and triggers
  s'.time > s.time
  s'.emergencyStartTime = s'.time
  s'.emergencyDuration = s.emergencyDuration
  s'.emergencyManuallyEnded = False
  s'.adminCredentialsUpdated = none
}

// Emergency mode duration and manual ending
pred R2_EmergencyDuration (s, s': SystemState) {
  s.mode = Emergency

  // Manual end triggers change to Normal mode
  (s.emergencyManuallyEnded = True and s'.mode = Normal and
    s'.time > s.time and
    s'.emergencyStartTime = none and
    s'.emergencyDuration = s.emergencyDuration and
    s'.emergencyManuallyEnded = False and
    s'.adminCredentialsUpdated = s.adminCredentialsUpdated)
