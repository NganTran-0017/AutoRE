// === Basic Enums and Ordering ===

abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig CHigh, CMedium, CLow extends ClassificationLevel {}

// Define ordering of ClearanceLevel: High > Medium > Low
fact ClearanceOrder {
  High != Medium; Medium != Low; High != Low;
  // strict ordering modeled by clearanceAtLeast predicate below
}

// Predicate for clearance comparison: c1 >= c2 (High > Medium > Low)
pred clearanceAtLeast[c1, c2: ClearanceLevel] {
  (c1 = High) or
  (c1 = Medium and c2 != High) or
  (c1 = Low and c2 = Low)
}

// Predicate for classification comparison: c1 <= c2 (CLow < CMedium < CHigh)
pred classificationAtMost[c1, c2: ClassificationLevel] {
  (c1 = CLow) or
  (c1 = CMedium and c2 != CLow) or
  (c1 = CHigh and c2 = CHigh)
}

// === Time modeled as ordered atoms with integer mapping for arithmetic ===

sig Time {}

fact TimeOrdering {
  // Util ordering provides next, first, last relations on Time
}

fun timeValue[t: Time]: Int

// We must define that timeValue is total, injective, strictly increasing over ordering
fact TimeValueProperties {
  all t1, t2: Time |
    (t1 = t2) iff (timeValue[t1] = timeValue[t2])
  all t1, t2: Time |
    (timeValue[t1] < timeValue[t2]) iff (t1 in (t2.^prev))
