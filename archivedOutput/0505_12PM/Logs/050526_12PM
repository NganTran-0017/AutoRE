// R3.1: Request processing prioritizes classification levels in strict order: all High concurrently, then all Medium concurrently, then all Low concurrently
pred R3_1_RequestProcessing (s: SystemState, reqsHigh, reqsMed, reqsLow: set Request) {
  s.mode = Emergency;
  // All requests in respective sets have matching classification
  all r: reqsHigh | r.classification = CHigh;
  all r: reqsMed | r.classification = CMedium;
  all r: reqsLow | r.classification = CLow;
  // Processed concurrently in batches by classification level
  // ProcessedAt times must reflect this ordering:
  // For all processed requests, processedAt is defined (non-lone)
  all r: reqsHigh | r.processedAt != none;
  all r: reqsMed | r.processedAt != none;
  all r: reqsLow | r.processedAt != none;

  // processedAt times respect classification priority ordering:
  // All High requests processed before any Medium requests processed
  all rH: reqsHigh, rM: reqsMed | timeValue[rH.processedAt] < timeValue[rM.processedAt];
  // All Medium requests processed before any Low requests processed
  all rM: reqsMed, rL: reqsLow | timeValue[rM.processedAt] < timeValue[rL.processedAt];

  // Within each classification, requests processed concurrently (same processedAt time)
  all r1, r2: reqsHigh | r1.processedAt = r2.processedAt;
  all r1, r2: reqsMed | r1.processedAt = r2.processedAt;
  all r1, r2: reqsLow | r1.processedAt = r2.processedAt;
}

