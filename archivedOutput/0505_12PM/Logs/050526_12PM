// prev is not defined in util/ordering, define helper predicate for strict ordering
pred prev[t1, t2: Time] { t1 in t2.^prev } // placeholder for strict ordering
// Since util/ordering defines next, we can define:
fun prev[t1, t2: Time]: Bool { some t3: Time | t3 = t2 and t1 in t3.^next } // but better to define timeValue ordering as ground truth

