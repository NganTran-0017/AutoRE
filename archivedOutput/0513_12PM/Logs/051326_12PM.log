}

// R3.2: In Emergency, at least one user holds two mutually exclusive roles (EmergencyScenario_Positive required)
assert assertMutExRolesCanBeHeldEmergency {
    EmergencyScenario_Positive =>
        some s: State |
            s.mode = Emergency and
            some u: User, r1, r2: Role |
                r1 != r2 and
                r1 in r2.mutuallyExclusiveWith and
                r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s]
}

// R3-Normal: In Normal mode, no user ever holds two mutually exclusive roles
assert assertNoMutExRolesNormal {
    all s: State |
        (s.mode = Normal) =>
            all u: User |
                all r1, r2: Role |
                    not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and r1 in rolesHeld[u, s] and r2 in rolesHeld[u, s])
}

// Delegation cannot expire before it is granted
assert assertDelegationNoEarlyExpiry {
    all d: Delegation | no d.expiresAt or lt[d.delegatedAt, d.expiresAt]
}

// Delegation only possible if delegator holds the role and delegatee meets clearance at delegation
assert assertDelegationAssignmentValid {
    all d: Delegation |
        some s: State |
            d in s.delegations and d.delegatedAt = s and
            d.role in rolesHeld[d.delegator, s] and
            ClearanceOrd/lte[d.role.minClearance, d.delegatee.clearance]
}

// R4.1: After Emergency, ALL EmergencyPrivileges must be revoked from emAdmins
assert assertR4_1 {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            s.emPrivs = none)
}

// R4.2a: After Emergency, ONLY Emergency-delegated roles revoked
assert assertR4_2a {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s))
}

// R4.2b: Delegations assigned before Emergency are NOT revoked at Emergency end
assert assertR4_2b {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Normal) =>
                    (no d.expiresAt) or (d.expiresAt != s))
}

// R4.3: Only emAdmins must update credentials after Emergency
assert assertR4_3 {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            (Time/prev[s].emAdmins in s.needsCredentialUpdate and
             all a: s.needsCredentialUpdate | a in Time/prev[s].emAdmins))
}

// EmergencyPrivilege only ever granted in Emergency, always revoked after
assert assertEmergencyPrivilegeOnlyInEmergency {
    all s: State | (s.mode != Emergency) => s.emPrivs = none
}

// Liveness: Emergency must always eventually return to Normal somewhere in the trace
assert assertEmergencyLiveness {
    all s: State |
        (s.mode = Emergency) =>
            some s2: future[s] | s2.mode = Normal
}

// Mutual exclusion structure is symmetric and irreflexive
assert assertMutExSymmIrreflexive {
    all r: Role | r not in r.mutuallyExclusiveWith
    all r1, r2: Role | r1 in r2.mutuallyExclusiveWith iff r2 in r1.mutuallyExclusiveWith
}

// Edge-case: Delegation expires at Emergency exit (positive)
assert assertDelegationExpiresAtEmergencyExit_Positive {
    DelegationExpiresAtEmergencyExit_Positive =>
        some s: State |
            s.mode = Normal and prevModeIsEmergency[s] and
            some d: Time/prev[s].delegations |
                d.delegatedAt.mode = Emergency and d.expiresAt = s
}

// [REMOVED]: Negative delegation expiry edge-case assertion (assertDelegationExpiresAtEmergencyExit_Negative) and predicate, as this scenario is impossible per requirements
// [EVENT]: Removed DelegationExpiresAtEmergencyExit_Negative and assertDelegationExpiresAtEmergencyExit_Negative per feedback; updated documentation to clarify R4.2a

// Edge-case: Delegation with min-clearance delegatee (positive)
assert assertDelegationMinClearance_Positive {
    DelegationMinClearance_Positive =>
        some d: Delegation | d.delegatee.clearance = d.role.minClearance
}

// Edge-case: Delegation with min-clearance delegatee (negative)
assert assertDelegationMinClearance_Negative {
    DelegationMinClearance_Negative =>
        all d: Delegation | d.delegatee.clearance != d.role.minClearance
}

// Edge-case: Multiple Emergency-Normal-Emergency transitions
assert assertMultipleEmergencyTransitions_Positive {
    MultipleEmergencyTransitions_Positive =>
        some s1, s2, s3: State |
            Time/lt[s1, s2] and Time/lt[s2, s3] and
            s1.mode = Emergency and s2.mode = Normal and s3.mode = Emergency
}

// =========================================================
// =================== RUN/CHECK COMMANDS ==================
// =========================================================

// Emergency scenario: require Emergency, mut-ex roles, and observability of user holding both mut-ex roles
pred EmergencyVerificationScenario_Positive {
    EmergencyScenario_Positive
    All_Requirements
}

// Delegation expiry at Emergency exit (positive)
pred DelegationExpiresAtEmergencyExitVerification_Positive {
    DelegationExpiresAtEmergencyExit_Positive
    All_Requirements
}

// [REMOVED]: DelegationExpiresAtEmergencyExitVerification_Negative predicate and associated run, as negative scenario is not possible

// Delegation with min-clearance delegatee (positive)
pred DelegationMinClearanceVerification_Positive {
    DelegationMinClearance_Positive
    All_Requirements
}

// Delegation with min-clearance delegatee (negative)
pred DelegationMinClearanceVerification_Negative {
    DelegationMinClearance_Negative
    All_Requirements
}

// Multiple Emergency/Normal transitions (positive)
pred MultipleEmergencyTransitionsVerification_Positive {
    MultipleEmergencyTransitions_Positive
    All_Requirements
}

// Normal mode only (no Emergency enforced, mut-ex roles optional)
pred NormalVerificationScenario {
    NormalScenario_Generic
    All_Requirements
}

// ----------- RUNS/CHECKS ------------

// [NOTE]: All Emergency-related runs MUST use EmergencyScenario_Positive for coverage.

run EmergencyVerificationScenario_Positive for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

run DelegationExpiresAtEmergencyExitVerification_Positive for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

run DelegationMinClearanceVerification_Positive for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
run DelegationMinClearanceVerification_Negative for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

run MultipleEmergencyTransitionsVerification_Positive for 5 but 5 State, 5 User, 3 Role, 5 Object, 5 Request

run NormalVerificationScenario for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

check assertR1 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR1b_strict for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR2 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertEmergencyClassOrder for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertMutExRolesCanBeHeldEmergency for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertNoMutExRolesNormal for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegationNoEarlyExpiry for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegationAssignmentValid for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_1 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_2a for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_2b for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertR4_3 for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertEmergencyPrivilegeOnlyInEmergency for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertEmergencyLiveness for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertMutExSymmIrreflexive for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

check assertDelegationExpiresAtEmergencyExit_Positive for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
// [REMOVED]: check assertDelegationExpiresAtEmergencyExit_Negative

check assertDelegationMinClearance_Positive for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegationMinClearance_Negative for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

check assertMultipleEmergencyTransitions_Positive for 5 but 5 State, 5 User, 3 Role, 5 Object, 5 Request

// [LESSON]: "=> false" is invalid in Alloy 6. Instead, use negated conjunction or "no" quantification.
// [EVENT]: Removed impossible negative delegation expiry scenario and assertion per evaluator feedback and clarified requirement R4.2a.
