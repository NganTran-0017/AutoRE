// R3: Emergency Mode Operational Changes
pred R1R2R3 {
    R1R2 and
    // R3.1: FIFO may be bypassed for high-classification requests during Emergency
    all s: State |
        s.mode = Emergency =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            some high implies (
                all r: Request | (s.reqStatus[r] = Pending and s.reqStatus[r] = Processed) => r in high
            )
    // R3.2: During Emergency, users may hold mutually exclusive roles
    and
    all s: State |
        s.mode = Emergency =>
            some u: User, r1, r2: Role | r1 != r2 and r2 in r1.mutexWith and r1 in s.userRoles[u] and r2 in s.userRoles[u]
    // R3.3: Administrators temporarily gain EmergencyPrivilege (enforced in assertions)
}

// R4: Emergency Deactivation Effects
pred R1R2R3R4 {
    R1R2R3 and
    // EmergencyPrivilege revoked at Emergency exit (asserted)
    // Delegated roles assigned during Emergency are revoked at exit (asserted)
    // Delegated roles assigned before Emergency are not revoked (asserted)
    // R4.3: Administrators must update their credentials after Emergency exit (asserted)
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | s2.adminCredUpdated[a] = True
}

// --- PREDICATE: All Requirements ---
pred All_Requirements { R1R2R3R4 }

// --- BASELINE PREDICATE (Existing System Only) ---
pred baseline {}

// --- POSITIVE TEST: ENSURE DELEGATION DURING EMERGENCY MODE IS EXERCISED ---

pred TestDelegationDuringEmergency {
    some s: State | s.mode = Emergency and some d: Delegation | d in s.activeDelegations and d.duringEmergency = True
}

// --- ASSERTIONS FOR VERIFICATION ---

// Mutual exclusion negative property: In Normal, no user ever holds mutex pair
assert assertMutexNegative {
    all s: State |
        s.mode = Normal =>
            all u: User, r1, r2: Role |
                r2 in r1.mutexWith =>
                    not (r1 in s.userRoles[u] and r2 in s.userRoles[u])
}

// EmergencyPrivilege only granted during Emergency
assert assertEmergencyPrivsOnlyDuringEmergency {
    all s: State |
        all a: Administrator |
            some s.emergencyPrivs[a] implies s.mode = Emergency
}

// EmergencyPrivilege always revoked at Emergency exit
assert assertEmergencyPrivsRevokedAtExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | no s2.emergencyPrivs[a]
}

// Delegated roles during Emergency revoked at exit
assert assertDelegationRevokedAtEmergencyExit {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = True => d not in s2.activeDelegations
}

// Delegated roles from before Emergency not revoked at exit
assert assertDelegationRetainedAfterEmergencyIfNotDuring {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all d: Delegation |
                d.duringEmergency = False => (d in s2.activeDelegations iff d in s.activeDelegations)
}

// --- NEW ASSERTIONS: REQUEST STATUS, FIFO, PROCESSOR, CLEARANCE, PERSISTENCE ---

assert assertRequestStatusMonotonic {
    all s, s2: State, r: Request |
        Next[s, s2] =>
            (s.reqStatus[r] = Processed) => (s2.reqStatus[r] = Processed)
}

assert assertNormalModeFIFO {
    all s, s2: State |
        s.mode = Normal and s2.mode = Normal and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let first = firstPendingFIFO[s] |
            all r: Request |
                (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r = first
}

assert assertEmergencyProcessingPriority {
    all s, s2: State |
        s.mode = Emergency and s2.mode = Emergency and Next[s, s2] =>
            let pending = {r: Request | s.reqStatus[r] = Pending} |
            let high = {r: Request | r in pending and requestClassification[r] = High} |
            let med = {r: Request | r in pending and requestClassification[r] = Medium} |
            let low = {r: Request | r in pending and requestClassification[r] = Low} |
            (
                (some high and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in high) or
                (no high and some med and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in med) or
                (no high and no med and some low and all r: Request | (s.reqStatus[r] = Pending and s2.reqStatus[r] = Processed) => r in low)
            )
}

assert assertRequestProcessorClearance {
    all s: State, r: Request |
        s.reqStatus[r] = Processed and some s.reqProcessor[r] =>
            let proc = s.reqProcessor[r], rc = requestClassification[r] |
                (proc in User) and
                (some c1, c2: Clearance | proc.clearance = c1 and rc = c2 and
                    (c1 = High or (c1 = Medium and (rc = Medium or rc = Low)) or (c1 = Low and rc = Low))
                )
}

assert assertRoleAssignmentClearance {
    all s: State, u: User, r: Role |
        r in s.userRoles[u] => leqClearance[r.minClearance, u.clearance]
}

assert assertRolePersistence {
    all s, s2: State | 
        Next[s, s2] =>
            all u: User, r: Role |
                (r in s.userRoles[u] and not isRoleRevoked[s, s2, u, r]) => r in s2.userRoles[u]
}

// --- NEW ASSERTIONS: STRONGER COVERAGE (PER FEEDBACK) ---

// R1: Exactly two admins required to activate Emergency
assert assertExactlyTwoAdminsActivateEmergency {
    all s, s2: State |
        s.mode = Normal and s2.mode = Emergency and Next[s, s2] =>
            one as: set Administrator | #as = 2
}

// R4.3: Admin credential updates only after Emergency ends
assert assertAdminCredUpdateOnlyAfterEmergency {
    // After Emergency exit, credentials must be updated
    all s, s2: State |
        s.mode = Emergency and s2.mode = Normal and Next[s, s2] =>
            all a: Administrator | s2.adminCredUpdated[a] = True
    // Otherwise, credentials do not spontaneously change
    all s, s2: State |
        not (s.mode = Emergency and s2.mode = Normal and Next[s, s2]) =>
            all a: Administrator | s2.adminCredUpdated[a] = s.adminCredUpdated[a]
}

// --- POSSIBILITY PREDICATE (for Emergency mutex) ---

// It is possible for a user to hold mutually exclusive roles during Emergency
pred MutexPossibleDuringEmergency {
    some s: State | 
        s.mode = Emergency and 
        some u: User, r1, r2: Role | 
            r2 in r1.mutexWith and 
            r1 in s.userRoles[u] and 
            r2 in s.userRoles[u]
}

// --- RUN COMMANDS (Verification Order) ---

run baseline
run All_Requirements
run R1
run R1R2
run R1R2R3
run R1R2R3R4

run MutexPossibleDuringEmergency
run TestDelegationDuringEmergency

check assertMutexNegative
check assertEmergencyPrivsOnlyDuringEmergency
check assertEmergencyPrivsRevokedAtExit
check assertDelegationRevokedAtEmergencyExit
check assertDelegationRetainedAfterEmergencyIfNotDuring
check assertRequestStatusMonotonic
check assertNormalModeFIFO
check assertEmergencyProcessingPriority
check assertRequestProcessorClearance
check assertRoleAssignmentClearance
check assertRolePersistence
check assertExactlyTwoAdminsActivateEmergency
check assertAdminCredUpdateOnlyAfterEmergency

**Evaluator Feedback:**
```
[DIAGNOSIS]:
The syntax error is caused by the use of a 'one' quantifier in the form "one as: set Administrator | #as = 2" within the assertion 'assertExactlyTwoAdminsActivateEmergency'. In Alloy, the 'one' quantifier introduces a single element, not a set, and the syntax "one as: set Administrator | #as = 2" is invalid because 'as' would be a single Administrator, making "#as" (cardinality of an individual) nonsensical. The intention appears to be to assert the existence of exactly two distinct Administrators, but the quantifier and expression do not accomplish this.

[FIX INTENT]:
Replace the invalid quantifier/expression with a correct Alloy 6 idiom for specifying that exactly two distinct Administrators are responsible for Emergency activation.

[REPAIR INSTRUCTIONS]:
- Step 1: Go to the assertion 'assertExactlyTwoAdminsActivateEmergency' and locate the line:
      one as: set Administrator | #as = 2
- Step 2: Replace this line with:
      some a1, a2: Administrator | a1 != a2
- Step 3: (Optional) If you intend to assert that exactly two and only two Administrators are involved, use:
      one as: Administrator -> Administrator | #as = 2 and all x, y: Administrator | (x in as. Administrator and y in as. Administrator and x != y) or (x not in as. Administrator and y not in as. Administrator)
  but for most RBAC models, simply asserting "some a1, a2: Administrator | a1 != a2" suffices for "exactly two".

[RATIONALE]:
This fix is compliant with Alloy 6 syntax and avoids the invalid use of 'one' with a set variable; it correctly asserts the existence of two distinct Administrators, differing from failed approaches that tried to use set quantification or cardinality on scalar variables.

[LESSON]:
When expressing constraints about the number of elements satisfying a property in Alloy, use 'some' with distinct variables and explicit inequality, rather than quantifying over sets with 'one' or applying cardinality to singleton variables.
```

Previous Lessons:
1. Alloy 6 does not allow the 'in' operator with set comprehensions like User & (u: User | u.isAdmin = True); must use {u: User | u.isAdmin = True} for set comprehension.
2. Alloy 6 requires all predicate parameters to have explicit type annotations and to be separated by commas; cannot use parameters without types in predicate headers.
3. Alloy 6 does not support parameterized open of util/seq (e.g., open util/seq[Request]) → Must use open util/seq as Seq and use Seq/Seq[Type] for sequence-typed fields.
4. Alloy 6 does not allow inline comments at the end of open statements → Comments must be on a separate line above the statement.
5. After open util/seq[Request], type Seq[Request] is directly in scope—do not prefix with util/seq/ or alias.

