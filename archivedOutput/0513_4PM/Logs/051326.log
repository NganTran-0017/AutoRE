```alloy
// ====================================================
// RBAC Emergency Model (Alloy 6) -- Strengthened Verification Coverage & Scenario Predicates
// STRUCTURE, BEHAVIOR, CONSTRAINTS ONLY (Abstract, Verifiable)
// ====================================================

// == Utility modules ==
open util/ordering[ClearanceLevel] as ClearanceOrd
open util/ordering[State] as Time

// == ENUMS AND MODES ==
abstract sig ClearanceLevel {}
one sig High, Medium, Low extends ClearanceLevel {}

abstract sig ClassificationLevel {}
one sig C_High, C_Medium, C_Low extends ClassificationLevel {}

abstract sig SystemMode {}
one sig Normal, Emergency extends SystemMode {}

// == USERS, ROLES, OBJECTS ==
sig User {
    clearance: one ClearanceLevel
}
sig Administrator in User {}

sig Role {
    mutuallyExclusiveWith: set Role,
    minClearance: one ClearanceLevel
}

sig Object {
    classification: one ClassificationLevel
}

sig Request {
    requestedBy: one User,
    affects: some Object,
    classification: one ClassificationLevel
}

// == DELEGATION & PRIVILEGES ==
abstract sig ApprovalStatus {}
one sig Approved, Denied extends ApprovalStatus {}

sig Delegation {
    delegator: one User,
    delegatee: one User,
    role: one Role,
    delegatedAt: one State,
    expiresAt: one State,
    approvedBy: one User,
    approvalStatus: one ApprovalStatus
}

sig EmergencyPrivilege {
    admin: one Administrator,
    grantedAt: one State,
    revokedAt: lone State,
    approvedBy: one User,
    approvalStatus: one ApprovalStatus
}

// == SYSTEM STATE (Time-Indexed) ==
sig State {
    mode: one SystemMode,
    emAdmins: set Administrator, // Exactly two admins if Emergency, else none
    requests: set Request,
    delegations: set Delegation,
    emPrivs: set EmergencyPrivilege,
    needsCredentialUpdate: set Administrator,
    assigned: User -> set Role // Explicit mapping: which roles are assigned to which users in this State
}

// == ADMINISTRATOR CONSTRAINT ==
fact AdminCountRange {
    #Administrator >= 0 and #Administrator <= 4
}

// == SYSTEM FACTS AND INVARIANTS ==

// All administrators have High clearance
fact AdminDefinition {
    all a: Administrator | a.clearance = High
}

// For verification coverage: always include users with all clearance levels
fact UsersWithAllClearances {
    all cl: ClearanceLevel | some u: User | u.clearance = cl
}

// For verification coverage: always include a mutually exclusive role pair
fact MutExSymmIrreflexive {
    all r: Role | r not in r.mutuallyExclusiveWith
    all r1, r2: Role | r1 in r2.mutuallyExclusiveWith iff r2 in r1.mutuallyExclusiveWith
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
}

// == ROLE ASSIGNMENT AND HOLDING ==

fun rolesHeld[u: User, s: State]: set Role {
    s.assigned[u]
}

fun activeDelegations[u: User, s: State]: set Delegation {
    { d: s.delegations |
        d.delegatee = u and
        d.delegatedAt in pastOrEqual[s] and
        lte[s, d.expiresAt] and
        d.approvalStatus = Approved
    }
}

fun allRolesHeld[u: User, s: State]: set Role {
    rolesHeld[u, s] + activeDelegations[u, s].role
}

// == EMERGENCY MODULE ==

fact EmergencyTriggerStrict {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and prevModeIsNormal[s] and all a: s.emAdmins | a in Administrator)
        else
            s.emAdmins = none
}

// EmergencyPrivilege: only emAdmins, only during Emergency, must be explicitly revoked after Emergency, approval tracked
fact EmergencyPrivilegeLifecycle {
    all s: State |
        (s.mode = Emergency) =>
            (all ep: s.emPrivs | ep.admin in s.emAdmins and ep.grantedAt = s and
                no ep.revokedAt and ep.approvalStatus = Approved)
        else
            s.emPrivs = none
    all ep: EmergencyPrivilege | some ep.revokedAt => ep.revokedAt.mode = Normal and prevModeIsEmergency[ep.revokedAt]
}

// EmergencyPrivilege must never exist in Normal mode (including first step after Emergency)
fact NoEmergencyPrivsInNormal {
    all s: State | s.mode = Normal => s.emPrivs = none
}

// == REQUEST CLASSIFICATION ==
fun highestClass[os: set Object]: one ClassificationLevel {
    (some o: os | o.classification = C_High) => C_High
    else (some o: os | o.classification = C_Medium) => C_Medium
    else C_Low
}
fact RequestClassification {
    all req: Request | req.classification = highestClass[req.affects]
}

// == FIFO & EMERGENCY ORDERING ==
fact FIFOEnforcedExceptEmergency {
    all s: State | (s.mode = Normal) => FIFOProcessing[s]
}
pred FIFOProcessing[s: State] { } // Abstract placeholder

fact EmergencyRequestClassOrdering {
    all s: State | (s.mode = Emergency) => EmergencyClassOrder[s]
}
pred EmergencyClassOrder[s: State] {
    all r: s.requests | 
        (r.classification = C_Medium) =>
            no r2: s.requests | r2.classification = C_High
    all r: s.requests | 
        (r.classification = C_Low) =>
            no r2: s.requests | r2.classification in (C_High + C_Medium)
}

// == DELEGATION RULES ==

// Self-delegation forbidden; delegator must hold the role; all delegations have explicit expiry; clearance check GTE; approval tracking; expiry after grant
fact DelegationValidity {
    all d: Delegation | 
        d.delegator != d.delegatee
        and d.role in rolesHeld[d.delegator, d.delegatedAt]
        and ClearanceOrd/lte[d.role.minClearance, d.delegatee.clearance]
        and ClearanceOrd/lte[d.delegatee.clearance, d.delegator.clearance]
        and lt[d.delegatedAt, d.expiresAt]
        and d.approvedBy != none
}

// Delegations assigned during Emergency must expire at first state after Emergency; those assigned before Emergency persist until their expiry
fact DelegationExpiryEmergency {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Emergency) => (d.expiresAt = s)
}

// Delegations assigned before Emergency are NOT forcibly expired at Emergency exit
fact PreEmergencyDelegationsRemain {
    all s: State |
        (s.mode = Normal and prevModeIsEmergency[s]) =>
            all d: Time/prev[s].delegations |
                (d.delegatedAt.mode = Normal) =>
                    d.expiresAt != s
}

// Delegations remain active until their explicit expiry unless revoked or expired
fact DelegationPersistsUntilExpiry {
    all d: Delegation, s: State | lte[d.delegatedAt, s] and lte[s, d.expiresAt] =>
        d in s.delegations
}

// == MUTUAL EXCLUSION ENFORCEMENT ==

// In Normal mode: no user holds both roles of any mutually exclusive pair
fact MutualExclusionNormalOnly {
    all s: State | (s.mode = Normal) =>
        all u: User | 
            all r1, r2: Role |
                not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and
                     r1 in allRolesHeld[u, s] and r2 in allRolesHeld[u, s])
}

// In Emergency mode: mutual exclusion is suspended

// == CREDENTIAL UPDATE ==
fact EmergencyCredentialUpdate {
    all s: State |
        ((s.mode = Normal and prevModeIsEmergency[s]) =>
            (Time/prev[s].emAdmins in s.needsCredentialUpdate and
             all a: s.needsCredentialUpdate | a in Time/prev[s].emAdmins))
}

// == TIME HELPERS/ORDERING ==
fun pastOrEqual[s: State]: set State { { s2: State | lte[s2, s] } }
fun past[s: State]: set State { { s2: State | lt[s2, s] } }
fun future[s: State]: set State { { s2: State | gt[s2, s] } }
pred prevModeIsNormal[s: State] { some Time/prev[s] and Time/prev[s].mode = Normal }
pred prevModeIsEmergency[s: State] { some Time/prev[s] and Time/prev[s].mode = Emergency }

// == VERIFICATION SCENARIO: COVERAGE ENFORCEMENT FACTS/PREDS ==

// For Emergency scenario: must have at least one Emergency state, at least one mut-ex role pair, and at least one user holding both during Emergency
pred EmergencyCoverage_Positive {
    some s: State | s.mode = Emergency
    some r1, r2: Role | r1 != r2 and r1 in r2.mutuallyExclusiveWith
    some s: State | s.mode = Emergency and
        some u: User, r1, r2: Role |
            r1 != r2 and r1 in r2.mutuallyExclusiveWith and
            r1 in allRolesHeld[u, s] and r2 in allRolesHeld[u, s]
}

// For Pre-Emergency Delegation Persistence scenario: 
// At least one delegation granted in Normal before Emergency, with expiry after Emergency, remains active through Emergency and after
pred PreEmergencyDelegationCoverage_Positive {
    some s_pre, s_em, s_post: State, d: Delegation |
        Time/lt[s_pre, s_em] and Time/lt[s_em, s_post] and
        s_pre.mode = Normal and
        s_em.mode = Emergency and
        s_post.mode = Normal and
        prevModeIsEmergency[s_post] and
        d.delegatedAt = s_pre and
        d.expiresAt = s_post and
        d in s_pre.delegations and
        d in s_em.delegations and
        d in s_post.delegations
}

// == POSITIVE/NEGATIVE SCENARIO PREDICATES ==

// Emergency: At least one Emergency state, at least one mut-ex role pair, and at least one user holds both in Emergency
pred EmergencyScenario_Positive {
    EmergencyCoverage_Positive
}

// Delegation persists through Emergency: at least one delegation as required
pred PreEmergencyDelegationPersists_Positive {
    PreEmergencyDelegationCoverage_Positive
}

// Negative: delegation assigned in Emergency, expiry after Emergency (should not be allowed)
pred EmergencyDelegationWithLateExpiry_Negative {
    some s_em, s_post: State, d: Delegation |
        s_em.mode = Emergency and
        s_post.mode = Normal and
        prevModeIsEmergency[s_post] and
        d.delegatedAt = s_em and
        d.expiresAt != s_post and
        d in s_em.delegations and
        d in s_post.delegations
}

// == REQUIREMENT PREDICATES (incremental) ==

// R1: Emergency Trigger
pred R1 {
    all s: State |
        (s.mode = Emergency) =>
            (#s.emAdmins = 2 and prevModeIsNormal[s] and all a: s.emAdmins | a in Administrator)
}

// R2: Emergency must eventually return to Normal
pred R1R2 {
    R1 and all s: State | (s.mode = Emergency) => some s2: future[s] | s2.mode = Normal
}

// R3: Emergency behavior (ordering, mutual exclusion suspension, privilege lifecycle)
pred R1R2R3 {
    R1R2 and
    (all s: State | (s.mode = Emergency) => EmergencyClassOrder[s]) and
    (all s: State | (s.mode = Normal) => 
        all u: User | 
            all r1, r2: Role |
                not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and r1 in allRolesHeld[u, s] and r2 in allRolesHeld[u, s]))
    and
    (all s: State | (s.mode = Emergency) =>
        all ep: s.emPrivs | ep.admin in s.emAdmins and ep.grantedAt = s and no ep.revokedAt and ep.approvalStatus = Approved)
    and
    (all ep: EmergencyPrivilege | some ep.revokedAt => ep.revokedAt.mode = Normal and prevModeIsEmergency[ep.revokedAt])
}

// R3.2: For verification, require at least one user simultaneously holds both roles of a mut-ex pair during Emergency
pred R1R2R3_Verification {
    R1R2R3 and EmergencyCoverage_Positive
}

// R4: Emergency restoration (privilege revoked, delegations handled, credential update)
pred R1R2R3R4 {
    R1R2R3_Verification and
    (all s: State | (s.mode = Normal and prevModeIsEmergency[s]) =>
        s.emPrivs = none and
        all d: Time/prev[s].delegations |
            (d.delegatedAt.mode = Emergency) => (d.expiresAt = s) and
            (d.delegatedAt.mode = Normal) => (d.expiresAt != s)
        and
        (Time/prev[s].emAdmins in s.needsCredentialUpdate and
         all a: s.needsCredentialUpdate | a in Time/prev[s].emAdmins)
    )
}

// R4.2b: For verification, require at least one delegation granted pre-Emergency with expiry after Emergency, and persists through Emergency and after
pred R1R2R3R4_Verification {
    R1R2R3R4 and PreEmergencyDelegationCoverage_Positive
}

// R5: Delegation rules (clearance, assignment, expiry, approval)
pred R1R2R3R4R5 {
    R1R2R3R4_Verification and
    all d: Delegation |
        d.delegator != d.delegatee
        and d.role in rolesHeld[d.delegator, d.delegatedAt]
        and ClearanceOrd/lte[d.role.minClearance, d.delegatee.clearance]
        and ClearanceOrd/lte[d.delegatee.clearance, d.delegator.clearance]
        and lt[d.delegatedAt, d.expiresAt]
        and d.approvedBy != none
}

// R6: Mutual exclusivity enforcement (Normal/Emergency)
pred R1R2R3R4R5R6 {
    R1R2R3R4R5
}

// R7: Approval/audit trail for all delegation and privilege requests
pred R1R2R3R4R5R6R7 {
    R1R2R3R4R5R6
    and (all d: Delegation | d.approvedBy != none)
    and (all ep: EmergencyPrivilege | ep.approvedBy != none)
}

// All requirements: for verification, always includes Emergency and pre-Emergency delegation persistence coverage
pred All_Requirements { R1R2R3R4R5R6R7 }

// == ASSERTIONS FOR VERIFICATION ==

// Emergency coverage: At least one user holds both mut-ex roles in Emergency (verification)
assert assertMutExRolesHeldInEmergency {
    EmergencyCoverage_Positive
}

// Mutual exclusion enforced in Normal, never both mut-ex roles held by a user
assert assertMutExRolesNeverHeldInNormal {
    all s: State | (s.mode = Normal) =>
        all u: User | 
            all r1, r2: Role |
                not (r1 != r2 and r1 in r2.mutuallyExclusiveWith and
                     r1 in allRolesHeld[u, s] and r2 in allRolesHeld[u, s])
}

// Delegation persists through Emergency: pre-Emergency granted, post-Emergency expiry
assert assertPreEmergencyDelegationPersists {
    PreEmergencyDelegationCoverage_Positive
}

// Emergency delegation cannot outlive Emergency (must expire at first Normal state after Emergency)
assert assertEmergencyDelegationWithLateExpiry_Negative {
    not EmergencyDelegationWithLateExpiry_Negative
}

// No self-delegation (enforced by fact)
assert assertSelfDelegationForbidden {
    all d: Delegation | d.delegator != d.delegatee
}

// Delegator must be assigned the role (not via delegation, enforced by fact)
assert assertDelegatorAssignedRole {
    all d: Delegation | d.role in rolesHeld[d.delegator, d.delegatedAt]
}

// Delegation clearance: delegator clearance >= delegatee clearance (enforced by fact)
assert assertDelegationClearanceGTE {
    all d: Delegation | ClearanceOrd/lte[d.delegatee.clearance, d.delegator.clearance]
}

// Delegation expiry: never expires before it is granted (enforced by fact)
assert assertDelegationExpiryOrder {
    all d: Delegation | lt[d.delegatedAt, d.expiresAt]
}

// EmergencyPrivilege never in Normal mode, always revoked after Emergency
assert assertNoEmergencyPrivilegeInNormal {
    all s: State | s.mode = Normal => s.emPrivs = none
    all ep: EmergencyPrivilege | some ep.revokedAt => ep.revokedAt.mode = Normal and prevModeIsEmergency[ep.revokedAt]
}

// All delegations and EmergencyPrivileges have approver
assert assertDelegationAndPrivilegeAudit {
    all d: Delegation | d.approvedBy != none
    all ep: EmergencyPrivilege | ep.approvedBy != none
}

// == RUN/CHECK COMMANDS ==

// Main positive scenario: Emergency coverage and delegation persistence; all requirements
pred PositiveVerificationScenario {
    EmergencyCoverage_Positive
    PreEmergencyDelegationCoverage_Positive
    All_Requirements
}

// Emergency scenario only: at least one user holds both mutually exclusive roles in Emergency
pred EmergencyVerificationScenario_Positive {
    EmergencyCoverage_Positive
    All_Requirements
}

// Delegation persistence scenario only: delegation granted before Emergency, persists through Emergency and after
pred PreEmergencyDelegationPersistsVerification_Positive {
    PreEmergencyDelegationCoverage_Positive
    All_Requirements
}

// Negative: Emergency delegation with expiry after Emergency (should NOT exist)
pred EmergencyDelegationWithLateExpiryVerification_Negative {
    EmergencyDelegationWithLateExpiry_Negative
    All_Requirements
}

// == Run commands for positive verification scenarios, always enforce coverage predicates ==
run PositiveVerificationScenario for 8 but 4 State, 5 User, 3 Role, 5 Object, 5 Request
run EmergencyVerificationScenario_Positive for 7 but 4 State, 5 User, 3 Role, 5 Object, 5 Request
run PreEmergencyDelegationPersistsVerification_Positive for 7 but 4 State, 5 User, 3 Role, 5 Object, 5 Request

// == Negative scenario: delegation granted in Emergency does not persist after Emergency ==
run EmergencyDelegationWithLateExpiryVerification_Negative for 7 but 4 State, 5 User, 3 Role, 5 Object, 5 Request

// == Check commands for assertions, always at sufficient scope and with coverage facts ==
check assertMutExRolesHeldInEmergency for 7 but 4 State, 5 User, 3 Role, 5 Object, 5 Request
check assertMutExRolesNeverHeldInNormal for 7 but 4 State, 5 User, 3 Role, 5 Object, 5 Request
check assertPreEmergencyDelegationPersists for 7 but 4 State, 5 User, 3 Role, 5 Object, 5 Request
check assertEmergencyDelegationWithLateExpiry_Negative for 7 but 4 State, 5 User, 3 Role, 5 Object, 5 Request
check assertSelfDelegationForbidden for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegatorAssignedRole for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegationClearanceGTE for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegationExpiryOrder for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertNoEmergencyPrivilegeInNormal for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request
check assertDelegationAndPrivilegeAudit for 5 but 3 State, 5 User, 3 Role, 5 Object, 5 Request

// --- Learning Statements ---

// [LESSON]: Can't use 'no' as a standalone statement in Alloy 6 → Must use 'no x' or negate the conjunction directly
