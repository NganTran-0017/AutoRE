+def extract_alloy_code(text: str, strip_generic_fence: bool = False) -> str:
+    """
+    Extract Alloy code from an LLM response that may wrap it in markdown fences.
+
+    Shared by artifact_store, file_manager, workflow, requirement_actions and
+    the validators below (previously five near-identical local copies).
+
+    Args:
+        text: Raw response text (may contain ```alloy ... ``` fences, a generic
+              ``` fence, or already-plain Alloy code).
+        strip_generic_fence: Also strip a generic ``` fence when the text starts
+              with one and no ```alloy block was found (storage-path behavior).
+
+    Returns:
+        The extracted code, stripped; falls back to the stripped input text.
+    """
+    text = text.strip()
+
+    match = re.search(r'```alloy\s*\n(.*?)```', text, re.DOTALL)
+    if match:
+        return match.group(1).strip()
+
+    if strip_generic_fence and text.startswith('```'):
+        lines = text.split('\n')
+        if lines[0].startswith('```'):
+            lines = lines[1:]
+        if lines and lines[-1].strip() == '```':
+            lines = lines[:-1]
+        return '\n'.join(lines)
+
+    return text
+
+
